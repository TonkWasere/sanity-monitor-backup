f\u043e\u044d\u0442\u043e\u043c\u0443 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u044e \u0441\u043f\u0438\u0441\u043a\u043e\u043c. \u041d\u0435 \u0432\u044b\u0434\u0435\u043b\u0438\u043b\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043d\u0430 \u043f\u0430\u0442\u0447\u043d\u043e\u0443\u0442. \u041d\u0430 \u043a\u0430\u043d\u0430\u043b \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u2014 \u0442\u043e\u0436\u0435. \u041d\u0430 \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0436\u0435 \u043d\u0435\u0434\u0435\u043b\u044e \u0432 \u0438\u0433\u0440\u0435, \u2014 \u0442\u0435\u043c \u0431\u043e\u043b\u0435\u0435. \u0417\u0430\u0442\u043e \u043b\u044e\u0434\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u0442\u0440\u0435\u0434\u044b \u043f\u0440\u043e \u044d\u0442\u043e, \u043d\u0430 \u0444\u043e\u0440\u0443\u043c\u0435 \u0435\u0441\u0442\u044c. \u041e\u0442\u0432\u0435\u0447\u0430\u044e\u0442 \u0431\u044b\u0441\u0442\u0440\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421\u043f\u0440\u0430\u0432\u043a\u0430 \u0438\u0437 \u0445\u0440\u043e\u043d\u0438\u043a\u0438, \u0432\u0441\u0451 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c\u043e:\u003C\/p\u003E\n\n\u003Cp\u003E\u2022 30 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f \u2014 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u00ab\u041f\u0430\u0442\u0447\u043d\u043e\u0443\u0442\u00bb \u043d\u0430 \u0444\u043e\u0440\u0443\u043c\u0435 (d\/195660). \u0421\u0435\u0440\u0438\u044f \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u0430 \u0440\u043e\u0432\u043d\u043e \u043d\u0430 \u043f\u0430\u0442\u0447\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u0441\u0442\u0443\u043f\u0438\u043b \u0432 \u0441\u0438\u043b\u0443.\u003Cbr\u003E\n\u2022 8 \u043e\u043a\u0442\u044f\u0431\u0440\u044f, 23:12 \u2014 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u043f\u043e\u0441\u0442 \u0432 \u0442\u0435\u043c\u0435 \u00ab\u0418\u0433\u0440\u043e\u0432\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u00bb (d\/196062). \u0428\u0435\u0441\u0442\u044b\u0435 \u0441\u0443\u0442\u043a\u0438 \u0442\u0438\u0448\u0438\u043d\u044b. \u041a\u0430\u043d\u0430\u043b \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u043d\u0438 \u043f\u0440\u0430\u0432\u043e\u043a 12-\u0433\u043e, \u043d\u0438 \u043f\u0430\u0442\u0447\u0430 14-\u0433\u043e.\u003Cbr\u003E\n\u2022 12 \u043e\u043a\u0442\u044f\u0431\u0440\u044f, 08:44 \u2014 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c Magoda1 \u0432\u044b\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u044b\u0445 \u043f\u0440\u0430\u0432\u043e\u043a \u2014 14 \u0441\u043a\u0440\u0438\u043d\u0448\u043e\u0442\u043e\u0432 (d\/196315). \u041d\u0435 \u043a\u043e\u043d\u0442\u043e\u0440\u0430, \u043d\u0435 Balance, \u043d\u0435 PR \u2014 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c.\u003Cbr\u003E\n\u2022 13\u201314 \u043e\u043a\u0442\u044f\u0431\u0440\u044f \u2014 \u0438\u0433\u0440\u043e\u043a\u0438 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0442: \u043f\u0440\u0430\u0432\u043a\u0438 \u0443\u0436\u0435 \u0432 \u0438\u0433\u0440\u0435. \u041a\u0442\u043e-\u0442\u043e \u2014 \u043f\u043e \u043a\u044123 \u0438 \u0435\u0451 \u00ab\u0441\u043c\u0435\u0440\u0442\u0435\u043b\u044c\u043d\u043e\u043c\u0443 \u0432\u044b\u0441\u0442\u0440\u0435\u043b\u0443 \u0434\u043e 34 \u043c\u0435\u0442\u0440\u043e\u0432\u00bb (#82), \u043a\u0442\u043e-\u0442\u043e \u2014 \u043f\u043e \u0446\u0435\u0432\u044c\u044e \u041f\u041a\u041f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0436\u0434\u0430\u043b \u043f\u044f\u0442\u044c \u043b\u0435\u0442 (#86), \u043a\u0442\u043e-\u0442\u043e \u2014 \u043f\u043e \u0430\u0432\u0442\u043e\u043e\u0442\u0441\u0435\u0447\u043a\u0430\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u00ab\u043a\u0430\u043a \u0441 \u043a\u043b\u0438\u043a\u0435\u0440\u043e\u043c\u00bb (#87). \u0418\u0433\u0440\u0430 \u0443\u0436\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c. \u041e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u043d\u0435\u0442.\u003Cbr\u003E\n\u2022 14 \u043e\u043a\u0442\u044f\u0431\u0440\u044f, 06:37 \u2014 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u043f\u043e\u0441\u0442 \u0432 \u0442\u0440\u0435\u0434\u0435 \u0441\u043e \u0441\u043a\u0440\u0438\u043d\u0430\u043c\u0438: \u00ab\u044f \u0431\u044b \u043d\u0435 \u0445\u043e\u0442\u0435\u043b \u0432 \u043a\u0435\u043a\u0441\u0431\u043e \u0442\u0430\u043a\u043e\u0433\u043e \u0431\u0430\u043b\u0430\u043d\u0441\u0435\u0440\u0430\u00bb (#88). \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u2014 \u0442\u0438\u0448\u0438\u043d\u0430. \u041a\u043d\u043e\u043f\u043a\u0430 \u00ab\u041e\u0442\u0432\u0435\u0442\u0438\u0442\u044c\u00bb \u0442\u0430\u043c \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u00ab\u041d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c\u00bb. \u0411\u0435\u0437 \u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0438\u044f, \u0431\u0435\u0437 \u043b\u043e\u043a\u0430, \u0431\u0435\u0437 \u043f\u0440\u0438\u0447\u0438\u043d\u044b \u2014 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435\u043b\u044c\u0437\u044f. \u041a\u0430\u043a \u0438 \u0432\u0441\u0451 \u0432 \u044d\u0442\u043e\u043c \u043f\u0430\u0442\u0447\u0435.\u003Cbr\u003E\n\u2022 14 \u043e\u043a\u0442\u044f\u0431\u0440\u044f, 08:29 \u2014 \u044d\u0442\u0430 \u0442\u0435\u043c\u0430: \u00ab\u0418\u0433\u0440\u043e\u0432\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432\u0441\u0442\u0443\u043f\u0438\u043b\u0438 \u0432 \u0441\u0438\u043b\u0443\u00bb. \u0412\u043d\u0443\u0442\u0440\u0438: \u0438\u0432\u0435\u043d\u0442, \u043a\u0435\u0439\u0441 \u0437\u0430 \u0434\u043e\u043d\u0430\u0442, \u043e\u043f\u0440\u043e\u0441. \u0418\u0433\u0440\u043e\u0432\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u2014 \u043d\u043e\u043b\u044c. \u041f\u043e\u0441\u0442 \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0435\u0449\u0451 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0442\u0435\u0445\u0440\u0430\u0431\u043e\u0442. \u041d\u0430 \u043f\u0430\u0442\u0447\u043d\u043e\u0443\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0435 \u043d\u0430\u0448\u043b\u043e\u0441\u044c, \u043d\u0430 \u043a\u0435\u0439\u0441 \u2014 \u043d\u0430\u0448\u0451\u043b\u0441\u044f.\u003Cbr\u003E\n\u2022 09:51 \u2014 \u0442\u0435\u043c\u0430 \u00ab\u041a\u043e\u0433\u0434\u0430 \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u044b\u0439 \u043f\u0430\u0442\u0447?\u00bb (d\/196415): \u00ab\u0432\u043e\u0442 @magoda1 \u043f\u043e\u0441\u0442\u0438\u043b \u0447\u0442\u043e-\u0442\u043e \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0435 \u043f\u0440\u043e \u0431\u0430\u043b\u0430\u043d\u0441\u2026 \u043f\u043e\u0447\u0435\u043c\u0443 \u044d\u0442\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u0431\u044b\u043b\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c\u00bb. \u0412 10:14 \u0442\u0443\u0434\u0430 \u0441\u043f\u0443\u0441\u0442\u0438\u043b\u0441\u044f Crios \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c, \u0447\u0442\u043e \u043f\u0430\u0442\u0447\u0438 \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0435, \u0430 \u00ab\u0435\u0441\u043b\u0438 \u043a\u0442\u043e-\u0442\u043e \u0432\u044b\u0434\u0430\u043b \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u0443\u044e \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044e \u043d\u0430 \u0424\u043e\u0440\u0443\u043c\u0435, \u044d\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e \u043c\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u0440\u0430\u0437\u0443 \u0431\u0440\u0430\u0442\u044c \u0435\u0451 \u0432 \u0440\u0430\u0431\u043e\u0442\u0443 \u0438 \u0440\u0435\u043b\u0438\u0437\u0438\u0442\u044c\u00bb. \u0421 10:14 \u0442\u0435\u043c\u0430 \u043c\u043e\u043b\u0447\u0438\u0442. \u041a\u043d\u043e\u043f\u043a\u0430 \u2014 \u00ab\u041d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c\u00bb. \u0414\u0432\u0435 \u0442\u0435\u043c\u044b \u043f\u0440\u043e \u0431\u0430\u043b\u0430\u043d\u0441 \u0437\u0430 \u043e\u0434\u043d\u043e \u0443\u0442\u0440\u043e. \u0421\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u043c\u043f.\u003Cbr\u003E\n\u2022 10:27 \u2014 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442\u0441\u044f \u043a\u0440\u0430\u0448\u0438: \u00ab\u043a\u0430\u0436\u0434\u044b\u0435 10\u201315 \u043c\u0438\u043d\u0443\u0442\u00bb, \u00ab6 \u0440\u0430\u0437 \u0437\u0430 \u0447\u0430\u0441\u00bb, \u00ab\u0412\u0410\u0419\u0411\u041a\u041e\u0414 \u041f\u041e\u0411\u0415\u0414\u0418\u041b\u00bb (#36\u201341). \u0414\u043e \u00ab\u043e\u0431\u0432\u0435\u0441\u044b \u0432 \u043d\u0430\u0433\u0440\u0430\u0434\u0430\u0445 \u041a\u043e\u043b\u0438\u0437\u0435\u044f\u00bb (#34) \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0434\u043e\u0448\u043b\u0430 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e: \u0438\u0437 \u0434\u0432\u0443\u0445 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0445 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043e\u0434\u0438\u043d \u0443\u0436\u0435 \u0443\u0431\u0440\u0430\u043b\u0438 (#33).\u003C\/p\u003E\n\n\u003Cp\u003E\u0422\u0435\u043f\u0435\u0440\u044c \u043f\u043e \u043b\u043e\u0433\u0438\u043a\u0435 \u043e\u0442\u0432\u0435\u0442\u0430 Crios. \u00ab\u041c\u044b \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u0440\u0430\u0442\u044c \u0444\u043e\u0440\u0443\u043c\u043d\u0443\u044e \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u044e \u0432 \u0440\u0430\u0431\u043e\u0442\u0443\u00bb \u2014 \u043d\u0438\u043a\u0442\u043e \u0438 \u043d\u0435 \u043f\u0440\u043e\u0441\u0438\u0442 \u0431\u0440\u0430\u0442\u044c \u0432 \u0440\u0430\u0431\u043e\u0442\u0443. \u041f\u0440\u0430\u0432\u043a\u0438 \u043e\u0442 12-\u0433\u043e \u0423\u0416\u0415 \u0437\u0430\u043b\u0438\u0442\u044b \u0438 \u0423\u0416\u0415 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u2014 \u0438\u0433\u0440\u043e\u043a\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b\u0438 \u044d\u0442\u043e \u0432\u0430\u0448\u0438\u043c \u0436\u0435 \u043e\u0440\u0443\u0436\u0438\u0435\u043c. \u041f\u0440\u043e\u0441\u044c\u0431\u0430 \u043d\u0435 \u00ab\u0431\u0440\u0430\u0442\u044c\u00bb, \u0430 \u00ab\u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c\u00bb. \u0422\u0435\u043a\u0441\u0442\u043e\u043c. \u0421 \u0446\u0438\u0444\u0440\u0430\u043c\u0438. \u041a\u0430\u043a \u0432 \u0430\u043d\u043e\u043d\u0441\u0435 \u043d\u0430 Steam. \u0420\u0430\u0431\u043e\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u044b \u0441\u0434\u0435\u043b\u0430\u043b\u0438 12-\u0433\u043e, \u043e\u043f\u0438\u0441\u0430\u043d\u0430 \u043d\u0435 \u0432\u0430\u043c\u0438, \u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u0441 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u043c \u2014 \u0438 \u0442\u0435\u043f\u0435\u0440\u044c \u0435\u0449\u0451 \u0438 \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u0430 \u043e\u0442 \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u043a\u043d\u043e\u043f\u043a\u043e\u0439 \u00ab\u041d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c\u00bb.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421\u0447\u0438\u0442\u0430\u0435\u043c \u0434\u0432\u0435\u0440\u0438, \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043b\u0435\u0436\u0438\u0442 \u0441\u043e\u0441\u0442\u0430\u0432 \u043f\u0430\u0442\u0447\u0430: \u043f\u0430\u0442\u0447\u043d\u043e\u0443\u0442 \u2014 \u043d\u0435\u0442. \u041a\u0430\u043d\u0430\u043b \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u2014 \u043c\u043e\u043b\u0447\u0438\u0442. \u0422\u0440\u0435\u0434 \u0441\u043e \u0441\u043a\u0440\u0438\u043d\u0430\u043c\u0438 \u2014 \u0437\u0430\u043a\u0440\u044b\u0442 \u0434\u043b\u044f \u043e\u0442\u0432\u0435\u0442\u043e\u0432. \u00ab\u041a\u043e\u0433\u0434\u0430 \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u044b\u0439 \u043f\u0430\u0442\u0447\u00bb \u2014 \u0437\u0430\u043a\u0440\u044b\u0442 \u0434\u043b\u044f \u043e\u0442\u0432\u0435\u0442\u043e\u0432. \u041e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u044d\u0442\u0430 \u0442\u0435\u043c\u0430. \u041f\u043e\u043a\u0430 \u043a\u043d\u043e\u043f\u043a\u0430 \u0436\u0438\u0432\u0430 \u2014 \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u0441\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u0417\u0430\u0434\u0430\u043d\u0438\u0435 PR-\u043e\u0442\u0434\u0435\u043b\u0443 (\u043f\u0435\u0440\u0447\u0430\u0442\u043a\u0430 \u0438\u0437 d\/195192 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442):\u003C\/p\u003E\n\n\u003Col style=\u0022list-style-type:decimal\u0022\u003E\u003Cli\u003E\u041e\u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0439\u0442\u0435 \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u043a\u0438 \u043e\u0442 12.10 \u0442\u0435\u043a\u0441\u0442\u043e\u043c \u0441 \u0446\u0438\u0444\u0440\u0430\u043c\u0438. \u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u2014 14 \u0441\u043a\u0440\u0438\u043d\u0448\u043e\u0442\u043e\u0432 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f. \u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0435\u0436\u043d\u044f\u044f: \u00ab\u0441\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u00bb.\u003C\/li\u003E\n\u003Cli\u003E\u041e\u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0439\u0442\u0435 \u043d\u0430 \u0444\u043e\u0440\u0443\u043c\u0435 \u0441\u043e\u0441\u0442\u0430\u0432 \u00ab\u042d\u0442\u0430\u043b\u043e\u043d\u043d\u043e\u0439 \u0440\u0430\u0437\u0434\u0430\u0447\u0438\u00bb. \u0421\u0435\u0439\u0447\u0430\u0441 \u043e\u043d \u0436\u0438\u0432\u0451\u0442 \u0432 \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c\u0435 \u0444\u0430\u043d-\u0430\u0433\u0440\u0435\u0433\u0430\u0442\u043e\u0440\u0430 \u2014 \u043f\u0440\u0438\u0447\u0451\u043c \u0432 \u0432\u0438\u0434\u0435 \u0441\u044b\u0440\u043e\u0433\u043e \u0448\u0430\u0431\u043b\u043e\u043d\u0430 \u043a\u043e\u043d\u0442\u043e\u0440\u044b \u0441 \u043d\u0435\u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u043c\u0438 {amount}. \u0417\u0430\u0434\u0430\u0447\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u0434\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0440\u0430\u0434\u0438 \u0442\u0430\u043b\u043e\u043d\u043e\u0432 (#30), \u0438\u0433\u0440\u043e\u043a\u0438 \u0443\u0433\u0430\u0434\u044b\u0432\u0430\u044e\u0442 \u0441\u0430\u043c\u0438.\u003C\/li\u003E\n\u003Cli\u003E\u0412\u0435\u0440\u043d\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0438 \u00ab\u041e\u0442\u0432\u0435\u0442\u0438\u0442\u044c\u00bb \u0432 \u0434\u0432\u0443\u0445 \u0442\u0435\u043c\u0430\u0445 \u043f\u0440\u043e \u0431\u0430\u043b\u0430\u043d\u0441. \u0418\u043b\u0438 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u0435, \u0437\u0430 \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d\u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0438 \u00ab\u041d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c\u00bb.\u