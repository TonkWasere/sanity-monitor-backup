\u0438\u0445 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u0445 \u043a\u0430\u043a \u043e\u043d\u0438 \u0432\u0435\u0441\u044c \u0441\u0435\u0440\u0432\u0435\u0440 \u0443\u0431\u0438\u0432\u0430\u044e\u0442. \u0413\u043b\u044f\u0434\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0443 \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0423\u0431\u0438\u043b\\\u0423\u043c\u0435\u0440 \u0432 \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 10\\1, \u043d\u0435 \u0432\u0441\u0435 \u0442\u0430\u043a \u043c\u043e\u0433\u0443\u0442, \u0443 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u043e\u0432\u0441\u0435\u043c \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442.\u003C\/li\u003E\n \u003Cli\u003E\u041a\u0432\u0435\u0441\u0442\u044b, \u043d\u043e\u0432\u044b\u0435 \u043a\u0432\u0435\u0441\u0442\u044b \u0445\u043e\u0440\u043e\u0448\u043e, \u043d\u043e \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430 \u044d\u0442\u0438 \u0433\u0440\u0435\u0431\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u044b\u0433\u0430\u043d\u044c\u0435(\u043f\u0430\u0440\u043a\u0443\u0440), \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435, \u0432 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043c\u0435\u0441\u0442\u0430\u0445 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u0440\u044b\u0433\u043d\u0443\u0442\u044c. \u0437\u0430\u043f\u0440\u044b\u0433\u043d\u0443\u0442\u044c, \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044f \u0438 \u043f\u0440. \u041b\u044e\u0434\u0438 \u0447\u0430\u0441\u0430\u043c\u0438 \u0438 \u0437\u0430 \u043e\u0434\u043d\u043e\u0433\u043e \u0434\u0432\u0443\u0445 \u043c\u0435\u0441\u0442 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u043f\u0440\u043e\u0439\u0442\u0438 \u0434\u0430\u043d\u043d\u044b\u0435 \u0443\u0447\u0430\u0441\u0442\u043a\u0438.\u003C\/li\u003E\n \u003Cli\u003E\u041d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430 \u041f\u0432\u0435, \u043d\u0435 \u0432\u0441\u0435 \u0438\u0433\u0440\u043e\u043a\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u044f \u0434\u043e\u043c\u043e\u0439 \u0441 \u0440\u0430\u0431\u043e\u0442\u044b \u043c\u043e\u0433\u0443\u0442 \u0431\u0435\u0433\u0430\u0442\u044c \u0447\u0430\u0441\u0430\u043c\u0438 \u0432\u0441\u044e \u043d\u043e\u0447\u044c \u0432 \u043f\u043e\u0438\u0441\u043a\u0430\u0445 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u043e\u0432, \u0430 \u044d\u0442\u043e \u0432 \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043e\u043a, \u0430 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u043e\u0431\u044b\u0447\u043d\u044b\u043c\u0438 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043a\u0430\u043c\u0438 \u043f\u043e 100 \u0442\u044b\u0441\u044f\u0447 \u0432 \u0434\u0435\u043d\u044c, \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0443 \u0442\u0430\u043a\u0438\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u043d\u0438\u0447\u0435\u0433\u043e \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0442\u0435\u043c \u043a\u0442\u043e \u0441\u0443\u0442\u043a\u0430\u043c\u0438 \u0432 \u0438\u0433\u0440\u0435 \u0437\u0430\u0432\u0438\u0441\u0430\u0435\u0442.\u003C\/li\u003E\n \u003Cli\u003E\u0420\u0443\u043a\u0438, \u043f\u0430\u043b\u044c\u0446\u044b \u044d\u0442\u043e \u043a\u0440\u0443\u0442\u043e.\u003C\/li\u003E\n \u003Cli\u003E\u0410\u043f\u0442\u0435\u0447\u043a\u0438 \u0438 \u043f\u0440 \u0432 \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043a\u0443 \u044d\u0442\u043e \u0445\u0440\u0435\u043d\u044c \u043f\u043e\u043b\u043d\u0430\u044f, \u044d\u0442\u043e \u043d\u0435 \u043e\u0434\u0438\u043d\u043e\u0447\u043d\u0430\u044f \u0438\u0433\u0440\u0430 \u0433\u0434\u0435 \u0435\u0435 \u043d\u0430\u0434\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c.\u003C\/li\u003E\n \u003Cli\u003E\u0418 \u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0431\u044b \u0432 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0435 \u0447\u0442\u043e \u0431\u044b \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 (\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c \u043e\u0440\u0443\u0436\u0438\u0435\\\u0431\u0440\u043e\u043d\u044f) \u0431\u044b\u043b\u0430 \u043f\u043e \u0443\u0440\u043e\u0432\u043d\u044e \u0437\u0430\u0442\u043e\u0447\u043a\u0438 \u0438 \u043a\u043b\u0430\u0441\u0441\u043d\u043e\u0441\u0442\u0438, \u0442.\u0435 \u043a \u043f\u0440\u0438\u043c\u0435\u0440\u0443 \u0447\u0442\u043e \u0431\u044b \u043d\u0430\u0432\u0435\u0440\u0445\u0443 \u0431\u044b\u043b\u0438 +15, \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0438\u0435 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u0438\u0435, \u0438 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e \u043a\u043b\u0430\u0441\u0441\u0443 \u043e\u0440\u0443\u0436\u0438\u0435, \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u044b \u043f\u0443\u043b\u0435\u043c\u0435\u0442\u044b \u0438 \u043f\u0440\u043e\u0447\u0435\u0435. \u0410 \u0442\u043e \u0447\u0442\u043e \u0431\u044b \u0441\u0432\u043e\u0435 \u043a\u0430\u043a\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435 \u043d\u0430\u0439\u0442\u0438 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0435. \u043e\u043d\u0438 \u043b\u0435\u0436\u0438\u0442 \u0432\u043d\u0438\u0437\u0443(\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 MP-7) \u043f\u043e\u0441\u043b\u0435 \u0437\u0435\u043b\u0435\u043d\u044b\u0445 \u043a\u0432\u0435\u0441\u0442\u043e\u0432\u044b\u0445 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u043e\u0432.\u003C\/li\u003E\u003C\/ol\u003E\n\n\u003Cp\u003EP.S. \u044d\u0445\u0445, \u0432\u043e\u0442 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b\u0438 \u0431\u044b \u0421\u0438\u043d\u0433\u043b \u041f\u043b\u0435\u0435\u0440 \u043a\u0430\u043a \u0443 \u0422\u0430\u0440\u043a\u043e\u0432\u0430, \u0441 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435\u043c \u0443\u0448\u0435\u043b \u0431\u044b \u0442\u0443\u0434\u0430 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043d\u0443\u044e \u0438\u0433\u0440\u0443, \u0432 \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u0445 \u0440\u0435\u0430\u043b\u0438\u044f\u0445 \u0432 \u044d\u0442\u0443 \u0438\u0433\u0440\u0443 \u0438\u0433\u0440\u0430\u0442\u044c \u043e\u0447\u0435\u043d\u044c \u0441\u043b\u043e\u0436\u043d\u043e, \u043e\u0447\u0435\u043d\u044c \u043c\u043d\u043e\u0433\u043e \u0447\u0438\u0442\u0435\u0440\u043e\u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0437 \u0437\u0430 \u043d\u0438\u043e\u0442\u043a\u0443\u0434\u0430 \u0432\u044b\u0441\u043a\u0430\u043a\u0438\u0432\u0430\u044e\u0442 \u0438 \u0443\u0436\u0435 \u0432 \u0431\u0430\u0448\u043a\u0443 \u0442\u0435\u0431\u0435 \u0441\u0442\u0440\u0435\u043b\u044f\u044e\u0442, \u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441 \u0440\u0430\u0437\u0432\u043e\u0440\u043e\u0442\u0430, \u0432 \u043f\u0440\u044b\u0436\u043a\u0435, \u043d\u0430 \u043f\u043e\u043b\u043d\u043e\u043c \u0431\u0435\u0433\u0443 \u0434\u043e\u0433\u043e\u043d\u044f\u044f \u0441\u0442\u0440\u0435\u043b\u044f\u044f \u0441 MG \u0443\u0431\u0438\u0432\u0430\u044e\u0442 \u0442\u0435\u0431\u044f \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0432\u0441\u0435 \u043f\u0443\u043b\u0438 \u043b\u043e\u0436\u0430\u0442\u0441\u044f \u0432 \u0433\u043e\u043b\u043e\u0432\u0443. \u041b\u044e\u0434\u0438 \u0431\u0435\u0433\u0430\u044e\u0442 \u0441 \u043c\u0430\u043a\u0440\u043e\u0441\u0430\u043c\u0438. \u0447\u0438\u0442\u0430\u043c\u0438 \u0438 \u0435\u0449\u0435 