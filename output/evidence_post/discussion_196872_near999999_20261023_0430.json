30\u043c \u043d\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u044f.\u003C\/p\u003E \n\n\u003Cul\u003E\u003Cli\u003E\u043d\u0435 \u0441\u043a\u0430\u0436\u0443 \u0437\u0430 \u0434\u043e\u0442\u0443, \u043d\u043e \u0432 \u041b\u0438\u0433\u0435 \u043b\u0435\u0433\u0435\u043d\u0434 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0438\u0445 \u0440\u0430\u043d\u0433\u0430\u0445 \u043d\u0435 \u0434\u0430\u044e\u0442 \u0431\u0440\u0430\u0442\u044c \u0441\u0435\u0431\u0435 \u0432 \u043f\u0430\u0447\u043a\u0443 \u043d\u0438\u0449\u0443\u043a\u043e\u0432, \u0447\u0442\u043e \u0431\u044b \u043d\u0435 \u0430\u0431\u0443\u0437\u0438\u043b\u0438\u003C\/li\u003E\u003C\/ul\u003E\n\n\u003Cp\u003E\u0423 \u0432\u0430\u0441 \u0436\u0435 \u043c\u0430\u043b\u043e \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043f\u043e\u0434\u0431\u043e\u0440 \u043f\u043e\u0434\u0431\u0438\u0440\u0430\u0435\u0442 \u043f\u043e \u0432\u0430\u0448\u0435\u043c\u0443 \u201c\u0442\u0440\u0443 \u0441\u043a\u0438\u043b\u0443\u201d, \u0442\u0430\u043a \u043e\u043d \u0435\u0449\u0451 \u0438 \u0434\u044b\u0440\u044f\u0432\u044b\u0439 \u0447\u0442\u043e \u0435\u0431\u043d\u0435\u0448\u044c\u0441\u044f. \u0427\u0443\u0432\u0430\u043a\u0438 \u0430\u0431\u0443\u0437\u044f\u0442 \u0435\u0433\u043e \u0432\u043e \u0432\u0441\u0435 \u0434\u044b\u0440\u043a\u0438, \u0430 \u0432\u044b \u0437\u0430\u0431\u0438\u043b\u0438 \u0445\u0443\u0439 \u0441 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430 \u043d\u0430 \u0444\u0438\u0434\u0431\u0435\u043a \u0438 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0438 \u0435\u0433\u043e \u043f\u043e \u043d\u043e\u0432\u043e\u0439, \u043d\u0438\u0445\u0443\u044f \u043d\u0435 \u043f\u043e\u043f\u0440\u0430\u0432\u0438\u0432\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u043d\u043e\u0441\u0438\u0442\u044c \u043f\u0440\u0430\u0432\u043a\u0438 - \u0445\u0430\u0440\u0430\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u0