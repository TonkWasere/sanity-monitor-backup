41 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 Trueskill \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f - \u0445\u0430\u0440\u0430\u043c, \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0434\u043e \u044d\u0442\u043e\u0433\u043e \u0434\u043e\u0434\u0443\u043c\u0430\u0442\u044c\u0441\u044f?\u003C\/p\u003E\n\n\u003Cp\u003E\u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043f\u043e\u0431\u0435\u0434\u0430, \u0430 \u043d\u0435 \u043d\u0430\u0431\u043e\u0440 \u0446\u0438\u0444\u0440.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0435 \u0441\u0442\u043e\u0439 \u043f\u043e\u0433\u043e\u0434\u0438, \u0432\u043e\u0442 \u0442\u0443\u0442 \u043f\u043e\u0434\u043e\u0436\u0434\u0438 \u043f\u043e\u0434\u043e\u0436\u0434\u0438, \u044f \u043f\u0438\u0441\u0430\u043b \u043d\u0435 \u0437\u0430 \u043f\u043e\u0434\u0431\u043e\u0440, \u0430 \u0437\u0430 \u0441\u0430\u043c\u043e \u043d\u0430\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 \u043e\u0447\u043a\u043e\u0432, \u043f\u0440\u0438\u0447\u0451\u043c \u0437\u0434\u0435\u0441\u044c \u043e\u043f\u044f\u0442\u044c \u043f\u043e\u0434\u0431\u043e\u0440, \u044f \u0432\u043e\u0442 \u043f\u043e\u043d\u044f\u0442\u044c \u043d\u0435 \u043c\u043e\u0433\u0443, \u043c\u043d\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0432\u043e\u0442 \u0432\u044b \u043f\u0440\u0438\u0432\u0435\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u0440, \u0441 \u0434\u043e\u0442\u043e\u0439, \u043e\u043a\u0435\u0439, \u0430 \u043a\u0430\u043a \u0442\u0435\u0431\u0435 \u0442\u043e \u0447\u0442\u043e \u0438\u0433\u0440\u0430\u044f \u0442\u043e\u0442-\u0436\u0435 \u0444\u0435\u0439\u0441\u0438\u0442 \u043d\u0430 \u0442\u0435\u0445-\u0436\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u0438\u0434\u044f \u0444\u0451\u0440\u0441\u0442 \u0442\u0430\u0431\u043e\u043c \u0432 \u043a\u0430\u0442\u043a\u0430\u044f \u044f \u0411\u0423\u0414\u0423 \u041f\u041e\u041b\u0423\u0427\u0410\u0422\u042c \u0411\u041e\u041b\u042c\u0428\u0415 \u0420\u0415\u0419\u0422\u0410, \u043d\u0435 \u0437\u043d\u0430\u044e \u043a\u0430\u043a \u0438\u043c\u0435\u043d\u043d\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0441 \u043d\u043e\u0432\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f, \u043d\u043e \u043a\u043e\u0433\u0434\u0430  \u044f \u0438\u0433\u0440\u0430\u043b, \u0412\u0421\u0415\u0413\u0414\u0410 \u0411\u042b\u041b\u041e \u0422\u0410\u041a \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0442\u044b \u0438\u0434\u0451\u0448\u044c \u0424\u0451\u0440\u0441\u0442 \u0442\u0430\u0431\u043e\u043c \u0442\u043e \u0442\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0435\u0439\u0442\u0430. \u041e\u043a\u0435\u0439 \u0430 \u043a\u0430\u043a \u0442\u0435\u0431\u0435 \u043f\u0440\u0438\u043c\u0435\u0440 \u0441 \u043b\u0438\u0433\u043e \u043b\u0435\u0433\u0435\u043d\u0434, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0442\u0435\u0431\u044f \u043c\u043e\u0433\u0443 \u0430\u0432\u0442\u043e\u0444\u0438\u043b\u044c\u043d\u0443\u0442\u044c \u043d\u0430 \u043d\u0435 \u0442\u0432\u043e\u044e \u0440\u043e\u043b\u044c, \u0438 \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438 \u0447\u0442\u043e \u0442\u044b \u043e\u0442\u044b\u0433\u0440\u0430\u0435\u0448\u044c \u041f\u041e \u0418\u0425 \u0421\u0418\u0421\u0422\u0415\u041c\u0415 \u0421 \u041e\u0426\u0415\u041d\u041a\u0410\u041c\u0418 \u041f\u041e\u0421\u041b\u0415 \u0418\u0413\u0420, \u0445\u043e\u0442\u044f\u0431\u044b \u043d\u0430 \u043e\u0446\u0435\u043d\u043a\u0443 C \u0438 \u0432\u044b\u0448\u0435 \u0442\u043e \u043f\u0440\u0438 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0442\u0435\u0431\u0435 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u0441\u043d\u0438\u043c\u0443\u0442 \u043b\u043f