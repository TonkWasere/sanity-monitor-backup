0451\u043c \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0435, \u043c\u0435\u043d\u044f \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043b\u0438\u0432\u0430\u044e\u0442 \u043b\u044e\u0434\u0438 \u0441\u043e \u0441\u0440\u0451\u043c\u043e\u043c \u0447\u0443\u0442\u044c \u043b\u0438 \u043d\u0435 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u0434\u0438\u0441\u0442\u0435. \u0412\u043e\u0442 \u043d\u0430\u0448\u0438 \u0434\u0440\u0443\u0437\u044c\u044f \u0432 \u0440\u044f\u0434 \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0436\u043a\u043e\u0439 \u0432 \u043f\u0438\u043a\u043e\u0432\u044b\u0445 \u043e\u0431\u0432\u0435\u0441\u0430\u0445. \u0412 \u0442\u0430\u0431\u043b\u0438\u0446\u0443 \u043d\u0435 \u0432\u043b\u0435\u0437\u043b\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c, \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435: \u0421\u04203\u041c - 3,5 \u043f\u043b\u044e\u0441\u0430 \u043a \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 | \u0421\u043a\u043e\u0440\u043f\u0438\u043e\u043d +1.5 | \u0412\u0435\u043a\u0442\u043e\u0440 +2 |\u003C\/p\u003E\n\n\u003Cp\u003E\u0420\u0430\u0437\u0431\u0440\u043e\u0441 \u0443 \u0441\u0440\u0451\u043c\u0430 \u043e\u0442 \u0431\u0435\u0434\u0440\u0430 \u0438 \u0432 \u043f\u0440\u0438\u0446\u0435\u043b\u0438\u0432\u0430\u043d\u0438\u0438 \u043c\u0435\u043d\u044c\u0448\u0435 \u0435\u0433\u043e \u0441\u043e\u0431\u0440\u0430\u0442\u044c\u0435\u0432.\u003Cbr\u003E\n\u041e\u0442\u0434\u0430\u0447\u0430 \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432\u044b\u0448\u0435 \u0447\u0435\u043c \u0443 \u043d\u0438\u0445, \u043d\u043e \u043d\u0435 \u0434\u043e\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442 \u0434\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u0448\u0442\u0443\u0440\u043c\u043e\u0432\u044b\u0445 \u0432\u0438\u043d\u0442\u043e\u0432\u043e\u043a 9\u00d739\u003Cbr\u003E\n\u042d\u0440\u0433\u043e\u043d\u043e\u043c\u0438\u043a\u0430 \u0432 120, \u0447\u0442\u043e \u0434\u0430\u0451\u0442 \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0443\u0442\u0443\u044e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0438 \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0442\u0430\u043a \u043d\u0443\u0436\u043d\u0430 \u043d\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u0432 25 \u043f\u0442.\u003Cbr\u003E\n\u041d\u0443 \u0438 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u043b\u0443\u0447\u0448\u0438\u0439 \u043f\u0430\u0442\u0440\u043e\u043d \u0432 \u0438\u0433\u0440\u0435 \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u044f 12.7 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u043e\u043f\u044f\u0442\u044c \u0436\u0435 \u0441 \u043d\u0435\u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u043c\u0438\u043d\u0443\u0441\u043e\u043c \u043a \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0440\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0438 \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438 \u043d\u0430 \u043f\u0430\u0440\u0430\u0431\u0435\u043b\u043b\u0443\u043c\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u0410\u0445 \u0434\u0430, \u0438 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u044f \u0443 \u043d\u0435\u0433\u043e, \u0432\u044b\u0448\u0435 \u0438\u0445 \u0432\u0441\u0435\u0445, \u0438 \u0434\u0430\u0436\u0435 \u0432\u044b\u0448\u0435 \u0421\u0415\u0420\u0412\u0410\u041b\u0410, \u0420\u0410\u0417\u0420\u042f\u0414\u0410 \u0438 \u0410\u041c\u0411. \u041d\u0430 \u0434\u0432\u0430-\u0442\u0440\u0438 \u0431\u043b\u043e\u043a\u0430. \u041a\u0430\u043a, \u043f\u043e\u0447\u0435\u043c\u0443?\u003C\/p\u003E\n\n\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196567-sr3m\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224711761\