436\u0435 \u0438 10 \u044f\u0434\u0435\u0440 \u0431\u0442\u0432.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196624-trebuetsya-cpushnyh-del-master\/28\u0022 class=\u0022PostMention\u0022 data-id=\u00224713788\u0022\u003EGOBEH\u003C\/a\u003E \u0423 \u0442\u0435\u0431\u044f \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u043e\u0446 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d \u043d\u0430 \u0432\u0441\u0435 100%, \u0434\u0430\u0436\u0435 \u043a\u0430\u043a \u0442\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u0448\u044c\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0443 \u043c\u0435\u043d\u044f \u043e\u043d \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d \u0432 \u0431\u0444 \u0438 \u0432\u0430\u0440\u0434\u043e\u0433\u0441\u0435 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u043f\u043e \u043a\u0434, \u043d\u0435 \u043d\u0435\u0441\u0438 \u0447\u0443\u0448\u044c. \u0414\u0430 \u043e\u043f\u044f\u0442\u044c \u0436\u0435 \u0435\u0441\u043b\u0438 \u0445\u043e\u0447\u0435\u0448\u044c \u043f\u043e\u0434\u0443\u0448\u0438\u0442\u044c\u0441\u044f, \u0442\u043e \u0432 \u0441\u043e\u0442\u043a\u0443 \u043e\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0435 \u0443\u0435\u0431\u0435\u0442\u0441\u044f, \u043a\u0430\u043a \u0438 \u0432\u0438\u0434\u044e\u0445\u0430, \u043d\u043e \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0441\u043a\u0430\u0447\u043a\u043e\u0432 \u0434\u043e 80-90%, \u0447\u0442\u043e\u0431\u044b \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u043b\u0438 \u043c\u0438\u043a\u0440\u043e\u0444\u0440\u0438\u0437\u044b \u043f\u043e \u043f\u0440\u043e\u0446\u0443. \u0421 \u0432\u0438\u0434\u044e\u0445\u043e\u0439 \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0435\u0441\u043b\u0438 \u043e\u043d\u0430 \u0437\u0430\u043