":{"type":"users","id":"1701649"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4719247","attributes":{"number":27,"createdAt":"2026-10-21T09:35:53+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196784-vozduhan\/18\u0022 class=\u0022PostMention\u0022 data-id=\u00224719186\u0022\u003EPpwky\u003C\/a\u003E \u043c\u043d\u0435 \u0434\u0438\u0441\u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u043e, \u0447\u0442\u043e \u0432\u044b\u0441\u0442\u0440\u0435\u043b \u043d\u0430 \u043e\u0442\u043f\u0443\u0441\u043a\u0430\u043d\u0438\u0435, \u0430 \u044f \u0435\u0431\u0430\u043d\u0443\u0442\u044b\u0439 \u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437 \u043f\u043e \u043b\u043a\u043c\u0443 \u0436\u043c\u0443 \u0442\u0430\u043a, \u0447\u0442\u043e \u043f\u043e \u0437\u0430\u043a\u0438\u0441\u0448\u0435\u043c\u0443 \u043a\u0443\u0440\u043a\u0443 \u0441\u043f\u0443\u0441\u043a\u043e\u0432\u043e\u043c\u0443 \u0433\u0440\u044f\u0437\u043d\u043e\u0433\u043e \u0430\u043a\u043c\u0430 \u043d\u0430 \u043c\u043e\u0440\u043e\u0437\u0435, \u0447\u0442\u043e \u0430\u0436 \u0445\u0440\u0443\u0441\u0442\u0438\u0442. \u0425\u0437 \u043a\u0430\u043a \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0440\u0443\u043a\u0438, \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d\u0438 \u0434\u0435\u0440\u0435\u0432\u0435\u043d\u0435\u044e\u0442 \u0432 \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043b\u043a\u0430\u0445. \u0421\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u043c\u044b\u0448\u043a\u043e\u0439 \u0445\u0440\u0435\u043d\u043e\u0432\u043e \u0432\u043e\u0436\u0443, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0442\u0440\u0435\u043a\u0430\u0442\u044c \u043d\u0435 \u0443\u043c\u0435\u044e, \u043d\u043e \u0444\u043b\u0438\u043a\u0430\u0442\u044c \u0445\u043e\u0442\u044f \u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f. \u0421 \u0432\u043e\u0437\u0434\u0443\u0445\u0430\u043d\u043e\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u043c\u0438\u043d\u0438 \u0438\u0433\u0440\u0430:\u003Cbr\u003E\n1) \u0447\u0438\u0442\u0430\u0435\u0448\u044c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u0431\u044b\u0442\u044c \u0437\u0430\u0440\u044f\u0436\u0435\u043d\u043d\u044b\u043c \u0442\u043e\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f.\u003Cbr\u003E\n2) \u043f\u0435\u0440\u0432\u044b\u0439 \u0444\u043b\u0438\u043a \u0434\u0435\u043b\u0430\u0435\u0448\u044c \u0441 \u043e\u0442\u043f\u0443\u0441\u043a\u0430\u043d\u0438\u0435\u043c \u043b\u043a\u043c\u003Cbr\u003E\n3) \u0432\u0442\u043e\u0440\u043e\u0439 \u0444\u043b\u0438\u043a \u0434\u0435\u043b\u0430\u0435\u0448\u044c \u043a\u0430\u043a \u043e\u0431\u044b\u0447\u043d\u043e, \u043d\u043e \u0435\u0433\u043e \u043f\u0440\u043e\u0449\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u044c, \u0442\u0430\u043a \u043a\u0430\u043a \u0446\u0435\u043b\u044c \u0447\u0443\u0442\u044c \u043b\u0438 \u043d\u0435 \u0432 \u0441\u0442\u0430\u043d\u0435 (\u043f\u0440\u0430\u0432\u0434\u0430 \u0443 \u0442\u0435\u0431\u044f \u0432\u0438\u043b\u043a\u0430 \u0442\u0443\u0442 \u0435\u0441\u0442\u044c, \u0438\u043d\u043e\u0433\u0434\u0430 \u043d\u0430\u0434\u043e \u0438 \u0432\u0442\u043e\u0440\u043e\u0439 \u0437\u0430\u0440\u044f\u0436\u0430\u0442\u044c).\u003C\/p\u003E\n\n\u003Cp\u003E\u0418\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0435\u0441\u0442\u044c. 6 \u043f\u0442 (\u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0432\u044b\u0445\u043b\u043e\u043f\u043e\u0432\u0441\u043a\u0438\u0445 5). \u041a\u043e\u043c\u0444\u043e\u0440\u0442. \u0412\u0438\u0437\u0443\u0430\u043b \u043