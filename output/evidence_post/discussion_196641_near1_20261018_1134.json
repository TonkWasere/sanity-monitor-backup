34\u043e\u0431\u0440\u044f\u0447\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432 99% \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u043e\u0442\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043d\u0435 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u044e\u0449\u0438\u0445 \u043f\u043e\u0434\u043e\u0437\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043d\u043e\u0441\u0438\u0442\u0435\u043b\u0435\u0439 \u043f\u043e\u0441\u044b\u043b\u043e\u043a.\u003C\/p\u003E \n\n\u003Cp\u003E\u0418 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u0430\u043c \u043e\u0442\u043d\u0435\u0441 \u0432 (\u0443\u0436\u0435) \u0434\u0440\u0435\u0432\u043d\u0438\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430 2022-23 \u0433\u043e\u0434\u043e\u0432 \u0442\u044b\u0441\u044f\u0447\u0443+ \u043f\u0430\u043a\u043e\u0432, \u043f\u043e\u043a\u0430 \u0441\u043e\u0431\u0438\u0440\u0430\u043b \u003Cdel\u003E\u0441\u0440\u0430\u043d\u044b\u0439 \u043a\u0432\u0430\u043d\u0442 \u0434\u043b\u044f \u0433\u043e\u043d\u0447\u0435\u0433\u043e\u003C\/del\u003E \u0442\u0440\u0443\u0434\u043d\u043e\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044b \u0434\u043b\u044f \u0431\u0430\u0440\u0442\u0435\u0440\u0430.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421\u0435\u0439\u0447\u0430\u0441 \u0432\u0430\u0448 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u043f\u043e\u0447\u0442\u0430\u043b\u044c\u043e\u043d \u0443\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u003Cdel\u003E\u0443\u043c\u0435\u0440 \u0432 \u0434\u0440\u0430\u043a\u0435 \u0437\u0430 \u0440\u0430\u0439\u043e\u043d\u003C\/del\u003E \u043e\u0442\u043e\u0448\u0435\u043b \u043e\u0442 \u0434\u0435\u043b \u0438 \u0434\u0430\u0436\u0435 \u0437\u0438\u043c\u043e\u0439 \u043d\u043e\u0441\u0438\u043b \u0440\u044e\u043a\u0437\u0430\u0447\u043a\u0438 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0440\u0435\u0434\u043a\u043e. \u041d\u0430 \u0442\u0440\u0438\u0443\u043c\u0444\u044b \u043f\u0440\u0438\u0448\u043b\u043e\u0441\u044c \u0431\u044b \u0435\u0449\u0435 \u0446\u0435\u043b\u044b\u0439 \u043c\u0435\u0441\u044f\u0446, \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u0431\u0435\u0433\u0430\u0442\u044c, \u0435\u0441\u043b\u0438 \u0431\u044b 30 \u0445\u043e\u0442\u0435\u043b \u043e\u0444\u043e\u0440\u043c\u0438\u0442\u044c (\u0434\u0430, \u0417\u043e\u0440\u044c\u043a\u0438, \u0432\u044b \u0438\u0437-\u0437\u0430 \u043c\u0435\u043d\u044f \u043d\u0435 \u0432\u044b\u0438\u0433\u0440\u0430\u043b\u0438 \u0443 \u043d\u0430\u0439\u043c\u043e\u0432 \u0422\u0440\u0438\u0443\u043c\u0444\u0430\u0442\u043e\u0440\u0430)).\u003C\/p\u003E\n\n\u003Chr\u003E\n\n\u003Cp\u003E\u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#23acaf;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u0420\u0443\u043f\u043e\u0440\u044b\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-bullhorn\u0022\u003E\u003C\/i\u003E\u003C\/span\u003E\u003C\/p\u003E \n\n\u003Cp\u003E\u0412 \u0441\u0432\u044f\u0437\u0438 \u0441 \u043c\u0438\u043d\u0438-\u0438\u0432\u0435\u043d\u0442\u043e\u043c \u201c\u042d\u0442\u0430\u043b\u043e\u043d\u043d\u0430\u044f \u0440\u0430\u0437\u0434\u0430\u0447\u0430\u201d \u043c\u043d\u0435 \u0434\u043e\u0432\u0435\u043b\u043e\u0441\u044c \u0441\u043d\u043e\u0432\u0430 \u043e\u0449\u0443\u0442\u0438\u0442\u044c \u0447\u0442\u043e-\u0442\u043e \u043f\u043e\u0445\u043e\u0436\u0435\u0435 \u043d\u0430 \u0441\u0442\u0430\u0440\u044b\u0439 \u0430\u0437\u0430\u0440\u0442 \u043e\u0442 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044f \u0434\u0430\u043b\u044c\u043d\u043e\u0431\u043e\u0439\u0449\u0438\u043a\u0430. \u0421\u043e \u0432\u0441\u0435\u043c\u0438 \u0435\u0433\u043e \u0433\u043b\u0430\u0441\u043d\u044b\u043c\u0438\/\u043d\u0435 \u0433\u043b\u0430\u0441\u043d\u044b\u043c\u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c\u0438, \u043a\u043e\u0434\u0435\u043a\u0441\u043e\u043c \u0447\u0435\u0441\u0442\u0438 \u0438 \u0438\u0433\u0440\u043e\u0439 \u0432 \u043c\u0430\u0444\u0438\u044e \u0441 \u0442\u0432\u0435\u0440\u043a\u0430\u044e\u0449\u0438\u043c\u0438\/\u0441\u0442\u0440\u0435\u043b\u044f\u044e\u0449\u0438\u043c\u0438 \u043f\u043e \u0442\u0432\u0451\u0440\u043a\u0430\u044e\u0449\u0438\u043c \u0432 \u0441\u043f\u0438\u043d\u0443 \u0431\u0435\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u044c\u0449\u0438\u043a\u0430\u043c\u0438.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u0412 \u043e\u0431\u0449\u0435\u043c, \u043f\u0430\u043a\u0435\u0440\u0441\u043a\u0430\u044f \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u0430 \u043c\u043d\u0435 \u043d\u0435 \u0447\u0443\u0436\u0434\u0430, \u043d\u043e \u0435\u0441\u0442\u044c \u043d\u044e\u0430\u043d\u0441: \u043f\u043e\u043a\u0430 \u0437\u0430 \u043f\u0430\u043a \u043d\u0435 \u043d\u0430\u0432\u0430\u043b\u0438\u0432\u0430\u044e\u0442 \u0447\u0435\u0433\u043e-\u0442\u043e \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0430\u0436\u043d\u043e\u0433\u043e, \u0442\u043e \u043e\u043d \u043d\u0430\u0444\u0438\u0433 \u043d\u0435 \u043d\u0443\u0436\u0435\u043d. \u0418 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u043a\u043e\u043b\u044c\u043d\u043e \u0438\u0433\u0440\u0430\u0435\u0442\u0441\u044f, \u0443\u043c\u0438\u0440\u0430\u0435\u0442.\u003C\/strong\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e\u0447\u0435\u043c\u0443 \u0442\u0430\u043a? \u0421\u0430\u043c\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0432\u0435\u0442 - \u0440\u0438\u0441\u043a\u0438 \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \ud83c\udfc5\ud83c\udfc5\ud83c\udfc5. \u041d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0430\u0437\u0430\u0440\u0442\u0430 \u0442\u0430\u0449\u0438\u0442\u044c \u043f\u0430\u043a \u0437\u0430 \u0441\u043a\u0443\u0434\u043d\u044b\u0435 \u043a\u043e\u043f\u0435\u0439\u043a\u0438 \u043d\u0430 \u041f\u0440\u0438\u0442\u043e\u043a, \u0440\u0430\u0432\u043d\u043e \u043a\u0430\u043a \u0438 \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e\u0439 \u043e\u0431\u0438\u0434\u044b \u043d\u0430 \u0430\u043d\u0442\u0438\u043f\u0430\u043a\u0435\u0440\u0430, \u0435\u0441\u043b\u0438 \u043e\u043d \u0437\u0430\u0436\u0430\u043b \u043f\u043e \u0442\u0435\u0431\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u0427\u0442\u043e \u0435\u0449\u0435 \u0445\u0443\u0436\u0435: \u043d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u043e\u0445\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u043f\u0430\u043a\u0435\u0440\u043e\u0432, \u043a\u0440\u043e\u043c\u0435 \u043a\u0430\u043a \u0441 \u0446\u0435\u043b\u044c\u044e \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0439 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0438 \u0437\u0430\u0442\u0440\u043e\u043b\u043b\u0438\u0442\u044c \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0433\u043e \u0440\u0430\u0431\u043e\u0442\u044f\u0433\u0443.\u003C\/strong\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e \u0441\u0443\u0442\u0438 \u043c\u043e\u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0432\u0435\u0440\u0442\u044f\u0442\u0441\u044f \u0432\u043e\u043a\u0440\u0443\u0433 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044f \u003Cem\u003E\u0440\u0438\u0441\u043a\u043e\u0432 \u0438 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438\u003C\/em\u003E: \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0430\u043b\u044e\u0442\u044b \u043d\u043e\u0440\u043c, \u043d\u043e \u043c\u043e\u0436\u043d\u043e \u0438 \u0447\u0442\u043e-\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0435\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u0442\u044c, \u043f\u043e\u0445\u043e\u0436\u0435\u0435 \u043d\u0430 \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u044e \u0410\u0440\u0441\u0435\u043d\u0430\/\u0421\u043f\u0430\u0440\u0442\u0430\u043a\u0430, \u0447\u0442\u043e\u0431\u044b \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0443 \u043d\u0435 \u043c\u0443\u0447\u0438\u0442\u044c.\u003C\/p\u003E \n\n\u003Cp\u003E\u0426\u0435\u043d\u043d\u044b\u0435 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0440\u0430\u0441\u0445\u043e\u0434\u043d\u0438\u043a\u0438 \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043b\u0438\u043a\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u044c\u044e: \u0437\u0430\u043f\u0430\u0441\u043a\u0438, \u0441\u044b\u0432\u043e\u0440\u043e\u0442\u043a\u0430 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f, \u044210\u0435 \u0431\u0443\u0441\u0442\u044b \u0434\u043b\u044f \u043a\u0432\u0448\u0435\u043a\/\u0440\u0435\u0441\u0443\u0440\u0441\u044b \u0434\u043b\u044f \u0438\u0445 \u043a\u0440\u0430\u0444\u0442\u0430, \u043e\u0431\u043c\u0435\u043d\u043d\u044b\u0435 \u043c\u043e\u043d\u0435\u0442\u044b \u0432 \u0431\u043e\u043b\u044c\u0448\u043e\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435, \u0432 \u043e\u0431\u0449\u0435\u043c, \u0447\u0442\u043e-\u0442\u043e \u043d\u0443\u0436\u043d\u043e\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e\u0434\u0430\u0440\u043a\u0438 \u0434\u043b\u044f \u0401\u043b\u043e\u0447\u043a\u0438 \u0432 \u041d\u0413, \u043a\u0441\u0442\u0430\u0442\u0438, \u0431\u044b\u043b\u0438 \u0445\u043e\u0440\u043e\u0448\u0435\u0439 \u043d\u0430\u0433\u0440\u0430\u0434\u043e\u0439, \u0442\u043a \u043d\u0435 \u0431\u0438\u043b\u0438 \u043f\u043e \u0440\u044b\u043d\u043a\u0443 \u043f\u0440\u044f\u043c\u044b\u043c \u0432\u043b\u0438\u0432\u0430\u043d\u0438\u0435\u043c \u0434\u0435\u043d\u0435\u0433, \u043d\u043e, \u043f\u043e \u0444\u0430\u043a\u0442\u0443, \u0440\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u0440\u044b\u043d\u043e\u0447\u043d\u0430\u044f \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043e\u0434\u043d\u043e\u0439 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0431\u044b\u043b\u0430 \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 700\u043a, \u0447\u0442\u043e \u0441\u0442\u043e\u0438\u043b\u043e \u0442\u0440\u0443\u0434\u043e\u0432.\u003C\/p\u003E\n\n\u003Cp\u003E\u0422\u0435\u043f\u0435\u0440\u044c \u043a \u0440\u0438\u0441\u043a\u0430\u043c: \u0430\u043d\u0442\u0438\u043f\u0430\u043a\u0435\u0440\u044b, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043c\u0440\u0430\u0437\u0438, \u0431\u044b\u0434\u043b\u043e \u0438 \u043d\u0435\u0433\u043e\u0434\u044f\u0438. \u0418, \u0435\u0441\u043b\u0438 \u0443 \u043d\u0438\u0445 \u0435\u0441\u0442\u044c \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u043a \u0441\u0430\u043c\u043e\u0440\u0435\u0444\u043b\u0435\u043a\u0441\u0438\u0438, \u0442\u043e \u043e\u043d\u0438 \u0441\u0430\u043c\u0438 \u043e\u0431 \u044d\u0442\u043e\u043c \u0437\u043d\u0430\u044e\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u041d\u043e \u044d\u0442\u0438 \u043e\u0431\u0437\u044b\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u0432\u0434\u0438\u0432\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043e \u0442\u0435\u0445 \u043f\u043e\u0440, \u043f\u043e\u043a\u0430 \u0438\u0445 \u043f\u043e\u0437\u043e\u0440\u043d\u044b\u0439 \u0438 \u0431\u0435\u0441\u0447\u0435\u0441\u0442\u043d\u044b\u0439 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439 \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0441\u043c\u044b\u0441\u043b\u0430.\u003C\/strong\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u041f\u0438\u0440\u0430\u0442\u0441\u0442\u0432\u043e \u0434\u043e\u043b\u0436\u043d\u043e \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u044c, \u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u043f\u0440\u0438\u0431\u044b\u043b\u044c! \u0410 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0434\u043e\u0441\u0442\u044c \u043c\u0430\u043c\u043a\u0438\u043d\u043e\u0433\u043e \u0441\u0430\u0434\u0438\u0441\u0442\u0430.\u003C\/strong\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u0418\u043c\u0435\u043d\u043d\u043e \u0447\u0435\u0440\u0435\u0437 \u0432\u044b\u0433\u043e\u0434\u0443 \u0434\u043b\u044f \u0443\u0431\u0438\u0439\u0446\u044b \u043f\u0430\u043a\u0435\u0440\u0430 \u044f \u0431\u044b \u0438 \u0443\u0441\u0438\u043b\u0438\u043b \u0440\u0438\u0441\u043a\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a\u043e\u0432, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0431\u044b \u0438\u043c, \u0432 \u0441\u0432\u043e\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u0438\u043c\u0435\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u0436\u0438\u0440\u043d\u0443\u044e \u043d\u0430\u0433\u0440\u0430\u0434\u0443: \u0432\u0435\u0434\u044c \u043a\u043e\u0433\u0434\u0430 \u044f \u0431\u0443\u0434\u0443 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0447\u0442\u043e-\u0442\u043e \u0437\u0430 \u0441\u0430\u043c \u0444\u0440\u0430\u0433, \u0442\u043e \u0442\u0430\u043a\u043e\u0439 \u0434\u043e\u0431\u0440\u044f\u0447\u043e\u043a \u043a\u0430\u043a \u044f \u0442\u043e\u0436\u0435 \u0441 \u0440\u0430\u0434\u043e\u0441\u0442\u044c\u044e \u043d\u0430\u0447\u043d\u0451\u0442 \u0443\u0431\u0438\u0432\u0430\u0442\u044c, \u044d\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u0432\u0435\u0441\u0451\u043b\u0430\u044f \u0438 \u0437\u0430\u0431\u0430\u0432\u043d\u0430\u044f \u0438\u0433\u0440\u0430 \u0432 \u0434\u0443\u0445\u0435 \u0441\u0443\u0440\u043e\u0432\u043e\u0433\u043e \u0447\u0437\u043e. \u003Cspan class=\u0022spoiler\u0022 onclick=\u0022removeAttribute(\u0027class\u0027)\u0022\u003E\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u0442\u0430\u0449\u0438\u0442\u044c \u0438 \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0434\u0430\u0442\u044c \u043e\u043f\u043b\u0451\u0432\u0430\u043d\u043d\u044b\u0439 \u0440\u044e\u043a\u0437\u0430\u043a \u0434\u043e \u043a\u0443\u0440\u044c\u0435\u0440\u0430 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u0432 \u0441\u0447\u0451\u0442: \u0442\u0430\u043a \u0442\u044b \u0441\u0430\u043c \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0448\u044c\u0441\u044f \u0432 \u043f\u0430\u043a\u0435\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0435\u0449\u0435 \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0437\u0430 \u0435\u0449\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043a\u043e\u043f\u0435\u0439\u043a\u0438, \u0447\u0435\u043c \u0442\u043e\u0442, \u043a\u043e\u0433\u043e \u0442\u044b \u0443\u0431\u0438\u043b.\u003C\/span\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0434\u0438\u043d \u0432\u044b\u0436\u0438\u0432\u0430\u0435\u0442 \u0438 \u0441\u0440\u044b\u0432\u0430\u0435\u0442 \u043a\u0443\u0448, \u0434\u0440\u0443\u0433\u043e\u0439 \u0435\u043c\u0443 \u044d\u0442\u043e\u0442 \u0447\u0435\u043b\u043b\u0435\u043d\u0434\u0436 \u0441\u043e\u0437\u0434\u0430\u0435\u0442. \u0412\u0441\u0435 \u043a\u0430\u043a \u0438 \u0434\u043e\u043b\u0436\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432 \u043e\u043f\u0435\u043d\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u0423\u0441\u043b\u043e\u0432\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0432\u0435 \u0448\u043a\u0430\u043b\u044b \u0440\u0435\u043f\u0443\u0442\u0430\u0446\u0438\u0438: \u043e\u0444\u0438\u0441 \u043e\u0442\u0447\u0430\u044f\u043d\u043d\u044b\u0445 \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0432 \u0411\u0430\u0440\u0435, \u0438 \u043f\u043e\u0434\u0432\u0430\u043b \u043f\u0440\u044b\u0449\u0430\u0432\u044b\u0445 \u043d\u0435\u0434\u043e\u0431\u0440\u043e\u0436\u0435\u043b\u0430\u0442\u0435\u043b\u0435\u0439 \u0433\u0434\u0435-\u0442\u043e \u0432 \u0416\u0438\u043b\u043a\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0443 \u0438 \u0434\u0430\u043b\u044c\u0448\u0435 \u043c\u043e\u0436\u043d\u043e \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0440\u0435\u0433\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434 \u0442\u0435\u043c \u0438 \u0434\u0440\u0443\u0433\u0438\u043c, \u0447\u0442\u043e\u0431\u044b \u0431\u0430\u043b\u0430\u043d\u0441 \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u0445 \u0434\u043e\u0441\u0442\u0430\u0432\u043e\u043a\/\u0441\u043c\u044b\u0441\u043b\u0430 \u0438\u0445 \u043f\u043a\u0430\u0448\u0438\u0442\u044c \u0431\u044b\u043b \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d.\u003C\/p\u003E\n\n\u003Cp\u003E\u0415\u0449\u0435 \u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0431\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f \u0432 \u0432\u044b\u0431\u043e\u0440\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432. \u0425\u043e\u0447\u0443, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0430\u043a\u0438 \u0438\u0437 \u0431\u0430\u0440\u0430 \u043d\u0430 \u044e\u0433 \u0434\u043e \u0431\u043e\u043b\u043e\u0442 \u0438 \u043e\u0431\u0440\u0430\u0442\u043d\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e\u0447\u0442\u0430\u043b\u044c\u043e\u043d\u044b\/\u0431\u0443\u0434\u0443\u0449\u0438\u0435 \u043f\u0438\u0440\u0430\u0442\u044b \u043d\u0430 \u0444\u043e\u0440\u0443\u043c\u0435 \u0435\u0441\u0442\u044c? \u0418\u043b\u0438 \u003Cdel\u003E\u0443 \u043d\u0430\u0441 \u0432\u0441\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435\u003C\/del\u003E \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0440\u043e\u04