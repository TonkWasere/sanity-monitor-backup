-2dd8-4038-bf7f-2390472c6cd2\u0022 loading=\u0022lazy\u0022 width=\u0022430\u0022 height=\u0022329\u0022\u003E\u003Cbr\u003E\n\u0417\u043d\u0430\u0435\u0442\u0435, \u043c\u043d\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u043c\u0435\u0440\u0437\u043e\u0442\u043d\u043e \u043e\u0442 \u0438\u0433\u0440. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u0430\u043d\u0430\u043b\u044c\u043d\u043e \u0432\u044b\u0437\u044b\u0432\u0430\u043b\u0438 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u0435 (\u043c\u043e\u0431\u0438\u043b\u043a\u0438 \u0442\u0430\u043a \u0442\u043e\u0447\u043d\u043e), \u043d\u043e \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0430: \u201c\u044d\u0442\u043e \u0434\u0435\u0440\u044c\u043c\u043e\u201d. \u0418 \u0432\u043e\u0442 \u043d\u0430\u0441\u0442\u0430\u043b \u043c\u043e\u043c\u0435\u043d\u0442, \u043a\u043e\u0433\u0434\u0430 \u043c\u043e\u043b\u0447\u0430\u0442\u044c \u043e \u0431\u0430\u043d\u0430\u043b\u044c\u043d\u043e\u043c \u0443\u0436\u0435 \u043d\u0435\u043b\u044c\u0437\u044f. \u041c\u0435\u043d\u044f \u0431\u043b\u0435\u0432\u0430\u0442\u044c \u0442\u044f\u043d\u0435\u0442 \u043e\u0442 \u0421\u0442\u0430\u043b\u0437\u043e\u043d\u0435. \u041b\u044e\u0431\u043e\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0435 \u044d\u0442\u043e\u0439 \u0438\u0433\u0440\u044b - \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u043e \u043d\u0435\u0434\u043e\u0440\u0430\u0437\u0443\u043c\u0435\u043d\u0438\u0435.\u003Cbr\u003E\n\u041d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0436\u0435 \u043d\u0430\u0434\u043e \u0437\u0430\u0435\u0431\u0430\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0430, \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u0443\u0436\u0435 \u0431\u043b\u0435\u0432\u0430\u0442\u044c \u0442\u044f\u043d\u0443\u043b\u043e \u043d\u0430 \u0432\u0430\u0448\u0443 \u0438\u0433\u0440\u0443? \u041a\u043e\u0433\u0434\u0430 \u0438\u0433\u0440\u043e\u043a \u043e\u0442 \u0433\u0440\u0435\u0445\u0430 \u043f\u043e\u0434\u0430\u043b\u044c\u0448\u0435 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0438\u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0439 \u043e\u0444\u0444 \u043a\u0430\u043d\u0430\u043b \u043f\u0440\u043e\u0435\u043a\u0442\u0430 [\u041a\u043b\u043e\u0430\u043a\u0430, \u0433\u0434\u0435 \u0440\u0430\u0437 \u0432 \u043f\u043e\u043b \u0433\u043e\u0434\u0430 \u0447\u0442\u043e-\u0442\u043e \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f.]. \u0422\u043e\u0439\u043e\u0442\u0430 \u0441 \u041c\u0418\u0420 \u0412 \u0421\u041e\u0421\u0410\u041d\u0418\u0418 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0434\u043e\u0431\u0438\u043b \u043c\u043e\u044e \u0442\u0430\u0439\u043d\u0443\u044e \u0432\u0435\u0440\u0443 \u0432 \u0442\u043e, \u0447\u0442\u043e \u0432\u0430\u043c \u0432\u043e\u043e\u0431\u0449\u0435 \u0447\u0442\u043e-\u0442\u043e \u043f\u043e\u043c\u043e\u0436\u0435\u0442. \u0440\u0435\u0440\u0430\u043d\u0438\u0442\u044c \u0438\u0432\u0435\u043d\u0442 \u0432 3 \u0440\u0430\u0437 \u043f\u043e\u0434\u0440\u044f\u0434 \u0441 \u0435\u0431\u0430\u043d\u0443\u0442\u044b\u043c \u0440\u0430\u043d\u0434\u043e\u043c\u043e\u043c \u0438 \u0441 \u0420\u0415\u0419\u0422\u0418\u041d\u0413\u041e\u041c. \u0410\u0440\u0435\u043d\u0430 \u0412\u043e\u0440\u043e\u043d\u0430 \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u0445\u043e\u0440\u043e\u0448\u0438\u0439 \u0438\u0432\u0435\u043d\u0442. \u041f\u0440\u043e\u0441\u0442\u043e\u0439. \u0411\u044b\u043b\u0430 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u0441\u044e\u0436\u0435\u0442\u043d\u0430\u044f \u043b\u0438\u043d\u0438\u044f (\u0441 \u0434\u0430\u043d\u0436\u0430\u043c\u0438 \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u0