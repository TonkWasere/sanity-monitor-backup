s=\u0022PostMention\u0022 data-id=\u00224720490\u0022\u003EMrZakZek\u003C\/a\u003E 1) \u0414\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0431\u044b \u0442\u0430\u043a\u0438\u0435 \u0438 \u0431\u044b\u043b\u0438, \u0442\u043e \u043e\u043d\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u0442\u044c \u043d\u0435\u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b \u0438 \u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c\u0441\u044f.\u003Cbr\u003E\n2) \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0447\u0435\u0433\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0432\u0441\u044f\u043a\u0438\u0435 \u0430\u043a\u0443\u043b\u044c\u0442\u043d\u044b\u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0432 \u0418\u0420\u041b \u0442\u043e \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435, \u0430 \u043f\u043e\u0447\u0435\u043c\u0443 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u0442\u044c \u0432 \u0417\u041e\u041d\u0415, \u0434\u0430 \u0435\u0431\u0430\u0442\u044c \u0432\u0441\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043c\u0435\u0441\u0442\u043e \u0431\u0435\u0437 \u0437\u0430\u043a\u043e\u043d\u0430 \u0433\u0434\u0435 \u043c\u043e\u0436\u043d\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0441\u0435 \u0447\u0442\u043e \u0443\u0433\u043e\u0434\u043d\u043e.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196817-kultisty-v-zone\/16\u0022 class=\u0022PostMention\u0022 data-id=\u00224720490\u0022\u003EMrZakZek\u003C\/a\u003E \u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0444\u0440\u0430\u043a\u0446\u0438\u0438 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u0432 \u043d\u0435\u0439 \u0437\u0430\u0445\u043e\u0442\u044f\u0442 \u043f\u043e\u0431\u044b\u0432\u0430\u0442\u044c. \u0415\u0441\u043b\u0438 \u0438 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c \u0447\u0442\u043e-\u0442\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u0441\u043e \u0432\u0440\u0435\u043c\u0435\u043d \u041f\u0420\u0422, \u0442\u043e \u044d\u0442\u043e \u0432\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0432\u043e \u0444\u0440\u0430\u043a\u0446\u0438\u0438 \u0432\u043e\u0435\u043d\u043d\u044b\u0445 \u0438 \u043c\u043e\u043d\u043e\u043b\u0438\u0442\u0430, \u0433\u0434\u0435 \u044d\u0442\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u043b\u043e\u0441\u044c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c\u044e \u0434\u0430\u043d\u0430\u0442\u0438\u0442\u044c. \u0422\u0430\u043c \u0438 \u0438\u0445 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0438 \u0441\u0432\u043e\u044f \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u0434\u043b\u044f \u0438\u0433\u0440\u044b.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0435 \u0432\u0438\u0436\u0443 \u043c\u0438\u043d\u0443\u0441\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u044c \u0432 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u043a\u0443 \u043c\u043e\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043e\u0442\u0431\u043e\u0440 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0442\u044c \u043c\u0435\u0441\u0442\u0430 \u043d\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u043c\u0435\u0441\u044f\u0446, \u0430\u0432\u0442\u043e\u043a\u0438\u043a \u0441\u0434\u0435\u043b\u0430\u0442\u044c. \u0414\u043b\u044f \u0432\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u043f\u043e\u0440\u043e\u0433 \u0443\u0431\u0438\u0439\u0441\u0442\u0432, \u043d\u0430\u0439\u0434\u0435\u043d\u044b \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u043e\u0432 \u0430 \u043d\u0430\u0431\u043e\u0440 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u044c \u043e\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0440\u0430\u043d\u0434\u043e\u043c\u043d\u043e \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0435\u0442\u044c \u043e\u0442 \u0434\u043e\u043d\u0430\u0442\u0430 \u0438\u0442\u0434.\u003C\/p\u003E \n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196817-kultisty-v-zone\/16\u0022 class=\u0022PostMention\u0022 data-id=\u00224720490\u0022\u003EMrZakZek\u003C\/a\u003E \u0419\u043e\u0443, \u0413\u041f \u041f\u041a\u0448\u0435\u0440\u043e\u0432\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0443 \u044d\u0442\u043e \u043f\u043e\u043a\u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f \u0447\u0442\u043e \u043e\u043d\u0438 \u043c\u043e\u0433\u0443\u0442 \u0434\u0435\u043b\u0430\u0442\u044c, \u0441\u043f\u043e\u0441\u043e\u0431 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0430.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196817-kultisty-v-zone\/16\u0022 class=\u0022PostMention\u0022 data-id=\u00224720490\u0022\u003EMrZakZek\u003C\/a\u003E \u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0443\u0436\u0435 \u043f\u043e\u043d\u044f\u0442\u044c, \u0447\u0442\u043e \u0438\u0434\u0435\u044f \u0432\u043e\u0437\u043d\u0438\u043a\u043b\u0430 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u043a\u0430\u043a\u043e\u0433\u043e-\u0442\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0430, \u043b\u0438\u0431\u043e \u0430\u0432\u0442\u043e\u0440 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f \u0441 \u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u043a\u0443\u043b\u044c\u0442\u0438\u0441\u0442\u043e\u0432, \u0430 \u043f\u043e\u0437\u043d\u0430\u043d\u0438\u044f \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u044f\u043c\u0438 \u043e \u043c\u0443\u0436\u0438\u043a\u0430\u0445, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043a\u0438\u0448\u043a\u0430\u043c\u0438 \u043c\u0430\u0436\u0443\u0442\u0441\u044f.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u042d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0434\u0435\u044f \u0447\u0442\u043e \u0432 \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u043c \u043c\u043e\u0436\u043d\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c, \u0441 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043c \u0441\u0430\u043c\u043e\u0439 \u0444\u0440\u0430\u043a\u0446\u0438\u0438, \u0434\u0430 \u044f \u043f\u043e\u043d\u0438\u043c\u0430\u044e \u0434\u0438\u043a\u0438\u0439 \u0441\u0435\u0432\u0435\u0440 \u0441\u0430\u043c \u043f\u043e \u0441\u0435\u0431\u0435 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439 \u043d\u043e \u043a\u043e\u0433\u0434\u0430 \u043e\u0442\u043a\u0440\u043e\u044e\u0442 