41\u0442\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0445\u0443\u0439 \u0437\u0430\u0431\u0438\u043b\u0438 \u043d\u0430 \u044d\u0442\u0443 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u043a\u0443, \u043c\u044b \u0441\u0442\u0440\u0430\u0434\u0430\u0435\u043c \u0432\u044b \u0432 \u043a\u043e\u0439 \u0442\u043e \u0432\u0435\u043a\u0438 \u0432\u044b\u043a\u0438\u0434\u0430\u0432\u0430\u0435\u0442\u0435 \u043e\u0431\u043d\u043e\u0432\u0443 \u0438 \u0447\u0442\u043e \u043c\u044b \u0432\u0438\u0434\u0438\u043c? \u041e\u043f\u044f\u0442\u044c \u0431\u043e\u043d\u0443\u0441\u044b \u043d\u0430\u0439\u043c\u0430\u043c \u0438 \u0445\u0443\u0439 \u0437\u0430\u0432\u0435\u0442\u0443 \u0437\u0430 \u0432\u0441\u0451 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0438 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a\u043e\u0433\u043e \u0445\u0443\u044f, \u0430 \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0431\u043b\u044f\u0442\u044c.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196928-zdravstvuyte-exbo\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224724166\u0022\u003EArgions\u003C\/a\u003E \u0415\u0431\u0430\u043d\u0443\u0442\u044b\u0439 \u0442\u0435\u0439\u043a, \u0417\u0430\u0432\u0435\u0442 \u0441\u043e \u0434\u043d\u044f \u0438\u043a\u0441 \u0435\u0431\u0451\u0442 \u0440\u0443\u0431\u0435\u0436 \u043d\u0435 \u0432\u044b\u043d\u0438\u043c\u0430\u044f, \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0438\u0445\u0443\u044f, \u043f\u0430\u0440\u0443 \u0440\u0430\u0437 \u0440\u0443\u0431\u0435\u0436 \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0440\u044b\u043f\u043d\u0443\u0442\u044c\u0441\u044f, \u043d\u0435 \u043f\u043e\u043c\u043e\u0433\u043b\u043e\u003C\/p\u003E\n\n\u003Cp\u003E\u0418\u0437\u043d\u0430\u043d\u043a\u0430 2026 \u0435\u0441\u043b\u0438 \u0447\u0451 \u0441\u0442\u0430\u0442\u0430, \u0417\u0430\u0432\u0435\u0442 \u0442\u0443\u0442 \u0434\u0430\u0436\u0435 \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u0432\u0441\u0435\u0445 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0430\u0451\u041c\u044b\u0448\u0435\u0439\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-05\/1791212481-482031-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u0022be48c5d7-3bf0-4279-9a45-d406fa0f9b03\u0022 loading=\u0022lazy\u0022 width=\u00222124\u0022 height=\u0022306\u0022\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u0413\u043e\u043d\u043a\u0443 \u0444\u0440\u0430\u043a\u0446\u0438\u0439 - \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0431\u044b \u043f\u043e\u0445\u0443\u0439, \u0417\u0430\u0432\u0435\u0442 - \u044d\u0442\u043e \u0447\u0438\u0441\u0442\u043e \u0431\u0430\u0442\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0435\u0431\u0430\u0448\u0438\u0442 \u0431\u043b\u044f\u0434\u0435\u0439 \u0438 \u043f\u044c\u0451\u0442 \u043f\u0438\u0432\u0430\u0441\u0438\u043a, \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0443\u0451\u0431\u043e-\u0441\u043a\u0438\u043d\u0447\u0438\u043a\u003C\/p\u003E","renderFailed":false,"editedAt":"2026-10-24T07:01:46+00:00","canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196928"}},"user":{"data":{"type":"users",