438\u0445\u0435\u0440\u0430 \u043d\u0435 \u0434\u0435\u043b\u0430\u0442\u044c. \u0421\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0439 \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b\u043e \u043e\u0442 \u043c\u0435\u043d\u044f, \u043e\u0442 \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u043d\u043e\u0432\u0438\u0447\u043a\u043e\u0432, \u043e\u0442 \u043c\u0430\u0441\u0442\u043e\u0432, \u043e\u0442 \u044e\u0442\u0443\u0431\u0435\u0440\u043e\u0432, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0438 \u0432\u0430\u0448\u0438\u0445 \u043c\u0435\u0434\u0438\u0430 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u043e\u0432. \u041d\u043e \u0441\u0430\u043c\u044b\u043c \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u043e \u0447\u0435\u043c \u043f\u0440\u043e\u0441\u044f\u0442 \u0438 \u043f\u0440\u043e\u0441\u0438\u043b\u0438 \u0432\u0441\u0435 \u0438\u0433\u0440\u043e\u043a\u0438 \u0432\u0441\u0435 \u0432\u0440\u0435\u043c\u044f - \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f. \u0411\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u043c\u0438\u043d\u0443\u0442 5 \u043d\u0430\u0437\u0430\u0434 \u0431\u0435\u0433\u0430\u043b \u0432 \u043e\u043f\u0435\u043d\u0435, \u043a\u0430\u043a \u0432\u0434\u0440\u0443\u0433 \u043d\u0430\u0442\u043a\u043d\u0443\u043b\u0441\u044f \u043d\u0430 \u043f\u0430\u0440\u0443 \u0434\u043e\u0445\u043e\u0434\u044f\u0433. \u0420\u0435\u0448\u0438\u0432 \u0432\u0441\u0442\u0443\u043f\u0438\u0442\u044c \u0432 \u0431\u043e\u0439, \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043e\u0442\u043a\u0438\u0434\u044b\u0432\u0430\u044e \u043e\u0442\u0434\u044b\u0445\u0430\u0442\u044c \u043d\u0430 \u0431\u0430\u0437\u0443 1 \u044e\u043d\u0433\u0443, \u043f\u043e\u043a\u0430 \u0435\u0433\u043e \u003Cdel\u003E\u0433\u0435\u0439 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u003C\/del\u003E \u043d\u0430\u043f\u0430\u0440\u043d\u0438\u043a \u043d\u0435 \u043f\u044b\u0442\u0430\u0435\u0442\u044c\u0441\u044f \u043c\u0435\u043d\u044f \u0434\u043e\u0431\u0438\u0442\u044c. \u0411\u043b\u0430\u0433\u043e \u0443 \u043c\u0435\u043d\u044f \u0435\u0449\u0435 \u0431\u044b\u043b\u0438 \u043f\u0430\u0442\u0440\u043e\u043d\u044b \u0432 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0435, \u0430 \u043f\u043e\u0442\u043e\u043c\u0443 \u044f \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u0437\u0430\u0436\u0430\u043b \u0435\u0433\u043e, \u0441\u043d\u0435\u0441\u044f \u0435\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f, \u0437\u0430\u0442\u0435\u043c, \u0432\u043c\u0435\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0438, \u0440\u0435\u0448\u0430\u044e \u0434\u043e\u0441\u0442\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0434\u0440\u0430\u0433\u043e\u0446\u0435\u043d\u043d\u044b\u0439 \u0433\u043b\u043e\u043a \u0438 \u043f\u043e\u0439\u0442\u0438 \u0432 \u0440\u0430\u0448. \u0421\u0442\u0440\u0435\u043b\u044f\u044e \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432 \u0443\u043f\u043e\u0440, \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0430\u044f\u0441\u044c \u043a \u043d\u0435\u043c\u0443, \u0448\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043e\u043c, \u0441\u043e\u043a\u0440\u0430\u0449\u0430\u044e \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u044e, \u043f\u043e\u043a\u0430 \u043d\u0435 \u0443\u0441\u043b\u044b\u0448\u0438\u043b \u0437\u0430\u0432\u0435\u0442\u043d\u044b\u0439 \u0437\u0432\u0443\u043a \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0432 \u0433\u043e\u043b\u043e\u0432\u0443 \u0438 \u043f\u043e\u043b\u043e\u0441\u043a\u0443 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u043d\u0430 0. \u0410 \u043f\u043e\u0442\u043e\u043c \u0431\u043e\u0433 \u0417\u0438\u0432 \u0440\u0435\u0448\u0430\u0435\u0442, \u0447\u0442\u043e \u044d\u0442\u043e \u043d\u0435\u0447\u0435\u0441\u0442\u043d\u043e \u0438 \u043d\u0430\u0445\u0443\u0439 \u043e\u0442\u043a\u0438\u0434\u044b\u0432\u0430\u0435\u0442 \u043c\u0435\u043d\u044f \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u043d\u0430 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e, \u043f\u043e\u043f\u0443\u0442\u043d\u043e \u0432\u044b\u043b\u0435\u0447\u0438\u0432 \u0441\u0432\u043e\u0435\u0433\u043e \u003Cdel\u003E\u043b\u044e\u0431\u0438\u043c\u0447\u0438\u043a\u0430 \u0438\u0437 \u0417\u0430\u0440\u0438\u003C\/del\u003E \u0432\u0435\u0440\u043d\u0443\u0432 \u0447\u0430\u0441\u0442\u044c \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f (\u043e\u043a\u043e\u043b\u043e 10%) \u043d\u0430\u0437\u0430\u0434. \u0412\u0430\u0443, \u043c\u043e\u043b\u043e\u0434\u0446\u044b \u0440\u0435\u0431\u044f\u0442\u0430. \u0421\u0430\u043c\u043e\u0443\u0447\u0438\u043b\u0438\u0441\u044c, \u0441\u0430\u043c\u043e\u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0438\u0441\u044c, \u043d\u043e \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u0438\u043b, \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u044d\u0442\u043e \u0432 \u043e\u0431\u0440\u0430\u0442\u043d\u0443\u044e. \u0441\u0442\u043e\u0440\u043e\u043d\u0443.\u003C\/p\u003E \n\n\u003Cp\u003E\u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#23acaf;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u0420\u0443\u043f\u043e\u0440\u044b\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-bullhorn\u0022\u003E\u003C\/i\u003E\u003C\/span\u003E  \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0443\u0436\u0435 \u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0441 \u044d\u0442\u0438\u043c \u0447\u0442\u043e-\u0442\u043e. \u041d\u0435 \u0432\u043f\u0435\u0440\u0432\u043e\u0439 \u0438\u0437-\u0437\u0445\u0430 \u043a\u0440\u0438\u0432\u043e\u0433\u043e \u043a\u043e\u0434\u0430 \u043b\u044e\u0431\u0430\u044f \u0441\u0442\u044b\u0447\u043a\u0430 \u0438\u0434\u0435\u0442 \u043f\u043e \u043f\u0435\u0448\u0435\u043c\u0443 \u044d\u0440\u043e\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443. \u0421\u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0433\u0440 \u0435\u0441\u0442\u044c \u0441 \u043f\u043e\u0445\u043e\u0436\u0438\u043c\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u043c\u0438, \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u043c\u0438 \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435. \u041d\u0423 \u0432\u043e\u0437\u044c\u043c\u0438\u0442\u0435 \u0432\u044b \u043e\u0442\u0442\u0443\u0434\u0430 \u0445\u043e\u0442\u044c \u0447\u0442\u043e-\u0442\u043e. \u0421\u043f\u0438\u0437\u0434\u0438\u0442\u0435 \u0443\u0436\u044d\u0435 \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e, \u0432\u0430\u0441 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043f\u043e\u0440\u0443\u0433\u0430\u0435\u0442. \u0415\u0441\u043b\u0438 \u044d\u0442\u043e \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u0438\u0433\u0440\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e, \u0442\u043e \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u0430\u0440\u0443 \u0447\u0430\u0441\u043e\u0432 \u0432\u0430\u0441 \u043d\u0430 \u0440\u0443\u043a\u0430\u0445 \u0431\u0443\u0434\u0443\u0442 \u043d\u043e\u0441\u0438\u0442\u044c.\u003C\/p\u003E \n\n\u003Cp\u003E\u041f.\u0421. \u0438 \u043d\u0435 \u043d\u0430\u0434\u043e \u043f\u0438\u0441\u0430\u0442\u044c \u043f\u0440\u043e \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442, \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u0438 \u0440\u0435\u0433\u0438\u043e\u043d. \u0412\u0441\u0435 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e, \u0433\u0440\u0443\u0437\u0438\u0442\u044c\u0441\u044f \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e, \u0440\u0435\u0433\u0438\u043e\u043d \u0441\u0430\u043c\u044b\u0439 \u043b\u0443\u0447\u0448\u0438\u0439 \u0441\u0442\u043e\u0438\u0442. \u0423 \u043c\u0435\u043d\u044f