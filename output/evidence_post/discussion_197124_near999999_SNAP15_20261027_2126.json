3e\u043e\u0431\u0449\u0435 \u043d\u0435 \u043e\u0431 \u044d\u0442\u043e\u043c. \u0418\u0433\u0440\u0430\u043b \u0432 \u0421\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442 \u0434\u043e 23 \u0433\u043e\u0434\u0430?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0420\u0435\u0433\u0443 \u0430\u043a\u043a\u0430 \u0433\u043b\u044f\u043d\u044c, \u043e\u043d \u043d\u0435 \u0431\u044b\u043b \u0442\u0435\u043c \u0436\u0435 \u0441\u0442\u0430\u043b\u043a\u0435\u0440\u043e\u043c, \u043d\u0435 \u0432 23, \u043d\u0435 \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u043e\u0433\u0434\u0430 \u0431\u044b\u043b \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0435\u0440\u0432\u0435\u0440\u043e\u043c \u043c\u0430\u0439\u043d\u043a\u0440\u0430\u0444\u0442\u0430, \u043f\u0435\u0440\u0435\u0440\u043e\u0441 \u0438\u0437 \u043f\u0430\u0440\u043e\u0434\u0438\u0438 \u0441\u0442\u0430\u043b\u043a\u0435\u0440\u0430, \u0432 \u043d\u0435\u0447\u0442\u043e \u0434\u0440\u0443\u0433\u043e\u0435, \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u044b \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0441\u0442\u0430\u043b\u043a\u0435\u0440\u0441\u043a\u043e\u0439 \u0442\u043e\u0436\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e, \u044d\u0442\u043e \u0432\u0441\u0451 \u0431\u0430\u0439\u043a\u0438 \u0441\u0442\u0430\u0440\u0438\u043a\u043e\u0432 \u201c\u0440\u0430\u043d\u044c\u0448\u0435 \u0442\u0440\u0430\u0432\u0430 \u0431\u044b\u043b\u0430 \u0437\u0435\u043b\u0435\u043d\u0435\u0435\u201d\u003C\/p\u003E \n\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197124-exbo-u-menya-vopros\/17\u0022 class=\u0022PostMention\u0022 data-id=\u00224731946\u0022\u003ESakushaNoShi\u003C\/a\u003E \u0422\u0430\u043a \u0432\u0430\u0439\u0431\u0430 \u043d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e, \u043e\u043d\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0434\u0430\u0435\u0442. \u0412