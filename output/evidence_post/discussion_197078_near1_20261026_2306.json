2ed0045726\u0022 loading=\u0022lazy\u0022 width=\u0022994\u0022 height=\u0022182\u0022\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e\u043a\u0430 \u0447\u0442\u043e \u0432 \u0434\u0430\u043d\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043e\u0434\u043d\u0430 \u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0438\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u0411\u044b\u043b\u043e 4 \u0441\u0440\u0435\u0434\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b, \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u043e\u0447\u0435\u043c\u0443-\u0442\u043e \u0438\u043c\u0435\u0435\u043c \u0442\u043e\u043b\u044c\u043a\u043e 2 (\u043a\u043e\u043b\u043b\u0430\u043f\u0441 \u0438 \u0442\u0440\u0430\u043d\u0437\u0438\u0442 \u044d\u043a\u0435\u0439 \u043a\u043e\u043b\u0438\u0437\u0435\u0439)\u003C\/p\u003E \n\n\u003Cp\u003E\u041a\u043e\u0433\u0434\u0430 \u0443\u0436\u0435 \u0432 \u0438\u0433\u0440\u0443 \u0432\u0435\u0440\u043d\u0443\u0442 \u0442\u0435 \u0441\u0430\u043c\u044b\u0435 \u0431\u0438\u0433 \u043a\u0430\u0440\u0442\u044b, \u0433\u0434\u0435 \u0445\u043e\u0442\u044c \u0447\u0443\u0442\u044c \u0447\u0443\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0434\u0432\u0438\u0433\u0430\u0442\u044c\u0441\u044f?\u003C\/p\u003E \n\n\u003Cp\u003E\u0413\u0434\u0435 \u0442\u044b \u0431\u0435\u0433\u0430\u0435\u0448\u044c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e \u0432\u0441\u0435\u0439 \u043a\u0430\u0440\u0442\u0435, \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0431\u0438\u0432\u0430\u0435\u0448\u044c \u043b\u044e\u0434\u0435\u0439 \u0438 \u043f\u0435\u0440\u0435\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0448\u044c \u0442\u043e\u0447\u043a\u0438, \u0430 \u043d\u0435 \u0435\u0431\u0430\u043d\u0430\u044f \u0434\u0440\u043e\u0447\u0438\u043b\u044c\u043d\u044f \u043d\u0430 \u043a\u043e\u043b\u043b\u0430\u043f\u0441\u0435 \u0437\u0430 \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u0442\u043e\u0447\u043a\u0443, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0437\u0430\u0439\u0442\u0438, \u0438\u043b\u0438 \u043f\u043e\u043c\u043e\u0439\u043d\u044b\u0435 \u0437\u0430\u0436\u0438\u043c\u043a\u0438 \u043d\u0430 \u0442\u0440\u0430\u043d\u0437\u0438\u0442\u0435 \u0437\u0430 2-3 \u043c\u0438\u043d\u0443\u0442\u044b, \u0433\u0434\u0435 \u043e\u0434\u043d\u0430 \u0442\u0438\u043c\u0430 \u0431\u043e\u0433\u043e\u0432, \u0434\u0440\u0443\u0433\u0430\u044f \u043e\u0441\u044c\u043c\u0438\u043d\u043e\u0433\u043e\u0432.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412 \u0438\u0433\u0440\u0435 20\u043a+ \u043e\u043d\u043b\u0430\u0439\u043d\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c, \u043d\u043e \u043f\u043e\u0447\u0435\u043c\u0443-\u0442\u043e \u043a\u0430\u0440\u0442\u044b \u0432\u0441\u0435 \u0443\u0431\u0438\u0440\u0430\u044e\u0442 \u0438 \u0443\u0431\u0438\u0440\u0430\u044e\u0442, \u043f\u0440\u0438 \u0442\u043e\u043c, \u0447\u0442\u043e \u0440\u0430\u043d\u0435\u0435 \u0431\u044b\u043b\u0438 \u043a\u0430\u0440\u0442\u044b \u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0441 \u0442\u0435\u043c \u0441\u0430\u043c\u044b\u043c \u0436\u0430\u043b\u043a\u0438\u043c \u043e\u043d\u043b\u0430\u0439\u043d\u043e\u043c \u0432 1\u043a, \u0438 \u043e\u043d\u0438 \u0438\u0433\u0440\u0430\u043b\u0438\u0441\u044c, \u043d\u0430\u0431\u0438\u0440\u0430\u043b\u0438\u0441\u044c, \u0432\u0441\u0451 \u0431\u044b\u043b\u043e \u043d\u0438\u0448\u0442\u044f\u043a.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0443 \u0437\u0430\u0435\u0431\u0430\u043b\u043e \u0443\u0436\u0435 5 \u043b\u0435\u0442 \u043f\u043e\u0434\u0440\u044f\u0434 \u0438\u0433\u0440\u0430\u0442\u044c \u043d\u0430 \u043e\u0434\u043d\u0438\u0445 \u0438 \u0442\u0435\u0445 \u0436\u0435 \u043a\u0430\u0440\u0442\u0430\u0445. \u003Cbr\u003E\n\u0412\u0435\u0440\u043d\u0438\u0442\u0435 \u043d\u0430\u0437\u0430\u0434 \u0431\u0438\u0433 \u043a\u0430\u0440\u0442\u044b 60 \u043d\u0430 60, \u0438 \u0443\u0432\u0435\u043b\u0438\u0447\u044c\u0442\u0435 \u0432\u0440\u0435\u043c\u044f \u044d\u0442\u043e\u0439 \u043a\u0430\u0442\u043a\u0438 \u0445\u043e\u0442\u044f\u0431 \u0434\u043e 30-40 \u043c\u0438\u043d\u0443\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u043e\u0433\u0434\u0430 \u0438\u0437\u043c\u0435\u043d\u044f\u0442 \u0430\u0441\u0441\u043e\u0440\u0442\u0438\u043c\u0435\u043d\u0442 \u0441\u043f\u0430\u0440\u0442\u0430\u043a\u0430? \u003Cbr\u003E\n\u041d\u0435\u0442 \u0436\u0435\u043b\u0430\u043d\u0438\u044f \u0437\u0430\u043f\u0438\u0445\u043d\u0443\u0442\u044c \u0442\u0430\u043a \u0436\u0435 \u043a\u0430\u043a \u0437\u0430 \u043a\u0432\u0448\u043a\u0438 \u0438 \u043a\u043e\u043b\u0438\u0437\u0435\u0439, \u043a\u0430\u043a\u0438\u0445-\u043d\u0438\u0431\u0443\u0434\u044c \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u043a\u0438\u043d\u0447\u0438\u043a\u043e\u0432 \u0437\u0430 \u043a\u0430\u043a\u043e\u0439-\u043d\u0438\u0431\u0443\u0434\u044c 1\u043a \u043b\u0432\u043b \u0441\u0435\u0441\u0441\u0438\u043e\u043d\u043e\u043a (\u0441 \u044d\u0442\u0438\u043c \u043c\u043e\u0436\u0435\u0442 \u0431\u043e\u0440\u0449\u0443, \u043d\u0443 \u0445\u043e\u0442\u044f\u0431 \u0437\u0430 750)\u003C\/p\u003E \n\n\u003Cp\u003E\u0414\u043e \u0440\u0435\u0432\u043e\u0440\u043a\u0430 \u0441\u0435\u0441\u0441\u0438\u043e\u043d\u043e\u043a, \u0443 \u043c\u0435\u043d\u044f \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0431\u044b\u043b 319 \u043b\u0432\u043b.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421 \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0440\u0435\u0432\u043e\u0440\u043a\u0430 \u043f\u0440\u043e\u0448\u043b\u043e \u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043a\u0430\u043a\u0438\u043c-\u0442\u043e \u0447\u0443\u0434\u043e\u043c \u043b\u0432\u043b \u043f\u0435\u0440\u0435\u0432\u0430\u043b\u0438\u043b \u0437\u0430 900+ \u003Cbr\u003E\n\u0423 \u043c\u043d\u043e\u0433\u0438\u0445 \u043b\u044e\u0434\u0435\u0439 \u0443\u0436\u0435 \u0435\u0441\u0442\u044c \u0432\u0441\u0435 \u043f\u0443\u0448\u043a\u0438 \u0441 \u0441\u0435\u0441\u0441\u0438\u043e\u043d\u043e\u043a, \u043d\u043e \u043d\u0430\u043c \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0432\u043e\u0437\u0434\u0443\u0445\u0430\u043d\u0438\u043b\u0438 \u043f\u0440\u043e \u0441\u0435\u0437\u043e\u043d\u043d\u0443\u044e \u0441\u043c\u0435\u043d\u0443 \u0430\u0441\u0441\u043e\u0440\u0442\u0438\u043c\u0435\u043d\u0442\u0430, \u0438 \u0434\u0430\u0436\u0435 \u043d\u0435 \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u043a\u0430\u043a\u0438\u0445-\u043d\u0438\u0431\u0443\u0434\u044c \u043d\u043e\u0432\u044b\u0445 \u043a\u0440\u0430\u0441\u043e\u0447\u0435\u043a.\u003C\/p\u003E \n\n\u003Cp\u003E\u042d\u0442\u043e \u043d\u0435 \u0442\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0432 \u0438\u0433\u0440\u0435, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0443\u0436\u043d\u043e \u0437\u0430\u0431\u0438\u0432\u0430\u0442\u044c \u0445\u0443\u0439, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u0430 \u041f\u041e\u0421\u0422\u041e\u042f\u041d\u041d\u0410\u042f.\u003Cbr\u003E\n\u0415\u0451 \u043d\u0435 \u0432\u0432\u043e\u0434\u044f\u0442 \u0440\u0430\u0437 \u0432 \u043f\u043e\u043b \u0433\u043e\u0434\u0430, \u043e\u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0437\u0434\u0435\u0441\u044c \u0438 \u0441\u0435\u0439\u0447\u0430\u0441.\u003C\/p\u003E \n\n\u003Cp\u003E\u041a\u0430\u0436\u0434\u044b\u0439 \u0438\u0433\u0440\u043e\u043a \u0442\u0430\u043a \u0438\u043b\u0438 \u0438\u043d\u0430\u0447\u0435 \u0438\u0433\u0440\u0430\u043b \u0432 \u0441\u0435\u0441\u0441\u0438\u043e\u043d\u043a\u0438, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u0438\u0433\u0440\u0430\u0442\u044c, \u0438\u043b\u0438 \u0437\u0430\u0431\u0438\u043b \u043d\u0430 \u043d\u0438\u0445 \u043f\u043e \u0442\u043e\u0439 \u0438\u043b\u0438 \u0438\u043d\u043e\u0439 \u043f\u0440\u0438\u0447\u0438\u043d\u0435, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u0438 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u043d\u0435\u0445\u043e\u0440\u043e\u0448\u0435\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438.\u003C\/p\u003E\n\n\u003Cp\u003E\u0425\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0431\u044b \u0443\u0441\u043b\u044b\u0448\u0430\u0442\u044c \u043a\u0430\u043a\u0438\u0435-\u043d\u0438\u0431\u0443\u0434\u044c \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438, \u0432\u0435\u0434\u0443\u0442\u0441\u044f \u043b\u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u043a\u0430\u043a\u0438\u0435-\u043d\u0438\u0431\u0443\u0434\u044c \u0440\u0430\u0431\u043e\u0442\u044b, \u0431\u0443\u0434\u0443\u0442 \u043b\u0438 \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#23acaf;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u0420\u0443\u043f\u043e\u0440\u044b\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-bullhorn\u0022\u003E\u003C\/i\u003E\u003C\/span\u003E \u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#22b7f7;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u041a\u043e\u043c\u0430\u043d\u0434\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-gem\u0022\u003E\u003C\/i\u003E\u003C\/span\u003E\u003C\/p\u003E \n\n\n\n\n\n\n\n","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":3,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likes