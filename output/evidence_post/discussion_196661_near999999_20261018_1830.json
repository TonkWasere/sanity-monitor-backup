u00224714865\u0022\u003ETank\u003C\/a\u003E \u043a\u0430\u043a\u0443\u044e-\u0442\u043e \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0443? \u0421\u0435\u0437\u043e\u043d\u043d\u0443\u044e \u0432\u0430\u043b\u044e\u0442\u0443 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0421 \u0432\u0430\u0448\u0435\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u044d\u0442\u043e \u0442\u043e\u0436\u0435 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0439 \u043f\u0440\u0438\u043c\u0435\u0440, \u0442.\u043a. \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c \u043c\u0435\u0436\u0434\u0443 \u0432\u0430\u043b\u044e\u0442\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043c\u043e\u0436\u043d\u043e \u0444\u0430\u0440\u043c\u0438\u0442\u044c \u0433\u0440\u0443\u0431\u043e \u0433\u043e\u0432\u043e\u0440\u044f - \u043f\u043e\u0447\u0442\u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0438 FOMO-\u0441\u043a\u0438\u043d\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043a\u043e\u0433\u0434\u0430 \u0435\u0449\u0451 \u0432\u0435\u0440\u043d\u0451\u0442\u0441\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e, \u043a\u043e\u0433\u0434\u0430 \u043e\u0434\u0438\u043d \u0438\u0433\u0440\u043e\u043a \u0443\u0434\u0430\u043b\u0438\u043b \u0420\u0443\u043d\u0443 \u0441 \u043c\u044b\u0441\u043b\u044f\u043c\u0438, \u0447\u0442\u043e \u043e\u043d\u0430 \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c \u042221, \u0430 \u043f\u043e\u0441\u043b\u0435 \u0432\u0432\u043e\u0434\u0430 \u0435\u0451 \u043a \u0410\u0440\u0441\u0435\u043d\u0443 - \u043f\u0440\u043e\u0441\u0438\u043b \u0432\u0435\u0440\u043d\u0443\u0442\u044c. \u041d\u0443 \u0437\u0430\u0442\u043e \u0