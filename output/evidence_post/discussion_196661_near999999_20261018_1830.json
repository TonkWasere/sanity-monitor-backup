41\u0435\u043d\u0443 - \u043f\u0440\u043e\u0441\u0438\u043b \u0432\u0435\u0440\u043d\u0443\u0442\u044c. \u041d\u0443 \u0437\u0430\u0442\u043e \u043f\u043e\u0447\u0438\u0441\u0442\u0438\u043b \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u044c.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u042f \u0441\u0440\u0430\u0432\u043d\u0438\u043b \u043c\u0435\u0436\u0434\u0443 \u0432\u0430\u043b\u044e\u0442\u043e\u0439 \u0438 \u043e\u0431\u043b\u0438\u043a\u043e\u043c, \u0442\u044b \u043c\u0435\u0436\u0434\u0443 \u0448\u043c\u043e\u0442\u043a\u043e\u0439 \u0438 \u0441\u043a\u0438\u043d\u043e\u043c. \u041d\u043e \u043f\u043e \u0444\u0430\u043a\u0442\u0443 \u043c\u044b \u043e\u0431\u0430 \u043e\u0434\u0435\u0442\u044b. \u0422\u0435\u043c \u0431\u043e\u043b\u0435\u0435 \u0432\u0430\u043b\u044e\u0442\u0443 \u044f \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u043b \u043a\u0430\u043a \u043f\u0440\u0438\u043c\u0435\u0440, \u0430 \u043d\u0435 \u043a\u0430\u043a \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u0443\u044e \u0438\u0441\u0442\u0438\u043d\u0443\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196661-zachem-mne-pokrovnik\/11\u0022 class=\u0022PostMention\u0022 data-id=\u00224714885\u0022\u003ERodzya\u003C\/a\u003E \u0423 \u043d\u0430\u0441 \u043d\u0435\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u042226 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u0432 \u0446\u0435\u043b\u043e\u043c, \u0442\u0430\u043a \u0447\u0442\u043e \u043f\u043e\u043a\u0430 \u0435\u0433\u043e \u043d\u0435\u0442 - \u0442\u0430\u043a\u0438\u0435 \u043a\u043e\u0441\u0442\u044e\u043c\u044b \u0432\u0441\u0451 \u0435\u0449\u0451 \u0443\u043c\u0435\u0441\u0442\u043d\u044b, \u0428\u0442\u0443\u0440\u043c\u0430 \u044d\u0442\u043e \u0431\u043e\u043b\u0432\u0430\u043d\u043a\u0430 \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u0421\u043a\u04