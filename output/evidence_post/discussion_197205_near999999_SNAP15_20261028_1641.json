8 \u0448\u043c\u043e\u0442\u0430 \u043d\u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435. \u0421\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u041f\u0412\u0415 \u0438 \u041f\u0412\u041f \u0440\u0435\u0436\u0438\u043c\u043e\u0432 \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0430, \u0442\u0430\u043a\u0436\u0435 \u043a\u0430\u043a \u0438 \u0437\u043d\u0430\u0447\u0438\u043c\u043e\u0441\u0442\u044c \u0432\u043a\u043b\u0430\u0434\u0430 \u0432 \u044d\u0442\u0438\u0445 \u0434\u0432\u0443\u0445 \u0440\u0435\u0436\u0438\u043c\u0430\u0445. \u041d\u043e \u043c\u0435\u043d\u044f \u043e\u0434\u043d\u043e\u0433\u043e \u0432\u043e\u043b\u043d\u0443\u0435\u0442 \u0432\u043e\u043f\u0440\u043e\u0441 \u043e \u0440\u0435\u0438\u0433\u0440\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u0430\u0445 \u043d\u0430 \u0438\u0432\u0435\u043d\u0442\u0435?\u003Cbr\u003E\n\u0417\u0430 \u043f\u043e\u043b\u0447\u0430\u0441\u0430 \u043c\u0430\u0442\u0447\u0430 \u0432\u044b\u0434\u0430\u0435\u0442 \u003Csub\u003E100\u043a\u003C\/sub\u003E \u0438\u0433\u0440\u043e\u0432\u043e\u0439 \u0432\u0430\u043b\u044e\u0442\u044b, \u0432\u044b \u0443\u0436 \u043f\u0440\u043e\u0441\u0442\u0438\u0442\u0435, \u043d\u043e \u044f \u043e\u0441\u0442\u0430\u0432\u043b\u044e \u044d\u0442\u043e\u0442 \u043f\u0443\u043d\u043a\u0442 \u0431\u0435\u0437 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432.\u003Cbr\u003E\n\u0422\u0430\u043c \u0435\u0449\u0435 \u0432\u044b\u0434\u0430\u0435\u0442 \u0432\u0430\u043b\u044e\u0442\u0443 \u0438\u0432\u0435\u043d\u0442\u0430, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043c\u043e\u0436\u043d\u043e \u043a\u0435\u0439\u0441 \u043a\u0440\u0443\u0442\u0430\u043d\u0443\u0442\u044c, \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u0437\u0433\u043b\u044f\u043d\u0435\u043c \u0447\u0442\u043e \u0432 \u043d\u0435\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f:\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-28\/1793198510-161793-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u0022ae585d07-d867-4524-9099-3f72c77409fc\u0022 loading=\u0022lazy\u0022 width=\u0022289\u0022 height=\u0022679\u0022\u003E\u003Cbr\u003E\n\u0420\u0435\u0431\u044f\u0442, \u0430 \u043c\u043d\u043e\u0433\u0438\u043c \u0438\u0437 \u0432\u0430\u0441 \u043d\u0443\u0436\u0435\u043d \u201cQBU \u043d\u0430 \u043a\u043e\u043b\u043e\u0441\u044c\u044f\u0445\u201d, \u201c\u043f\u0448\u0435\u043d\u0438\u0447\u043d\u044b\u0439 \u0433\u043b\u043e\u043a\u201d \u0438\u043b\u0438 \u043f\u0443\u0433\u0430\u043b\u043e \u0432 \u0443\u0431\u0435\u0436\u043a\u0443? \u0410 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u0443 \u0432\u0430\u0441 \u0432\u0441\u0435 \u0435\u0449\u0435 \u043d\u0435\u0442 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0433\u043e \u043d\u043e\u0436\u0430? \u0410 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u0442\u0443\u0434\u0430 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0445\u043e\u0442\u044f \u0431\u044b \u043b\u0430\u0437\u0435\u0440 \u043d\u0430 25% \u0432\u043b\u043e\u0436\u0438\u0442\u044c (\u0440\u0435\u0440\u0430\u043d \u043e\u0431\u0432\u0435\u0441\u043e\u0432-\u0442\u043e\u2026 \u043d\u0435 \u0441\u043b\u044b\u0448\u0430\u043b\u0438, \u043d\u0435)?\u003Cbr\u003E\n\u041d\u0443 \u043b\u0430\u0434\u043d\u043e, \u0442\u0430\u043c \u0436\u0435 \u0435\u0449\u0435 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u0435\u0441\u0442\u044c, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0442\u0443\u0434\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a \u0431\u0435\u0440\u0435\u0436\u043d\u043e \u0432\u043b\u043e\u0436\u0438\u043b \u0445\u043e\u0442\u044c \u043c\u0430\u043b\u043e\u043c\u0430\u043b\u044c\u0441\u043a\u0438 \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u0439 \u043b\u0443\u0442. \u0418 \u0432\u043e\u0442 \u0442\u0443\u0442 \u043c\u044b \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u043c, \u0447\u0442\u043e \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u0434\u043b\u0438\u0442\u0441\u044f 2 \u043d\u0435\u0434\u0435\u043b\u0438, \u0438\u0433\u0440\u0430\u0442\u044c 2 \u043d\u0435\u0434\u0435\u043b\u0438 \u0440\u0430\u0434\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043b\u0438\u0433\u0438 (\u0432\u044b \u0441\u0430\u043c\u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442\u0435, \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u043c\u0441\u044f \u043d\u0430 \u043f\u043e\u043b\u043d\u0443\u044e \u0441\u0442\u0430\u0432\u043a\u0443 \u0432 \u0438\u0433\u0440\u0443\ud83d\ude07) \u0438 \u0432\u043e\u0442 \u043d\u0430\u0433\u0440\u0430\u0434\u044b:\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-28\/1793198179-484204-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u00225195d638-75e1-4992-9126-c86a4cd9b4f4\u0022 loading=\u0022lazy\u0022 width=\u0022700\u0022 height=\u0022391\u0022\u003E\u003Cbr\u003E\n\u041e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439 \u043a\u0438\u0442 \u043a\u0430\u0441\u0442\u043e\u043c\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u043a\u0443\u043f\u043e\u043d\u044b\u2026 \u041e, \u0438 \u043a\u0435\u0439\u0441\u044b! \u0412\u043e\u0442 \u0438\u0445-\u0442\u043e \u0435\u0441\u0442\u044c \u0441\u043c\u044b\u0441\u043b \u0432\u0441\u0435\u0433\u043e \u0438\u0432\u0435\u043d\u0442\u0430, \u0438\u0445 \u043d\u0430\u043c \u0438 \u043d\u0430\u0434\u043e \u0444\u0430\u0440\u043c\u0438\u0442\u044c, \u0432\u0435\u0440\u043d\u043e? \ud83d\ude43 \u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-28\/1793199942-746472-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002218e0a196-7ac4-4318-a0ae-dd3411a85824\u0022 loading=\u0022lazy\u0022 width=\u0022298\u0022 height=\u0022381\u0022\u003E\u003Cbr\u003E\n\u0418 \u0435\u0449\u0435 \u0440\u0430\u0437 \u0441\u043a\u0438\u043d\u044b \u0432 \u043a\u0435\u0439\u0441\u0435\u2026 \u041b\u0430\u0434\u043d\u043e \u0431\u044b \u0434\u0440\u043e\u043f \u0441 \u044f\u0449\u0438\u043a\u043e\u0432 \u0438 \u0441\u0430\u043c\u0438 \u044d\u0442\u0438 \u043a\u0435\u0439\u0441\u044b \u0431\u044b\u043b\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0435, \u043d\u043e \u043d\u0435\u0442, \u043e\u043d\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435\u2757 \u0418 \u0442\u0430\u043a \u0443\u0436 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u043a\u0430, \u0431\u0435\u0433\u0430\u044f \u043d\u0430 \u044e\u0433\u0435 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u0442\u0438\u043f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043d\u0430\u0444\u0430\u0440\u043c\u0438\u0442\u044c \u0432 \u0430\u0440\u0435\u043d\u0435, \u0430\u043f\u0430\u044f \u0441\u0435\u0431\u0435 \u043b\u0438\u0433\u0443 \u0437\u0430 \u0442\u043e \u0436\u0435 \u0432\u0440\u0435\u043c\u044f.\u003Cbr\u003E\n\u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a \u043d\u0435 \u0445\u043e\u0447\u0435\u0442 \u041a\u0435\u0439\u0441 \u0438 \u044f\u0449\u0438\u043a\u0438 \u0438\u0432\u0435\u043d\u0442\u0430 \u0438 \u0441\u0430\u043c\u043e \u0438\u0445 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u041f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0435\u043c\u043e\u0439? \u0418 \u0441 \u0447\u0435\u043c \u0441\u0432\u044f\u0437\u0430\u043d\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0434\u0435\u043b\u0430\u0442\u04