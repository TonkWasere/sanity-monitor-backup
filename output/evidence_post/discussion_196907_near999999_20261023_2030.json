\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0414\u0440\u043e\u0431\u043e\u0432\u0438\u043a\u0438 \u043f\u043e\u043d\u0435\u0440\u0444\u043b\u0435\u043d\u044b, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0432\u0430\u043d\u0448\u043e\u0442\u043e\u0432\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u041e\u0440\u0443\u0436\u0438\u0435 \u0437\u0430\u0431\u0430\u043b\u0430\u043d\u0448\u0435\u043d\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e, \u0432\u0441\u0435 \u0438\u0433\u0440\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0410\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b \u0437\u0430\u0431\u0430\u043b\u0430\u043d\u0448\u0435\u043d\u044b \u0430\u0442\u0432\u0440\u0430\u0442\u043d\u043e. 60% \u0432\u0430\u043c\u043f\u0438\u0440\u0438\u0437\u043c\u0430 \u044d\u0442\u043e \u043f\u0438\u0437\u0434\u0435\u0446. \u041d\u0443\u0436\u043d\u043e \u0441\u0440\u0435\u0437\u0430\u0442\u044c \u0440\u0430\u0437\u0430 \u0432 2. \u0421\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u0447\u0442\u043e \u0442\u043e \u043a\u0440\u043e\u043c\u0435 \u0441\u0435\u0442\u0430 \u0441\u043e\u0441\u044b\u0447\u0430 \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0441\u043c\u044b\u0441\u043b\u0430\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u041c\u043e\u0431\u044b \u044f\u0432\u043d\u043e \u0441\u043b\u043e\u043c\u0430\u043d\u044b. \u041e\u043d\u0438 \u043d\u0435 \u0434\u043e\u043c\u0430\u0436\u0430\u0442 \u043f\u043e \u0442\u043e \u0442\u0435\u043c\u0443, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0432\u0441\u0435 \u043a\u0430\u0442\u043a\u0438 \u0437\u0430\u0442\u044f\u0433\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0434\u043e 25 \u0440\u0430\u0443\u043d\u0434\u0430. \u0412\u0435\u0440\u043d\u0438\u0442\u0435 \u043a\u0430\u043a \u0431\u044b\u043b\u043e \u0440\u0430\u043d\u044c\u0448\u0435. \u041d\u0435 \u041e\u043a\u0435\u0439, \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0443\u043d\u0434 \u0442\u044b \u0442\u0435\u0440\u044f\u0435\u0448\u044c \u043e\u0442 0 \u0434\u043e 3-\u0445 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043e\u0432\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u201c\u041a\u043b\u0430\u0441\u0441\u044b\u201d \u0417\u0430\u0431\u0430\u043b\u0430\u043d\u0448\u0435\u043d\u044b \u043f\u043b\u043e\u0445\u043e. \u041d\u0430\u0443\u0447\u043a\u0430 \u0431\u0435\u0437\u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u0430. \u0422\u044b \u043c\u043e\u0436\u0435\u0448\u044c \u043f\u0440\u043e\u0441\u0442\u0440\u0435\u043b\u0438\u0432\u0430\u0442\u044c \u0441\u043d\u0438\u0437\u0443 \u0432\u0432\u0435\u0440\u0445 \u0432\u0441\u0435, \u043d\u043e \u0441\u0432\u0435\u0440\u0445\u0443 \u0432\u043d\u0438\u0437 \u043d\u0438\u0445\u0443\u044f. \u0422\u0430\u043a \u0436\u0435 \u0431\u0430\u0431\u043b \u043c\u0435\u0434\u0438\u043a\u0430 \u044d\u0442\u043e \u0438\u043c\u0431\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0443\u0436\u043d\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0432 \u043f\u0432\u0435, \u043e\u043d \u043f\u043e\u043b\u0435\u0437\u043d\u0435\u0435 \u0432\u0441\u0435\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u0440\u0430\u043d\u0430\u0442 \u0432\u043c\u0435\u0441\u0442\u0435 \u0432\u0437\u044f\u0442\u044b\u0445\u003C\/p\u003E\u003C\/li\u003E\u003C\/ol\u003E\n\n\u003Cp\u003E\u0412 \u0446\u0435\u043b\u043e\u043c \u043c\u043e\u0433\u0443 \u043f\u043e\u0445\u0432\u0430\u043b\u0438\u0442\u044c, \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430\u0434 \u043e\u0448\u0438\u0431\u043a\u0430\u043c\u0438 \u0432\u0438\u0434\u043d\u0430, \u043d\u0443\u0436\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0431\u044b\u043b\u0438 \u0441\u0434\u0435\u043b\u0430\u043d\u044b.  \u0421\u0442\u0430\u0432\u043b\u044e 7\/10\u003C\/p\u003E","renderFailed":false,"canEdit":false,"canD