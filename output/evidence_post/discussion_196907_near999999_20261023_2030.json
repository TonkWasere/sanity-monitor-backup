0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"user":{"data":{"type":"users","id":"1021092"}},"discussion":{"data":{"type":"discussions","id":"196907"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4724082","attributes":{"number":34,"createdAt":"2026-10-23T20:07:55+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#22b7f7;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u041a\u043e\u043c\u0430\u043d\u0434\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-gem\u0022\u003E\u003C\/i\u003E\u003C\/span\u003E \u003Cbr\u003E\n\u0412\u043f\u0435\u0440\u0432\u044b\u0435 \u0443\u043f\u0430\u043b \u041e\u0422\u0421 \u0437\u0430 3 \u0433\u043e\u0434\u0430 \u0438\u0433\u0440\u044b, \u0441\u043f\u0430\u0441\u0438\u0431\u043e)\u003Cbr\u003E\n\u041f\u043e\u0438\u0433\u0440\u0430\u043b \u044f \u0437\u043d\u0430\u0447\u0438\u0442 5-6 \u043a\u0430\u0442\u043e\u043a \u0432 \u0438\u0432\u0435\u043d\u0442 \u043d\u043e\u0432\u044b\u0439, \u0445\u043e\u0447\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c:\u003C\/p\u003E\n\u003Col style=\u0022list-style-type:decimal\u0022\u003E\u003Cli\u003E\u041e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u0432 \u044d\u0442\u043e\u043c \u0438\u0432\u0435\u043d\u0442\u0435 \u043d\u0435\u0442 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u044f \u0438\u0433\u0440\u043e\u043a\u0430 ( \u043e\u043d\u043e \u043d\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 ), \u0430 \u043f\u0443\u0442\u0451\u043c \u043f\u043e\u043a\u0443\u043f\u043a\u0438 - \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438. \u041d\u0430\u043a\u043e\u043d\u0435\u0446 \u0442\u043e \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u044b, \u0430 \u043d\u0435 \u043f\u043e\u043f\u0430\u0434\u0430\u043d\u0438\u0435 \u0441 \u0442\u0438\u043f\u0430\u043c\u0438 \u0441 \u043b\u0435\u0433 \u0441\u0431\u043e\u0440\u043a\u0430\u043c\u0438.\u003Cbr\u003E\n\u0425\u043e\u0447\u0443 \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043a\u043e\u0441\u044f\u043a, \u0430 \u0438\u043c\u0435\u043d\u043d\u043e:\u003C\/li\u003E\n\u003Cli\u003E\u0418\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f \u201c20 \u0431\u043e\u0441\u0441\u043e\u0432\u201d \u043d\u0435 \u0437\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e, \u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0431\u043e\u0441\u0441\u0430 \u0443\u0431\u0438\u043b\u0438 \u0441\u043f\u0443\u0441\u0442\u044f 5 \u043d\u0435 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u043d\u043d\u044b\u0445 \u0431\u043e\u0441\u0441\u043e\u0432.\u003C\/li\u003E\n\u003Cli\u003E\u0421\u043a\u0438\u0444 \u0438 \u0414\u043e\u043b\u0433\u043e\u0436\u0438\u0442\u0435\u043b\u044c \u0445\u0438\u043c\u0435\u0440\u0430 \u0448\u043e\u0442\u0430\u0435\u0442 \u0437\u0430 2-3 \u0443\u0434\u0430\u0440\u0430, \u0443\u0432\u044b, \u043d\u0435 \u0443\u0441\u043f\u0435\u0442\u044c \u043e\u0442\u0431\u0435\u0436\u0430\u0442\u044c, \u043e\u043d\u0430 \u0432 \u043b\u044e\u0431\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u0434\u043e\u0433\u043e\u043d\u0438\u0442 \u043d\u0430 \u0432\u043e\u043b\u043d\u0435, \u043e\u043d\u0430 \u0432 \u0440\u0430\u0437\u044b \u0431\u044b\u0441\u0442\u0440\u0435\u0435.\u003C\/li\u003E\n\u003Cli\u003E\u0411\u043e\u0441\u0441 \u0441\u043e\u0437\u0434\u0430\u044e\u0449\u0438\u0439 \u043e\u0433\u043d\u0435\u043d\u043d\u044b\u0435 \u043f\u043b\u0438\u0442\u044b \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0448\u043e\u0442\u0430\u0435\u0442 \u0446\u0435\u043d\u0442\u0443 \u0437\u0430 0.4 \u0441\u0435\u043a\u0443\u043d\u0434\u044b, \u043d\u0435\u0442 \u0448\u0430\u043d\u0441\u0430 \u0432\u044b\u0431\u0435\u0436\u0430\u0442\u044c \u0438\u0437 \u043b\u0443\u0436\u0438.\u003C\/li\u003E\n\u003Cli\u003E\u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c \u0440\u0430\u0443\u043d\u0434\u0435 \u043f\u043e\u043f\u0430\u043b\u0441\u044f \u0447\u0438\u0442\u0435\u0440 \u043f\u0440\u043e\u0442\u0438\u0432 \u043c\u043e\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b, \u043d\u043e \u044d\u0442\u043e \u0442\u0430\u043a, \u043a \u0441\u043b\u043e\u0432\u0443 \ud83d\ude42\u003C\/li\u003E\n\u003Cli\u003E\u0421\u0434\u0435\u043b\u0430\u0442\u044c \u0431\u044b \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c, \u043c\u043e\u043b, \u043f\u0440\u0438 \u0442\u0432\u043e\u0435\u043c \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0438 \u043e\u0434\u0435\u0442\u043e\u043c \u0442\u0435\u0431\u0435 \u0432\u044b\u043f\u0430\u0434\u0430\u044e\u0442 \u0447\u0435\u0440\u0442\u0435\u0436\u0438 \u0447\u0430\u0449\u0435, \u0438\u043d\u0430\u0447\u0435 \u043d\u0435 \u043c\u043e\u0433\u0443 \u043e\u0431\u044c\u044f\u0441\u043d\u0438\u0442\u044c \u043a\u0430\u043a \u0442\u0430\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u044f \u0431\u0435\u0433\u0430\u044e \u0432 \u0441\u043a\u0438\u0444\u0435 \u0438\u043b\u0438 \u0446\u0435\u043d\u0442\u0435 +0 \u043f\u043e\u0434 25 \u0440\u0430\u0443\u043d\u0434, \u0432\u0435\u0434\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0443\u043f\u0430\u043b\u043e \u0437\u0430 11-12 \u043a\u0440\u0443\u0442\u043e\u043a. \u003Cbr\u003E\n\u0412 \u0446\u0435\u043b\u043e\u043c \u043c\u043d\u0435 \u0432\u0441\u0451 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u043e\u0441\u044c, \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0438 \u0441\u0430\u043c\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435 - \u043d\u043e\u0441\u0442\u0430\u043b\u044c\u0433\u0438\u044f \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f) \u003Cbr\u003E\n\u0412 \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u043e\u0437\u0434\u0430\u044e \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u0433\u0434\u0435 \u043d\u0430 80% \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0435\u043d \u0437\u0430 \u0430\u043a\u0442\u0438\u0432\u043a\u0443.\u003C\/li\u003E \u003C\/ol\u003E\n","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196907"}},"user":{"data":{"type":"users","id":"1716746"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4724103","attributes":{"number":35,"createdAt":"2026-10-23T20:23:59+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0432\u0442\u043e\u0440\u0443\u044e \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0431\u043e\u043b\u0435\u0435 \u044f\u0440\u043a\u0443\u044e(\u0442\u0430\u043c \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u043d\u0443\u044e \u043a\u0430\u043a\u0443\u044e-\u043d\u0438\u0431\u0443\u0434\u044c \u0436\u0435\u043b\u0442\u044b\u0439, \u043a\u0440\u0430\u0441\u043d\u044b\u0439 \u0438 \u0442\u0434). \u0417\u0435\u043b\u0435\u043d\u0430\u044f \u0441\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u0