47\u0442\u043e \u0431\u044b \u0441\u0435\u0440\u0432\u0430\u043a \u043d\u0435 \u043f\u043e\u0442\u0435\u0440\u044f\u0442\u044c (\u044f \u0431\u044b\u043b \u0432 \u043e\u0442\u0440\u044f\u0434\u0435 \u0441 \u0442\u0438\u043f\u043e\u043c \u0443\u0436\u0435 \u0442\u043e\u0433\u0434\u0430).\u003C\/p\u003E\n\n\u003Cp\u003E\u043d\u0443 \u043c\u044b \u043f\u043e\u0448\u043b\u0438 \u0432 \u043e\u0442\u0440\u044f\u0434, \u0441\u0442\u0430\u043a\u043d\u0443\u043b\u0438\u0441\u044c \u0432 \u0434\u0441\u0435.\u003C\/p\u003E \n\n\u003Cp\u003E\u0410 \u043e\u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c \u0442\u0438\u043f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0433\u0440\u0430\u043b \u0441 \u044d\u0442\u0438\u043c \u0442\u0438\u043f\u043e\u043c \u0441 \u0441\u043e\u0444\u0442\u043e\u043c, \u0432\u0435\u0447\u043d\u043e \u0434\u0430\u0432\u0430\u0439 \u0438\u043d\u0444\u0443 \u043f\u043e \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u043e\u043c\u0443 \u043e\u0442\u0440\u044f\u0434\u0443, \u0433\u0434\u0435 \u0442\u043e\u0442 \u0431\u0435\u0433\u0430\u0435\u0442, \u0441\u0442\u0440\u0435\u043b\u044f\u043b \u043e\u043d\u043b\u0438 \u0433\u043e\u043b\u043e\u0432\u0443, \u043f\u043e \u0438\u0442\u043e\u0433\u0443 \u0447\u0435\u0440\u0435\u0437 \u043f\u0430\u0440\u0443 \u0434\u043d\u0435\u0439 \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043a\u0438\u043d\u0443\u0442\u043e\u0433\u043e \u0436\u0431 \u043d\u0430 \u0438\u0445 \u043e\u0431\u043e\u0438\u0445 \u0441\u043c\u043e\u0442\u0440\u044e, \u0447\u0442\u043e \u0442\u0438\u043f\u0430 \u0441 \u0441\u043e\u0444\u0442\u043e\u043c \u0437\u0430\u0431\u0430\u043d\u0438\u043b\u0438, \u0430 \u044d\u0442\u043e\u0442 \u043d\u0438\u0447\u0435, \u0436\u0438\u0432\u0435\u0442 \u0441\u0435\u0431\u0435, \u0431\u0435\u0433\u0430\u0435\u0442\u003C\/p\u003E\n\n\u003Cp\u003E\u043c\u0431 \u0435\u0433\u043e \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0430-\u0441\u043e\u0444\u0442\u0435\u0440 \u0441\u043e\u0437\u0434\u0430\u043b\u0430 \u0441\u0435\