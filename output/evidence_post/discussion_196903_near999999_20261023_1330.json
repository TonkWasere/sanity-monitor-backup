3b\u0438 \u043d\u0430 \u0438\u0433\u0440\u0443 \u0432 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438\u003C\/h3\u003E\n\u003Cp\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-23\/1792760525-671842-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u0022e68b94e7-aa30-4fbc-b590-a49dc08d576e\u0022 loading=\u0022lazy\u0022 width=\u0022301\u0022 height=\u002274\u0022\u003E\u003C\/p\u003E\n\n\u003Ch3\u003E\u0422\u043e\u043f 10 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u043f\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f\u003C\/h3\u003E\n\u003Cp\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-23\/1792760534-345393-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002259b3f92a-708e-49f2-b4d4-8967e3ae2386\u0022 loading=\u0022lazy\u0022 width=\u0022663\u0022 height=\u0022174\u0022\u003E\u003C\/p\u003E\n\n\u003Ch3\u003E\u0421\u0440\u0435\u0434\u0438 30 \u0434\u043e\u043f\u0443\u0441\u043a\u0430 \u0442\u043e\u043f 3 \u043f\u043e 3\u043c \u0440\u0430\u0437\u043d\u044b\u043c \u043a\u0430\u0440\u0442\u0430\u043c\u003C\/h3\u003E\n\u003Cp\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-23\/1792760564-368412-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002210501385-3b23-4a5f-a4a0-fb2cc074e84c\u0022 loading=\u0022lazy\u0022 width=\u0022604\u0022 height=\u0022154\u0022\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u042f \u043c\u043e\u0436\u0435\u0442 \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0447\u0435\u0442 \u043d\u0435 \u0442\u0430\u043a \u0432\u044b\u0433\u0440\u0443\u0437\u0438\u043b, \u043d\u043e \u0440\u0435\u0436\u0438\u043c \u043d\u0435 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043c\u0435\u0440\u0442\u0432\u044b\u043c \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0440\u0444\u0430, \u0434\u0430 \u043e\u043d:\u003Cbr\u003E\n\u0412\u0441\u0435 \u0435\u0449\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u043e\u0440\u0430\u0431\u043e\u0442\u043a\u0438\u003Cbr\u003E\n\u0412\u0441\u0435 \u0435\u0449\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0442\u043d\u044b\u0445 \u043b\u044e\u0434\u0435\u0439 \u0438 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0433\u043e \u0432\u0438\u0436\u0435\u043d\u0430\u003Cbr\u003E\n\u0412\u0441\u0435 \u0435\u0449\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u043e \u0435\u0441\u043b\u0438 \u0432\u044b \u043d\u0435 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u0435\u0442\u0435 \u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u0432\u0441\u0435 \u043f\u043e\u0434\u0440\u044f\u0434, \u0430 \u043f\u043e\u0442\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u043a\u0438\u0434\u044b\u0432\u0430\u0442\u044c \u044d\u0442\u043e \u0432 \u043c\u0443\u0441\u043e\u0440, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0442\u0443\u043f\u043e \u043d\u0430\u0438\u0433\u0440\u0430\u043b\u0438\u0441\u044c \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u043a\u0430\u043a \u0431\u044b\u043b\u043e \u0441: \u0423\u0431\u0435\u0436\u043a\u043e\u0439, \u0410\u0440\u0441\u0435\u043d\u0430\u043b\u043e\u043c, \u0441\u0435\u0441\u0441\u0438\u044f\u043c\u0438, \u0441\u0438\u0433\u043d\u0430\u043b\u0430\u043c\u0438 (\u0445\u043e\u0442\u044f \u0442\u0430\u043c \u0432\u0440\u043e\u0434\u0435 \u0447\u0435\u0442 \u0434\u0435\u043b\u0430\u0442\u044c \u043f\u044b\u0442\u0430\u044e\u0442\u0441\u044f \u0445\u043e\u0442\u044f \u0431\u044b \u043d\u0430 \u0441\u043b\u043e\u0432\u0430\u0445), \u043a\u043e\u043b\u0438\u0437\u0435\u0435\u043c, \u0441\u0442\u0430\u0440\u044b\u043c\u0438 \u0438\u0432\u0435\u043d\u0442\u0430\u043c\u0438, \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u043e\u043c, \u043a\u0432, \u0441\u0435\u0432\u0435\u0440\u043e\u043c \u0438 \u0442.\u0434\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u044d\u0442\u043e \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0432\u043e\u0442 \u0442\u0430\u043a:\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-23\/1792761666-633382-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u00228b41b93a-8713-43d8-b0f4-367053af6d02\u0022 loading=\u0022lazy\u0022 width=\u00221000\u0022 height=\u0022562\u0022\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-23\/1792761358-377929-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u0022343aa853-2450-4b56-96c0-94eb75c12db3\u0022 loading=\u0022lazy\u0022 width=\u00221600\u0022 height=\u0022900\u0022\u003E\u003C\/p\u003E\n\n","renderFailed":false,"editedAt":"2026-10-23T13:23:56+00:00","canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":3,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":2,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":2,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196903"}},"user":{"data":{"type":"users","id":"1396845"}},"editedUser":{"data":{"type":"users","id":"1396845"}},"mentionedBy":{"data":[{"type":"posts","id":"4723466"},{"type":"posts","id":"4723467"},{"type":"posts","id":"