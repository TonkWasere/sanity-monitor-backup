2 \u043d\u0435 \u0441\u0442\u0440\u043e\u0447\u043a\u0430 \u043d\u043e\u043c\u0435\u0440 \u0441\u0435\u043c\u044c, \u043e\u0442\u043d\u044e\u0434\u044c \u043d\u0435\u0442. \u003Cbr\u003E\n\u041f\u043e\u0447\u0435\u043c\u0443 \u0434\u043b\u044f \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0430\u0442\u0438 \u043d\u0435\u0442 \u0425\u041e\u0422\u042f \u0431\u044b \u043b\u0430\u0431\u0438\u0440\u0438\u043d\u0442\u0430 \u0438 \u043b\u0438\u043c\u0430\u043d\u0441\u043a\u0430 ? \u0410, \u043d\u0443 \u0434\u0430, \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c \u043d\u0435\u0442. \u0422\u043e\u0433\u0434\u0430 \u043f\u043e\u0447\u0435\u043c\u0443 \u0434\u0438\u043a\u043e\u0433\u043e \u0441\u0435\u0432\u0435\u0440\u0430 \u043d\u0435\u0442 ? \u0412\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0435\u0441\u0442 \u044d\u0442\u043e\u0439 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 (\u043a\u043e\u0442\u043e\u0440\u0430\u044f \u044f\u0432\u043d\u043e \u0432\u0430\u0436\u043d\u0435\u0435 \u043e\u0431\u043e\u0441\u0440\u0430\u043d\u043d\u044b\u0445 \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432 100 \u0434\u0430\u043d\u0436\u0435\u0439 \u043d\u0430 \u0447\u0430\u0441\u0442\u044c, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0432\u044b \u043d\u0435\u0435\u0431\u0430\u0442\u044c \u043a\u0430\u043a\u0438\u043c\u0438 \u043a\u0440\u0443\u0442\u044b\u043c\u0438 \u0430\u043d\u0438\u043c\u043a\u0430\u043c\u0438 \u0437\u0430\u0434\u0443\u0448\u0438\u043b\u0438), \u0442\u0430\u043a, \u043d\u0430 \u0441\u0434\u0430\u0447\u0443 \u0432\u043a\u0438\u043d\u0443\u043b\u0438, \u0434\u0430 ?\u003Cbr\u003E\n\u0410, \u0434\u0430 \u0432\u0440\u043e\u0434\u0435 \u043d\u0435\u0442. \u0412\u043e\u0442 \u0447\u0442\u043e \u043f\u0438\u0448\u0435\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044c \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u0430\u0448\u0435\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u041b\u0438\u0440\u0438\u043a\u0430\u043b\u041c\u0438\u043a\u0441\u0424\u043b\u0430\u0439\u0442:\u003C\/p\u003E\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196501-kriticheskaya\/104\u0022 class=\u0022PostMention\u0022 data-id=\u00224715231\u0022\u003EpsychosociaI\u003C\/a\u003E (\u043e \u0447\u0451\u043c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0435\u0441\u043b\u0438 \u043d\u0430 \u0434\u0438\u043a\u043e\u043c \u0441\u0435\u0432\u0435\u0440\u0435 \u0441\u0432\u043e\u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0438 \u043a \u0442\u043e\u043c\u0443 \u0436\u0435 \u043d\u0435\u0442 \u201c\u0444\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0430\u201d)\u003Cbr\u003E\n\u0414\u0438\u043a\u0438\u0439 \u0421\u0435\u0432\u0435\u0440 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043a\u043b\u0430\u043d\u043e\u0432\u044b\u043c \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u043e\u043c, \u0430 \u043a\u043b\u0430\u043d\u043e\u0432\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0441 \u0441\u043e\u043b\u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u043d\u0438\u043a\u0430\u043a \u043d\u0435 \u0432\u044f\u0436\u0435\u0442\u0441\u044f\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0425\u043e\u0442\u044f \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u043f\u0440\u0430\u0432\u043e\u0447\u043a\u0430:\u003C\/p\u003E\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196501-kriticheskaya\/108\u0022 class=\u0022PostMention\u0022 data-id=\u00224715244\u0022\u003EpsychosociaI\u003C\/a\u003E \u041d\u043e \u0434\u0430, \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u043c\u043e\u0438 \u0441\u043b\u043e\u0432\u0430 \u043f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u043f\u043e \u0447\u0430\u0441\u0442\u0438 \u0414\u0421 \u043d\u0435 \u043d\u0443\u0436\u043d\u043e\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0410 \u043c\u043d\u0435 \u043a\u0430\u043a \u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#22b7f7;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u041a\u043e\u043c\u0430\u043d\u0434\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-gem\u0022\u003E\u003C\/i\u003E\u003C\/span\u003E \u043a \u0434\u0430\u043d\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u044c\u0441\u044f ? \u0422\u0430\u043a \u0431\u0443\u0434\u0435\u0442 \u0438\u043b\u0438 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430 \u0434\u0438\u043a\u043e\u043c \u0441\u0435\u0432\u0435\u0440\u0435 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0430 ? \u042d\u0442\u0430 \u0432\u0430\u0448\u0430 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u0437\u0438\u0446\u0438\u044f, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u044d\u0442\u043e \u0432\u0430\u0448 \u043c\u043b\u0430\u0434\u0448\u0438\u0439 \u043a\u0430\u043c\u043c\u0443\u043d\u0438\u0442\u0438 \u043c\u0430\u043d\u0430\u0433\u0435\u0440 \u043f\u0438\u0448\u0435\u0442 \u0438\u043b\u0438 \u043d\u0435\u0442? \u003Cbr\u003E\n\u003Ca href=\u0022https:\/\/forum.exbo.net\/u\/psychosociaI\u0022 class=\u0022UserMention\u0022\u003E@psychosociaI\u003C\/a\u003E \u0414\u0440\u0443\u0436\u0438\u0449\u0435 \u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-09-19\/1789806150-403646-izobrazenie.png\u0022 title=\u0022izobrazenie.png\u0022 alt=\u0022\u0022 data-id=\u00223a3b9d53-c806-4a20-b030-1bb6dbd6ebd5\u0022 loading=\u0022lazy\u0022 width=\u0022484\u0022 height=\u0022234\u0022\u003E \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0433\u0434\u0435 ?\u003Cbr\u003E\n\u041b\u0430\u0434\u043d\u043e, \u0441\u0445\u0430\u0432\u0430\u0435\u043c\u003C\/p\u003E\n\n\u003Ch3\u003E\u0422\u0430\u043a \u0432\u043e\u0442 \u0442\u0435\u043f\u0435\u0440\u044c \u043a \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u201c\u042d\u0442\u043e \u043a\u043b\u0430\u043d\u043e\u0432\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u201d\u003C\/h3\u003E\n\n\u003Cp\u003E\u041d\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u0435 \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0440\u0430\u0437 \u0431\u044b\u043b\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u043a\u043b\u0430\u043d\u0430\u043c\u0438 ? \u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-20\/1792527509-541450-izobrazenie.png\u0022 title=\u0022izobrazenie.png\u0022 alt=\u0022\u0022 data-id=\u0022c4ad28f0-dd55-4cf9-8aaa-7472104cdb99\u0022 loading=\u0022lazy\u0022 width=\u0022623\u0022 height=\u002266\u0022\u003E\u003Cbr\u003E\n\u0410\u0433\u0430, \u0430 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \u201c\u043a\u0430\u043b\u043e\u0432\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u201d ?\u003Cbr\u003E\n\u0422\u0430\u0430\u0430\u0430\u0430\u043a, \u0437\u043d\u0430\u0447\u0438\u0442 \u0434\u0438\u043a\u0438\u0439 \u0441\u0435\u0432\u0435\u0440 \u043c\u0438\u043d\u043e\u0440\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u043a\u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u043b 17.06.26\u003Cbr\u003E\n\u0410\u0433\u0430, \u0442.\u0435 \u043d\u0430\u0434\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0434\u043e\u0436\u0434\u0430\u0442\u044c, \u043a\u043e\u0433\u0434\u0430 \u043d\u0430\u043a\u043e\u043d\u0435\u0446 \u0442\u043e \u0437\u0430\u0432\u0435\u0437\u0443\u0442 \u043d\u0430 \u044d\u0442\u043e\u0442 \u0441\u0430\u043c\u044b\u0439 \u043a\u043b\u0430\u043d\u043e\u0432\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0434\u043b\u044f \u043a\u043b\u0430\u043d\u043e\u0432, \u044f \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043f\u043e\u043d\u044f\u043b ?\u003Cbr\u003E\n\u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u043b\u0438\u0447\u043d\u043e \u044f \u043c\u043e\u0433\u0443 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0432\u0438\u0434\u0435\u0442\u044c 34 \u0435\u0431\u0430\u043b\u0430 \u0441\u0432\u043e\u0438\u0445 \u0441\u043e\u044e\u0437\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a \u043a\u043b\u0430\u043d\u043e\u0432\u043e\u043c\u0443 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0443 \u043e\u0442\u043d\u0435\u0441\u0442\u0438, \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 - \u0438 \u043f\u0430\u0442\u0438 \u0441 \u0441\u043e\u043b\u043e\u0432\u0438\u0447\u043a\u0430\u043c\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e.\u003Cbr\u003E\n\u041a\u043e\u0433\u0434\u0430 \u0442\u0430\u043c \u043d\u0443 \u0447\u0442\u043e - \u0442\u043e \u0434\u043b\u044f \u043a\u043b\u0430\u043d\u043e\u0432, \u0442\u0430\u043c \u0431\u0430\u0437\u044b, \u043a\u043b\u0430\u0439\u043c\u044b \u0438 \u0442.\u0434., \u043c\u0431 \u0441\u043f\u043e\u0442\u044b \u0433\u0434\u0435 \u043d\u0430\u0434\u043e \u041d\u0418\u0425\u0423\u042f \u0421\u0415\u0411\u0415 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u044f\u0442\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0442\u0430\u043c \u0440\u0435\u0439\u0434\u043e\u0432\u044b\u0435 \u0431\u043e\u0441\u0441\u044b \u0432\u0441\u044f \u0445\u0443\u0439\u043d\u044f ?\u003Cbr\u003E\n\u0422\u043e\u0447\u043d\u043e, \u044d\u0442\u043e \u0436\u0435 \u043d\u0435 \u0430\u043b\u044c\u0431\u0438\u043e\u043d, \u0442\u0443\u0442 \u0432\u0441\u0435\u0433\u043e \u0442\u0440\u0438 \u043b\u043e\u043a\u0430\u0446\u0438\u0438 \u043f\u043e 50 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0430 \u043a\u043e\u043f\u0438\u044e, \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0441\u044f \u0431\u0430\u0437\u0430\u043c\u0438 \u043d\u0430\u0441\u0440\u0430\u0442\u044c, \u0437\u0430\u0442\u043e \u044d\u0442\u043e\u0442 \u0443\u0432\u0430\u0436\u0430\u0435\u043c\u044b\u0439 \u0438 \u043d\u0438 \u0447\u0443\u0442\u044c \u043d\u0435 \u0443\u044e\u0442\u043d\u0435\u043d\u044c\u043a\u043e \u0441\u0438\u0434\u044f\u0449\u0438\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u003Ca href=\u0022https:\/\/forum.exbo.net\/u\/Kommynist\u0022 class=\u0022UserMention\u0022\u003E@Kommynist\u003C\/a\u003E \u0443\u0436\u0435 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043b\u043e\u043c\u0430\u0435\u0442 \u0433\u043e\u043b\u043e\u0432\u043e \u043d\u0438\u043a\u0430\u043a \u043d\u0435 \u0434\u043e\u043b\u043e\u043c\u0430\u0435\u0442.\u003Cbr\u003E\n\u041b\u043e\u043c\u0430\u0435\u0448\u044c \u0436\u0435, \u0418\u043b\u044e\u0445\u0430 \u043f\u0430\u0432\u0443\u043a, \u0442\u044b \u0436\u0435 \u0441\u0434\u0435\u043b\u0430\u0435\u0448\u044c \u043a\u043b\u0430\u043d\u044b \u043a\u0440\u0443\u0442\u044b\u043c\u0438 ? \u0422\u044b \u0436\u0435 \u0438\u0437\u043b\u0435\u0447\u0438\u0448\u044c \u043a\u0438\u043a\u0438 \u043f\u0435\u0440\u0435\u0434 \u043d\u0430\u0433\u0440\u0430\u0434\u0430\u043c\u0438 \ud83d\ude4f?\u003C\/p\u003E \n\n\u003Ch3\u003E\u0422\u0435\u043f\u0435\u0440\u044c \u043a \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0443\u003C\/h3\u003E\n\n\u003Cp\u003E\u0420\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0438\u0433\u0440\u0435 \u0432 \u043b\u044e\u0431\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0443 \u0441\u043e\u043b\u043e\u0432\u0438\u0447\u043a\u0430 \u041d\u0415\u0422 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043f\u0435\u0440\u0435\u0434 \u043f\u0430\u0442\u0438 \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e, \u0430 \u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442\u044b \u0441 \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u043a\u043e\u0439 \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u043f\u0440\u043e\u0442\u0438\u0432 \u043f\u0430\u0442\u0438 \u043d\u0435 \u043e\u0442\u0441\u0442\u0430\u043b\u044b\u0445 \u0434\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0432, \u044d\u0442\u043e\u0442 \u0432\u044b\u0441\u0435\u0440 \u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0438\u0433\u0440\u0430\u043c \u0441 \u043d\u0438\u0437\u043a\u0438\u043c \u0442\u0442\u043a \u0438 \u0442\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0435\u0439.\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0441\u0442\u0438\u043c\u044b \u003Cbr\u003E\n\u041c\u043e\u0436\u0435\u0442 \u043f\u043e\u0440\u0430 \u0438\u0445 \u0432\u044b\u0440\u0435\u0437\u0430\u0442\u044c \u043d\u0430\u0445\u0443\u0439, \u0447\u0442\u043e\u0431\u044b \u043f\u0430\u0442\u0438\u0447\u0443\u0445 \u0434\u0435\u043b\u0430\u043b \u043f\u043e\u043b\u0435\u0437\u043d\u0443\u044e \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c, \u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u0435, \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043d\u043d\u0443\u044e ? \u0410 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u043e\u0436\u043a\u0430\u043c\u0438 \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u043b \u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0436\u043a\u0443 ? \u041c\u043e\u0436\u0435\u0442 \u043f\u043e\u0440\u0430 \u043d\u0435 \u0444\u0443\u043b\u043b \u043f\u0440\u0438\u0432\u0435\u0434\u0443 \u0432 \u043d\u043e\u043a\u0435 \u043d\u0430\u0441\u0442\u0440\u0435\u043b\u0438\u0432\u0430\u0442\u044c ? \u041c\u043e\u0436\u0435\u0442 \u043f\u043e\u0440\u0430 \u0445\u043e\u0442\u044f \u0431\u044b \u043f\u043e\u043c\u0435\u043d\u044f\u0442\u044c \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443 \u043d\u043e\u043a\u0430 ? \u0410 \u0442\u043e \u0447\u0435\u0442 \u0437\u0430\u0435\u0431\u044b\u0432\u0430\u0435\u0442 \u0447\u0435\u0441\u0442\u043d\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u043f\u0443\u043b\u044c\u043a\u043e\u0439 \u0438\u0437 \u0437\u0430\u0436\u0438\u043c\u0430 \u0432 \u0433\u043e\u043b\u043e\u0432\u0443 \u043f\u043e\u043f\u0430\u0434\u0430\u0442\u044c \u0432 \u0440\u0443\u043a\u0443 \u0438\u043b\u0438 \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u0443. \u0418\u043b\u0438 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e \u0441\u0442\u0440\u0435\u043b\u044f\u0435\u0442 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u0443, \u043d\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u043f\u0443\u043b\u044c\u043a\u043e\u0439 \u0437\u0430\u043b\u0435\u0442\u0430\u0435\u0442 \u0433\u043e\u043b\u043e\u0432\u0430, \u043c\u043c\u043c\u043c, \u0431\u0435\u043b\u0438\u0441\u0441\u0438\u043c\u043e.  \u0421\u043e\u043b\u043e\u0432\u0438\u0447\u0435\u043a, \u0435\u0441\u043b\u0438 \u0447\u0442\u043e, \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0441\u043e\u0441\u0435\u0442 \u0432 \u0434\u0430\u043d\u043d\u043e\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438.\u003C\/p\u003E\n\n\u003Cp\u003E\u0414\u0430, \u0438 \u043a\u0430\u043a \u0440\u0430\u0437 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0430\u0441\u043f\u0435\u043a\u0442 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f.\u003Cbr\u003E\n\u041b\u0443\u0447\u0448\u0435 \u043c\u0435\u043d\u044f \u0431\u0443\u0434\u0435\u0442 \u0435\u0431\u0430\u0442\u044c \u043e\u0434\u0438\u043d, \u0447\u0435\u043c \u043f\u044f\u0442\u0435\u0440\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u0422\u0430\u043a, \u0432\u0441\u0435, \u044f \u0432\u044b\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0441\u044f, \u043d\u043e, \u0433\u043b\u0430\u0432\u043d\u043e\u0435, \u0436\u0434\u0443 \u0433\u043e\u0441\u0442\u0435\u0439 \u0438\u0434\u0436\u0438\u0441\u0438\u0442\u0430\u0440\u0440\u0430, \u043d\u0435\u043e\u043d\u0447\u0438\u043a\u0430, \u0438\u043d\u0432\u0438\u0441\u0438\u043a\u044c\u044e\u0435, \u043f\u0438\u0432\u043e12\u043f\u0438\u0432\u043e \u003Cspan class=\u0022spoiler\u0022 onclick=\u0022removeAttribute(\u0027class\u0027)\u0022\u003E\u043d\u0430\u0439\u0434\u0438 \u0432 \u0441\u043a\u0443\u0444\u0438\u043a\u0430\u0445 \u043f\u0430\u0442\u0438 \u0432 \u043a\u043e\u043b\u043b\u0438\u0437\u0435\u0439 \u0447\u0435 \u0442\u044b \u043a\u0430\u043a \u043b\u043e\u0445\u003C\/span\u003E\u003Cbr\u003E\n, \u0430 \u0442\u0430\u043a \u0436\u0435 \u043a\u043c\u043c\u043a \u0440\u0430\u043d\u0434\u043e\u043c\u043d\u044b\u0435 \u0446\u0438\u0444\u0440\u044b, \u044f \u0432\u0441\u0435\u0433\u0434\u0430 \u043e\u0442\u043a\u0440\u044b\u0442 \u043a \u0434\u0438\u0441\u043a\u0443\u0441\u0441\u0438\u0438. \u0410 \u0442\u0430\u043a \u0436\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0432 \u0432\u0438\u0434\u0435 \u0421\u0430\u0448\u0438 \u041d\u0435\u0421\u0432\u0438\u043d\u0430, \u0418\u0433\u043e\u0440\u044f, \u041d\u043e\u0432\u043e\u0433\u043e \