a\u0443 \u0438\u0437 \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u0442\u0444\u0442, \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u043d\u0435\u0442. \u041d\u043e \u043f\u043e\u0447\u0435\u043c\u0443 \u0435\u0451 \u0434\u0430\u0436\u0435 \u0441\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c. \u041d\u0410\u0425\u0415\u0420\u0410 \u0448\u043c\u043e\u0442\u043a\u0430 \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0438\u0437 \u043e\u0431\u0449\u0435\u0433\u043e \u043f\u0443\u043b\u0430 \u043f\u0440\u0438 \u043f\u0440\u043e\u0434\u0430\u0436\u0435?\u003Cbr\u003E\n\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197164-potentsial-dlya-namerennogo-ruina\/7\u0022 class=\u0022PostMention\u0022 data-id=\u00224733232\u0022\u003Ehoho_1337\u003C\/a\u003E \u0449\u0430\u0441 \u0441 \u043d\u0438\u043c\u0438 \u0434\u0430\u0436\u0435 \u0441\u0438\u0434\u0435\u0442\u044c \u043d\u0435 \u043d\u0430\u0434\u043e, \u0438\u0445 \u043c\u043e\u0436\u043d\u043e \u0442\u0443\u043f\u043e \u043f\u0440\u043e\u0434\u0430\u0442\u044c. \u042f \u0442\u0430\u043a \u043f\u043e\u043d\u044f\u043b \u043d\u0438\u0433\u0434\u0435 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043e, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u044b\u0439 \u0447\u0435\u0440\u0442\u0451\u0436 \u043d\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u044b\u0431\u044b\u043b \u0438\u0437 \u043f\u0443\u043b\u0430 \u043f\u0440\u0438 \u043f\u0440\u043e\u0434\u0430\u0436\u0435.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0415\u0441\u043b\u0438 \u0447\u0435\u0441\u0442\u043d\u043e, \u0445\u043e\u0442\u0435\u043b \u043f\u0440\u043e\u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u043d\u043e \u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u043c \u0438\u0442\u043e\u0433\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0443\u0432\u0438\u0434\u0435\u043b \u0440\u0430\u0437\u043d\u0438\u0446\u044b \u043c\u0435\u0436\u0434\u0443 \u0442\u0438\u043f\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0445\u043e\u043b\u0434\u044f\u0442 \u0447\u0430\u0441\u0442\u0438 \u0438 \u0442\u0438\u043f\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u043a\u0443\u043f\u0438\u043b\u0438 \u0438 \u043f\u0440\u043e\u0434\u0430\u043b\u0438 \u043a\u0440\u043e\u043c\u0435 \u043a\u0430\u043a \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u003Cem\u003E(\u0432\u043e\u043f\u0440\u043e\u0441 \u0431\u043b\u0438\u0436\u0435 \u043a \u0442\u043e\u043c\u0443, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u0438\u043f \u0432\u044b\u0438\u0433\u0440\u0430\u0435\u0442 \u0432 \u0434\u0435\u043d\u044c\u0433\u0430\u0445 \u0438 \u0432\u044b\u0438\u0433\u0440\u0430\u0435\u0442 \u0447\u0442\u043e-\u0442\u043e \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b, \u0435\u0441\u043b\u0438 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u0432\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044e \u043f\u043e \u0434\u0438\u0432\u0435\u0440\u0441\u0438\u044f\u043c (\u0435\u0441\u043b\u0438 \u044d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u043a \u0438\u0433\u0440\u0435 4 \u0432 5, \u0442\u043e \u0432\u044b\u0439\u0434\u0435\u0442 \u043a\u0430\u043a\u0430\u044f-\u0442\u043e \u0444\u0438\u0433\u043d\u044f))\u003C\/em\u003E.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412 \u043f\u0440\u043e\u0448\u043b\u044b\u0445 \u0430\u0440\u0435\u043d\u0430\u0445 \u0432 \u043f\u0443\u043b \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u043b\u0441\u044f, \u0432 \u044d\u0442\u043e\u0442 \u0440\u0430\u043