6d-42a9-89d7-c46edba7abf2\u0022 loading=\u0022lazy\u0022 width=\u00222119\u0022 height=\u0022807\u0022\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u0413\u043e\u0440\u0434\u044b\u043d\u044f \u0438 \u043c\u043e\u0440\u043e\u0437\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0432\u0430\u043b \u044d\u0442\u043e \u043d\u0430\u0439\u0441, \u043d\u043e \u043f\u0435\u0440\u0435\u0432\u0430\u043b \u0434\u043e\u0440\u043e\u0433\u043e\u0432\u0430\u0442, \u0430 \u0412\u041e\u0422 \u0415\u0411\u0423\u0427\u0418\u0419 \u0425\u041e\u0420\u041d\u0415\u0422, \u044f \u043e\u0431\u043e\u0436\u0430\u044e \u0410\u041a-15, \u043d\u043e \u0445\u043e\u0440\u043d\u0435\u0442\u2026 \u042d\u0442\u043e \u043f\u043e\u043b\u043d\u0430\u044f \u043f\u043e\u043f\u043b\u0430\u0432\u0430, \u043a\u0430\u043a \u0436\u0435 \u044f \u043c\u0435\u0447\u0442\u0430\u043b \u043e \u0410\u041a \u0428\u0443\u0441\u0442\u0440\u043e\u0433\u043e, \u0430 \u0432\u044b\u043f\u0430\u043b \u044d\u0442\u043e\u0442 \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439 \u043a\u0443\u0441\u043e\u043a \u0417\u0438\u0432\u043a\u0430\u0441\u0430\u2026\u003C\/p\u003E\n\n\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/u\/Tarnum\u0022 class=\u0022UserMention\u0022\u003E@Tarnum\u003C\/a\u003E \u044f \u0432\u0441\u0451 \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u043c\u043e\u043d\u0435\u0442\u0430-\u043c\u043e\u043d\u0435\u0442\u043e\u0439, \u043d\u043e \u0435\u0431\u0430\u0442\u044c, \u0430 \u0441 \u0442\u0435\u043c \u0447\u0442\u043e \u0431\u0430\u0440\u0430\u0431\u0430\u043d \u0441\u044a\u0435\u043b \u043f\u0440\u0438\u0451\u043c\u043d\u0438\u043a (\u0436\u043e\u043f\u0430 \u0441\u044a\u0435\u043b\u0430 \u0442\u0440\u0443\u0441\u044b) \u043c\u043e\u0436\u0435\u0442 \u0445\u043e\u0442\u044c \u0447\u0442\u043e-\u0442\u043e \u043d\u0430\u0434\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043f\u0440\u043e\u0441\u0438\u0442\u044c \u0434\u0435\u043d\u0435\u0433? \u