447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0433\u0435\u0439\u043c\u0434\u0438\u0437\u0430\u0439\u043d\u0430 \u0438 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0437\u0434\u0440\u0430\u0432\u043e\u0439 \u043b\u043e\u0433\u0438\u043a\u0438, \u0432 \u0438\u0433\u0440\u0430\u0445-\u0441\u0435\u0440\u0432\u0438\u0441\u0430\u0445 \u043f\u0440\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 \u0438 \u0433\u0440\u0438\u043d\u0434, \u043b\u044c\u0432\u0438\u043d\u0443\u044e \u0434\u043e\u043b\u044e \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u0438\u043c\u0435\u043d\u043d\u043e \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430 \u043f\u043e\u0442\u0440\u0430\u0447\u0435\u043d\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0443 \u0432\u0430\u0440\u0438\u0430\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0444\u0430\u0440\u043c\u0430 \u043d\u0430 \u0432\u0440\u0435\u043c\u044f \u0438\u0432\u0435\u043d\u0442\u0430 \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u043f\u043e\u043b\u0443\u0447\u0430\u043b \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0432 \u0442\u043e\u043c-\u0436\u0435 \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0438\/\u043f\u0440\u0438\u0431\u044b\u043b\u0438 \u043a\u0430\u043a \u0438 \u0432 \u043e\u043f\u0435\u043d\u0435, \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u043d\u0435\u043b\u044c\u0437\u044f - \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0432\u0435\u043d\u0442 \u0437\u0430\u043a\u043e\u043d\u044b \u0436\u0430\u043d\u0440\u0430 \u0432 \u0440\u043e\u0442 \u0435\u0431\u0430\u043b \u0438 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u0432\u044b\u0434\u0430\u043d\u043d\u043e\u043c \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0438, \u0430 \u043d\u0435 \u043d\u0430 \u0441\u0432\u043e\u0435\u043c, \u0442\u043e \u0435\u0441\u0442\u044c \u043e\u0431\u0435\u0441\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0432\u0435\u0441\u044c \u0442\u0432\u043e\u0439 \u0444\u0430\u0440\u043c \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u0442\u044b\u0441\u044f\u0447 \u0447\u0430\u0441\u043e\u0432. \u003Cbr\u003E\n\u0410 \u0435\u0441\u043b\u0438 \u0438\u0437 \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0442\u0432\u043e\u044f \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0441\u0442\u0440\u043e\u0438\u0442\u0441\u044f \u043d\u0430 \u043d\u0435\u0442\u0432\u043e\u0440\u0441\u0435 \u0438 \u043d\u0430\u0432\u044b\u043a\u0435, \u0432\u044b\u0447\u0435\u0441\u0442\u044c \u043d\u0435\u0442\u0432\u043e\u0440\u0441, \u0442\u043e \u0443\u0436\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u0434\u0435\u043b\u0430\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0440\u0430\u0432\u043d\u043e\u0439 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435, \u0438\u043b\u0438 \u0442\u0435\u043c \u0431\u043e\u043b\u0435\u0435 \u0434\u0435\u043b\u0430\u0442\u044c \u0435\u0451 \u0446\u0435\u043d\u043d\u0435\u0435 (\u043a\u0430\u043a \u044d\u0442\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u043e \u0440\u0430\u043d\u044c\u0448\u0435). \u003Cbr\u003E\n\u041e\u0442\u0441\u044e\u0434\u0430 \u0435\u0449\u0451 \u0432\u044b\u0447\u0442\u0435\u043c \u043b\u044c\u0432\u0438\u043d\u0443\u044e \u0434\u043e\u043b\u044e \u0432\u043b\u0438\u044f\u043d\u0438\u044f \u043d\u0430\u0432\u044b\u043a\u0430 - \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0438 \u0437\u043d\u0430\u043d\u0438\u0435 \u043c\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438, \u043d\u0438 \u043d\u0430\u0432\u044b\u043a\u0438 \u0431\u043e\u044f \u0437\u0434\u0435\u0441\u044c \u0440\u043e\u043b\u0438 \u043d\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0438\u043a\u0430\u043a\u043e\u0439. \u0415\u0441\u043b\u0438 \u0447\u0442\u043e \u0438 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0437\u0434\u0435\u0441\u044c \u043e\u0442 \u201c\u043d\u0430\u0432\u044b\u043a\u0430\u201d, \u0432 \u043b\u0438\u0446\u0435 \u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u0438\u0432\u0435\u043d\u0442\u043e\u0433\u043e \u0431\u0438\u043b\u0434\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0438 \u0437\u0430\u0434\u0440\u0430\u0447\u0438\u0432\u0430\u043d\u0438\u044f \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u043e\u0432 \u0431\u043e\u0441\u0441\u043e\u0432, \u0442\u043e \u044d\u0442\u043e \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0434\u0435\u0441\u044c \u0438 \u0446\u0435\u043d\u0438\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0434\u0435\u0441\u044c. \u041e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u0442\u044c \u0437\u0430 \u043d\u0430\u0432\u044b\u043a \u0438\u0433\u0440\u044b \u0432 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0434\u0440\u0443\u0433\u0443\u044e \u0438\u0433\u0440\u0443 \u0431\u044b\u043b\u043e \u0431\u044b \u0431\u0435\u0437\u0443\u043c\u043d\u043e. \u0425\u043e\u0442\u044f \u0434\u043b\u044f \u044d\u043a\u0441\u0431\u043e \u0441\u043a\u043e\u0440\u0435\u0435 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u043d\u0435 \u0434\u043e\u043f\u0443\u