e \u043f\u043e \u0442\u0435\u0433\u0430\u043c. \u0421\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0434\u043b\u044f \u0441\u0442\u0430\u043a\u0430 \u0432 \u044d\u0442\u043e\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u043d\u0435\u0442.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196902-zamok-sefiry\/32\u0022 class=\u0022PostMention\u0022 data-id=\u00224724924\u0022\u003EDaikeri0\u003C\/a\u003E \u043f\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435 \u043f\u0436 ,\u0447\u0442\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 \u0441\u0440\u0430\u043a\u0443, \u0443 \u0432\u0430\u0441 \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u043e \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0438\u043c\u0435\u044e\u0442 \u043a\u0430\u043a\u043e\u0439 \u0442\u043e \u0432\u0441\u0440\u0430\u0442\u044b\u0439 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0441\u0442\u0430\u043a\u0430\u0442\u044c.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u042d\u0442\u043e \u043d\u0435 \u043e\u0441\u043e\u0431\u043e \u0442\u043e \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u044c, \u0442.\u043a. \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432 \u0442\u043e\u043c, \u043a\u0430\u043a \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u0441\u044f \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0438 \u043a\u0430\u043a\u043e\u0439 \u0442\u0435\u0445. \u0442\u0435\u0433 \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0441\u0442\u0430\u043a\u0430\u0442\u044c\u0441\u044f \u0434\u0432\u0443\u043c \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u043c \u0432 \u0441\u0432\u043e\u0435\u0439 \u0441\u0443\u0442\u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c.\u003Cbr\u003E\n\u041b\u0438\u0431\u043e \u0436\u0435 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0447\u0430\u0441\u0442\u044c \u043a\u0440\u0430\u0441\u043e\u043a \u0438\u0433\u0440\u043e\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b, \u043d\u043e \u0421\u041d\u042f\u041b \u003Cem\u003E(\u043e\u043f\u044f\u0442\u044c \u0436\u0435 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e \u043f\u0440\u043e \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u0433\u0438)\u003C\/em\u003E, \u0438 \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u043d\u0438 \u043d\u0435 \u0441\u0442\u0430\u043a\u0430\u044e\u0442\u0441\u044f. \u041d\u0443\u0436\u043d\u043e \u043d\u0430\u0446\u0435\u043f\u0438\u0442\u044c \u0438 \u0441\u043d\u044f\u0442\u044c \u0432\u0441\u0435 \u044d\u043a\u0437\u0435\u043c\u043f\u043b\u044f\u0440\u044b \u043a\u0440\u0430\u0441\u043a\u0438.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0442\u0440\u0430\u0431\u043b \u0440\u0435\u0448\u0438\u0442 \u0440\u0430\u0437\u0432\u0435 \u0447\u0442\u043e \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0413\u0430\u0440\u0434\u0435\u0440\u043e\u0431 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c, \u0435\u0441\u043b\u0438 \u0432 \u0441\u0432\u043e\u0435\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u0435 \u043e\u043d \u0437\u0430\u0431\u0435\u0440\u0451\u0442 \u0432\u0441\u0435 \u043a\u0440\u0430\u0441\u043a\u0438 \u0432 \u0441\u0432\u043e\u0435 \u043e\u0431\u043b\u0430\u0447\u043d\u043e\u0435 \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u00