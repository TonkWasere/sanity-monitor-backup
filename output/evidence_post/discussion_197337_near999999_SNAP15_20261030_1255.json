u043b\u043e\u043c \u0440\u0430\u0443\u043d\u0434\u0430 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u0435\u043d\u044f\u0435\u0442 \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u0441\u0440\u0430\u0436\u0435\u043d\u0438\u044f. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0437\u0430\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0432 \u043f\u043e\u0434\u0432\u0430\u043b\u0435, \u0438\u0437 \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0442\u0430\u043c \u0434\u0430\u0436\u0435 \u0432 \u043d\u0430\u0443\u0447\u043a\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e. \u003Cbr\u003E\n\u0418\u043b\u0438 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430\u043d\u043e\u0441\u0438\u0442 \u0443\u0440\u043e\u043d \u0440\u0435\u043b\u0438\u043a\u0432\u0438\u0438. \u003Cbr\u003E\n\u0418\u043b\u0438 \u0412\u0440\u0435\u043c\u044f \u0432\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043e \u0432 2 \u0440\u0430\u0437\u0430, \u0447\u0442\u043e \u043f\u043e\u0432\u044b\u0441\u0438\u0442 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0436\u0438\u0437\u043d\u0438 \u0438 \u0441\u0430\u043c\u043e\u0433\u043e \u041f\u0412\u041f \u0432 \u044d\u0442\u043e\u043c \u0440\u0430\u0443\u043d\u0434\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043c\u043d\u043e\u0433\u043e. \u0413\u043b\u0430\u0432\u043d\u043e\u0435, \u0447\u0442\u043e\u0431\u044b \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043c\u0435\u043d\u044f\u043b\u0438 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u044b\u0439 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043a \u043d\u043e\u0432\u044b\u043c \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E3. \u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u043c\u0443\u0442\u0430\u043d\u0442\/\u041d\u041f\u0421 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u041f\u0412\u0415 \u0440\u0430\u0443\u043d\u0434\u043e\u0432.\u003C\/strong\u003E\u003Cbr\u003E\n\u0412 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0439 \u041f\u0412\u0415 \u0440\u0430\u0443\u043d\u0434\u043e\u0432 \u043d\u0430 \u0430\u0440\u0435\u043d\u0443 \u043c\u043e\u0433 \u0431\u044b \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u043c\u0443\u0442\u0430\u043d\u0442 \u0438\u043b\u0438 \u0434\u0430\u0436\u0435 \u043c\u0438\u043d\u0438 \u0431\u043e\u0441\u0441. \u0417\u0430 \u0435\u0433\u043e \u0443\u0431\u0438\u0439\u0441\u0442\u04