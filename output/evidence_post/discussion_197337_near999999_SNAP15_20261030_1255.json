30\u0442\u044c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u043e\u0434\u043d\u0430\u0441\u0435\u0440\u044b \u0434\u043b\u044f \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u0432. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0434\u0435\u0431\u0430\u0444\u0444, \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0449\u0438\u0445\u0441\u044f \u043c\u0443\u0442\u0430\u043d\u0442\u043e\u0432, \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435 \u0443\u0440\u043e\u043d \u043f\u043e \u0440\u0435\u043b\u0438\u043a\u0432\u0438\u0438 \u0438\u043b\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0443 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0432\u043e\u043b\u043d\u0443 \u043c\u043e\u0431\u043e\u0432 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0443\u0436\u0435 \u0432\u044b\u0445\u043e\u0434\u044f\u0449\u0435\u0439. \u0412\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u044f \u0431\u043e\u0441\u0441\u0430 \u0438\u043b\u0438 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0443\u0442\u0430\u043d\u0442\u043e\u0432 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0431\u0438\u0442\u0432\u044b \u0441 \u043d\u0438\u043c.\u003Cbr\u003E\n\u042d\u0442\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u043e \u0431\u044b \u0435\u0449\u0451 \u043e\u0434\u0438\u043d \u0441\u043f\u043e\u0441\u043e\u0431 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u0443\u044e \u0432\u0430\u043b\u044e\u0442\u0443 \u0438 \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0431\u044b \u043a\u043e\u043c\