438\u0445 \u043b\u0438\u0431\u043e \u043f\u043e\u043f\u044b\u0442\u043e\u043a \u0440\u0435\u0448\u0438\u0442\u044c \u044d\u0442\u043e \u0438\u0445 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0440\u0435\u0437\u0430\u043b\u0438.\u003Cbr\u003E\n\u043c\u0430\u043b\u043e \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0439 \u0431\u043e\u0441\u0441\u043e\u0432, \u0434\u0430 \u0438 \u0442\u0435 \u043e\u0442\u0431\u0430\u043b\u0430\u043d\u0448\u0435\u043d\u044b \u0445\u0435\u0440\u043e\u0432\u043e, \u0442\u043e\u0433\u043e\u0436\u0435 \u043f\u0441\u0430\u0440\u044f \u0443\u0431\u0438\u0442\u044c \u043d\u0430 \u0442\u0430\u043a\u043e\u043c \u0440\u0430\u043d\u0435\u043c \u044d\u0442\u0430\u043f\u0435 \u043e\u043a\u043e\u043b\u043e \u043d\u0435\u0440\u0435\u0430\u043b\u044c\u043d\u043e, \u0443\u0447\u0438\u0442\u043e\u0432\u0430\u044f \u0435\u0433\u043e \u0441\u043f\u0430\u043c \u0441\u043e\u0431\u0430\u043a\u0430\u043c\u0438 \u0438 \u0436\u0438\u0440\u043d\u043e\u0441\u0442\u044c \u0438 \u043f\u0435\u0440\u0432\u043e\u0439 \u0438 \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u0441\u0442\u0430\u0434\u0438\u0438.\u003Cbr\u003E\n\u043e\u0431\u0447\u043d\u044b\u0435 \u044d\u0442\u0430\u043f\u044b \u0442\u0430\u043a\u0436\u0435 \u043e\u0434\u043d\u043e\u0431\u0440\u0430\u0437\u043d\u044b \u0434\u043e \u0436\u0443\u0442\u0438.\u003Cbr\u003E\n\u041f\u0412\u041f, \u043a\u0430\u0440\u0442\u0430 \u043d\u0438 \u043a\u0430\u043a \u043d\u0435 \u043f\u043e\u043c\u0435\u043d\u044f\u043b\u0430\u0441\u044c \u043a\u0440\u043e\u043c\u0435 \u043d\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u043e\u0445\u043e\u0434\u0430 \u0432 \u0431\u0438\u043e \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u043d\u0443 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0432\u044b \u0441\u0435\u0442 \u043d\u0430 \u043f\u0440\u044b\u0436\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0445\u0430\u0439