435\u0441\u0442\u044c \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043a\u043e\u0440\u0430\u0442\u044c \u0442\u0435\u0445 \u043a\u0442\u043e \u043d\u0435 \u043e\u0441\u0442\u043e\u0432\u043b\u044f\u0435\u0442 300 \u043c\u043e\u043d\u0435\u0442 \u0432 \u043a\u043e\u0440\u043c\u0430\u0448\u043a\u0435 \u0434\u043b\u044f \u0434\u043e\u043f \u0434\u0435\u043d\u0435\u0433? \u0438\u0445 \u0438 \u0442\u0430\u043a \u0431\u044b \u043f\u043e\u043a\u0430\u0440\u0430\u043b\u0438 \u0438\u0433\u0440\u043e\u043a\u0438 \u0432 \u0441\u043d\u0430\u0440\u044f\u0433\u0435 \u043f\u043e\u043b\u0443\u0447\u0448\u0435, \u043d\u043e\u0432\u044b\u0439 \u0432\u044b\u0432\u043e\u0434 \u0434\u0435\u043d\u0435\u0433? \u0443\u0432\u0438\u043b\u0438\u0447\u0438\u0442\u044c \u0440\u0430\u0437\u0440\u044b\u0432 \u043c\u0435\u0436\u0434\u0443 \u043d\u0435 \u0442\u0435\u0440\u043f\u0435\u043b\u0438\u0432\u044b\u043c\u0438 \u0438 \u0442\u0435\u0440\u043f\u0438\u043b\u0430\u043c\u0438?\u003Cbr\u003E\n4) \u043f\u0435\u0440\u043a\u0438\u003Cbr\u003E\n\u044f \u043c\u043e\u0433\u0443 \u043d\u0430\u0432\u0435\u0440\u043d\u043e \u043f\u043e\u043d\u044f\u0442\u044c \u043f\u0440\u0438\u0447\u0438\u043d\u0443 \u043f\u043e \u043a\u043e\u0442\u0440\u044b\u0439 \u0438\u0445 \u0443\u0431\u0440\u0430\u043b\u0438, \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u044c \u0440\u0430\u043d\u0434\u043e\u043c \u0432 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0435, \u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u0438\u043b\u043e \u043f\u043e\u0434\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043a\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0441 \u0440\u0430\u043d\u0434\u043e\u043c\u043e\u043c \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0433\u0440\u0430\u0445? \u0442\u0438\u043f\u043e \u0442\u0435 \u0436\u0435 \u0432\u0430\u043c\u043f\u0438\u0440\u043b\u0430\u0439\u043a\u0438 \u0433\u0434\u0435 \u0443 \u0442\u0435\u0431\u044f \u0435\u0441\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0440\u043e\u043b\u0438\u0442\u044c \u0438\u043b\u0438 \u0437\u0430\u0431\u0430\u043d\u0438\u0442\u044c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u0431\u0435 \u043d\u0435 \u043d\u0440\u0430\u0432\u044f\u0442\u0441\u044f, \u003Cbr\u003E\n\u0430 \u0447\u0442\u043e \u043a\u0441\u0442\u0430\u0442\u0438 \u043d\u0430\u043c \u0434\u0430\u043b\u0438 \u0432\u0437\u0430\u043c\u0435\u043d? \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0435\u0442\u043e\u0432 \u0430\u0440\u0442\u043e\u0432 \u0433\u0434\u0435 \u0432\u0441\u0435 \u0432\u0441\u0435\u0440\u0430\u0432\u043d\u043e \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442 \u043e\u0434\u0438\u043d \u0432\u0430\u043c\u043f\u0438\u0440\u0438\u0437\u043c? \u0421\u041a\u0423\u0423\u0423\u0427\u041d\u041e\u003Cbr\u003E\n5) \u043d\u0430\u0433\u0440\u0430\u0434\u044b\u003Cbr\u003E\n\u0440\u0430\u0437\u0440\u0430\u0431\u044b \u043e\u0431\u043e\u0436\u0433\u043b\u0438\u0441\u044c \u043e\u0431 \u0430\u0442\u0430\u043a\u0443 \u043f\u0435\u0440\u0438\u043c\u0438\u0442\u0440\u0430+\u0434\u0435\u0441\u0430\u043d\u0442+\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u0443\u0448\u043b\u0438 \u0432 \u0434\u0440\u0443\u0433\u0443\u044e \u043a\u0440\u0430\u0439\u043d\u043e\u0441\u0442\u044c, 80\u043a \u0437\u0430 30 \u043c\u0438\u043d\u0443\u0442 \u043d\u0443 \u044d\u0442\u043e \u043d\u0435 \u0441\u0435\u0440\u044c\u0451\u0437\u043d\u043e.\u003Cbr\u003E\n\u0410 2 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 \u0432\u0438\u0434\u0435 \u043f\u0440\u0438\u043a\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u043e\u0436\u0430 \u0438 \u043c\u0430\u0441\u0442 \u043c\u0430\u0433\u0430\u0437\u0430 \u043d\u0430 4 \u043f\u0443\u0448\u043a\u0438, \u043e\u043d\u043e \u043d\u0435 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0442\u0430\u043a \u043d\u0430 \u0447\u0442\u043e \u0431\u044b \u044f \u043f\u0440\u044f\u043c \u0445\u043e\u0442\u0435\u043b \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u0441\u0432\u043e\u0435 \u0432\u0435\u0440\u043c\u044f, \u043c\u0431 \u0432 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0435 \u0431\u0443\u0434\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u0435\u043d\u0435\u0433 \u0445\u043e\u0442\u044f\u0431\u044b\u003Cbr\u003E\n6) \u0440\u0435\u0439\u0442\u003Cbr\u003E\n\u0431\u0443\u0434\u0435\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u043a\u0430\u043a \u043d\u0430 \u0438\u0437\u043d\u0430\u043d\u043a\u0435 2025, \u0433\u0434\u0435 \u0431\u0443\u0434\u0435\u0442 \u0440\u0435\u0448\u0430\u0442\u044c \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u044b \u0437\u0430\u0434\u043e\u043d\u0430\u0442\u0438\u043b \u043d\u0430 \u0434\u0430\u0431\u043b\u044b + \u0435\u0441\u0442\u044c \u043b\u0438 \u0443 \u0442\u0435\u0431\u044f \u043b\u0438\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c, \u0430 \u043d\u0435 \u0443\u043c\u0435\u043d\u0438\u0435 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u043a\u043e\u043c\u043f\u043b\u044e\u043a\u0442\u0435\u0440\u043d\u044b\u0435 \u0438\u0433\u0440\u044b, \u0442\u043e\u043b\u044c\u043a\u043e \u0441 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0432\u043b\u0438\u044f\u043d\u0438\u0435\u043c \u043f\u0432\u043f.\u003Cbr\u003E\n\u0423\u0436\u0435 \u0447\u0443\u044e \u0437\u0430\u043f\u0430\u0445 \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u043c\u043e\u043d\u0435\u0442\u044b \u0434\u0430\u0431\u043b \u0440\u0435\u0439\u0442\u0430 \u043f\u043e\u043b\u0435\u0442\u044f\u0442 \u0432 \u0434\u043e\u043d\u0430\u0442 \u043d\u0430\u0431\u043e\u0440\u044b, \u043d\u0443 \u0445\u043e\u0442\u044c \u0432 \u0441\u0430\u043c \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u043d\u0435 \u0437\u0430\u0432\u0435\u0437\u043b\u0438 \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434 \u043a\u0430\u043a \u043d\u0430 \u0442\u043e\u0439 \u0436\u0435 \u0438\u0437\u0430\u043d\u043a\u0435, \u0430 \u0442\u043e \u0443 \u043c\u0435\u043d\u044f \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u0442\u0440\u0430\u0432\u043c\u0430 \u043f\u043e\u0441\u043b\u0435 \u0438\u0441\u043a\u043b \u043b\u0438\u0433\u0438\u003C\/li\u003E \u003C\/ol\u003E\n\n\u003Cp\u003E\u0438\u0437 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u043e\u0433\u0443 \u043f\u043e\u0445\u0432\u0430\u043b\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0430\u0440\u0442 \u043e\u0442\u0434\u0435\u043b \u0438 \u0441\u0430\u0443\u043d\u0434-\u0434\u0438\u0437\u043e\u0432, \u043e\u043d\u0438 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u043f\u0440\u0438\u043a\u043e\u043b\u044c\u043d\u043e\u003C\/p\u003E\n\n\u003Cp\u003E\u0438\u0442\u043e\u0433\u043e: \u043f\u043e\u0440\u0435\u0437\u0430\u043b\u0438 \u0432\u0441\u0435 \u0447\u0435\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043c\u043e\u0436\u043d\u043e, \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u043a\u0430\u043f\u043b\u044e \u043d\u043e\u0432\u043e\u0433\u043e \u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0433\u043e \u0438 \u0432\u0441\u0435, \u0438\u0432\u0435\u043d\u0442 \u043d\u0430 4\/10\u003Cbr\u003E\n\u003Cspan class=\u0022spoiler\u0022 onclick=\u0022removeAttribute(\u0027class\u0027)\u0022\u003E\u043c\u043d\u0435\u043d\u0438\u0435 \u0430\u0432\u0442\u043e\u0440\u0430 \u043d\u0435 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432\u0435\u0434\u044c \u0443 \u043d\u0435\u0433\u043e \u043d\u0435\u0442 \u0445\u043e\u0442\u044f \u0431\u044b \u0410 \u0442\u0438\u0440 \u043a\u0443\u0431\u043a\u0430, \u0438 \u043e\u043d \u0432\u043e\u043e\u0431\u0448\u0435 \u0444\u0440\u0438\u043a\u003C\/span\u003E\u003C\/p\u003E","renderFailed":false,