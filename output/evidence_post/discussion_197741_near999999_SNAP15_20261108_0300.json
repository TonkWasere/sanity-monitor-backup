\u0432, \u0438\u0445 \u0446\u0435\u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0442\u043e\u0438\u0442 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435. \u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u043f\u043e\u0441\u044b\u043b \u0431\u044b\u043b, \u0447\u0442\u043e \u043d\u043e\u0432\u0438\u0447\u043a\u0438 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u044f\u0449\u0438\u043a\u0438 \u0438 \u0440\u0430\u043d\u043e \u0437\u0430\u0445\u043e\u0434\u044f\u0442 \u043d\u0430 \u043c\u0430\u0441\u0442\u0435\u0440\u043a\u0438, \u043d\u043e \u0435\u0441\u0442\u044c \u043e\u043d\u043e \u041d\u041e.\u003Cbr\u003E\n\u0420\u0430\u043d\u044c\u0448\u0435 \u044f\u0449\u0438\u043a\u0438 \u0431\u044b\u043b\u0438 \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c 40-80\u043a \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0438 \u0433\u043e\u0434\u0430, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0432\u0435\u0449\u0435\u0439, \u0430 \u043d\u0430 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0438 1 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0439 \u0432\u0435\u0449\u0438 \u0443\u0445\u043e\u0434\u0438\u043b\u043e \u043e\u0442 500 \u0448\u0442\u0443\u043a, \u0442\u043e-\u0435\u0441\u0442\u044c 20-40\u043a\u043a \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e, \u0447\u0442\u043e \u0434\u043b\u044f \u043d\u043e\u0432\u0438\u0447\u043a\u0430 \u0431\u0435\u0437 \u0432\u043b\u0438\u0432\u0430\u043d\u0438\u044f \u0431\u044b\u043b\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.\u003Cbr\u003E\n\u041d\u043e \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043e\u0442\u043a\u0440\u043e\u0435\u043c \u0430\u0443\u043a\u0446\u0438\u043e\u043d \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u0446\u0435\u043d\u0443 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0438\u0445 \u0432\u0435\u0449\u0435\u0439, \u0442\u043e\u043b\u044c\u043a\u043e \u0443\u0436\u0435 \u0438\u0437 \u201c\u043f\u043b\u0430\u0442\u043d\u044b\u0445\u201d \u044f\u0449\u0438\u043a\u043e\u0432(\u0434\u0430\u0434\u0430, \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0435, \u0432\u0435\u0434\u044c \u0432\u0430\u043b\u044e\u0442\u0430 \u043a\u0430\u0447\u0430\u0435\u0442\u0441\u044f \u0437\u0430 \u0441\u0435\u0437\u043e\u043d. \u0412 \u043e\u0431\u0449\u0435\u043c \u0441\u043a\u0430\u0437\u043a\u0430 \u0434\u043b\u044f \u043c\u0430\u043c\u043e\u043d\u0442\u043e\u0432):\u003Cbr\u003E\nFN SCAR-H 3.1\u043a\u043a\u003Cbr\u003E\nHK417         3.2\u043a\u043a\u003Cbr\u003E\n\u041a\u0417-4            4.9\u043a\u043a\u003Cbr\u003E\n\u0418\u0442\u043e\u0433\u043e 8\u043a\u043a \u0437\u0430 \u043f\u043e\u043b\u043d\u043e\u0435 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u043d\u0433\u0430(24+23=\u0443\u0436\u0435 \u043c\u0430\u0441\u0442\u0435\u0440\u043a\u0438), \u0447\u0442\u043e \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u043d\u0438\u0436\u0435, \u0447\u0435\u043c \u0440\u0430\u043d\u044c\u0448\u0435, \u0442\u043e-\u0435\u0441\u0442\u044c \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435\u0435. \u0414\u0430, \u0442\u0443\u0442 \u043d\u0435 \u043f\u0430\u0434\u0430\u044e\u0442 \u0442\u043e\u0447\u043a\u0438 \u0438 \u043f\u0440\u043e\u0447\u0438\u0435 \u0432\u0435\u0449\u0438, \u043d\u043e \u043f\u043e\u0441\u044b\u043b \u0431\u044b\u043b \u201c\u0417\u0430\u0449\u0438\u0442\u0438\u043c \u0434\u0435\u0442\u0435\u0439\u201d.\u003Cbr\u003E\n\u041a\u0430\u043a\u043e\u0435 \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u0437\u0430 \u043f\u043b\u0430\u0442\u043d\u044b\u0435 \u044f\u0449\u0438\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435\u0435, \u0447\u0435\u043c \u0437\u0430 \u0438\u0433\u0440\u0443 \u0432 \u0438\u0433\u0440\u0443.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u0430\u043a \u044d\u0442\u043e \u043e\u0442\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0435 \u0438 \u0438\u0433\u0440\u0435 \u0432 \u0446\u0435\u043b\u043e\u043c(\u043c\u043e\u0451 \u0432\u0438\u0434\u0435\u043d\u044c\u0435):\u003Cbr\u003E\n\u042f\u0449\u0438\u043a\u0438 \u0441\u0442\u043e\u044f\u0442 \u043a\u043e\u043f\u0435\u0439\u043a\u0438 \u0438 \u043d\u0435 \u0440\u0430\u0441\u0442\u0443\u0442-\u0026gt;\u0434\u0435\u043d\u044c\u0433\u0438 \u043d\u0435 \u0432\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f-\u0026gt;\u043b\u044e\u0434\u0438 \u043c\u0435\u043d\u044c\u0448\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u0432 \u0438\u0433\u0440\u0443, \u0442\u0430\u043a \u043a\u0430\u043a \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u043d\u0438\u0449\u0438\u0435.\u003Cbr\u003E\n\u042f\u0432\u043d\u044b\u0439 \u0444\u0430\u043a\u0442, \u0447\u0442\u043e \u0437\u0430 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u0440\u0443\u0431\u043b\u0438 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0432\u044b\u0433\u043e\u0434\u043d\u0435\u0435 \u0438 \u0431\u044b\u0441\u0442\u0440\u0435\u0435.\u003Cbr\u003E\n\u0410\u0440\u0435\u043d\u0430 (\u043d\u0435 \u043f\u043e\u043c\u043d\u044e \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435), \u0447\u0442\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u0434\u0451\u0442 \u044f\u0432\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u043b\u0430, \u0447\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e\u0435 \u0438\u0433\u0440\u0430\u0442\u044c \u04