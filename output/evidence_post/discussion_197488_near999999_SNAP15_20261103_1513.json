1 \u0430\u0439\u0442\u0435\u043c\u0430, \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0443 \u043d\u0430 \u043d\u0435 \u043b\u0438\u043a\u0432\u0438\u0434 \u0448\u043c\u043e\u0442, \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u0432\u0441\u0435 \u044d\u0442\u043e \u0434\u0435\u043b\u043e \u0437\u0430\u043f\u0435\u0440\u0441\u0438\u0442\u044c. \u041d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u0442\u0430\u043a \u0436\u0435 \u043e \u0442\u043e\u043c \u0447\u0442\u043e \u0434\u0435\u043d\u044c\u0433\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0434\u0435\u043b\u0430\u0442\u044c\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043e\u043f\u0435\u043d\u0435, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0437\u0430 \u043f\u043e\u043b \u0447\u0430\u0441\u0430 \u043a\u0430\u0442\u043a\u0438 \u0434\u0430\u0435\u043c 100\u043a \u043d\u0430\u0433\u0440\u0430\u0434\u044b. (\u0427\u0435\u0440\u043d\u044b\u0439 \u0440\u0435\u0439\u0434, \u0430\u0442\u0430\u043a\u0430 \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0430 \u0438 \u043c\u043e\u0440\u043e\u0437\u043d\u044b\u0439 \u0434\u0435\u0441\u0430\u043d\u0442 \u0434\u0435\u043b\u0430\u043b\u0438 \u0434\u043e \u0440\u0435\u0430\u0431\u0438\u043b\u0438\u0442\u0430\u0446\u0438\u0438\/\u0440\u0435\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0442\u0430\u043a \u0447\u0442\u043e \u043f\u0440\u043e \u043d\u0438\u0445 \u0437\u0430\u0431\u0443\u0434\u0435\u043c) \u003Cbr\u003E\n\u041d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0430\u0437 \u0432\u044b\u043f\u0443\u043a\u0430\u0442\u044c \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u003Cbr\u003E\n\u0413\u043e\u0442\u043e\u0432 ! \u0420\u0430\u0434\u043e\u0441\u0442\u043d\u043e \u0434\u0440\u043e\u043f\u0430\u0435\u043c ! \u003Cbr\u003E\n\u0418\u0433\u0440\u043e\u043a\u0438 \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u044c\u043d\u044b \u043d\u0430\u0433\u0440\u0430\u0434\u0430\u043c\u0438,\u041d\u0415 \u041f\u041e\u041d\u042f\u0422\u041d\u041e\u003Cbr\u003E\n\u0418\u0433\u0440\u043e\u043a\u0430\u043c \u043d\u0435 \u043d\u0440\u0430\u0432\u044f\u0442\u0441\u044f \u0437\u0430\u0442\u044f\u043d\u0443\u0442\u044b\u0435 \u043f\u043e\u043b\u0443 \u0430\u0444\u043a \u043a\u0430\u0442\u043a\u0438, \u041d\u0415 \u041f\u041e\u041d\u042f\u0422\u041d\u041e\u003Cbr\u003E\n\u0418\u0433\u0440\u043e\u043a\u0430\u043c \u043d\u0435 \u043d\u0440\u0430\u0432\u044f\u0442\u0441\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430 \u0440\u0435\u0439\u0442, \u0442\u043e\u043f\u0435\u0440\u044b \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e\u0442 \u0440\u0430\u0434\u0438 \u0447\u0435\u0433\u043e \u043f\u043e\u0442\u0435\u0442\u044c, \u0412 \u0421\u041c\u042b\u0421\u041b\u0415, \u041a\u041e\u041b\u041e\u041a\u041e\u041b\u042c\u0427\u0418\u041a, \u0414\u0412\u0410 \u042f\u0429\u0418\u041a\u0410, \u041e\u0414\u0418\u041d \u041d\u0415 \u041f\u0415\u0420\u0421. \u003Cbr\u003E\n\u041d\u0415 \u041f\u041e\u041d\u042f\u0422\u041d\u041e. \u003Cbr\u003E\n\u0414\u0435\u043b\u0430\u0435\u043c \u0441\u0442\u0440\u0438\u043c \u0441\u043d\u0430\u0439\u043f, \u0440\u0430\u0437\u0434\u0430\u0435\u043c \u0434\u043e\u043d\u0430\u0442 \u0432\u0430\u043b\u044e\u0442\u0443. \u041e\u043d\u043b\u0430\u0439\u043d \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u043d\u0430 \u0432\u0440\u0435\u043c\u044f \u0441\u0442\u0440\u0438\u043c\u0430, \u0438\u0433\u0440\u043e\u043a\u0438 \u0437\u0430\u0445\u043e\u0434\u044f\u0442 \u0447\u0438\u0441\u0442\u043e \u043d\u0430\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u043c\u043e\u0440\u0434\u0443 \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u043c \u0437\u0430 \u0438\u0445 \u0434\u0435\u0442\u0438\u0449\u0435 \u0432 \u0432\u0432\u0438\u0434\u0435 \u0438\u0432\u0435\u043d\u0442\u0430, \u0448\u043a\u0443\u0440\u043d\u0443\u0442\u0441\u044f \u0437\u0430 1500 \u0441\u0442\u0430\u043b\u0431\u0430\u043a\u0441\u043e\u0432. \u0421\u0442\u0440\u0438\u043c \u043e\u0444\u0444\u043d\u0443\u043b\u0438 \u043e\u043d\u043b\u0430\u0439\u043d \u0443\u043f\u0430\u043b \u041d\u0415 \u041f\u041e\u041d\u042f\u0422\u041d\u041e\u003Cbr\u003E\n\u0422\u0430\u043a \u0447\u0435\u0442 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u0430 \u0442\u043e\u0447\u043d\u043e, \u0437\u0430\u0431\u044b\u043b\u0438 \u0437\u0430\u043a\u0438\u043d\u0443\u0442\u044c \u0431\u0430\u0431\u043e\u043a \u043d\u0430 \u0440\u0435\u043a\u043b\u0430\u043c\u0443, \u043f\u0443\u043a \u043f\u0443\u043a \u0441\u0440\u0435\u043d\u0431\u043a, \u0433\u043e\u0442\u043e\u0432\u043e. \u0410 \u0441\u0442\u043e\u043f, \u043d\u0430\u0434\u043e \u043f\u043e\u0445\u0432\u0430\u043b\u0438\u0442\u044c \u0432 \u0434\u0435\u0441\u044f\u0442\u044b\u0439 \u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u0438\u0432\u0435\u043d\u0442. \u041f\u043e\u0435\u0445\u0430\u043b\u0438 !\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-11-03\/1793717895-673965-c3a18a8f-b549-4fe8-9630-7f02325c230e.png\u0022 title=\u0022c3a18a8f-b549-4fe8-9630-7f02325c230e.png\u0022 alt=\u0022\u0022 data-id=\u0022218d71cf-2e69-43bf-9d94-ba6c775e9151\u0022 loading=\u0022lazy\u0022 width=\u0022553\u0022 height=\u0022393\u0022\u003E\u003C\/p\u003E\n","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":3,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":1,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"197