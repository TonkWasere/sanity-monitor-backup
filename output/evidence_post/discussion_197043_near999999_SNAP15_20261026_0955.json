\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197043-a-vot-stalzone-umiraet\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224728039\u0022\u003E\u0412\u044b\u0441\u0435\u0440\u003C\/a\u003E \u041d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0445\u043e\u0440\u0440\u043e\u0440\u0430\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0443 \u0445\u0437, \u0449\u0430 \u0441\u0435\u0437\u043e\u043d \u0442\u0443\u043b\u044c\u043f\u0430 \u0438 \u043c\u0431 \u043c\u0435\u0441\u044f\u0446 \u043d\u0430\u0437\u0430\u0434 \u043f\u043e\u0441\u043b\u0435 \u043e\u0431\u043d\u043e\u0432\u044b \u0432 \u043d\u0435\u0431\u0435 \u043b\u0435\u0442\u0430\u043b\u0438 \u0441\u043a\u0430\u0442\u044b, \u0430 \u043d\u0430 \u0431\u0430\u0437\u0430\u0445 \u0441\u0442\u043e\u044f\u043b\u0438 \u0442\u0430\u043d\u043a\u0438 \u0438 \u0441\u0430\u043c\u043e\u043b\u0451\u0442\u044b. \u0412\u043f\u043e\u043b\u043d\u0435 \u0441\u0435\u0431\u0435 \u0445\u043e\u0440\u0440\u043e\u0440.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197043-a-vot-stalzone-umiraet\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224728039\u0022\u003E\u0412\u044b\u0441\u0435\u0440\u003C\/a\u003E \u041d\u0438 \u043e\u0434\u043d\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0435 \u0437\u0430\u0442\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u043b\u043a\u0435\u0440\u0441\u043a\u0443\u044e \u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0443\u0436\u0435 \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041c\u044b \u043d\u0435 \u0441\u0442\u0430\u043b\u043a\u0435\u0440. \u0418 \u043d\u0435 \u043c\u0430\u0439\u043d\u043a\u0440\u0430\u0444\u0442.\u003C\/p\u003E \n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197043-a-vot-stalzone-umiraet\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224728039\u0022\u003E\u0412\u044b\u0441\u0435\u0440\u003C\/a\u003E \u0434\u043e\u0431\u0440\u043e\u0442\u043d\u044b\u0435 \u043a\u0432\u0435\u0441\u0442\u044b \u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f, \u0445\u043e\u0442\u044f \u0431\u044b \u0440\u0430\u0437 \u0432 \u0433\u043e\u0434.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041e\u043d\u0438 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0442\u0430\u043a \u0438 \u0434\u0435\u043b\u0430\u044e\u0442, \u043f\u0440\u043e\u0441\u0442\u043e \u044d\u0442\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435. \u0412\u043e\u043d \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0436\u0435 \u0434\u0435\u0439\u043b\u0438\u043a\u0438 2.0 (\u043d\u0430 \u0434\u0440 \u0441\u043a \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u044b). \u041a\u0430\u043a \u043f\u043e \u043c\u043d\u0435 \u0442\u0430\u043a \u043d\u043e\u0440\u043c \u043e\u0431\u043d\u043e\u0432\u0430 \u043d\u0430 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0443\u044e \u043e\u0441\u043d\u043e\u0432\u0443, \u043d\u043e \u0440\u0430\u0437\u0440\u0430\u0431 \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u0438\u043d\u0430\u0447\u0435\u003C\/p\u003E \n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197043-a-vot-stalzone-umiraet\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224728039\u0022\u003E\u0412\u044b\u0441\u0435\u0440\u003C\/a\u003E \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0431\u044b \u0437\u0438\u0432 \u0442\u0430\u043c \u043d\u0435 \u043f\u0438\u0437\u0434\u0435\u043b, \u043e\u043d\u0438 \u0434\u0435\u043b\u0430\u044e\u0442 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e \u0431\u0438\u0437\u043d\u0435\u0441, \u0430 \u043d\u0435 \u0438\u0433\u0440\u0443.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u043b\u043e\u0432\u0430 \u201c\u043c\u044b \u0434\u0435\u043b\u0430\u0435\u043c \u0438\u0433\u0440\u0443\u201d \u043f\u0440\u043e\u0434\u0430\u044e\u0442\u0441\u044f \u043b\u0443\u0447\u0448\u0435 \u0447\u0435\u043c \u201c\u043c\u044b \u0434\u0435\u043b\u0430\u0435\u043c \u0431\u0438\u0437\u043d\u0435\u0441\u201d. \u0410 \u0441\u0443\u0442\u044c \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0433\u043e \u0431\u0438\u0437\u043d\u0435\u0441\u0430 \u0438\u043c\u0435\u043d\u043d\u043e \u0447\u0442\u043e \u0432 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u043c \u0432\u044b\u0441\u043e\u043a\u043e\u043c \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0435. \u0418\u0433\u0440\u0443 \u043c\u043e\u0436\u043d\u043e \u0441\u0440\u0430\u0442\u044c \u0434\u043e\u043b\u0433\u043e \u0438 \u0441 \u0440\u0430\u0437\u043d\u044b\u0445 \u0441\u0442\u043e\u0440\u043e\u043d, \u043d\u043e, \u043a\u0430\u043a \u0431\u0438\u0437\u043d\u0435\u0441, \u201c\u0421\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442\u201d \u2013 \u043f\u0440\u043e\u0435\u043a\u0442 \u0443\u0441\u043f\u0435\u0448\u043d\u044b\u0439.\u003C\/p\u003E ","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"disc