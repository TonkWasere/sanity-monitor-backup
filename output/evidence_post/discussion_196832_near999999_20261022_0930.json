kquote\u003E\n\n\u003Cp\u003E\u0425\u0432\u0430\u0442\u0438\u0442 \u043d\u043e \u043d\u0430 \u043e\u043a\u043e\u043b\u043e \u0441\u0442\u043e\u043a\u043e\u0432\u044b\u0445 \u0447\u0430\u0441\u0442\u043e\u0442\u0430\u0445 \u043f\u043e\u0434 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u043e\u0439(\u043b\u0438\u0431\u043e \u0442\u0432\u043e\u0439 \u043a\u043e\u043c\u043f \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u0441\u044f \u0432 \u0441\u0430\u043c\u043e\u043b\u0435\u0442) \u0442\u043a 130 \u0432\u0430\u0442\u0442 \u043f\u043e\u0434 \u0444\u0443\u043b\u043b \u0440\u0430\u0437\u0433\u043e\u043d \u0431\u0443\u0434\u0435\u0442 \u043c\u0430\u043b\u043e\u0432\u0430\u0442\u043e \u043d\u0430\u0434\u043e \u0445\u043e\u0442\u044f\u0431 180 \u0432\u0430\u0442\u0442 \u0447\u0442\u043e\u0431 \u043d\u0435 \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044c \u043f\u043e\u0442\u043e\u043c\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196832-pamagite-pk\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224720894\u0022\u003Ekukuha_edet\u003C\/a\u003E 6500 \u0445\u0442 \u043d\u0430 8 \u0433\u0438\u0433\u043e\u0432\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0412 \u0441\u043a, \u0434\u0430 \u0438 \u044b \u0446\u0435\u043b\u043e\u0432 \u0432 \u0438\u0433\u0440\u0430\u0445 \u0442\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0442 \u0441\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u044f, \u0442\u043a \u043e\u043d\u043e \u043e\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043e\u0431\u043c\u0435\u043d\u0430 \u0441\u0438\u043b\u044c\u043d\u043e \u0437\u0430\u0432\u0438\u0441\u0438\u0442\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\