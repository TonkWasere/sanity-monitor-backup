\u0430\u0435\u0448\u044c. \u0418 \u044f \u043d\u0435 \u0437\u043d\u0430\u044e. \u041d\u043e \u044f \u0434\u0430\u0436\u0435 \u043d\u0435 \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043b: \u0441 \u0447\u0438\u0442\u0430\u043c\u0438 \u043d\u0435 \u0438\u0433\u0440\u0430\u043b, \u043f\u043e\u0434\u0443\u043c\u0430\u043b - \u0445\u0443\u0439\u043d\u044f \u043a\u0430\u043a\u0430\u044f-\u0442\u043e, \u0437\u0430\u0431\u0438\u043b \u0445\u0440\u0435\u043d. \u0410 \u043f\u0440\u043e\u0436\u0438\u043b \u044d\u0442\u043e\u0442 \u0431\u0430\u043d \u0432\u0441\u0435\u0433\u043e \u043f\u043e\u043b\u0434\u043d\u044f - \u043f\u043e\u0442\u043e\u043c \u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043d\u044f\u043b\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0447\u0438\u0442\u043e\u0432 \u0443 \u043c\u0435\u043d\u044f \u043d\u0435 \u0431\u044b\u043b\u043e. \u0412\u043e\u0442 \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u043e\u0433\u0434\u0430 \u0438\u0433\u0440\u043e\u043a \u0447\u0438\u0441\u0442.\u003C\/p\u003E \n\n\u003Cp\u003E\u0410 \u0442\u0435\u0431\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0438 \u0432 \u0422\u041f, \u0447\u0442\u043e \u0431\u0430\u043d \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u044b\u0439, \u0441\u0430\u043c \u041a\u043e\u0442\u043b\u0435\u0440 \u043f\u0440\u0438\u0448\u0435\u043b \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0437\u0430\u0431\u0430\u043d\u0435\u043d \u0437\u0430 \u041f\u041e, \u043d\u043e \u0442\u044b \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0448\u044c \u0434\u0435\u043b\u0430\u0442\u044c \u0438\u0437 \u0441\u0435\u0431\u044f \u043f\u0430\u0439 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u0430.\u003C\/p\u003E  ","renderFailed":false,"mentionedByCount":0,"canEdit":false,"canDelete":false,"canHide":false,"canFlag":false,"isApproved":true,"canApprove":false