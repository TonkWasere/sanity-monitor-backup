gel\u003C\/a\u003E \u0410 \u0442\u0430\u043a, \u0432\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0439 \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u0434\u043b\u044f \u0442\u0435\u0441\u0442\u043e\u0432 \u043d\u0430 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 - \u0441\u0443\u0442\u043a\u0438, \u0438 \u0434\u0435\u043b\u0430\u0435\u0442\u0441\u044f \u044d\u0442\u043e \u043e\u0442\u043d\u044e\u0434\u044c \u043d\u0435 \u0432 \u043c\u0435\u043c\u0442\u0435\u0441\u0442\u0435\/occt \u043f\u043e \u0443\u043a\u0430\u0437\u043a\u0435 \u0447\u0430\u0442\u0430 \u0436\u0431\u0442\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0422\u044b \u0447\u0435 \u043d\u0435\u0441\u0435\u0448\u044c \u043d\u0430\u0445\u0443\u0439 \u0432\u043e\u043e\u0431\u0449\u0435, \u0441\u0435\u0431\u044f \u0442\u043e \u0441\u043b\u044b\u0448\u0438\u0448\u044c \u043d\u0435\u0442? \u201c\u0412\u043c\u0435\u043d\u044f\u0435\u043c\u044b\u0439\u201d \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u044d\u0442\u043e 1.5 \u0447\u0430\u0441\u0430 \u043f\u043e \u0441\u043e\u0432\u0435\u0442\u0430\u043c \u043e\u0442 \u0441\u0442\u0430\u0440\u044b\u0445 \u043f\u0435\u0440\u0434\u0443\u043d\u043e\u0432. \u0413\u043e\u0432\u043e\u0440\u044e \u043d\u0430 \u043e\u043f\u044b\u0442\u0435 5 \u043b\u0435\u0442 \u0442\u0430\u043a\u0438\u0445 \u0440\u0430\u0437\u0433\u043e\u043d\u043e\u0432, \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0442\u0440\u0435\u0445 \u043c\u0438\u043d\u0443\u0442, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c \u043f\u0435\u0440\u0432\u0438\u0447\u043d\u0443\u044e \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0442\u044b \u043f\u043e\u0439\u043c\u0435\u0448\u044c \u0443\u0436\u0435 \u0432 \u0438\u0433\u0440\u0435, \u043d\u0443 \u0442\u043e \u0435\u0441\u0442\u044c \u0442\u0435 \u0441\u0430\u043c\u044b\u0435 \u0442\u0432\u043e\u0438 \u201c\u0441\u0443\u0442\u043a\u0438\u201d \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u043b\u0438 \u0442\u044b \u043d\u0435 \u0434\u043e\u043b\u0431\u0430\u0451\u0431. \u0414\u0435\u043b\u043e \u0435\u0449\u0435 \u0432\u043e\u0442 \u0432 \u0447\u0435\u043c, \u0447\u0438\u043f\u044b \u0442\u0438\u043f\u0430 \u0441-die \u0441\u0430\u043c\u0441\u044b \u043d\u0435 \u0431\u0435\u0440\u0443\u0442 \u0432\u044b\u0448\u0435 3200, \u043d\u043e \u043e\u0448\u0438\u0431\u043a\u0443 \u0442\u0435\u0431\u0435 \u043d\u0438 \u043e\u0434\u0438\u043d \u0442\u0435\u0441\u0442 \u043c\u0435\u043c \u043d\u0435 \u0434\u0430\u0441\u0442 \u0435\u0441\u043b\u0438 \u0442\u044b \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0448\u044c 3600, \u0443 \u0442\u0435\u0431\u044f \u0438 \u043a\u043e\u043c\u043f \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0441\u044f \u0438 \u0432\u0441\u0451 \u043e\u043a. \u0422\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u0442 \u0438\u0433\u0440\u044b \u0431\u0443\u0434\u0443\u0442 \u043a\u0440\u0430\u0448\u0438\u0442\u044c\u0441\u044f \u0438\u0437-\u0437\u0430 \u0445\u0443\u0439 \u043f\u043e\u0439\u043c\u0438 \u0447\u0435\u0433\u043e \u0438 \u0441\u0442\u0430\u0442\u0442\u0435\u0440\u0438\u0442\u044c \u043f\u043e \u043a\u0434.\u003C\/p\u003E\n\n\u003Cp\u003E\u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u043a\u043e\u0433\u0434\u0430 \u043d\u0443\u0436\u043d\u043e \u0442\u0435\u0441\u0442\u0438\u0442\u044c \u043f\u043e \u0447\u0430\u0441\u0443 \u044d\u0442\u043e \u043a\u043e\u0433\u0434\u0430 \u0436\u0435\u043b\u0435\u0437\u043e \u043d\u0435 \u0442\u0432\u043e\u0435 \u0438 \u0442\u044b \u043d\u0435 \u0437\u043d\u0430\u0435\u0448\u044c \u0432\u0438\u043d\u043e\u0432\u0430\u0442\u0430 \u043b\u0438 \u043f\u0430\u043c\u044f\u0442\u044c \u0442\u043e\u0447\u043d\u043e, \u043d\u043e \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c \u0432\u0438\u043d\u043e\u0432\u0430\u0442\u043e \u0447\u0442\u043e-\u0442\u043e \u0438\u043b\u0438 \u043d\u0435\u0442 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c \u0441\u043f\u0435\u043a \u0441\u0430\u043c\u043e\u0439 \u043f\u0430\u043c\u044f\u0442\u0438 \u0438 \u043c\u043e\u0436\u0435\u0442 \u043b\u0438 \u043e\u043d\u0430 \u0432\u043e\u043e\u0431\u0449\u0435 \u0431\u0440\u0430\u0442\u044c \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0443\u044e \u0447\u0430\u0441\u0442\u043e\u0442\u0443. \u041c\u043d\u0435 \u0432 \u0445\u0443\u0439 \u043d\u0435 \u0443\u043f\u0435\u0440\u043b\u043e\u0441\u044c \u0442\u0435\u0441\u0442\u0438\u0442\u044c c-die \u0412\u041e\u041e\u0411\u0429\u0415, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c \u0442\u043e \u0447\u0442\u043e \u043e\u043d\u0430 \u043d\u0435 \u0431\u0435\u0440\u0435\u0442 3600 \u0431\u0442\u0432, \u043e \u043a\u0430\u043a\u0438\u0445 \u0435\u0449\u0435 \u0441\u0443\u0442\u043a\u0430\u0445 \u0442\u043e\u0433\u0434\u0430 \u0440\u0435\u0447\u044c.\u003C\/p\u003E","renderFailed":false,"editedAt":"2026-10-25T12:09:59+00:00","canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":1,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":1,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196987"}},"user":{"data":{"type":"users","id":"1464470"}},"editedUser":{"data":{"type":"users","id":"1464470"}},"mentionedBy":{"data":[{"type":"posts","id":"4726391"}]},"likes":{"data":