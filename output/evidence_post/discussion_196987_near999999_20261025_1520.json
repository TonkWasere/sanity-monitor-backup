5\u0449\u0435 \u0441\u0443\u0442\u043a\u0430\u0445 \u0442\u043e\u0433\u0434\u0430 \u0440\u0435\u0447\u044c.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041f\u043e\u043c\u043d\u044e \u043b\u0438\u0448\u044c \u043e\u0434\u0438\u043d \u0441\u043b\u0443\u0447\u0430\u0439 \u043a\u043e\u0433\u0434\u0430 \u0440\u0430\u0437\u0433\u043e\u043d \u0431\u044b\u043b \u043d\u0435\u0441\u0442\u0430\u0431\u0438\u043b\u0435\u043d \u0438 \u0447\u0435\u0440\u0435\u0437 \u043f\u043e\u043b\u0447\u0430\u0441\u0430 \u0442\u0435\u0441\u0442\u0430 \u0432\u044b\u043b\u0435\u0437\u043b\u043e \u043f\u0430\u0440\u0443 \u043e\u0448\u0438\u0431\u043e\u043a, \u043d\u043e \u0438 \u0442\u043e \u044f \u0442\u043e\u0433\u0434\u0430 \u0442\u0435\u0441\u0442 \u0435\u0431\u0430\u043d\u0443\u043b \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e \u043a\u0430\u043a \u0443 \u043c\u0435\u043d\u044f \u0438\u0433\u0440\u0430 \u0432\u044b\u043b\u0435\u0442\u0430\u0442\u044c \u043d\u0430\u0447\u0430\u043b\u0430 \u0432 \u043e\u0447. \u043d\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0445 \u0441\u0446\u0435\u043d\u0430\u0445. \u0422\u0430\u043a \u0447\u0442\u043e \u0438\u0433\u0440\u044b \u0441\u0430\u043c\u044b\u0439 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u0439 \u043e\u0440\u0438\u0435\u043d\u0442\u0438\u0440, \u0435\u0441\u043b\u0438 \u0432\u044b\u043b\u0435\u0442\u043e\u0432 \u043d\u0435\u0442, \u0444\u0440\u0435\u0439\u043c\u0442\u0430\u0439\u043c \u0440\u043e\u0432\u043d\u044b\u0439 = \u043c\u043e\u0436\u043d\u043e \u0441\u0443\u0434\u0438\u0442\u044c, \u0447\u0442\u043e \u043f\u0430\u043c\u044f\u0442\u044c \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u0430\u044f.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196987-po-povodu-x3d-protsessorov\/21\u0022 class=\u0022PostMention\u0022 data-id=\u00224726342\u0022\u003ENotANigel\u003C\/a\u003E \u0438 \u04