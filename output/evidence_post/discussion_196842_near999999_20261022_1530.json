8 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435, \u043d\u043e \u043f\u043e \u0444\u0430\u043a\u0442\u0443 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0434\u0430 \u044f \u043f\u0440\u043e \u0442\u043e, \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0443 \u0438\u0433\u0440\u043e\u043a\u0430 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u043f\u043e\u0431\u0435\u0433\u0430\u0442\u044c \u0441 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0435\u0439 g36, \u0442\u043e \u0435\u0433\u043e \u0438 \u0432 \u0442\u0435\u043a\u0443\u0449\u0438\u0445 \u0440\u0435\u0430\u043b\u0438\u044f\u0445 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442, \u0432 \u0438\u0433\u0440\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u0430\u0436 2(3) \u0433\u0430\u043d\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0434\u0443\u0445\u043e\u0432\u043d\u044b\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0438\u043a\u043e\u043c \u044d\u0442\u043e\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u043e g36 \u0438 \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0438\u043c\u0435\u044e\u0442 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u0442\u0438\u0440 \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u0432\u0430\u0448\u0435\u0433\u043e \u0433\u0435\u0439\u043c\u0434\u0438\u0437\u0430\u0439\u043d\u0430. \u0423 \u043e\u0434\u043d\u043e\u0433\u043e (\u0434\u0432\u0443\u0445) \u0438\u0437 \u043d\u0438\u0445 \u0434\u0430\u0436\u0435 \u0448\u0430\u0431\u043b\u043e\u043d \u0438\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u044b\u0439 \u044d\u0442\u043e\u043c\u0443 \u0441\u0430\u043c\