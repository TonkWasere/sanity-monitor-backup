40\u043c \u0437\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c \u043f\u0430\u0440\u044b \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u0432.\u003Cbr\u003E\n1) \u0414\u0430\u0439\u0442\u0435 \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a\u0443 \u0441\u0432\u0430\u043f \u043f\u0430\u0442\u0440\u043e\u043d\u043e\u0432 \u0443\u043c\u043e\u043b\u044f\u044e, \u0434\u0430\u0439\u0442\u0435 \u043e\u0431\u044b\u0447\u043d\u0443\u044e \u0434\u0440\u043e\u0431\u044c \u043d\u0443 \u044f \u0445\u0437, \u043f\u043e\u0434 \u043c\u043e\u0439 \u043f\u0438\u0432\u043d\u043e\u0439 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439 \u0433\u0434\u0435 \u044f \u0431\u0435\u0433\u0430\u044e \u043f\u043e\u0434 \u043f\u0438\u0432\u043e \u0441 \u043c\u0443\u0437\u044b\u043a\u043e\u0439 \u043e\u0442 \u0431\u0435\u0434\u0440\u0430 \u043d\u0435 \u043b\u0435\u0442\u0438\u0442\ud83d\ude21.\u003Cbr\u003E\n2) \u0415\u0431\u0430\u043d\u044b\u0439 \u0441\u043d\u043e\u0440\u043a, \u043d\u0443 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0438\u0437\u0434\u0430, \u0435\u043b\u0438 \u043d\u0435 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0441\u044f \u0441 \u0442\u0438\u043c\u0435\u0439\u0442\u0430\u043c\u0438 \u043a\u0430\u043a \u0438 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c, \u0430 \u0432 \u044d\u0442\u043e\u0439 \u0438\u0433\u0440\u0435 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044c \u0441 \u0438\u0433\u0440\u043e\u043a\u0430\u043c\u0438 \u043f\u0430\u0433\u0443\u0431\u043d\u043e \u0434\u043b\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f, \u0432 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0435 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u0432\u044b \u0435\u0433\u043e \u043d\u0435 \u0443\u0431\u044c\u0435\u0442\u0435, \u0432\u0435\u0434\u044c \u043e\u043d \u043f\u0438\u0437\u0434\u0435\u0446 \u0437\u0434\u043e\u0440\u043e\u0432\u0430\u044f \u0433\u0443\u0431\u043a\u0430, \u0430 \u0435\u0433\u043e \u043f\u043e\u043d\u043e\u0441 \u044d\u0442\u043e \u043f\u0440\u0438\u043a\u043e\u043b, \u043d\u043e \u044d\u0442\u043e \u0434\u0435\u043b\u043e \u043e\u043f\u044b\u0442\u0430 \u043c\u0431, \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0434\u0438\u0444 \u0441\u0440\u0435\u0434\u0438 \u0431\u043e\u0441\u0441\u043e\u0432. \u003Cbr\u003E\n3) \u0420\u0430\u043d\u0434\u043e\u043c, \u0442\u0443\u0442 \u044f \u0447\u0435\u0441\u0442\u043d\u043e \u0445\u0443\u0439 \u0437\u043d\u0430\u0435\u0442, \u043d\u043e \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u044f \u0440\u0435\u0448\u0438\u043b \u0432\u0442\u043e\u043f\u0438\u044c\u0441\u044f \u0432 \u043f\u043f\u0448\u043a\u0443, \u044f \u0441\u043e\u0431\u0440\u0430\u043b 3 \u0437\u0435\u043b\u0451\u043d\u044b\u0445 \u0438 3 \u0441\u0438\u043d\u0438\u0445 \u0447\u0435\u0440\u0442\u0435\u0436\u0430, \u043d\u043e \u0441\u0430\u043c\u044b\u0439 \u043e\u0431\u043e\u0441\u0441\u0430\u043d\u044b\u0439 \u0431\u0435\u043b\u044b\u0439 \u043f\u043f \u044f \u0442\u0430\u043a \u0438 \u043d\u0435 \u0443\u0432\u0438\u0434\u0435\u043b, \u043d\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c \u0430\u043f\u0435 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0433\u0434\u0435 \u043f\u0430\u0434\u0430\u0435\u0442 \u0448\u0430\u043d\u0441 \u0431\u0435\u043b\u044b\u0445 \u044f \u043f\u0441\u0438\u0445\u0430\u043d\u0443\u043b \u0438 \u043f\u043e\u0434\u0440\u044f\u0434 \u0435\u0431\u0430\u043d\u0443\u043b \u043e\u043a\u043e\u043b\u043e 20 \u0440\u0435\u0440\u043e\u043b\u043e\u0432 \u0438\u0442\u043e\u0433 \u0445\u0443\u0439 \u0432 \u0440\u043e\u0442, \u043a\u0430\u043a \u0442\u0430\u043a \u0442\u043e. \u003Cbr\u003E\n4) \u041c\u0430\u0433\u043f\u0443\u043b \u043e\u0431\u043e\u0441\u0440\u0430\u043b\u0438 \u0432\u0441\u0435\u043c \u043a\u043e\u043c\u0443 \u0431\u044b\u043b\u043e \u043d\u0435 \u043b\u0435\u043d\u044c, \u0432\u043e\u043e\u0431\u0449\u0435 \u044f \u0432 \u0430\u0445\u0443\u0435, \u043a\u0430\u043a\u0430\u044f \u0443 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0432 \u043b\u044e\u0431\u043e\u0432\u044c \u043a \u044d\u0442\u043e\u0439 \u0440\u0443\u043a\u043e\u044f\u0442\u043a\u0435, \u043e\u043d\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0440\u043e\u043b\u044f\u0442 \u044f \u0443\u0436\u0435 \u0443\u0432\u0435\u0440\u0435\u043d.\u003Cbr\u003E\n5) \u041d\u0443 \u0438 \u0441\u043c\u043e\u0442\u0440\u044f \u0441\u0431\u043e\u043a\u0443 \u043c\u043e\u0433\u0443 \u0431\u044b\u0442\u044c \u043d\u0435\u043f\u0440\u0430\u0432, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u0442\u044b\u0433\u0440\u0430\u043b \u043d\u0435 \u0434\u0430\u0445\u0443\u044f \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043d\u043e \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0440\u0435\u0438\u0433\u0440\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0432\u0441\u0435 \u0441\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u043a \u0441\u0431\u043e\u0440\u0443 \u043e\u0434\u043d\u043e\u0439 \u0438 \u0442\u043e\u0439 \u0436\u0435 \u0445\u0443\u0439\u043d\u0438 \u0438\u0437 \u0440\u0430\u0443\u043d\u0434\u0430 \u0432 \u0440\u0430\u0443\u043d\u0434, \u043a\u0430\u043a \u0438 \u0438\u0437 \u0438\u0433\u0440\u044b \u0432 \u0438\u0433\u0440\u0443. \u003Cbr\u003E\n6) \u0414\u043e\u0431\u0430\u0432\u043b\u044e \u0435\u0449\u0451 \u043f\u0440\u043e \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u044b, \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0434\u043e 10\u043e\u0433\u043e \u0440\u0430\u0443\u043d\u0434\u0430 \u043d\u0430\u043c \u0432\u044b\u043f\u0430\u043b\u0438 \u0431\u043e\u043c\u0436\u0438 \u0441 \u043f\u0430\u043b\u043a\u0430\u043c\u0438+\u0443\u0432\u0435\u043b. \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u044d\u0442\u0438\u0445 \u0431\u043e\u043c\u0436\u0435\u0439, \u0438\u0442\u043e\u0433 \u0435\u0431\u0430\u043d\u044b\u0