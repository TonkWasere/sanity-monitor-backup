u0442(\u0435\u0449\u0451 \u0432 \u043f\u0435\u0440\u0432\u043e\u043c \u0441\u0435\u0437\u043e\u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438 \u043d\u0430\u0445\u0443\u044f \u0438\u0433\u0440\u0430\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u0434\u0430\u043b\u043e \u0440\u0435\u0439\u0442), \u0442.\u0435. \u0442\u044b \u0441\u0440\u0430\u0437\u0443 \u0438\u0433\u0440\u0430\u0435\u0448\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0443 \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0447\u0438\u043d\u0438\u0442\u0441\u044f. 20 \u0438\u0433\u0440. \u0424\u0430\u0440\u043c. \u041f\u0430\u0442\u0442\u0435\u0440\u043d\u043e\u0432. \u0421. \u0414\u0412\u0410\u0414\u0426\u0410\u0422\u042c\u042e. \u0415\u0411\u0410\u041d\u042b\u041c\u0418. \u0411\u0415\u0421\u041f\u041b\u0410\u0422\u041d\u042b\u041c\u0418. \u0418\u0413\u0420\u0410\u041c\u0418.\u003Cbr\u003E\n\u0423 \u043c\u0435\u043d\u044f 5\u043a \u043d\u0430 \u0440\u0443\u043a\u0430\u0445. 5\u043a \u0437\u0430 \u0438\u0441\u043a\u043b \u043b\u0438\u0433\u0443. \u041e\u043a\u0435\u0439, \u0432 \u0441\u0443\u043c\u043c\u0435 10\u043a \u0443\u0436\u0435 \u0435\u0441\u0442\u044c. \u041c\u043d\u0435 \u043d\u0430\u0434\u043e \u043d\u0430\u0444\u0430\u0440\u043c\u0438\u0442\u044c 5\u043a. \u0411\u0435\u0440\u0451\u043c \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0444\u0430\u0440\u043c\u0430 70 \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u043e\u0432 \u0437\u0430 \u043a\u0430\u0442\u043a\u0443\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-20\/1792475101-908700-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u0022e732a332-9b28-4c25-a8da-ff147607a02b\u0022 loading=\u0022lazy\u0022 width=\u0022310\u0022 height=\u002290\u0022\u003E\u003Cbr\u003E\n\u0421\u0422\u0410\u0411\u0418\u041b\u042c\u041d\u041e \u041d\u0410\u0414\u041e 2 \u043c\u0435\u0441\u0442\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c+\u0436\u0438\u0442\u044c \u0432 \u0438\u0433\u0440\u0435. \u041f\u043e\u0445\u0443\u0439, \u043e\u043a\u0435\u0439. \u042f \u0436\u0438\u0432\u0443 +4 \u043c\u0441\u043a \u0438 \u0442\u0430\u043c \u0447\u0442\u043e-\u0442\u043e \u0438\u0433\u0440\u0430\u044e. \u0410 \u043f\u0440\u0438\u043a\u0438\u043d\u044c \u0441\u044e\u0434\u0430 \u0437\u0430\u043f\u0438\u0445\u043d\u0443\u0442\u044c 20 \u0438\u0433\u0440 \u0438\u0437 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0438? \u041e\u041e\u041e, \u0443\u0436\u0435 51 \u0438\u0433\u0440\u0430. \u041f\u0438\u0437\u0434\u0435\u0446, \u0444\u0438\u0434\u0431\u044d\u043a \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442 \u043e\u043d\u0438. \u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-09\/1791555983-51451-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u0022658d3102-474c-4a47-b6c3-dbb621cd68f1\u0022 loading=\u0022lazy\u0022 width=\u0022640\u0022 height=\u0022336\u0022\u003E\u003C\/p\u003E\n","renderFailed":false,"mentionedByCount":1,"canEdit":false,"canDelete":false,"canHide":false,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":1,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":1,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"user":{"data":{"type":"users","id":"1675553"}},"discussion":{"data":{"type":"discussions","id":"196709"}},"mentionedBy":{"data":[{"type":"posts","id":"4717311"}]},"likes":{"data":[{"type":"users","id":"1180106"}]}}},{"type":"posts","id":"4717845","attributes":{"num