\u0430\u044e, \u044f \u0432 \u0448\u043e\u043a\u0435 \u0441 \u0442\u043e\u0433\u043e \u0448\u043e \u0443 \u043d\u0438\u0445 \u0431\u0430\u0437\u0430 \u0432\u043f\u043e\u043b\u043d\u0435 \u0441\u0435\u0431\u0435 \u0441\u044a\u0435\u0434\u043e\u0431\u043d\u0430\u044f, \u043b\u0430\u0433\u043e\u0432 \u043d\u0435\u0442, \u0431\u0430\u0433\u043e\u0432 \u043e\u0441\u043e\u0431\u043e\u0432 \u043d\u0435\u0442, \u0445\u0435\u0440\u043e\u0432\u0430 \u0442\u043e\u043d\u043d\u0430 \u043e\u0447\u0435\u043d\u044c \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u043d\u044b\u0445 \u043c\u0435\u0445\u0430\u043d\u0438\u043a \u043e \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u044f \u043a\u0430\u043a \u0438\u0433\u0440\u043e\u043a \u0431\u0444-\u0441\u043a\u0432\u0430\u0434\u0430-\u043a\u043e\u043b\u0434\u044b \u043c\u0435\u0447\u0442\u0430\u043b \u043f\u0440\u044f\u043c \u043f\u0437\u0434\u0446 \u0434\u0430\u0432\u043d\u043e. \u0427\u0438\u0442\u0435\u0440\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043b\u043d\u044b\u0439 \u043f\u0438\u0437\u0434\u0435\u0446 \u043a\u0440\u043e\u043c\u0435\u0448\u043d\u044b\u0439, \u0438\u0437 70 \u0447\u0430\u0441\u043e\u0432 \u044f \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u043d\u043e\u0433\u043e, \u043d\u043e \u044d\u0442\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435\u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c\u043e\u0439.\u003C\/p\u003E \n\n\u003Cp\u003E\u0427\u0435\u043b \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443 \u0440\u0430\u0437\u044a\u0435\u0431\u0430\u0448\u0438\u043b \u0432\u0441\u0435\u0445 100 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043d\u0430 \u043a\u0430\u0440\u0442\u0435, \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c \u0440\u0435\u043f\u043e\u0440\u0442\u043d\u0443\u0442\u044c \u043e\u043d \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0438\u043c \u043f\u043e\u043c\u0435\u043d\u044f\u043b \u0441\u0435\u0431\u0435 \u043d\u0438\u043a\u043d\u0435\u0439\u043c \u0438 \u041d\u0415 \u041f\u0420\u041e\u0421\u0422\u041e \u041f\u041e\u041c\u0415\u041d\u042f\u041b, \u0430 \u043f\u043e\u043c\u0435\u043d\u044f\u043b \u043d\u0430 \u043d\u0438\u043a\u043d\u0435\u0439\u043c \u043c\u043e\u0435\u0433\u043e \u0442\u0438\u043c\u043c\u0435\u0439\u0442\u0430. \u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u043e\u0435\u0433\u043e \u0442\u0438\u043c\u043c\u0435\u0439\u0442\u0430 \u043f\u043e \u0438\u0442\u043e\u0433\u0443 \u0437\u0430\u0440\u0435\u043f\u043e\u0440\u0442\u0438\u043b\u0438 \u0438 \u0435\u0433\u043e \u0437\u0430\u0431\u0430\u043d\u0438\u043b\u043e \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435. \u003Cbr\u003E\n\u0411\u043e\u043b\u0435\u0435 \u043d\u0430\u0433\u043b\u044b\u0445 \u0438 \u0435\u0431\u043d\u0443\u0442\u044b\u0445 \u0447\u0438\u0442\u0435\u0440\u043e\u0432 \u044f \u0435\u0449\u0435 \u043d\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b, \u0442\u0443\u0442 \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0438\u0433\u0440\u0430 \u043e\u0447\u0435\u043d\u044c \u0443\u044f\u0437\u0432\u0438\u043c\u0430\u044f \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u0442.\u043a. \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430 + \u043a\u0430\u0442\u043a\u0430 \u043d\u0430 100 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0447\u0438\u0442\u0435\u0440 \u0437\u0430 \u0440\u0430\u0437 \u043c\u043e\u0436\u0435\u0442 \u0432\u0441\u0435 \u0440\u0430\u0441\u0445\u0443\u044f\u0440\u0438\u0442\u044c, \u0430 \u043a\u0430\u043a \u043c\u044b \u0437\u043d\u0430\u0435\u043c \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0430\u043d\u0442\u0438\u0447\u0438\u0442\u0430 \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0438 \u0432 \u043e\u0431\u0449\u0435\u043c \u043d\u0430\u043f\u043b\u044b\u0432 \u044d\u0442\u043e\u0433\u043e \u0433\u043e\u0432