\u043f\u043e\u0447\u0435\u043c\u0443 \u043a\u043e\u043c\u0430\u043d\u0434\u0435 , \u043f\u0440\u043e\u0435\u0431\u0430\u0432\u0448\u0435\u0439 \u0434\u0432\u0430 \u043f\u0432\u043f \u0440\u0430\u0443\u043d\u0434\u0430 \u043f\u043e\u0434\u0440\u044f\u0434, \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u0434\u0430\u0432\u0430\u0442\u044c \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0435 \u043e\u0447\u043a\u0438 \u0443\u0440\u043e\u043d\u0430. \u0412 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0435 \u0431\u0443\u0434\u0435\u0442 \u0440\u0435\u0448\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043b\u0430\u0441\u0442 \u0440\u0430\u0443\u043d\u0434. \u042d\u0442\u043e \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u0438\u0437\u0434\u0435\u0446. \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0435\u0431\u044b\u0432\u0430\u044e\u0442, \u0442\u043e \u043f\u0443\u0447\u0442\u044c \u043f\u0440\u043e\u0435\u0431\u044b\u0432\u0430\u044e\u0442, \u0447\u0437\u0445, \u0437\u0430\u0447\u0435\u043c \u0440\u0430\u0441\u0442\u044f\u0433\u0438\u0432\u0430\u0442\u044c \u0438\u0433\u0440\u044b \u0442\u0430\u043a \u0441\u0438\u043b\u044c\u043d\u043e.\u003Cbr\u003E\n3) \u043e\u0440\u0443\u0436\u0438\u0435 +- \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043e, \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0443\u043b\u0435\u043c\u0435\u0442\u044b \u0438 \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a\u0438 \u043a\u0430\u0436\u0443\u0442\u0441\u044f \u0441\u043b\u0430\u0431\u044b\u043c\u0438 \u0432 \u043f\u0432\u043f.\u003Cbr\u003E\n\u041a\u043e\u0441\u0442\u044e\u043c\u044b \u043a\u0430\u0436\u0443\u0442\u0441\u044f \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u044b\u043c\u0438.\u003Cbr\u003E\n4) \u0411\u0430\u0433\u0438.\u003Cbr\u003E\n \u0412\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u0442\u043f \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u0434\u0435\u043b\u0430\u0442\u044c \u043f\u043e\u043a\u0430 \u043d\u0435 \u0443\u0431\u0435\u0440\u0435\u0442\u0435 \u043e\u0440\u0443\u0436\u0438\u0435. \u0417\u043d\u0430\u043a\u043e\u043c\u044b\u0439 \u0432\u0441\u0435\u043c \u0431\u0430\u0433.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0435 \u043a\u0438\u0434\u0430\u043b\u0438\u0441\u044c \u0437\u0430\u0449\u0438\u0442\u043d\u044b\u0435 \u0433\u0440\u0430\u043d\u0430\u0442\u044b \u0432 \u043d\u0430\u0443\u0447\u043a\u0435. \u0410\u043d\u0438\u043c\u0430\u0446\u0438\u044f \u0431\u044b\u043b\u0430, \u0433\u0440\u0430\u043d\u0430\u0442\u0430 \u0434\u043e\u043b\u0435\u0442\u0430\u043b\u0430. \u041a\u0443\u043f\u043e\u043b\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u042d\u0442\u043e \u043c\u043e\u0433 \u0431\u044b\u0442\u044c \u0445\u043e\u0440\u043e\u0448\u0438\u0439 \u0438\u0432\u0435\u043d\u0442, \u043d\u0435 \u0431\u0443\u0434\u044c \u0442\u0430\u043c \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430.\u003Cbr\u003E\n\u0421\u0442\u0430\u0432\u044c\u0442\u0435 \u0441\u0432\u0435\u0447\u043a\u0438 \u0437\u0430 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0442\u043e\u043f 250 \u0438 \u0442\u043e\u043f 10%.\u003Cbr\u003E\n\u0420\u0430\u043d\u0434\u043e\u043c \u0438 \u0433\u0443\u043c\u043c\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u0440\u043e\u0435\u0431\u044b\u0432\u0430\u044e\u0449\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u0435 \u0432\u0433\u043e\u043d\u044f\u0442 \u0438\u0445 \u0432 \u0433\u0440\u043e\u0431.\u003Cbr\u003E\n\u0415\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c - \u0443\u0434\u0430\u043b\u044f\u0439\u0442\u0435 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u043d\u0430\u0445\u0443\u0439  \u0438\u043b\u0438 \u043f\u0443\u0441\u0442\u044c \u043e\u043d \u0431\u0443\u0434\u0435\u0442 \u043e\u043d\u043b\u0438 \u043d\u0430\u043a\u043e\u043f\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cspan class=\u0022GroupMention Gro