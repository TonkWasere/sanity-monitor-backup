u043e \u0431\u044b \u0443\u043f\u0438\u0445\u0430\u0442\u044c \u0432 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443 \u043e\u0431\u044a\u0435\u043c\u0430.\u003Cbr\u003E\n\u0417\u0430\u043a\u043e\u043d\u0447\u0443 \u043a\u0443\u0431\u043e\u0447\u0435\u043b\u043e\u043c \u043d\u0430 \u0437\u0430\u0434\u043d\u0435\u043c \u0444\u043e\u043d\u0435, \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043e\u043d \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u043e, \u0445\u043e\u0442\u044f \u0431\u044b \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0415\u0413\u041e \u041d\u0415 \u0412\u0418\u0414\u041d\u041e \u0422\u041e\u041b\u041a\u041e\u041c \u0411\u041b\u042f\u0422\u042c..\u003C\/p\u003E\n\n\u003Cp\u003E\u044f \u043d\u0435 UI \u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440, \u043d\u043e \u0434\u0430\u0436\u0435 \u043c\u043d\u0435 \u043f\u043e\u043d\u044f\u0442\u043d\u043e \u0447\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u044d\u0442\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0443\u0431\u043e\u0433\u043e. \u0438 \u044d\u0442\u043e \u043d\u0435 \u0434\u043e\u0432\u043e\u0434 \u043f\u043e \u0442\u0438\u043f\u0443, \u043d\u0443 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0441\u0437 \u0441\u0442\u0430\u0440\u044b\u0439 \u0436\u0435, \u043d\u0443 \u0442\u0430\u043a \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0430\u043d\u043e\u043c\u0430 \u0438 \u0441\u0437, \u0443 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0435\u0439 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0442\u043e \u043e\u0434\u043d\u0430 \u0438 \u0442\u0430 \u0436\u0435, \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u0442 \u0430\u043d\u043e\u043c\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u0438\u0442 \u0435\u0449\u0435 \u0435\u0433\u043e \u0434\u0438\u0437\u0430\u0439\u043d\u0438\u0442\u044c \u04