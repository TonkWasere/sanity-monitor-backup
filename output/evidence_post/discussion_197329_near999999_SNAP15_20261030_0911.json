48\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c 60\u043a\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197329-prazdnichnaya-luzha\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224737923\u0022\u003EDaikeri0\u003C\/a\u003E \u0426\u0435\u043d\u043d\u0438\u043a\u0438 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430\u0445 \u0442\u043e\u0436\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u0441 \u043e\u0434\u043d\u043e\u0439 \u0446\u0435\u043b\u044c\u044e, \u0417\u0410\u0421\u0422\u0410\u0412\u0418\u0422\u042c \u0436\u0435\u043b\u0430\u044e\u0449\u0438\u0445 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u0443\u044e \u0448\u043c\u043e\u0442\u043a\u0443 \u0438\u0433\u0440\u0430\u0442\u044c \u041c\u041d\u041e\u0413\u041e \u0438\u0433\u0440.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E100 \u0438\u0433\u0440 \u043d\u0430 \u043f\u0435\u0440\u0432\u0443\u044e \u0448\u043c\u043e\u0442\u043a\u0443 (\u0435\u0441\u043b\u0438 \u0437\u0430 \u043a\u0430\u0442\u043a\u0443 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u043a\u0443 1,5\u043a). 100 \u0438\u0433\u0440 \u0437\u0430 21 \u0434\u0435\u043d\u044c \u043d\u0435 \u0448\u0438\u0431\u043a\u043e \u043c\u043d\u043e\u0433\u043e \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435. \u0425\u043e\u0442\u044f \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043d\u0438\u0449\u0438\u0435 \u0441 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u0430 \u0441 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0442\u044b \u043b\u0443\u0442\u0430\u0435\u0448\u044c \u0438 \u043b\u0432\u043b\u044b \u0411\u041f, \u0438  \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430 \u201c\u0440\u0435\u0439\u0442\u0438\u043d\u0433\u201d, \u0438 \u0441\u0430\u043c\u0443 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0437\u0430 \u043a\u0430\u0442\u043a\u0443. \u0415\u0441\u043b\u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0430 \u0432\u0441\u0451 \u044d\u0442\u043e \u0440\u0430\u0437\u043e\u043c, \u0442\u043e \u0431\u0443\u0434\u0442\u043e \u0431\u044b \u0438 \u043d\u043e\u0440\u043c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0442\u044b \u0445\u043e\u0440\u043e\u0448\u043e \u043e\u043f\u0438\u0441\u0430\u043b \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044f. \u041d\u0443 \u044d\u0442\u043e \u043d\u0443\u0434\u043d\u043e. \u0412 \u0442\u043e\u0439 \u0436\u0435 \u0430\u0442\u0430\u043a\u0435 \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0430 \u0431\u044b\u043b\u043e \u0445\u043e\u0442\u044f \u0431\u044b \u0432\u0435\u0441\u0435\u043b\u043e \u043e\u0442 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438 \u0438 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0433\u043e \u043f\u0438\u0437\u0434\u0435\u0446\u0430 \u043e\u0442 \u0432\u0437\u0440\u044b\u0432\u043e\u0432 \u0438 \u043e\u0431\u0438\u043b\u0438\u044f \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u0432. \u0410 \u0442\u0443\u0442 \u0432 \u043f\u0438\u043a \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0431\u043e\u0441\u0441\u0430\u0445, \u0447\u0430\u0441\u0442\u044c \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0435 \u0434\u0430\u0451\u0442 \u0442\u0435\u0431\u0435 \u0441\u0442\u043e\u044f\u0442\u044c \u043a\u0430\u043a \u0425\u0443, \u0438 \u0442\u0435\u0431\u0435 \u043f\u0440\u0438\u0445\u043e\u04