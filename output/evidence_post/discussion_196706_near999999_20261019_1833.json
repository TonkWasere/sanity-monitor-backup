3e\u0434\u043d\u0430 \u043b\u043e\u0433\u0438\u0447\u043d\u0430\u044f \u0430\u0440\u0445\u0438\u0430\u043d\u043e\u043c\u0430\u043b\u0438\u044f ? \u003Cbr\u003E\n\u0432\u0430\u0443 \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 2 \u0433\u043e\u0434\u0430 \u043e\u0434\u043d\u0430 \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c, \u0438 \u0442\u043e \u044d\u0442\u043e \u0432\u0437\u0440\u044b\u0432 \u0441\u0438\u0441\u044c\u043a\u0438 \u003Cbr\u003E\n\u0410 \u0434\u0438\u043a\u0438\u0439 \u0441\u0435\u0432\u0435\u0440, \u043e\u043d \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0441\u0436\u0430\u0442\u044b\u043c , \u0442\u0435\u0441\u043d\u044b\u043c , \u043e\u043d \u043f\u0440\u043e\u0432\u0430\u043b \u003Cbr\u003E\n\u0414\u0430 \u0441\u0430\u043c \u0431\u0435\u0433\u0430\u044e \u0442\u0430\u043c, \u043d\u043e \u043e\u043d \u0441\u044b\u0440\u043e\u0439 , \u0438 \u043d\u0435 \u043f\u0440\u043e\u0434\u0443\u043c\u0430\u043d\u043d\u044b\u0439 \u003Cbr\u003E\n\u0410 \u0442\u043e \u0447\u0442\u043e \u0442\u044b \u0431\u0435\u0436\u0438\u0448\u044c \u043f\u043e \u043a\u0438\u0448\u043a\u0435 \u0438\u043d\u0432\u0430\u043b\u0438\u0434\u043e\u0432 3 \u043c\u0438\u043d\u0443\u0442\u044b , \u044d\u0442\u043e \u0441\u043c\u0435\u0445 \u003Cbr\u003E\n\u041e\u0447\u0435\u043d\u044c \u0445\u043e\u0447\u0435\u0442\u0441\u044f \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0438\u044e \u0412 \u0415\u0414\u0418\u041d\u041e\u041c \u041c\u0418\u0420\u0415 , \u043f\u043e\u0447\u0435\u043c\u0443 \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u0444\u0440\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0441\u0435\u0432\u0435\u0440 \u0431\u044b\u043b\u043e \u043d\u0435 \u0432\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0432 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u043f\u043e\u0441\