e\u043c \u043d\u0435 \u043b\u0435\u0437\u0442\u044c \u0434\u0440\u0443\u0433 \u043a \u0434\u0440\u0443\u0433\u0443, \u043d\u043e \u043d\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438 \u043f\u043e\u043b\u0438\u0433\u043e\u043d\u043e\u0432 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0432\u0441\u0435 \u0432\u0440\u0435\u043c\u044f \u0441\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043e\u043c \u043f\u043e\u043a\u0430 \u0438\u0449\u0443\u0442 \u043d\u0430 \u0432\u044b\u043d\u043e\u0441 \u0432\u0441\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043f\u0440\u0438\u043a\u043e\u043b\u043e\u0447\u0435\u043d\u044b \u043a \u043f\u043e\u043b\u0443 \u0433\u0432\u043e\u0437\u0434\u044f\u043c\u0438. \u0430 \u043e\u0442\u0440\u044f\u0434\u044b \u0417\u0438\u0432\u043a\u0430\u0441\u0430 \u043f\u0430\u0442\u0440\u0443\u043b\u0438\u0440\u0443\u044e\u0442 \u0441\u0432\u043e\u044e \u0437\u043e\u043d\u0443 \u0438 \u043d\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0441\u0442\u0430\u043b\u043a\u0435\u0440\u043e\u0432-\u043c\u0430\u0440\u043e\u0434\u0435\u0440\u043e\u0432 (\u0442.\u0435. \u0438\u0433\u0440\u043e\u043a\u043e\u0432)\u003C\/p\u003E\n\n\u003Cp\u003E\u0438\u0441\u0445\u043e\u0434\u044f \u0438\u0437 \u044d\u0442\u043e\u0433\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0447\u0443\u0442\u044c \u043b\u043e\u0433\u0438\u0447\u043d\u0435\u0439, \u043f\u043e\u0447\u0435\u043c\u0443 \u0417\u0438\u0432\u043a\u0430\u0441 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043e\u0442\u0431\u0438\u0440\u0430\u0435\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u044b\u0435 \u0442\u043e\u0447\u043a\u0438 \u0438 \u0430\u0432\u0430\u043d\u043f\u043e\u0441\u0442\u044b \u043d\u0430 \u0432\u0441\u0435\u0445 \u043b\u043e\