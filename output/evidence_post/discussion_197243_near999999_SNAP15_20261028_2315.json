8","attributes":{"number":1,"createdAt":"2026-10-28T21:16:18+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u042d\u0442\u043e\u0442 \u0438\u0432\u0435\u043d\u0442, \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441\u043e \u0434\u043d\u044f X , \u0441\u0430\u043c\u044b\u0439 \u0443\u043d\u044b\u043b\u044b\u0439 \u0438\u0437 \u0432\u0441\u0435\u0445, \u0414\u0410\u0416\u0415 \u201c\u0412\u0417\u0410\u041f\u0415\u0420\u0422\u0418\u201d \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u0435\u0435 \u0440\u043e\u0444\u0435\u043b\u044c\u043d\u043e  \u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0435\u0435 \u0438\u0433\u0440\u0430\u0442\u044c, \u0447\u0435\u043c \u044d\u0442\u043e\u2026\u003C\/p\u003E \n\n\u003Cp\u003E\u042f \u043d\u0435 \u0437\u043d\u0430\u044e \u0437\u0430\u0447\u0435\u043c \u043b\u044e\u0434\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u043b\u0438 \u0437\u0430 \u043d\u0435\u0433\u043e, \u0432\u0441\u0451 \u0441\u043b\u043e\u043c\u0430\u043b\u0438, \u0438\u0441\u043f\u043e\u0440\u0442\u0438\u043b\u0438 \u0438 \u0432\u043e\u043e\u0431\u0449\u0435 \u0447\u0442\u043e \u043b\u0438\u0431\u043e \u043c\u0435\u043d\u044f\u043b\u0438. \u0423 \u043d\u0438\u0445 \u0431\u044b\u043b\u043e \u0412\u0421\u0401 \u0413\u041e\u0422\u041e\u0412\u041e, \u0432\u043e\u0442 \u0432\u043e\u043e\u0431\u0449\u0435 \u0432\u0441\u0451, \u0438\u043c \u043d\u0430\u0434\u043e \u0431\u044b\u043b\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043c\u0435\u043d\u044f\u0442\u044c \u0442\u0435\u043a\u0441\u0442\u0443\u0440\u043a\u0438 \u0438 \u0412\u0421\u0401.\u003C\/p\u003E\n\n \u003Cp\u003E4 \u0443\u043b\u044c\u0442\u0440\u0430 \u0443\u043d\u044b\u043b\u044b\u0445, \u043e\u0434\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0445 \u043f\u0432\u0435 \u0440\u0430\u0443\u043d\u0434\u043e\u0432, \u0433\u0434\u0435 \u0437\u0430 40 \u0441\u0435\u043a \u0432\u044b\u0431\u0435\u0433\u0430\u0435\u0442 \u043e\u0434\u0438\u043d \u0434\u0435\u0441\u044f\u0442\u043e\u043a \u0441\u043e\u0431\u0430\u043a, \u043e\u0447\u0435\u043d\u044c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u0432\u043e\u043b\u043d\u0443 \u0438\u0437 \u043f\u044f\u0442\u0438 \u0441\u043e\u0431\u0430\u043a \u0437\u0430 4\u0441\u0435\u043a \u0438 \u0436\u0434\u0430\u0442\u044c \u0440\u0430\u0437\u0440\u0435\u0441 10 \u0441\u0435\u043a (\u041e\u043d\u0438 \u043d\u043e\u0440\u043c \u0440\u0435\u0441\u0430\u044e\u0442\u0441\u044f, \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u0442 \u0432\u044b\u0439\u0442\u0438 \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u0438\u0437 \u0442\u0435\u043a\u0441\u0442\u0443\u0440\u043e\u043a))) ). \u0423\u0431\u0440\u0430\u043b\u0438 \u043b\u0443\u0447\u0448\u0438\u0439 \u0440\u0430\u0443\u043d\u0434 - \u0414\u0443\u044d\u043b\u0438, \u0432\u043c\u0435\u0441\u0442\u043e \u043d\u0435\u0433\u043e \u0434\u0430\u043b\u0438 \u043f\u0432\u0435 \u0440\u0430\u0443\u043d\u0434 \u0441 \u0442\u0440\u0435\u043c\u044f \u043a\u0440\u043e\u0432\u043e\u0441\u043e\u0441\u0430\u043c\u0438, \u0434\u0435\u0441\u044f\u0442\u043e\u043a \u0437\u043e\u043c\u0431\u0438-\u0431\u043e\u043c\u0431\u0435 \u0438 \u043f\u044f\u0442\u044c \u043a\u0430\u0431\u0430\u043d\u043e\u0432.\u003C\/p\u003E \n\n\u003Cp\u003E\u041f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u044f \u0433\u043e\u0432\u043d\u043e, \u0431\u0435\u0437 \u0434\u043e\u043f \u044d\u0444\u0444\u0435\u043a\u0442\u043e\u0432 \u043e\u0440\u0443\u0436\u0438\u044f \u0438 \u0425\u041e\u0420\u041e\u0428\u0418\u0425 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u043e\u0432 \u0431\u0438\u043b\u0434\u044b \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435, \u0440\u0430\u0437\u043d\u0438\u0446\u0430 \u043b\u0438\u0448\u044c \u0432 \u043e\u0440\u0443\u0436\u0438\u0438 \u0438 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0442\u044b \u0432 \u043d\u0430\u0443\u0447\u043a\u0435 \u0438\u043b\u0438 \u041d\u0415\u0432\u043d\u0430\u0443\u0447\u043a\u0435\ud83d\ude10.\u003Cbr\u003E\n \u0412 \u0447\u0451\u043c \u0441\u043c\u044b\u0441\u043b \u043c\u043d\u0435 \u0432 \u043f\u0440\u044b\u0436\u043a\u0430\u0445 \u043e\u0442 \u0441\u0442\u0435\u043d,  \u0432\u0430\u043c\u043f\u0438\u0440\u0438\u0437\u043c\u0435, \u0434\u043e\u043f \u0444\u0430\u0440\u043c \u043c\u043e\u043d\u0435\u0442 \u0438 \u0442\u0434, \u0435\u0441\u043b\u0438 \u044f \u0443\u0431\u0438\u0432\u0430\u044e \u0447\u0435\u043b\u0430 \u0437\u0430 0.2 \u0438 \u043e\u043d \u043c\u0435\u043d\u044f \u0442\u043e\u0436. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043d\u043e\u0440\u043c \u0430\u0440\u0442 - \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0430\u0451\u0442 35\u043f\u0443 \u0438 \u0447\u0451 \u0442\u043e \u0435\u0449\u0451, \u0440\u0430\u0437\u0440\u044b\u0432 \u0447\u0442\u043e \u043b\u0438, \u043d\u0435 \u043f\u043e\u043c\u043d\u044e. \u041c\u043e\u043d\u0435\u0442 \u0438 \u0442\u0430\u043a \u0434\u0430\u0451\u0442 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e, \u0447\u0442\u043e \u0431\u044b \u0431\u044b\u0442\u044c \u043a\u0440\u0430\u0441\u043d\u044b\u043c \u043a 20 \u0440\u0430\u0443\u043d\u0434\u0443 \u0438 \u0445\u043e\u0442\u044f \u0431\u044b 1 \u0430\u0440\u0442\u043e\u043c \u0432 \u0441\u0431\u043e\u0440\u043a\u0435, \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u0440\u0438 \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0439 \u0442\u0440\u0430\u0442\u0435 \u0434\u0435\u043d\u044f\u043a. \u041c\u0430\u043d\u0441\u0438\u0442\u044c \u0442\u044b \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u0443\u0441\u043f\u0435\u0432\u0430\u0435\u0448\u044c, \u0441\u043c\u044b\u0441\u043b\u0430 \u043e\u0442 \u043a\u043b\u0430\u0441\u0441\u0430 \u0441\u043d\u043e\u0440\u043a\u0430 \u043d\u0435\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0430 \u0430\u0440\u0435\u043d\u0435 \u0440\u0443\u0441\u043e\u0432 \u0442\u044b \u043c\u043e\u0433 \u0440\u0430\u0437\u043e\u0433\u043d\u0430\u0442\u044c \u0435\u0431\u0430\u043d\u0443\u0442\u0443\u044e \u043f\u0440\u0438\u0432\u0435\u0434\u0443 \u0438 \u0441\u043b\u0443\u0442\u0430\u0442\u044c \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0443\u0442\u043e\u0439 \u0433\u0430\u043d, \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0440\u0430\u0437\u043d\u0438\u0446\u0443 \u0432 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0438, \u0449\u0430\u0441 \u0436\u0435, \u044f \u0432 \u0441\u0438\u043d\u0435\u043c \u0448\u043c\u043e\u0442\u0435 \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043b\u0438\u0432\u0430\u044e \u0444\u0438\u043e\u043b+, \u0438 \u044f \u0441\u0435\u0439\u0447\u0430\u0441 \u043d\u0435 \u043f\u0440\u043e \u0441\u043a\u0438\u043b\u043b, \u0430 \u043f\u0440\u043e \u0442\u043e, \u0447\u0442\u043e \u0447\u0435\u043b \u0434\u0430\u0436\u0435 \u0432 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u0439 \u0431\u0440\u043e\u043d\u0435 \u0443\u043c\u0438\u0440\u0430\u0435\u0442 \u0437\u0430 5 \u043f\u0443\u043b\u044c \u0432 \u0433\u043e\u043b\u043e\u0432\u0443 \u0441 \u0441\u0438\u043d\u0435\u0433\u043e \u043a\u0430\u043b\u0430\u0448\u0430, \u0430 \u044d\u0442\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0431\u044b\u0441\u0442\u0440\u043e\u003C\/p\u003E\n\n\u003Cp\u003E\u0410\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b \u043e\u043a\u043e\u043b\u043e \u044e\u0437\u043b\u0435\u0441\u0441, \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043d\u0438\u0437\u043a\u0438\u0439 \u0442\u0442\u043a \u0434\u043b\u044f \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0432 \u043f\u0432\u043f, \u044d\u0442\u0438 20%\u044d\u0444\u0444 \u0438 3 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043a\u0438 \u043d\u0435 \u0434\u0430\u0434\u0443\u0442 \u043c\u043d\u0435 \u0432\u044b\u0436\u0438\u0442\u044c \u043b\u0438\u0448\u043d\u044e\u044e \u043f\u0443\u043b\u044e, \u044f \u0442\u0430\u043a \u0438 \u0442\u0430\u043a \u0443\u043c\u0438\u0440\u0430\u044e \u0437\u0430 4 \u0433\u043e\u043b\u043e\u0432\u044b \u043e\u0442 \u043a\u0430\u043b\u0430\u043a\u043015. \u0412 \u043f\u0432\u0435 \u043e\u0442 \u043d\u0438\u0445 \u0441\u043c\u044b\u0441\u043b\u0430 \u0447\u0443\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435, \u043d\u043e \u0442\u0430\u043a \u0436\u0435 \u043d\u0435\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043c\u0443\u0442\u0430\u043d\u0442\u044b \u043d\u0430\u043d\u043e\u0441\u044f\u0442 \u0445\u043e\u0442\u044c \u043a\u0430\u043a\u043e\u0439 \u0442\u043e \u0443\u0440\u043e\u043d, \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043a\u0430 \u0443 \u0442\u0435\u0431\u044f \u043d\u0435\u0442 \u0431\u0440\u043e\u043d\u0438\ud83d\ude14\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u044f\u0442\u044b\u0439 \u0440\u0430\u0443\u043d\u0434 - \u043f\u0432\u043f \u0440\u0430\u0443\u043d\u0434. \u041d\u0443 \u044d\u044d\u043c\u043c\u043c, \u0442\u0442\u043a \u043d\u043e\u0440\u043c, \u043c\u043d\u0435 \u043d\u0440\u0430\u0432\u043a\u0438, \u043a\u0430\u043a \u0432 \u0441\u0442\u0430\u0440\u043e\u043c \u0434\u043e\u0431\u0440\u043e\u043c \u0434\u043e X. \u0414\u0440\u043e\u0431\u043e\u0432\u0438\u043a\u0438 \u043d\u0435 \u0438\u043c\u0431\u0443\u044e\u0442 \u043f\u043e \u043b\u044e\u0434\u044f\u043c, \u0430 \u043d\u0430\u043d\u043e\u0441\u044f\u0442 \u043d\u043e\u0440\u043c \u0443\u0440\u043e\u043d, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0434\u0430\u044e\u0442 \u0445\u043e\u0440\u043e\u0448\u0438\u0439 \u0438\u043c\u043f\u0430\u043a\u0442 \u043f\u043e \u0431\u043e\u0441\u0441\u0430\u043c, \u043f\u043f\/\u0430\u0432\u0442\u043e\u043c\u0430\u0442\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442, \u0432\u0441\u0451 \u043a\u0430\u0439\u0444. \u0422\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u0442 \u044f \u043d\u0435 \u043f\u043e\u043d, \u0430 \u0432 \u0447\u0451\u043c \u0441\u043c\u044b\u0441\u043b \u043e\u0442 \u0432\u0435\u0442\u043a\u0438 \u0435\u0431\u0440?\ud83e\udd2d \u0423 \u043d\u0430\u0441 \u043f\u0432\u043f \u043a\u0430\u0440\u0442\u0430 20 \u043c\u0435\u0442\u0440\u043e\u0432 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435, \u044d\u0442\u043e \u0434\u0430\u0436\u0435 \u043d\u0435 \u0431\u043e\u043b\u0442\u043e\u0432\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0440\u0430\u043d\u044c\u0448\u0435 \u0448\u043e\u0442\u0430\u043b\u0430 \u0438 \u0431\u044b\u043b\u043e \u0445\u043e\u0442\u044f \u0431\u044b \u0437\u0430\u0431\u0430\u0432\u043d\u043e \u0441 \u043d\u0435\u0439 \u0438\u0433\u0440\u0430\u0442\u044c, \u0430 \u0435\u0431\u0440 \u044d\u0442\u043e \u0445\u0443\u0438\u0442\u0430 \u043a\u0430\u043a\u0430\u044f \u0442\u043e, \u043d\u0438 \u0440\u044b\u0431\u0430 - \u043d\u0438 \u043c\u044f\u0441\u043e, \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0443\u0434\u0438\u043c\u0435\u043d\u0442, \u0447\u0442\u043e \u0431\u044b \u0437\u0430\u0441\u0440\u0430\u0442\u044c \u043f\u0443\u043b\u043b \u043f\u0443\u0448\u0435\u043a\ud83e\udee4\u003C\/p\u003E\n\n\n\u003Cp\u003E\u0422\u0430\u0430\u043a, \u0443 \u043d\u0430\u0441 \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0438 \u0437\u0430\u0432\u043e\u0437 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d.\u003C\/p\u003E\n\n\u003Cp\u003E\u0417\u0430 25 \u043c\u0438\u043d\u0443\u0442 (20+ \u0440\u0430\u0443\u043d\u0434) 80\u043a \u0432\u0430\u043b\u044e\u0442\u044b \u0438 2500 \u0438\u0432\u0435\u043d\u0442 \u0432\u0430\u043b\u044e\u0442\u044b - \u044d\u0442\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043f\u0435\u0439\u043a\u0438, \u0442\u044b \u043d\u0430 \u0448\u0430\u0445\u0442\u0430\u0445 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0430\u0444\u0430\u0440\u043c\u0438\u0448\u044c, \u0430 \u043f\u0440\u043e \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u043e\u0443\u0440\u043e\u0432\u043d\u0435\u0432\u044b\u0435 \u043b\u043e\u043a\u0430\u0446\u0438\u0438 \u044f \u0432\u043e\u043e\u0431\u0449\u0435 \u043c\u043e\u043b\u0447\u0443. \u0421\u0443\u043f\u0435\u0440 \u0443\u0440\u0435\u0437\u0430\u043d\u043d\u044b\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0432\u044b\u0433\u043e\u0434\u043d\u0435\u0435 \u0444\u0430\u0440\u043c\u0438\u0442\u044c, \u0445\u043e\u0442\u044f \u043f\u043e \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044e (\u0434\u0443\u0445\u043e\u0442\u0430, \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043e\u0434\u043d\u043e\u0433\u043e \u0438 \u0442\u043e\u0433\u043e \u0436\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f) \u043e\u043d\u0438 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b. \u0414\u0410\u0416\u0415 \u041a\u041e\u041b\u0418\u0417\u0415\u0419  \u0432\u044b\u0433\u043e\u0434\u043d\u0435\u0435 \u0431\u0435\u0433\u0430\u0442\u044c \u0438 \u043b\u0443\u0442\u0430\u0442\u044c \u0431\u0430\u0431\u043a\u0438 \u0437\u0430 \u0441\u0447\u0451\u0442 \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0431\u043e\u0435\u0432\u044b\u0445 \u043d\u0430\u0431\u043e\u0440\u043e\u0432 (2 \u0441\u0435\u0441\u0441\u0438\u0438 \u043f\u043e 15 \u043c\u0438\u043d\u0443\u0442 - 150\u043a), \u043f\u0440\u0438 \u0443\u0447\u0451\u0442\u0435 \u0437\u0430\u0442\u0440\u0430\u0442 \u043d\u0430 \u043f\u043e\u0447\u0438\u043d\u043a\u0443 \u0432\u0441\u0435\u0433\u043e \u0448\u043c\u043e\u0442\u0430 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u0447\u0443\u0442\u044c \u0432\u044b\u0433\u043e\u0434\u043d\u0435\u0435.\u003C\/p\u003E \n\n\u003Cp\u003E\u041d\u0443 \u043b\u0430\u0434\u043d\u043e, \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c, \u043c\u044b \u0438\u0433\u0440\u0430\u0435\u043c \u043d\u0435 \u0440\u0430\u0434\u0438 \u043d\u0430\u0433\u0440\u0430\u0434(\u0434\u043e \u0434\u043e \u0431\u0440\u0430\u0442\u0430\u043d), \u0430 \u0440\u0430\u0434\u0438 \u043a\u0430\u0439\u0444\u0430, \u0447\u0442\u043e \u043c\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c \u0432 \u0438\u0442\u043e\u0433\u0435? \u003Cbr\u003E\n\u0410 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c \u043c\u044b 25 \u043c\u0438\u043d\u0443\u0442 \u043e\u0434\u043d\u043e\u0442\u0438\u043f\u043d\u044b\u0445 \u0440\u0430\u0443\u043d\u0434\u043e\u0432, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043a\u043e\u043b\u043e \u043d\u0443\u043b\u0435\u0432\u043e\u0435 \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 \u043a\u043e\u0433\u043d\u0438\u0442\u0438\u0432\u043d\u044b\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u0438\ud83e\udd22\u003C\/p\u003E\n\n\u003Cp\u003E\u0411\u043f\u0448\u043d\u0438\u043a \u0443\u0434\u043e\u0431\u043d\u043e \u043a\u0430\u0447\u0430\u0442\u044c, \u0432\u0441\u0451, \u0431\u043e\u043b\u044c\u0448\u0435 \u0438\u0432\u0435\u043d\u0442 \u043d\u0435 \u043d\u0443\u0436\u0435\u043d)\u003C\/p\u003E\n\n\u003Cp\u003E\u0412 \u043c\u0430\u0433\u0430\u0437 \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u043c\u0430\u0433\u0430\u0437,(\u043a\u0440\u0443\u0442\u043e \u0434\u0430) \u043d\u0430 545 \u043a\u0430\u043b\u0438\u0431\u0440 45 \u043f\u0442, \u0437\u0430 300\u043a, \u043f\u0440\u0438 \u0443\u0447\u0451\u0442\u0435, \u0447\u0442\u043e \u0442\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c \u0437\u0430 \u043f\u043e\u0431\u0435\u0434\u0443 2500+-, \u0432\u044b\u0445\u043e\u0434\u0438\u0442 120 \u043a\u0430\u0442\u043e\u043a \u0440\u0430\u0434\u0438 \u043d\u0435 \u0441\u0430\u043c\u043e\u0433\u043e \u0441\u0438\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430, \u0437\u0430\u0442\u0440\u0430\u0442\u044b \u044f\u0432\u043d\u043e \u043d\u0435 \u043e\u043f\u0440\u0430\u0432\u0434\u044b\u0432\u0430\u044e\u0442 \u043d\u0430\u0433\u0440\u0430\u0434\u0443.\u003C\/p\u003E \n\n\u003Cp\u003E\u0421\u043a\u0438\u043d\u044b - \u0438\u0438-\u0441\u043b\u043e\u043f, \u0434\u0435\u0440\u044c\u043c\u0438\u0449\u0435 \u043f\u043e\u043b\u043d\u043e\u0435.\u003C\/p\u003E \n\n\u003Cp\u003E\u042e\u0437\u043b\u0435\u0441\u0441 \u043f\u043e\u043c\u043e\u0439\u043a\u0430 \u0432 \u0443\u0431\u0435\u0436\u043a\u0443 - \u044e\u0437\u043b\u0435\u0441\u0441 \u043f\u043e\u043c\u043e\u0439\u043a\u0430 \u0432 \u0443\u0431\u0435\u0436\u043a\u0443.\u003C\/p\u003E\n\n\u003Cp\u003E2500 \u0437\u0430 \u0437\u0430\u043f\u0430\u0441\u043a\u0443 - 25\u043c\u0438\u043d\u0443\u0442 \u0437\u0430 1 \u0437\u0430\u043f\u0430\u0441\u043a\u0443)) \u0411\u0435\u0437 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 - \u043f\u043b\u0435\u0432\u043e\u043a \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0442\u0438\u043f\u044b \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0430\u043b\u0438 \u0441 \u0431\u0430\u0440\u0441\u043a\u043e\u0433\u043e \u043f\u043b\u0435\u0447\u0430 \u043a\u0430\u043a\u0443\u044e \u0442\u043e \u043a\u0440\u0430\u0441\u043a\u0443, \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u044b\u0435 \u043a\u0443\u043f\u043e\u043d\u044b (\u0423 \u043a\u043e\u0433\u043e \u0442\u043e \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0431\u0430\u0440\u0442\u0435\u0440\u043e\u043c \u0432 \u044d\u0442\u043e\u0439 \u0438\u0433\u0440\u0435??) \u0438\u2026. \u041a\u0415\u0419\u0421\u042b \u0421\u041e \u0421\u0422\u0410\u0420\u042b\u041c\u0418 \u0421\u041a\u0418\u041d\u0410\u041c\u0418 \u0425\u0412\u0410\u0425\u0412\u0410\u0425\u0412\u0410\u0425\u0412\u0410\u0412\u0425\u0410\u0425\u0412\u0410\u0425\u0412\u0410\u0425\u0412\u0410\u0425\u0412\u0410\u0425\u0410\u0425\u0412\u003C\/p\u003E\n\n\u003Cp\u003E\u042d\u0442\u043e \u0442\u0430\u043a\u043e\u0439 \u043a\u0440\u0438\u0438\u0438\u043d\u0436, \u0442\u043e \u0435\u0441\u0442\u044c, \u043f\u043e\u043a\u0430 \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u0435 \u0445\u0443\u0434\u043e\u0436\u043a\u0438+3\u0434 \u043c\u043e\u0434\u0435\u043b\u044c\u0435\u0440\u044b \u043a\u043b\u0435\u043f\u0430\u044e\u0442 \u0431\u0435\u0437\u0434\u0443\u0448\u043d\u044b\u0435, \u0431\u0435\u0437\u0432\u043a\u0443\u0441\u043d\u044b\u0435 \u0438\u0438 \u0441\u043a\u0438\u043d\u044b, \u043e\u043d\u0438 \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0442\u0440\u0443\u0434\u044b \u0431\u044b\u0432\u0448\u0438\u0445 \u0440\u0430\u0431\u043e\u0442\u043d\u0438\u043a\u043e\u0432 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e, \u044d\u0442\u043e \u0441\u0438\u043d\u0435\u043c\u0430\ud83d\udc4f\ud83d\udc4f\ud83d\udc4f\u003C\/p\u003E\n\n\u003Cp\u003E\u0421\u0442\u0430\u0440\u044b\u0435 \u043a\u0440\u0430\u0441\u043a\u0438 \u0432\u044b\u0433\u043b\u044f\u0434\u044f\u0442 \u043d\u0430 \u043e\u0440\u0443\u0436\u0438\u044f\u0445 \u041b\u0423\u0427\u0428\u0415, \u0447\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u043d\u043e\u0432\u044b\u0445 \u043e\u0431\u043b\u0438\u043a\u043e\u0432, \u043a\u0440\u0443\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442\u0435, \u0440\u0435\u0431\u044f\u0442\u0430, \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e \u043b\u044e\u0434\u044f\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0442 \u0437\u0430 \u043d\u043e\u0432\u044b\u0435 \u0441\u043a\u0438\u043d\u044b, \u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0432 \u0437\u043f \u0438\u0438 \u043f\u043d\u0433 \u0434\u0435\u043d\u044c\u0433\u0430\u043c\u0438.\u003C\/p\u003E\n\n\n\u003Cp\u003E\u041e, \u0435\u0449\u0451 \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u043b \u043f\u0440\u043e \u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440\u0441\u043a\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0438 \u0432 \u0446\u0435\u043b\u043e\u043c \u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0443 \u0438\u0432\u0435\u043d\u0442\u0430. \u0411\u043b\u044f\u0442\u044c. \u042d\u0442\u043e \u0430\u0445\u0443\u0435\u043d\u043d\u0430\u044f \u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430, \u043d\u043e \u0435\u0451 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f\u2026 \u042d\u0442\u043e \u0445\u0430\u043b\u0442\u0443\u0440\u0430 \u0443\u0440\u043e\u0432\u043d\u044f - \u043d\u0430\u0441\u044f\u043b\u044c\u043d\u0438\u043a\u0430, \u044f \u0437\u0434\u0435\u043b\u044f\u043b\u044c. \u041f\u0432\u0435 \u0430\u0440\u0435\u043d\u0430 - \u043d\u0435\u0443\u0434\u043e\u0431\u043d\u0430\u044f, \u043d\u043f\u0441 \u043d\u0435 \u0432\u044b\u0431\u0435\u0433\u0430\u044e\u0442, \u043f\u043e \u043d\u0438\u043c \u043d\u0435\u043b\u044c\u0437\u044f \u043d\u043e\u0440\u043c \u0437\u0430\u0442\u0443\u043b\u0438\u0442\u044c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d\u0438 \u0441\u0442\u043e\u044f\u0442 \u0437\u0430 \u043a\u0430\u043a\u0438\u043c\u0438 \u0442\u043e \u0442\u0440\u0443\u0431\u0430\u043c\u0438, \u0431\u0430\u043b\u043a\u0430\u043c\u0438 \u0438 \u043f\u0440\u043e\u0447\u0438\u043c \u043c\u0443\u0441\u043e\u0440\u043e\u043c. \u0418\u0433\u0440\u0430\u044f \u0432 \u0438\u0432\u0435\u043d\u0442, \u044f \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e \u0432\u0430\u0439\u0431\u0430, \u0432\u043e\u0442 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e, \u044f \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u0447\u0442\u043e \u0445\u043e\u0442\u0435\u043b\u0438 \u0434\u043e \u043c\u0435\u043d\u044f \u0434\u043e\u043d\u0435\u0441\u0442\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u044b.\u003Cbr\u003E\n\u041f\u0432\u043f \u0430\u0440\u0435\u043d\u0430, \u0432\u0440\u043e\u0434\u0435 \u043d\u043e\u0440\u043c, \u043a\u0440\u0443\u0442\u043e, \u0447\u0442\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u0432\u0442\u043e\u0440\u043e\u0439 \u0432\u0445\u043e\u0434, \u0432\u0435\u0434\u044c \u0440\u0430\u043d\u044c\u0448\u0435 \u0434\u0432\u0430 \u0447\u0435\u043b\u0430 \u0441\u0442\u043e\u044f\u043b\u0438 \u043f\u043e\u0434 \u0434\u0432\u0435\u0440\u044c\u044e \u0438 \u0444\u0430\u0440\u043c\u0438\u043b\u0438 \u0432\u044b\u0445\u043e\u0434, \u0430 \u0449\u0430\u0441\u2026 \u043d\u0443\u0436\u043d\u043e 3 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430)) \u041b\u0430\u0434\u043d\u043e, \u043f\u043e\u043a\u0430 \u0437\u0430\u0436\u0438\u043c\u043e\u0432 \u043d\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u043b, \u043d\u043e \u044f \u0443\u0432\u0435\u0440\u0435\u043d, \u0447\u0442\u043e \u0431\u043e\u043b\u0435\u0435 \u043c\u0435\u043d\u0435\u0435 \u043f\u043e\u0442\u043d\u0430\u044f \u043f\u0430\u0447\u043a\u0430 \u0431\u0435\u0437 \u0431 \u0437\u0430\u043f\u0440\u044f\u0433\u0443\u0442 \u0442\u0438\u043f\u043e\u0432 \u043f\u043e\u0434 \u0431\u0430\u0437\u0443, \u043f\u043e\u043a\u0430 1-2 \u0447\u0435\u043b\u0430 \u0431\u0443\u0434\u0443\u0442 \u0442\u0443\u043b\u0438\u0442\u044c \u043f\u043e \u0442\u043e\u0442\u0435\u043c\u0443.\u003C\/p\u003E \n\n\u003Cp\u003E\u041e\u0437\u0432\u0443\u0447\u043a\u0430 - \u0445\u0437, \u0443 \u043c\u0435\u043d\u044f \u044d\u0442\u043e\u0442 \u0447\u0435\u043b \u043d\u0430 5%, \u0447\u0451 \u0442\u043e \u0431\u0443\u0431\u043d\u0438\u0442 \u0438 \u043b\u0430\u0434\u043d\u043e. \u041d\u0430 \u0430\u0440\u0435\u043d\u0435 \u0440\u0443\u0441\u043e\u0432, \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u043e\u0437\u0432\u0443\u0447\u043a\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430 \u0434\u0435\u0441\u044f\u0442\u043e\u043a \u0433\u043e\u043b\u043e\u0432 \u0432\u044b\u0448\u0435, \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u043a\u043e\u043d\u0442\u0440\u0438\u0442\u044c\u0441\u044f \ud83d\ude01\u003C\/p\u003E\n\n\u003Cp\u003E\u0418\u0442\u043e\u0433 - \u0418\u0432\u0435\u043d\u0442 \u0441\u043a\u0443\u0447\u043d\u0430\u044f \u0437\u0430\u043b\u0443\u043f\u0430 \u0431\u0435\u0437 \u043d\u0430\u0433\u0440\u0430\u0434, \u0442\u0438\u043f\u044b \u0438\u0441\u043f\u043e\u0440\u0442\u0438\u043b\u0438 \u0442\u0440\u0443\u0434\u044b \u0431\u044b\u043b\u043e \u0446\u0438\u0432\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u0438, \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432 \u0441\u0443\u043f\u0435\u0440 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0443\u044e \u0437\u0430\u0434\u0443\u043c\u043a\u0443 \u0432 \u0433\u043e\u0432\u043d\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u041c\u0431 \u0440\u0430\u0437\u0440\u0430\u0431\u044b \u043a \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0443 \u043f\u043e\u0444\u0438\u043a\u0441\u044f\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b,\u0445\u043e\u0442\u044f \u0448\u0430\u043d\u0441 \u043e\u043a\u043e\u043b\u043e \u043d\u0443\u043b\u0435\u0432\u043e\u0439.\u003C\/p\u003E \n\n\n","renderFailed":false,"editedAt":"2026-10-28T21:19:41+00:00","canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":1,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":1,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":1,"63":1,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"197243"}},"user":{"data":{"type":"users","id":"1701649"}},"editedUser":{"data":{"type":"users","id":"1701649"}},"mentionedBy":{"data":[{"type":"posts","id":"4735305"}]},"likes":{"data":[]}}},{"type":"posts","id":"4735305","attributes":{"number":5,"createdAt":"2026-10-2