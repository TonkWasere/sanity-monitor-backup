3d\u0430\u0442\u044c \u0443 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u0438\u0433\u0440\u044b, \u0442\u0430\u043a \u0436\u0435 \u0443 \u0426\u0410.\u003Cbr\u003E\n\u0412\u043e\u043f\u0440\u043e\u0441\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u043c: \u0414\u043b\u044f \u0447\u0435\u0433\u043e \u0431\u044b\u043b\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u043e\u043a\u0430\u0437\u0443\u0430\u043b\u0438\u0432\u0430\u043d\u0438\u0435 \u0438\u0433\u0440\u044b \u043d\u0430\u0447\u0438\u043d\u0430\u044f \u0441 \u0431\u043e\u043b\u043e\u0442?\u003Cbr\u003E\n\u042f \u0434\u0443\u043c\u0430\u043b \u0438\u0433\u0440\u043e\u043a\u0438 \u0432\u0440\u0443\u0442 \u0438 \u0442\u043f, \u043d\u043e \u043d\u0435\u0442 \u0436\u0435, \u044f \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430, \u043f\u0440\u043e\u0431\u0435\u0436\u0430\u043b \u0432\u0441\u044e \u043b\u043e\u043a\u0430\u0446\u0438\u044e, \u043d\u0435 \u0443\u0432\u0438\u0434\u0435\u043b \u0442\u0430\u043c \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430, \u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u0431\u0435\u0436\u0430\u0432 \u043a \u0431\u0430\u0437\u0435. \u041d\u0415\u041a\u0421\u0422, \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0438 \u043d\u0430 \u043b\u043e\u043a\u0430\u0446\u0438\u0438 \u201c\u041e\u0431\u043e\u0447\u0438\u043d\u0430\u201d , \u0442\u0430\u043c \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0432\u0440\u0430\u0433\u0430 \u0434\u0430\u0436\u0435 \u043d\u0430 \u0430\u0432\u0430\u043d\u043f\u043e\u0441\u0442\u0443, \u0442\u0430\u043a\u0436\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b \u043f\u0440\u0438\u0431\u0435\u0436\u0430\u0432 \u043a \u0438\u0445 \u0431\u0430\u0437\u0435. \u0421\u0412\u0410\u041b\u041a\u0410, \u0442\u0443\u0442 \u044f \u0432\u043e\u043e\u0431\u0449\u0435 \u0447\u0443\u0442\u044c \u043d\u0435 \u0443\u043c\u0435\u0440, \u0440\u0430\u043d\u044c\u0448\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u044f(\u0442\u043e\u0433\u0434\u0430 \u0435\u0449\u0451 \u0441 \u041a\u0430\u0440\u0434\u043e\u043d\u0430), \u0431\u044b\u043b\u0430 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0430\u044f \u201c\u0433\u043e\u0440\u043b\u043e\u0432\u0438\u043d\u0430\u201d, \u0438 \u0442\u0430\u043c \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u043e\u0441\u0442\u0440\u0435\u043b\u044f\u0442\u044c\u0441\u044f, \u043d\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u0436\u0435, \u041e\u041f\u042f\u0422\u042c\u042c \u041d\u0418\u041a\u041e\u0413\u041e \u041d\u0415 \u0412\u0421\u0422\u0420\u0415\u0422\u0418\u041b , \u043d\u0430 \u0421\u0432\u0430\u043b\u043a\u0435, \u041d\u0415 \u0412\u0421\u0422\u0420\u0415\u0422\u0418\u041b \u041d\u0418\u041a\u041e\u0413\u041e, \u0427\u0442\u043e \u0437\u0430 \u0431\u0440\u0435\u0434? \u042f \u043f\u043e\u043c\u043d\u044e \u043a\u043e\u0433\u0434\u0430 \u0433\u043e\u0434\u0430 2-3 \u043d\u0430\u0437\u0430\u0434, \u044f \u0434\u0440\u0430\u043b\u0441\u044f \u0437\u0430 \u043c\u0435\u0434\u043d\u0443\u044e \u0438 \u0430\u043b\u044e\u043c\u0438\u043d\u0438\u0435\u0432\u0443\u044e \u043f\u0440\u043e\u0432\u043e\u043b\u043e\u043a\u0443, \u0431\u044b\u043b \u0440\u0430\u0434 \u0434\u0430\u0436\u0435 7 \u0448\u0442\u0443\u043a \u0432\u044b\u043d\u0435\u0441\u0442\u0438 \u044d\u0442\u043e\u0439 \u043f\u0440\u043e\u0432\u043e\u043b\u043e\u043a\u0438,  \u0430 \u0441\u0435\u0439\u0447\u0430\u0441, \u0442\u044b \u0438\u0433\u0440\u0430\u0435\u0448\u044c \u0432 \u0438\u0433\u0440\u0443, \u0433\u0434\u0435 \u043d\u0443\u0436\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u0435\u0433\u0430\u0442\u044c, \u0441\u0442\u0440\u0435\u043b\u044f\u0442\u044c \u041d\u041f\u0421, \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u0433\u043e\u0432\u043d\u043e \u0432 \u0442\u0430\u0439\u043d\u0438\u043a\u0430\u0445. \u0413\u0434\u0435 \u043d\u043e\u0432\u0438\u0447\u043a\u0430\u043c \u043f\u0440\u0438\u0432\u044b\u043a\u0430\u0442\u044c \u043a \u0441\u0442\u0440\u0435\u043b\u044c\u0431\u0435? \u041f\u043e\u0447\u0435\u043c\u0443 \u043d\u0435\u0442 \u0444\u0430\u0439\u0442\u043e\u0432 \u043d\u0430 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u044b\u0445 \u043b\u043e\u043a\u0430\u0446\u0438\u044f\u0445? \u0414\u0443\u043c\u0430\u0435\u0442\u0435 \u0435\u0441\u0442\u044c \u043f\u0440\u0438\u0431\u0435\u0436\u0430\u0432 \u0432 \u0431\u0430\u0440? \u041e\u0442 \u0447\u0430\u0441\u0442\u0438 \u0432\u044b \u043f\u0440\u0430\u0432\u044b, \u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u043b\u0438 \u0431\u0443\u0434\u0435\u0442 \u043a\u0430\u043a\u043e\u0439 \u043d\u0438\u0431\u0443\u0434\u044c \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u044b\u0439 \u043c\u0438\u043a\u0440\u043e\u0447\u0435\u043b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0435\u0448\u0438\u0442 \u0438\u0437\u0443\u0447\u0438\u0442\u044c \u0432\u0440\u0430\u0436\u0434\u0443\u044e\u0449\u0438\u0435 \u043b\u043e\u043a\u0438, \u043b\u0438\u0431\u043e \u0436\u0435 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u041f\u041a\u0448\u0438\u0442\u044c. \u003Cbr\u003E\n\u041d\u0430 \u0441\u0435\u0432\u0435\u0440\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0443\u0436\u0435 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u0430\u044f \u0432\u0441\u0435\u043c, \u0432 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435 \u043a\u0430\u043a \u0438 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c +- \u003Cbr\u003E\n\u0422\u0435\u043f\u0435\u0440\u044c \u0433\u043b\u0430\u0432\u043d\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b.\u003Cbr\u003E\n\u0427\u0442\u043e \u0432\u044b \u0445\u043e\u0442\u0438\u0442\u