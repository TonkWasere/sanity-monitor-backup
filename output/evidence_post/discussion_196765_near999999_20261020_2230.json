043b\u043e \u0438 \u043d\u0430\u0441\u0442\u043e\u0435\u0431\u0435\u043d\u0438\u043b\u043e \u0438 \u0442.\u0434 \u0438 \u0442.\u043f. \u003Cbr\u003E\n\u0410 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u0432 \u0447\u0435\u043c \u0441\u0443\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b, \u0447\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u0442\u0430\u043a\u043e\u0433\u043e \u0440\u043e\u0434\u0430 \u043d\u0435\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0430? \u0415\u0441\u0442\u044c \u0432\u043e\u043f\u0440\u043e\u0441 \u043b\u0443\u0447\u0448\u0435: \u00ab\u043a\u043e\u0433\u0434\u0430?\u00bb\u2026 \u0421 21:00 \u0434\u043e 00:00 \u0438 \u0441 05:00 \u0434\u043e 08:00 \u043f\u043e \u0438\u0433\u0440\u043e\u0432\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438\u2026 6 \u0447\u0430\u0441\u043e\u0432, \u00bc \u0438\u0433\u0440\u043e\u0432\u044b\u0445 \u0441\u0443\u0442\u043e\u043a \u0438 36 \u043c\u0438\u043d\u0443\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0418\u043c\u0435\u043d\u043d\u043e \u0432 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0438 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u0438\u0442\u0441\u044f \u0437\u043b\u043e\u0435\u0431\u0443\u0447\u0438\u0439 \u0440\u0430\u0441\u0441\u0432\u0435\u0442 \u0438 \u0437\u0430\u043a\u0430\u0442 - \u043f\u043e 18 \u043c\u0438\u043d\u0443\u0442 \u0442\u0435\u043c\u043d\u043e\u0442\u044b \u0431\u0435\u0437 \u041f\u041d\u0412 \u0438 \u0432\u044b\u0436\u0438\u0433\u0430\u044e\u0449\u0438\u0435 \u0433\u043b\u0430\u0437\u0430 \u043b\u0443\u0447\u0438 \u0441\u0432\u0435\u0442\u0430 \u0438 \u044f\u0440\u043a\u043e\u0441\u0442\u044c \u0441 \u041f\u041d\u0412, \u0430 \u043a\u0430\u043a \u0438\u0442\u043e\u0433: \u0420\u043e\u043b\u044c \u0442\u043e\u043b\u044c\u043a\u043e, \u0447\u0442\u043e \u0440\u043e\u0434\u0438\u0432\u0448\u0435\u0433\u043e\u0441\u044f \u043a\u043e\u0442\u0435\u043d\u043a\u0430 \u043d\u0443 \u0438\u043b\u0438 \u043a\u0440\u043e\u0442\u0430, \u043a\u043e\u043c\u0443 \u043a\u0430\u043a \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u0418 \u0432\u0440\u043e\u0434\u0435 \u0434\u0430\u0436\u0435 \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u043e, \u0432\u0435\u0434\u044c \u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u041f\u041d\u0412 \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u0443\u043c\u043d\u043e\u0436\u0430\u0442\u044c \u0441\u043b\u0430\u0431\u044b\u0439 \u0441\u0432\u0435\u0442 \u043e\u0442 \u043b\u0443\u043d\u044b, \u0437\u0432\u0435\u0437\u0434 \u0438 \u0442.\u0434. \u0418 \u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0441\u0432\u0435\u0442\u0430 \u043f\u043e \u0442\u0438\u043f\u0443 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445 \u043b\u0443\u0447\u0435\u0439 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0441\u043b\u0435\u043f\u043b\u044f\u0435\u0442 \u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044f\u2026 \u041d\u043e \u0442\u0443\u0442 \u0435\u0441\u0442\u044c \u0442\u043e\u043d\u043a\u0430\u044f \u0433\u0440\u0430\u043d\u044c \u043c\u0435\u0436\u0434\u0443 \u003Cstrong\u003E\u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0439 \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e\u003C\/strong\u003E \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0439 \u0441 \u0436\u0430\u043d\u0440\u043e\u043c \u0438\u0433\u0440\u044b, \u0441\u0442\u0438\u043b\u0435\u043c \u0438 \u0442.\u0434, \u0438 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0441\u0442\u044c\u044e - \u003Cstrong\u003E\u043d\u0435\u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u043d\u044b\u043c \u0440\u0435\u0430\u043b\u0438\u0437\u043c\u043e\u043c\u003C\/strong\u003E, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u0434\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u043e \u0432\u0440\u0435\u0434. \u0418 \u0434\u0430, \u044f \u0438\u043c\u0435\u044e \u0432\u0432\u0438\u0434\u0443, \u0447\u0442\u043e \u044d\u0442\u043e \u043e\u0441\u043b\u0435\u043f\u043b\u0435\u043d\u0438\u0435 - \u0432\u0442\u043e\u0440\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u2026 \u041f\u043e\u0447\u0435\u043c\u0443? \u0432\u0441\u0435 \u043d\u0435 \u0442\u0430\u043a \u0441\u043b\u043e\u0436\u043d\u043e, \u044d\u0442\u0430 \u00ab\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u00bb, \u043d\u0430\u0437\u043e\u0432\u0435\u043c \u0435\u0435 \u0442\u0430\u043a\u2026\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0435 \u0441\u043e\u0447\u0435\u0442\u0430\u0435\u0442\u0441\u044f \u0441 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0435\u0439 \u0438\u0433\u0440\u044b, \u0435\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e, \u0442\u0442\u043a \u0438 \u0436\u0430\u043d\u0440\u043e\u0432\u044b\u043c \u0440\u0435\u0430\u043b\u0438\u0437\u043c\u043e\u043c. \u0415\u0441\u043b\u0438 \u0432\u0437\u044f\u0442\u044c \u043a\u0430\u043a\u0443\u044e-\u043d\u0438\u0431\u0443\u0434\u044c \u0410\u0440\u043c\u0443 \u0438\u043b\u0438 \u043f\u043e\u0445\u043e\u0436\u0438\u0439 \u0442\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0448\u0443\u0442\u0435\u0440, \u0442\u043e \u0442\u0430\u043c \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u043a \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0434\u0430\u0435\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043b\u044f \u0442\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043c\u0430\u043d\u0435\u0432\u0440\u0430 \u0438\u043b\u0438 \u0447\u0435\u0433\u043e-\u0442\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0433\u043e. \u0412 \u0441\u0442\u0430\u043b\u0437\u043e\u043d\u0435 \u0436\u0435 \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u043a \u043d\u0435 \u0434\u0430\u0435\u0442 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0438\u043c\u043f\u0430\u043a\u0442\u0430 \u0438\u0437 \u0437\u0430, \u043a\u0430\u043a \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043e \u0432\u044b\u0448\u0435, \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438, \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0440\u0430\u0434\u0430\u0440\u0430 \u0438 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0436\u0438\u0437\u043d\u0438, \u043f\u043b\u044e\u0441\u043e\u043c \u043a \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e, \u043f\u0440\u0438 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0441\u0432\u0435\u0442\u043b\u043e \u0431\u0435\u0437 \u043f\u043d\u0432, \u0447\u0442\u043e\u0431\u044b \u044d\u0442\u043e \u043c\u043e\u0433\u043b\u043e \u0445\u043e\u0442\u044c \u043a\u0430\u043a-\u0442\u043e \u043f\u043e\u043c\u043e\u0447\u044c \u0431\u044b\u0442\u044c \u201c\u043d\u0435\u0437\u0430\u043c\u0435\u0442\u043d\u044b\u043c\u201d\u2026\u003C\/p\u003E\n \n\u003Cp\u003E\u0418 \u044f \u0441\u0438\u043b\u044c\u043d\u043e \u0441\u043e\u043c\u043d\u0435\u0432\u0430\u044e\u0441\u044c, \u0447\u0442\u043e \u0445\u043e\u0442\u044c \u043a\u043e\u043c\u0443-\u0442\u043e \u0438\u0437 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0432\u0448\u0438\u0445 \u044d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0445\u043e\u0442\u044c \u043a\u0430\u043a-\u0442\u043e, \u043a\u043e\u0433\u0434\u0430-\u043d\u0438\u0431\u0443\u0434\u044c \u043f\u043e\u043c\u043e\u0433\u043b\u043e, \u0432\u0435\u0434\u044c \u044d\u0442\u043e\u0442 \u0437\u0430\u0441\u0432\u0435\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043d\u0435 \u043d\u0435\u0438\u0433\u0440\u0430\u0431\u0435\u043b\u044c\u043d\u044b\u043c, \u0430 \u0441\u043a\u043e\u0440\u0435\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u044b\u043c. \u0414\u0430 \u0438 \u0441\u043e\u043c\u043d\u0435\u0432\u0430\u044e\u0441\u044c, \u0447\u0442\u043e \u043d\u0430\u0439\u0434\u0435\u0442\u0441\u044f \u0442\u043e\u0442, \u043a\u043e\u043c\u0443 \u0431\u044b \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u043e\u0441\u044c \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u0443\u0442\u043e\u043a\u2026\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u041a\u0430\u043a \u0440\u0435\u0448\u0438\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443?\u003C\/strong\u003E \u042f \u0432\u0438\u0436\u0443 2 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430, \u043f\u043e\u043c\u0438\u043c\u043e \u0437\u0430\u0431\u0438\u0432\u0430\u043d\u0438\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0433\u043e \u0431\u043e\u043b\u0442\u0430.\u003C\/p\u003E \n\u003Col style=\u0022list-style-type:decimal\u0022\u003E\u003Cli\u003E\u003Cp\u003E\u0421\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u0442\u044c \u0440\u0430\u0441\u0441\u0432\u0435\u0442-\u0437\u0430\u043a\u0430\u0442 \u0438 \u043d\u043e\u0447\u044c-\u0434\u0435\u043d\u044c \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b, \u043a\u043e\u0433\u0434\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0432\u044b\u0436\u0438\u0433\u0430\u0442\u044c \u0433\u043b\u0430\u0437\u0430 \u0438\u043b\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0432\u0438\u0434\u043d\u043e, \u0432 \u044d\u0442\u043e\u0442 \u0436\u0435 \u043c\u043e\u043c\u0435\u043d\u0442 \u0443\u0436\u0435 \u0431\u044b\u043b\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e \u0434\u043b\u044f \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u00ab\u0440\u0435\u0436\u0438\u043c\u0430\u00bb - \u0431\u0435\u0437 \u041f\u041d\u0412 \u0438\u043b\u0438 \u0441 \u041f\u041d\u0412.\u003C\/p\u003E\u003C\/li\u003E\n\