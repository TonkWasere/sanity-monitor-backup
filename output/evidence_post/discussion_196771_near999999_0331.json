\u0442\u043a\u0438\u0439 \u0444\u0430\u043d\u0442\u043e\u043c, \u043f\u043e\u0440\u043e\u0436\u0434\u0435\u043d\u043d\u044b\u0439 \u0440\u0430\u0437\u0443\u043c\u043e\u043c.\u003Cbr\u003E\n\u0417\u043e\u043d\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u043c\u0435\u043d\u044f\u0442\u044c\u0441\u044f, \u0438 \u044f\u0432\u043d\u043e \u043d\u0435 \u043d\u0430 \u043f\u0443\u0441\u0442\u043e\u043c \u043c\u0435\u0441\u0442\u0435. \u041e\u043d\u0430 \u0432\u044b\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u043d\u0430\u0438\u0437\u043d\u0430\u043d\u043a\u0443 \u0441\u0442\u0440\u0430\u0445\u0438, \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u0438 \u043c\u044b\u0441\u043b\u0438 \u043e\u0431\u0438\u0442\u0430\u0442\u0435\u043b\u0435\u0439 \u043b\u0430\u0433\u0435\u0440\u0435\u0439. \u0412\u0441\u043b\u0435\u0434 \u0437\u0430 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c \u0432 \u0432\u0438\u0434\u0435 \u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445 \u043b\u0430\u043c\u043f \u0438 \u043f\u0443\u0433\u0430\u043b \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u043c\u0435\u043d\u044f\u0442\u044c\u0441\u044f \u0438 \u00ab\u0436\u0438\u0432\u043e\u0439\u00bb, \u0434\u044b\u0448\u0430\u0449\u0438\u0439 (\u0430 \u043c\u043e\u0436\u0435\u0442, \u0443\u0436\u0435 \u0438 \u043d\u0435\u0442) \u043c\u0438\u0440. \u041e\u0431\u0438\u0442\u0430\u0442\u0435\u043b\u0438 \u0417\u043e\u043d\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u0445\u043e\u0434\u044f\u0442 \u0441 \u0443\u043c\u0430, \u0438\u0445 \u0437\u0430\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442 \u0432 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043f\u0441\u0438\u0445\u043e\u0437. \u041e\u043d\u0438 \u0441\u0442\u0430\u0441\u043a\u0438\u0432\u0430\u044e\u0442 \u0432 \u0441\u0432\u043e\u0438 \u043b\u0430\u0433\u0435\u0440\u044f \u0441\u0442\u0430\u0440\u044b\u0435 \u043a\u0438\u043d\u0435\u0441\u043a\u043e\u043f\u043d\u044b\u0435 \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u043e\u0440\u044b, \u043b\u0430\u043c\u043f\u044b \u0438 \u0440\u0430\u0434\u0438\u043e\u043f\u0440\u0438\u0435\u043c\u043d\u0438\u043a\u0438, \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u043f\u043e\u0439\u043c\u0430\u0442\u044c \u0441\u0438\u0433\u043d\u0430\u043b\u044b \u0438\u0437 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e \u0438\u043b\u0438 \u0437\u0430\u0433\u043b\u0443\u0448\u0438\u0442\u044c \u0448\u0435\u043f\u043e\u0442 \u0432 \u0433\u043e\u043b\u043e\u0432\u0435. \u042d\u043a\u0440\u0430\u043d\u044b \u043c\u0438\u0433\u0430\u044e\u0442 \u0436\u0443\u0442\u043a\u0438\u043c\u0438 \u043f\u043e\u043c\u0435\u0445\u0430\u043c\u0438, \u0430 \u0441\u0430\u043c\u0438 \u043a\u0435\u043c\u043f\u044b \u0431\u0435\u0437\u0443\u043c\u043d\u043e \u043e\u0431\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0433\u0440\u044f\u0437\u043d\u044b\u043c \u0441\u0435\u043d\u043e\u043c \u0438 \u0441\u043e\u043b\u043e\u043c\u043e\u0439, \u043e\u0431\u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044f \u00ab\u0433\u043d\u0435\u0437\u0434\u0430\u00bb \u0438\u043b\u0438 \u043f\u043e\u0434\u043e\u0431\u0438\u044f \u0440\u0438\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0445 \u043c\u0435\u0441\u0442 \u0434\u043b\u044f \u0437\u0430\u0449\u0438\u0442\u044b \u043e\u0442 \u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0430\u0432\u043b\u0435\u043d\u0438\u044f.\u003Cbr\u003E\n\u0412\u0434\u0440\u0443\u0433 \u043a\u0442\u043e-\u0442\u043e \u043f\u0440\u0438\u0448\u044c\u0435\u0442 \u0441\u0435\u0431\u0435 \u043f\u0443\u0447\u043e\u043a \u0441\u043e\u043b\u043e\u043c\u044b \u043a \u0448\u043b\u0435\u043c\u0443? \u0412\u0434\u0440\u0443\u0433 \u043a\u0442\u043e-\u0442\u043e \u0441\u0432\u044f\u0436\u0435\u0442 \u0441\u043d\u043e\u043f, \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e\u0449\u0438\u0439 \u0447\u0442\u043e-\u0442\u043e, \u0442\u043e\u043b\u044c\u043a\u043e \u0435\u043c\u0443 \u043e\u0434\u043d\u043e\u043c\u0443 \u0437\u043d\u0430\u043a\u043e\u043c\u043e\u0435? \u0412\u0434\u0440\u0443\u0433 \u043a\u0442\u043e-\u0442\u043e \u043d\u043e\u0447\u044c\u044e \u043d\u0430\u0447\u043d\u0435\u0442 \u0432\u0438\u0434\u0435\u0442\u044c \u0442\u0435\u0445, \u043a\u0442\u043e \u0443\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0443\u0448\u0435\u043b?\u003Cbr\u003E\n\u0412\u0434\u0440\u0443\u0433 \u043c\u0443\u0442\u0430\u043d\u0442\u044b \u043d\u0430\u0447\u043d\u0443\u0442 \u0432\u044b\u0445\u043e\u0434\u0438\u0442\u044c \u0438\u0437 \u0441\u0432\u043e\u0438\u0445 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u044b\u0445 \u0430\u0440\u0435\u0430\u043b\u043e\u0432 \u0438 \u043f\u043e\u0439\u0434\u0443\u0442 \u0431\u043b\u0443\u0436\u0434\u0430\u0442\u044c \u0437\u0430 \u0437\u0430\u043f\u0430\u0445\u043e\u043c \u0441\u0432\u0435\u0436\u0435\u0433\u043e \u0441\u0435\u043d\u0430, \u0431\u0440\u043e\u0434\u044f \u0432 \u0442\u0440\u0430\u043d\u0441\u0435 \u043f\u043e \u043f\u0443\u0441\u0442\u044b\u043c \u043c\u0435\u0441\u0442\u0430\u043c \u0438 \u0432\u044b\u0438\u0441\u043a\u0438\u0432\u0430\u044f \u0447\u0442\u043e-\u0442\u043e?\u003Cbr\u003E\n\u0412\u0434\u0440\u0443\u0433 \u043f\u0440\u0438 \u0437\u0430\u0447\u0438\u0441\u0442\u043a\u0435 \u0442\u0430\u043a\u0438\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u043d\u044b\u0445 \u043a\u0435\u043c\u043f\u043e\u0432 \u0441 \u043c\u043e\u0431\u043e\u0432 \u0438 \u043b\u044e\u0434\u0435\u0439 \u0441 \u043d\u0438\u0447\u0442\u043e\u0436\u043d\u044b\u043c \u0448\u0430\u043d\u0441\u043e\u043c \u043d\u0430\u0447\u043d\u0443\u0442 \u0432\u044b\u043f\u0430\u0434\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0435 \u0441\u0435\u0437\u043e\u043d\u043d\u044b\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044b - \u201c\u0418\u0441\u043a\u0430\u0436\u0435\u043d\u043d\u0430\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0438\u043a\u0430\u201d \u0438 \u201c\u041e\u0434\u0435\u0440\u0436\u0438\u043c\u043