u043e\u0431\u044b \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0434\u0435\u0438 \u0441\u0430\u043c\u043e\u043c\u0443, \u0438 \u043d\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044c \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u0435.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0438\u0439 \u0434\u0435\u043d\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043e \u0438 \u201c\u0443\u043f\u0430\u043a\u043e\u0432\u0430\u043d\u043e\u201d \u0432 \u0433\u043e\u0442\u043e\u0432\u044b\u0435 \u201c\u0448\u0430\u0431\u043b\u043e\u043d\u044b\u201d \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043b\u043e\u0432\u043d\u043e \u043b\u0435\u0433\u043e \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0448\u044c \u0432 \u0435\u0434\u0438\u043d\u043e\u0435 \u0446\u0435\u043b\u043e\u0435 \u0441 \u043f\u0440\u0430\u0432\u043a\u0430\u043c\u0438, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u043c\u0438 \u0434\u043b\u044f \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0438\u0434\u0435\u0438, \u043d\u0435\u0439\u0440\u043e\u043d\u043a\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0441\u043a\u043e\u0440\u0438\u043b\u0438 \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0446\u0435\u0441\u0441. \u041d\u043e \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0434\u043e \u0442\u0435\u0445 \u043f\u043e\u0440, \u043f\u043e\u043a\u0430 \u0442\u0432\u043e\u0439 \u201c\u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u201d \u043d\u0435 \u0441\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u044e, \u0433\u0434\u0435 \u043e\u043d\u043e \u0435\u0449\u0451 \u043d\u0435 \u0443\u0441\u043f\u0435\u043b\u043e \u043f\u043e\u0436\u0440\u0430\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0434\u0430\u043d\u043d\u044b\u0445 \u0434\u043b\u044f \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b, \u043a \u0442\u0430\u043a\u043e\u0439 \u043a\u0430\u043a \u0440\u0430\u0437 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u0434\u0430\u043d\u043d\u044b\u0439 \u0438\u0433\u0440\u043e\u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442 \u0441 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u043c\u0438, \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u043c\u0438 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u043a\u043e\u043b\u0435\u043d\u0438\u0439.\u003C\/p\u003E\n \n\u003Cp\u003E\u0422\u043e \u0435\u0441\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0442\u0443\u0442 \u201c\u0430\u0433\u0435\u043d\u0442\u043e\u0432\u201d \u0432 \u043a\u043e\u0434\u0435 \u0441\u043a\u043e\u0440\u0435\u0435 \u043d\u0430\u0432\u0440\u0435\u0434\u0438\u0442, \u0434\u0435\u0432\u0435\u043b\u043e\u043f\u0435\u0440 \u0431\u044b \u043d\u0430 \u043f\u0443\u0448\u0435\u0447\u043d\u044b\u0439 \u0432\u044b\u0441\u0442\u0440\u0435\u043b \u043d\u0435 \u043f\u043e\u0434\u043f\u0443\u0441\u0442\u0438\u043b \u0442\u0430\u043a\u043e\u0433\u043e \u043f\u043e\u043c\u043e\u0449\u043d\u0438\u043a\u0430 \u043a \u043f\u0440\u043e\u0435\u043a\u0442\u0443, \u043f\u0435\u0440\u0435\u0436\u0438\u0432\u0448\u0438\u043c \u043f\u043e \u0441\u0443\u0442\u0438 \u0442\u0440\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0445 \u0440\u0435\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0437\u0430\u0446\u0438\u0438 \u043a\u043e\u0434\u0430, \u0447\u04