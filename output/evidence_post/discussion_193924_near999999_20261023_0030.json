 \u0448\u0430\u0433\u0438 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E)))))))))\u003C\/p\u003E\n\n\u003Cp\u003E\u043d\u0430\u0439\u0441 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b\u0438 \u0440\u0435\u0431\u044f\u0442\u0430\u003C\/p\u003E\n\n\u003Cp\u003E\u0442\u043e \u0435\u0441\u0442\u044c \u0435\u0441\u043b\u0438 \u0442\u044b \u0434\u0440\u0443\u0433 \u043d\u0435 \u0443\u0441\u043f\u0435\u043b \u0437\u0430 \u0442\u043e \u0432\u0440\u0435\u043c\u044f, \u043f\u043e\u043a\u0430 \u0435\u0449\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432 \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438 \u043d\u0435 \u043f\u0440\u043e\u0448\u0430\u0440\u0438\u043b\u0430 \u0437\u0430 \u0442\u0432\u043e\u0439 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u0445\u0443\u0439 \u043d\u0430 \u043a\u0430\u0442\u043a\u0430\u0445 \u0441 +30 \u043f\u0442\u0441\/-30 \u043f\u0440\u0442\u0441 \u043d\u0430\u0431\u0440\u0430\u0442\u044c \u043d\u0443\u0436\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u041f\u0422\u0421 \u0434\u043b\u044f \u0430\u043f\u0430 \u0436\u0435\u043b\u0430\u0435\u043c\u043e\u0439 \u043b\u0438\u0433\u0438 - \u0432\u0441\u0435, \u0441\u043e\u0441\u0438 \u0445\u0443\u0439, \u0431\u0435\u0439\u0441\u044f \u043a\u0430\u0436\u0434\u0443\u044e \u043a\u0430\u0442\u043a\u0443 \u0437\u0430 +6-10, \u0430\u043f\u0430\u0439 \u043f\u043e 1 \u043b\u0438\u0433\u0435 \u0432 \u043d\u0435\u0434\u0435\u043b\u044e????))))))))\u003C\/p\u003E\n\n\u003Cp\u003E\u043e\u0445\u0443\u0435\u043d\u043d\u0430\u044f \u0442\u0435\u043c\u0430, \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043a\u0440\u0443\u0442\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u0432\u044b \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u043c\u043e\u043b\u043e\u0434\u0446\u044b, \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u0432 \u0438\u0433\