440\u0435\u0430\u043b\u044c\u043d\u043e \u0432\u0440\u043e\u0434\u0435 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u043e \u0440\u0435\u0448\u0438\u043b \u0443\u0437\u043d\u0430\u0442\u044c \u0447\u0442\u043e \u0434\u0430 \u043a\u0430\u043a \u0434\u0430 \u043f\u043e\u0447\u0435\u043c\u0443, \u043d\u043e \u043e\u0442\u0432\u0435\u0442 \u0435\u0433\u043e \u043d\u0435 \u0443\u0441\u0442\u0440\u043e\u0438\u043b \u0438 \u043e\u043d\u2026\u003Cbr\u003E\n\u041d\u0430\u0447\u0430\u043b \u0441\u0432\u043e\u044e \u0431\u043e\u0440\u044c\u0431\u0443 \u0430\u0445\u0430\u0445\u0430\u0445 \u003Cbr\u003E\n\u041f\u043e \u0441\u0443\u0442\u0438 \u0442\u0435\u043c \u0447\u0442\u043e \u043e\u043d \u0443\u0431\u0438\u0432\u0430\u043b \u0442\u0432\u0438\u043d\u043a\u043e\u0432 \u043f\u0443\u0441\u043a\u0430\u044e\u0449\u0438\u0445 \u043b\u044e\u0434\u0435\u0439, \u043e\u043d \u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0441\u0440\u0430\u043b \u0442\u0435\u043c \u043a\u0442\u043e \u0445\u043e\u0442\u0435\u043b \u043f\u043e\u043f\u0430\u0441\u0442\u044c \u0432 \u0431\u0443\u043d\u043a\u0435\u0440. \u0414\u0430 \u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u0435\u0441\u043b\u0438 \u043a\u0442\u043e \u0442\u043e \u043e\u0442\u043a\u043b\u0438\u043a\u043d\u0435\u0442\u0441\u044f \u0438 \u0431\u0443\u0434\u0435\u0442 \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u043b\u044e\u0434\u0435\u0439 \u0414\u0421 \u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u0442\u043e \u0442\u043e\u0436\u0435 \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u0434\u043d\u0430\u0441\u0435\u0440 \u0442\u043e\u043b\u044c\u043a\u043e \u043b\u044e\u0434\u044f\u043c \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0445\u043e\u0442\u044f\u0442 \u043a\u043e\u0441\u0442\u044e\u043c \u043f\u043e\u043b\u0443\u0442\u0430\u0442\u044c \u0438 \u043e\u0431\u0440\u0430\u0442\u0438\u043b\u0438\u0441\u044c \u0432 \u0414\u0421 \u0441\u0435\u0440\u0432\u0435\u0440) \u041d\u0443 \u0438 \u043c\u043e\u0436