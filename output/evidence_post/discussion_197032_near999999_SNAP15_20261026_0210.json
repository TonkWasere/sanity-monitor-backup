2\u0447\u0430, \u0442\u043e \u0434\u0430\u0432\u0430\u0442\u044c \u0435\u043c\u0443 \u0431\u0430\u043d \u043d\u0435 \u043d\u0430 10 \u043c\u0438\u043d\u0443\u0442 \u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u0430\u0442\u0447 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u0441\u044f, \u0430 \u043f\u043e \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0449\u0435\u0439. \u0422\u043e \u0435\u0441\u0442\u044c \u0441\u043d\u0430\u0447\u0430\u043b\u0430 10 \u043c\u0438\u043d\u0443\u0442, 20 \u043c\u0438\u043d\u0443\u0442, 30 \u043c\u0438\u043d\u0443\u0442, \u0447\u0430\u0441, \u0434\u0432\u0430 \u0447\u0430\u0441\u0430, \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0438 \u0442\u0434. \u0410 \u0442\u043e, \u0435\u0441\u0442\u044c \u0442\u0438\u043f\u044b \u043d\u0430 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043f\u043e\u0435\u0431\u0430\u0442\u044c \u0438 \u0435\u0441\u043b\u0438 \u043e\u043d\u0438 \u0432\u0438\u0434\u044f\u0442 \u0445\u043e\u0442\u044f \u0431\u044b \u043c\u0430\u043b\u0435\u0439\u0448\u0443\u044e \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0446\u0438\u044e, \u0432\u0438\u0434\u044f\u0442 \u0447\u0442\u043e \u043f\u0440\u0438\u0434\u0451\u0442\u0441\u044f \u043f\u043e\u0442\u0435\u0442\u044c \u0438 \u0441\u0442\u0430\u0440\u0430\u0442\u044c\u0441\u044f, \u0432 \u0442\u0443\u043f\u0443\u044e \u043d\u0430 \u043f\u0435\u0440\u0432\u043e\u043c \u0440\u0430\u0443\u043d\u0434\u0435 \u0432\u044b\u0445\u043e\u0434\u044f\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u0414\u0430\u043b\u044c\u0448\u0435, \u0441\u0430\u043c\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430. \u041d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u0440\u044f\u043d\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0442\u0430\u043c \u0441\u0442\u043e\u0438\u0442, \u0447\u0442\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0438\u0433\u0440\u0430\u0442\u044c 20 \u043a\u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u0430\u0447\u043d\u044b\u0445 \u043c\u0430\u0442\u0447\u0435\u0439. \u0412\u043e \u0432\u0441\u0435\u0445 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0448\u0443\u0442\u0435\u0440\u0430\u0445 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0441 \u0433\u043e\u043b\u043e\u0432\u043e\u0439 10 \u043c\u0430\u0442\u0447\u0435\u0439 \u0434\u043b\u044f \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0438. \u0421\u0430\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0438 \u0440\u0430\u0441\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0445\u0443\u0435\u0432\u0443 \u043d\u0435 \u043d\u0443\u0436\u043d\u0443\u044e \u043a\u0443\u0447\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0412\u043e\u0442 \u0432\u0437\u044f\u043b\u0438 \u0432\u044b \u0442\u0438\u043f\u0430 0 \u043c\u0430\u0442\u0447\u0435\u0439, \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0431\u043e\u043c\u0436\u0435\u0439 \u0437\u0430\u043a\u0438\u043d\u0443\u043b\u0438, \u043d\u0435\u043a\u0441\u0442 \u043f\u0440\u043e\u0442\u0438\u0432 2700-3000 \u044d\u043b\u043e \u0438 \u0432\u0441\u0451. \u0423\u0447\u0438\u0442\u0435 \u0441\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0447\u0442\u043e\u0431 \u043e\u043d\u0430 \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043b\u0430 \u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u043b\u0430 \u043d\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443, \u0430 \u043d\u0435 \u0442\u0430\u043a \u0447\u0442\u043e \u0447\u0430\u0442 \u0433\u0431\u0442 \u043d\u0430 \u0440\u0430\u043d\u0434\u043e\u043c \u0432\u044b\u0434\u0430\u043b \u0440\u0435\u0439\u0442\u0438\u043d\u0433. \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0442\u0438\u0432 \u0442\u043e\u043f\u0435\u0440\u043e\u0432 \u0442\u0438\u043f\u043e\u0447\u0435\u043a \u043e\u0442\u044b\u0433\u0440\u0430\u0442\u044c \u043d\u0435 \u043c\u043e\u0436\u0435\u0442, \u0430 \u0431\u043e\u043c\u0436\u0435\u0439 \u0432 \u043d\u0443\u043b\u0438\u043d\u0443 \u0440\u0430\u0437\u044a\u0435\u0431\u0430\u043b, \u0442\u043e \u043a\u0438\u0434\u0430\u0435\u0442\u0435 \u0435\u0433\u043e \u0443\u0436\u0435 \u043d\u0430 2400-2500 \u044d\u043b\u043e \u0438 \u0442\u0434. \u0418 \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u043d\u0435 \u043d\u0443\u0436\u043d\u0430\u044f 50 \u043b\u0435\u0442\u043d\u044f\u044f \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430. \u0410\u0440\u0433\u0443\u043c\u0435\u043d\u0442 \u043f\u0440\u043e \u0442\u0432\u0438\u043d\u043a\u043e\u0432\u043e\u0434\u043e\u0432 \u0438 \u0431\u0443\u0441\u0442\u0435\u0440 \u043d\u0435 \u043f\u0440\u043e\u043a\u0430\u0442\u0438\u0442.\u003C\/p\u003E \n\n\u003Cp\u003E\u0418\u0434\u0451\u043c \u0434\u0430\u043b\u044c\u0448\u0435, \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0431\u0430\u043d \u043b\u0438\u0441\u0442. \u041d\u0430 \u0444\u0435\u0439\u0441\u0438\u0442\u0435 \u0435\u0441\u0442\u044c \u0442\u0430\u043a\u0430\u044f \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0448\u0442\u0443\u043a\u0430 \u043a\u0430\u043a \u0431\u0430\u043d \u043b\u0438\u0441\u0442, \u043a\u0443\u0434\u0430 \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043a\u0438\u043d\u0443\u0442\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c 5 \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u041f\u043e\u0447\u0435\u043c\u0443 \u0431\u044b \u0442\u0430\u043a\u043e\u0435 \u043d\u0435 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c? \u0412\u043e\u0442 \u0441\u044b\u0433\u0440\u0430\u043b\u0438 \u0432\u044b \u0441 \u0442\u0438\u043f\u043e\u043c \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0431\u0435\u0433\u0430\u0435\u0442 \u0438 \u043b\u0430\u043f\u0443 \u0441\u043e\u0441\u00eb\u0442, \u043d\u0438\u0447\u0435\u0433\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0448\u043a\u0435\u0440\u0438\u0442\u0441\u044f \u043e\u0442 \u0432\u0441\u0435\u0445 (\u0432\u044b \u043f\u043e \u043b\u044e\u0431\u043e\u043c\u0443 \u0442\u0430\u043a\u0438\u0445 \u0438\u043c\u0431\u0435\u0446\u0438\u043b\u043e\u0432 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0438). \u041f\u043e\u0441\u043b\u0435 \u043a\u0430\u0442\u043a\u0438 \u0432\u044b \u0431\u0435\u0440\u00eb\u0442\u0435 \u0438 \u0437\u0430\u043a\u0438\u0434\u044b\u0432\u0430\u0435\u0442\u0435 \u0432 \u043b\u0438\u0447\u043d\u044b\u0439 \u0431\u0430\u043d \u043b\u0438\u0441\u0442 \u0447\u0442\u043e\u0431 \u043d\u0435 \u043f\u043e\u043f\u0430\u0434\u0430\u043b\u0441\u044f \u0432 \u043e\u0434\u043d\u043e\u0439 \u043f\u0430\u0442\u0438 \u0431\u043e\u043b\u044c\u0448\u0435. \u041d\u043e \u043d\u0443\u0436\u043d\u043e \u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0432 \u0443\u043c\u0435 \u0447\u0442\u043e \u043c\u0435\u0441\u0442 \u0432 \u0431\u0430\u043d \u043b\u0438\u0441\u0442\u0435 \u0432\u0441\u0433\u043e 5. \u0418\u0434\u0435\u044f \u0448\u0438\u043a\u0430\u0440\u043d\u0430\u044f \u044f \u0441\u0447\u0438\u0442\u0430\u044e. \u0418\u0437\u0431\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u0441\u043a\u0440\u044b\u0442\u043e\u043f\u0443\u043b\u044c\u043d\u044b\u0445 \u0432 \u043b\u043e\u0431\u0431\u0438 \u0431\u044b\u043b\u043e \u0431\u044b \u0448\u0438\u043a\u0430\u0440\u043d\u043e.\u003C\/p\u003E \n\n\u003Cp\u003E\u0424\u0435\u0439\u0441\u0438\u0442 \u0438 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u041a\u043e\u043b\u0438\u0437\u0435\u044f \u043f\u043e\u0447\u0442\u0438 \u043e\u0434\u043d\u043e \u0438 \u0442\u043e\u0436\u0435. \u041f\u043e\u0447\u0435\u043c\u0443 \u0431\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0435\u0440\u0435\u043d\u044f\u0442\u044c \u0444\u0438\u0448\u043a\u0438 \u0438\u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0432 \u0441\u0432\u043e\u0439, \u0433\u0434\u0435 \u044d\u0442\u0438 \u0444\u0438\u0448\u043a\u0438 \u0431\u044b\u043b\u0438 \u0431\u044b \u043a\u0430\u043a \u043d\u0435\u043b\u044c\u0437\u044f \u043a\u0441\u0442\u0430\u0442\u0438. \u0422\u043e\u0442 \u0436\u0435 \u0440\u0435\u0439\u0442\u0438\u043d\u0433, \u0442\u043e\u0442 \u0436\u0435 \u0434\u0440\u043e\u0447\u044c \u043d\u0430 \u0446\u0438\u0444\u0435\u0440\u043a\u0438, \u043a\u043e\u043c\u0430\u043d\u0434\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430, \u0441\u043a\u0438\u043b\u043b \u0440\u043e\u043b\u044f\u0435\u0442 \u043e\u0447\u0435\u043d\u044c,  \u0442\u0430\u043a\u0442\u0438\u043a\u0438 \u0442\u043e\u0436\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0432 \u043e\u0431\u0435\u0438\u0445 \u0438\u0433\u0440\u0430\u0445 \u0438 \u0432\u044b \u043d\u0435 \u0431\u0435\u0433\u0430\u0435\u0442\u0435 \u0432 \u0442\u0443\u043f\u0443\u044e \u043f\u043e \u043a\u0430\u0440\u0442\u0435. \u0414\u0443\u0445 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f \u0435\u0441\u0442\u044c \u0438 \u043e\u043d \u0443\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0431 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e.\u003C\/p\u003E ","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":2,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReacti