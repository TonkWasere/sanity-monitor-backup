0442\u0438\u044f \u0424\u041f\u0421\u043e\u0432. \u0415\u0441\u043b\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0442\u0440\u0430\u0445\u0435\u043d-\u0442\u0440\u0430\u0445\u0435\u043d \u043a\u0430\u0440\u0442\u0430 - \u043a\u0440\u0443\u0442\u043e. \u0415\u0441\u043b\u0438 \u0433\u043e\u0432\u043d\u043e - \u0442\u043e\u0436\u0435 \u043a\u0440\u0443\u0442\u043e. \u0417\u043d\u0430\u0435\u043c, \u043a\u043e\u0433\u043e \u043d\u0430\u0434\u043e \u0431\u0443\u0434\u0435\u0442 \u043a\u0430\u0437\u043d\u0438\u0442\u044c \u0437\u0430 \u0432\u043e\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f. \u041f\u043b\u044e\u0441 \u0433\u043b\u044f\u043d\u0443\u043b \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b, \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c, \u0445\u043e\u0442\u0441\u043f\u043e\u0442\u044b - \u043e\u0442 \u0441\u0442\u0430\u0440\u043e\u0439 \u043a\u0430\u0440\u0442\u044b \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u043e\u0442\u043b\u0438\u0447\u0430\u0435\u0442\u0441\u044f (\u043f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 \u043d\u0430 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430\u0445 \u0441 \u0433\u0440\u0430\u0444\u0438\u043a\u0430\u043c\u0438).\u003C\/p\u003E\n\n\u003Cp\u003E\u0411\u0422\u0412 \u043d\u0443 \u0438 \u0437\u0430\u0440\u0435\u0448\u0430\u043b\u043e \u0442\u043e, \u0447\u0442\u043e \u0443 \u043c\u0435\u043d\u044f \u043a\u0443\u043f\u0438\u043b\u0438 5070\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 5 \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0437\u0430 100\u043a. \u0414\u0430, \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u044b \u043f\u0440\u043e\u0434\u0430\u0442\u044c \u0437\u0430 120 \u0435\u0441\u043b\u0438 \u0431\u044b \u043f\u043e\u0442\u0440\u0430\u04