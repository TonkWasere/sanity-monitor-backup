0430 \u0443 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438 \u0432 \u043c\u043e\u043c\u0435\u043d\u0442\u0435 \u0441\u043e\u0437\u0434\u0430\u0435\u0442\u003C\/p\u003E \n\n\u003Cul\u003E\u003Cli\u003E\u003Cp\u003E\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0434\u043b\u044f \u043f\u0441\u0438\u043e\u043f\u0430. \u0421\u0440\u0435\u0434\u043d\u0435\u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438\u0433\u0440\u043e\u043a \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0443\u0433\u043b\u0443\u0431\u043b\u044f\u0442\u044c\u0441\u044f \u0432 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u043a \u0438\u0433\u0440\u044b \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u043e\u043d \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0439\u0434\u0435\u0442 \u043a \u043c\u0435\u0434\u0438\u0439\u043a\u0435, \u0430 \u0443 \u043c\u0435\u0434\u0438\u0439\u043a\u0438 \u043d\u0435\u0442 \u043f\u0440\u044f\u043c\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0438\u0441\u0442\u0438\u043d\u0443 - \u0432\u043c\u0435\u0441\u0442\u043e \u043d\u0435\u0435 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c \u0432 \u0440\u043e\u0442 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043c\u0443\u0441\u043e\u0440, \u0437\u0430\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u0439 \u0432 \u043e\u0431\u0435\u0440\u0442\u043a\u0443 \u043a\u043b\u0438\u043a\u0431\u0435\u0439\u0442\u0430 \u0438 \u044d\u043c\u043e\u0446\u0438\u0439, \u0432 \u0438\u0442\u043e\u0433\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u043c\u0435\u0441\u0442\u043e \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0444\u044b \u003Cstrong\u003E\u043f\u0440\u0438\u0432\u044b\u043a\u043b\u0430\u003C\/strong\u003E \u0432\u0441\u0435\u0440\u044c\u0435\u0437 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u043f\u0441\u0438\u043e\u043f\u044b \u0442\u0438\u043f\u0430 \u0420\u041f\u0423 \u0438 \u0442\u0434.\u003C\/p\u003E \u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u043d\u0435\u0434\u043e\u0432\u0435\u0440\u0438\u0435 \u0441\u0440\u0435\u0434\u0438 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438. \u0415\u0441\u043b\u0438 \u0447\u0442\u043e \u0442\u043e \u043d\u0435\u0434\u043e\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u044e\u0442 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e, \u0437\u043d\u0430\u0447\u0438\u0442 \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e \u0442\u0443\u0442 \u0435\u0441\u0442\u044c \u043f\u043e\u0434\u0432\u043e\u0445. \u0411\u0430\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u044f, \u0434\u0430 \u0438 \u043f\u0440\u0435\u0446\u0435\u0434\u0435\u043d\u0442\u043e\u0432, \u043a\u043e\u0433\u0434\u0430 \u0442\u0435 \u0438\u043b\u0438 \u0438\u043d\u044b\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u043a\u0440\u0443\u0442\u0438\u0442\u044c\u0441\u044f \u0432\u0442\u0438\u0445\u0443\u044e, \u043b\u0438\u0431\u043e \u043d\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c\u0441\u044f \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0434\u043e\u0441\u0442\u043e\u0432\u0435\u0440\u043d\u043e (\u0442\u043e \u0441\u0430\u043c\u043e\u0435 \u201c\u043c\u044b \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043d\u0438\u0437\u0438\u043b\u0438 \u0448\u0430\u043d\u0441\u044b\u201d, \u0437\u043d\u0430\u0447\u0438\u0442\u