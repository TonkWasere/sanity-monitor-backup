3e 63 \u0447\u0430\u0441\u0430 \u0432\u0441\u0435\u0433\u043e \u044f \u0432\u0435\u0440\u044e\u003C\/p\u003E\n\n\u003Cp\u003E\u0414\u0430, \u044f \u0438\u0437\u0443\u0447\u0430\u043b \u0432\u0441\u0435 \u043b\u043e\u043a\u0430\u0446\u0438\u0438, \u044f \u0432\u043e\u043e\u0431\u0449\u0435 \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0443\u0437\u043d\u0430\u043b \u043e\u0431 \u0438\u043c\u043f\u043b\u0430\u043d\u0442\u0430\u0445 \u0442\u0435 \u0436\u0435 (\u043d\u0435 \u0441 \u0434\u043b\u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0433\u043e\u0440\u044b), \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u043a\u0430\u0436\u0434\u0443\u044e \u043f\u0435\u0449\u0435\u0440\u043a\u0443 \u0437\u0430\u0433\u043b\u044f\u0434\u044b\u0432\u0430\u043b, \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0432 \u043d\u044c\u044e \u0432\u0435\u0433\u0430\u0441\u0435 \u043a\u0443\u0447\u0430 \u0444\u0438\u0447 \u0438 \u0442.\u0434\u003C\/p\u003E\n\n\u003Cp\u003E\u0412 \u0432\u0430\u043d\u0438\u043b\u0435 \u0442\u043e \u0434\u0430, \u043d\u0430 50 \u0447\u0430\u0441\u043e\u0432 \u043d\u0435 \u043f\u043e\u0442\u044f\u043d\u0435\u0442 \u0438\u0433\u0440\u0430 \u0441\u043a\u043e\u0440\u0435\u0439 \u0432\u0441\u0435\u0433\u043e, \u043d\u043e \u043a\u0430\u043a \u044f \u0443\u0436\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b, 63 \u0447\u0430\u0441\u0430 - \u044d\u0442\u043e \u0432\u0430\u043d\u0438\u043b\u0430 + \u0434\u043b\u0441 \u0432\u0440\u043e\u0434\u0435 \u043a\u0430\u043a \u0440\u0430\u0441\u0447\u0451\u0442\u003C\/p\u003E","renderFailed":false,"mentionedByCount":0,"editedAt":"2026-11-04T07:59:46+00:00","canEdit":false,"canDelete":false,"canHide":false,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":1,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":1,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0