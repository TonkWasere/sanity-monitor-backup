003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0445\u0437. \u044f \u043b\u0438\u0447\u043d\u043e \u043d\u0435 \u0432\u0438\u0436\u0443 \u0441\u043c\u044b\u0441\u043b\u0430 \u0438\u0434\u0442\u0438 \u0434\u0430\u043b\u044c\u0448\u0435 1,6 \u0431\u0435\u0434\u0440\u0430 \u043d\u0430 \u0442\u043e\u0439 \u0436\u0435 \u043a\u0441-1 \u0446\u0435\u043d\u043e\u0439 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u043b\u0430\u0437\u0435\u0440\u0433\u0430\u043d\u0430 \u043d\u0430 \u0434\u0438\u0441\u0442\u0443 + \u0430\u0434\u0441\u0430, \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u043b\u0443\u0447\u0448\u0435 \u0432\u0431\u043b\u0438\u0437\u0438 \u0441\u0442\u0440\u0435\u0439\u0444\u0438\u0442\u044c \u043d\u0430 +1,5 \u043c\u0441\u0430\u0445 \u0438 \u043e\u0447\u0435\u043d\u044c \u0434\u0430\u0436\u0435 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0437\u0430\u0436\u0430\u0442\u044c \u043d\u0430 \u0434\u0438\u0441\u0442\u0443. \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043a\u0441-1 \u0435\u0449\u0435 \u043e\u043a\u0435\u0439 (\u0440\u0430\u0437\u043c\u0435\u043d \u043e\u0442\u0434\u0430\u0447\u0438 \u043d\u0430 0,3 \u0433\u0440\u0430\u0434\u0443\u0441\u0430 \u043f\u0440\u0438\u0435\u043c\u043b\u0435\u043c\u044b\u0439), \u043d\u043e \u043d\u0430 7.62 \u043c\u0435\u0442\u043e\u0432\u044b\u0445 \u0433\u0430\u043d\u0430\u0445 - \u044f \u0431\u044b \u044f\u0432\u043d\u043e \u043d\u0435 \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043b \u0438\u0437-\u0437\u0430 \u0446\u0435\u043d\u044b \u0442\u0432\u043e\u0435\u0439 \u043e\u0448\u0438\u0431\u043a\u0438. \u043c\u043d\u0435 \u043f\u043e \u0432\u0430\u0439\u0431\u0443 \u0431\u0435\u0433\u0430\u0442\u044c \u043f\u0435\u0440\u043e + \u043e\u043a\u043e\u0435\u043c \u0432 \u0446\u0435\u043b\u043e\u043c\u003C\/p\u003E\n\n\u003Cp\u003E\u043d\u0443 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u044d\u044