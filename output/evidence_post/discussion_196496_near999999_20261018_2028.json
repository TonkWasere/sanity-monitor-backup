0\u043e\u0441\u044f\u0442 \u043f\u043e\u043c\u0435\u043d\u044c\u0448\u0435 \u0438\u0445 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0438\u0431\u043e \u044f\u0441\u0435\u043d \u0445\u0443\u0439 \u0441\u043b\u043e\u0436\u043d\u043e \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043d\u043e \u0443 \u043d\u0430\u0441 \u0438\u043c\u0435\u043d\u043d\u043e \u0447\u0442\u043e \u0434\u0443\u0448\u043d\u043e \u0430 \u043d\u0435 \u0441\u043b\u043e\u0436\u043d\u043e,\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196496-prostoy-primer\/86\u0022 class=\u0022PostMention\u0022 data-id=\u00224713242\u0022\u003ESTEAM_0194846724\u003C\/a\u003E \u043c\u0435\u043d\u0435\u0435 \u0434\u0443\u0448\u043d\u043e\u0435 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\/\u043d\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 (\u043e\u043d\u043e \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044e \u0432\u0430\u043b\u044e\u0442\u044b) \u0441\u043f\u043e\u0442\u043e\u0432 \u0443\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0444\u0440\u0443\u0441\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0444\u0443\u043b\u043b \u043f\u0432\u0435 \u0438 \u043f\u0432\u043f\u0432\u0435 \u0441\u0442\u044b\u0447\u0435\u043a, \u0432\u0435\u0434\u0443\u0449\u0438\u0445 \u043a \u0441\u043c\u0435\u0440\u0442\u0438 \u043f\u0440\u0438 \u043d\u0435\u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u0438 \u0438\u0433\u0440\u043e\u043a\u0430\/\u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u043f\u043e\u043f\u0443\u0442\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044f % \u0432\u044b\u043d\u043e\u0441\u043e\u0432 \u0441 \u044d\u043d\u0434\u0433\u0435\u0439\u043c-\u043b\u043e\u043a\u0430\u0446\u0438\u0438, \u0430 \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0440\u0430\u0437\u0433\u043e\u043d\u044f\u044f \u0438\u043d\u0444\u043b\u044f\u0446\u0438\u044e. \u044d\u0442\u043e \u043d\u0435 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0442\u0430\u043a\u0438\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u044b, \u043a\u0430\u043a, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0430\u0444\u043a \u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u0435 \u043f\u043e\u0431\u043e\u0440\u043e\u043b\u0438\u0441\u044c \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e. \u0431\u0442\u0432 \u043d\u0435 \u0442\u0430\u043a \u0434\u0430\u0432\u043d\u043e \u0432\u0437\u043e\u0440\u0432\u0430\u043b\u0438 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u043e\u0432 \u043f\u0440\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438 \u043d\u043e\u0432\u043e\u0433\u043e \u0441\u0435\u0432\u0435\u0440\u0430, \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0449\u0438\u0445\u0441\u044f \u0434\u043e \u0447\u0430\u0441 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438 \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0432\u044b\u0431\u0440\u043e\u0441\u0430, \u0447\u0442\u043e, \u043d\u0435\u0441\u043e\u043c\u043d\u0435\u043d\u043d\u043e, \u043d\u0435\u043f\u043b\u043e\u0445\u043e\u0439 \u0448\u0430\u0433\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u043e\u043a\u0435 \u0434\u0435\u043b\u0430\u0435\u043c \u043b\u043e\u043a\u0443 \u043c\u0435\u043d\u0435\u0435 \u0434\u0443\u0448\u043d\u0443\u044e \u043d\u043e \u0441\u0440\u0435\