3c\u043d\u0435 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c, \u0432\u0435\u0442\u044c \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u0435\u0435 \u0432\u0441\u0435\u0433\u043e \u0442\u0430\u043a\u043e\u0439 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436 \u0431\u044b\u043b, \u043d\u043e \u0435\u0433\u043e \u0443\u0434\u0430\u043b\u0438\u043b\u0438, \u043f\u0443\u0444\u0444! \u0438\u0441\u043f\u0430\u0440\u0438\u043b\u0441\u044f! \u0438 \u0432\u043e\u043f\u0440\u043e\u0441, \u0430 \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043d\u044f\u0442\u044c \u0435\u0433\u043e \u043d\u0438\u043a \u043a\u0430\u043a-\u0442\u043e? \u0442\u0438\u043f\u043e \u0431\u043b\u0438\u043d \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435 \u0443\u0436\u0435 \u0437\u0430\u0431\u044b\u043b \u043e\u0431 \u044d\u0442\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044d\u0442\u043e\u0442 \u043d\u0438\u043a \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b, \u043d\u0443 \u0438\u043b\u0438 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0433\u0440\u0443\u0441\u0442\u043d\u044b\u0445 \u043c\u044b\u0441\u043b\u0435\u0439, \u0438\u043b\u0438 \u043f\u044c\u044f\u043d\u043a\u0438 (\u0441\u043e\u0440\u044f\u043d \u0437\u0430 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u0438\u0435) \u044f \u0432\u043e\u0442 \u043e\u0447\u0435\u043d\u044c \u0445\u043e\u0447\u0443 \u0441\u0435\u0431\u0435 \u0442\u0430\u043a\u043e\u0439 \u043d\u0438\u043a, \u0442\u0430\u043a \u043a\u0430\u043a \u043d\u0443 \u0438\u0432\u0435\u043d\u0442 \u0410\u0440\u0435\u043d\u0430 \u041c\u0438\u0442\u0440\u043e\u043f\u043e\u043b\u0438\u0442\u0430, \u043a\u0430\u043a-\u0440\u0430\u0437 \u043f\u043e\u0434 \u0438\u0432\u0435\u043d\u0442 \u0441\u0430\u043c\u043e\u0435 \u0442\u043e, \u0442\u0430 \u0438 \u043f\u043e\u0441\u043b\u0435 \u0438\u0432\u0435\u043d\u0442\u0430 \u043e\u04