43e\u0440\u044c\u0431\u0430 \u0441 \u00ab\u043c\u0430\u043c\u043a\u0438\u043d\u044b\u043c\u0438 \u0431\u0438\u0437\u043d\u0435\u0441\u043c\u0435\u043d\u0430\u043c\u0438\u00bb, \u0438\u0433\u0440\u0430\u044e\u0449\u0438\u043c\u0438 \u043d\u0430 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u043c \u043d\u0430\u0436\u0430\u0442\u0438\u0438 \u2014 \u0438\u043b\u0438, \u043a\u0430\u043a \u0432 \u043d\u0430\u0440\u043e\u0434\u0435 \u0433\u043e\u0432\u043e\u0440\u044f\u0442, \u00ab\u043d\u0430 \u043b\u043e\u0445\u0430\u00bb, \u2014 \u0440\u0430\u0437\u0432\u0435 \u044d\u0442\u043e\u0433\u043e \u0432\u0441\u0435 \u0436\u0434\u0443\u0442 \u043e\u0442 \u0438\u0433\u0440\u044b? \u0422\u0430\u043a\u0438\u0435 \u0434\u0435\u043b\u044c\u0446\u044b \u043d\u0435 \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u0438: \u043e\u043d\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0430\u0440\u0430\u0437\u0438\u0442\u0438\u0440\u0443\u044e\u0442 \u043d\u0430 \u043d\u0435\u0432\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u044f \u0445\u043b\u0430\u043c \u043f\u043e \u0437\u0430\u043e\u0431\u043b\u0430\u0447\u043d\u044b\u043c \u0446\u0435\u043d\u0430\u043c \u0432 \u0440\u0430\u0441\u0447\u0451\u0442\u0435 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u0443 \u043a\u043e\u0433\u043e-\u0442\u043e \u0434\u0440\u043e\u0433\u043d\u0435\u0442 \u0440\u0443\u043a\u0430 \u043f\u043e\u0441\u043b\u0435 \u0442\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u0434\u043d\u044f. \u0412 \u0438\u0442\u043e\u0433\u0435 \u0441\u0442\u0440\u0430\u0434\u0430\u044e\u0442 \u0442\u0435, \u043a\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u0438\u0433\u0440\u0430\u0442\u044c \u0438 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u044c \u043d\u0443\u0436\u043d\u044b\u0435 \u0440\u0430\u0441\u0445\u043e\u0434\u043d\u0438\u043a\u0438, \u0430 \u043d\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0442\u044c\u0441\u044f \u0430\u0440\u0445\u0435\u043e\u043b\u043e\u0433\u0438\u0435\u0439 \u0441\u0440\u0435\u0434\u0438 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u043d\u0443\u043b\u0435\u0439. \u0420\u0430\u0437\u0432\u0435 \u044d\u0442\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u0439 \u0440\u044b\u043d\u043e\u043a? \u041d\u0435\u0442 \u2014 \u044d\u0442\u043e \u0441\u0440\u0435\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043b\u043e\u0434\u0438\u0442 \u043d\u0435\u0433\u0430\u0442\u0438\u0432, \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0437\u0430\u0431\u0438\u0442\u044c \u043d\u0430 \u0438\u0433\u0440\u0443.\u003C\/p\u003E\n\n\u003Cp\u003EP.S \u043f\u0440\u043e \u201c\u0432 \u043d\u0443\u043b\u0438\u201d \u043d\u0438 \u0441\u043b\u043e\u0432\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u043e, \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u043e \u043f\u0440\u043e \u0431\u043e\u043a\u0430\u043b \u0432\u0438\u043d\u0430, \u0435\u0441\u043b\u0438 \u043a\u0442\u043e \u0442\u043e \u0441\u0442\u043e\u043b\u044c \u044e\u043d \u0438 \u0435\u043c\u0443, \u0432 \u0441\u0438\u043b\u0443 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430, \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0432\u044b\u043f\u0438\u0442\u044c \u0431\u043e\u043a\u0430\u043b \u0432\u0438\u043d\u0430 \u0447\u0442\u043e \u0431\u044b \u0431\u044b\u0442\u044c \u0432 \u043d\u0443\u043b\u0438, \u0442\u043e \u0443 \u0432\u0430\u0441 \u0435\u0449\u0451 \u0432\u0441\u0435 \u0432\u043f\u0435\u0440\u0435\u0434, \u0440\u0430\u0434\u0443\u0439\u0442\u0435\u0441\u044c)\u003C\/p\u003E\n\n","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount