\u0433\u0440\u043e\u0432\u044b\u0445 \u0441\u0434\u0435\u043b\u043e\u043a \u0438 \u0442\u043e, \u0447\u0442\u043e \u0442\u044b \u0431\u0443\u0434\u0435\u0448\u044c \u0447\u0435\u0441\u0442\u043d\u044b\u043c \u0432 \u0441\u0434\u0435\u043b\u043a\u0430\u0445 \u0432\u043e\u0432\u0441\u0435 \u043d\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043e \u043e\u043d \u0432\u0435\u0440\u043d\u0435\u0442\u0441\u044f \u043a \u0442\u0435\u0431\u0435 \u0432 \u0441\u043b\u0435\u0434 \u0440\u0430\u0437 \u0438 \u043f\u0440\u043e\u0434\u0430\u0441\u0442 \u0432\u0441\u0435 \u0442\u0435\u0431\u0435 \u043e\u0434\u043d\u043e\u043c\u0443 \u0442\u043e\u043b\u044c\u043a\u043e \u043b\u0438\u0448\u044c \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043a\u043e\u0433\u0434\u0430-\u0442\u043e \u0442\u044b \u043e\u043f\u043b\u0430\u0442\u0438\u043b \u0441\u0432\u043e\u0439 \u0434\u043e\u043b\u0433, - \u043e\u043d \u0441\u043a\u043e\u0440\u0435\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044f \u0446\u0435\u043d\u0430\u043c\u0438 \u0438\u043b\u0438 \u0431\u044b\u0441\u0442\u0440\u043e \u0445\u043e\u0447\u0435\u0442 \u0441\u043b\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u0445\u0430\u0431\u0430\u0440.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u043e \u0435\u0441\u043b\u0438 \u0442\u044b \u0432\u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0435\u0434 \u0442\u0440\u0443\u0434\u043d\u044b\u043c \u043c\u043e\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0432\u044b\u0431\u043e\u0440\u043e\u043c \u003Cdel\u003E\u0432 \u043a\u0443\u0431\u0430\u0445\u003C\/del\u003E (\u043f\u0438\u0437\u0434\u0435\u0446\ud83e\udd23) \u0438 \u0442\u0435\u0431\u0435 \u043d\u0443\u0436\u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c \u0437\u0430\u043b\u0430, \u0442\u043e \u043f\u0440\u043e\u0433\u0440\u0435\u0439 \u0435\u0433\u043e - \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0443\u0442 \u0434\u0435\u043d\u044c\u0433\u0438, \u0430 \u0434\u0443\u0440\u