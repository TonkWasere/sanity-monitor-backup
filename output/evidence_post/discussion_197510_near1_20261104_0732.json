\u0435\u043f\u0435\u0440\u044c \u0432 \u043a\u043e\u043d\u0446\u0435 \u043c\u0430\u0442\u0447\u0430 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u043d\u0438\u043a\u043d\u0435\u0439\u043c\u044b \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u043e\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b.\u003C\/li\u003E\n\u003Cli\u003E\u0412 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u043c\u0430\u0442\u0447\u0430 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u043e \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0440\u0430\u043d\u0433\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432.\n\u003Ch3\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-11-04\/1793772423-115962-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u00221c23bfd5-71bb-4679-ac16-e936bff40ff0\u0022 loading=\u0022lazy\u0022 width=\u0022391\u0022 height=\u0022276\u0022\u003E\u003C\/h3\u003E\u003C\/li\u003E\n\u003Cli\u003E\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u043e\u0448\u0438\u0431\u043a\u0430, \u0438\u0437-\u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u043c\u0430\u0442\u0447\u0430 \u0438\u0433\u0440\u043e\u043a, \u043d\u0430\u0445\u043e\u0434\u044f\u0449\u0438\u0439\u0441\u044f \u0432 \u0443\u0431\u0435\u0436\u0438\u0449\u0435 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043e\u0442\u0440\u044f\u0434\u043e\u043c, \u043f\u043e\u043f\u0430\u0434\u0430\u043b \u0432 \u0438\u0433\u0440\u0443 \u043e\u0434\u0438\u043d.\u003C\/li\u003E\n\u003Cli\u003E\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u0441\u043b\u0443\u0447\u0430\u0438 \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u043d\u0438\u044f \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439 \u043d\u0430 \u0410\u0440\u0435\u043d\u0435.\u003C\/li\u003E\n\u003Cli\u003E\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u043e\u0448\u0438\u0431\u043a\u0430, \u0438\u0437-\u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0438\u0433\u0440\u043e\u043a\u0438 \u043c\u043e\u0433\u043b\u0438 \u043f\u0440\u043e\u0432\u0430\u043b\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u043a\u0430\u0440\u0442\u044b.\u003C\/li\u003E\n\u003Cli\u003E\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043c\u0443\u0442\u0430\u043d\u0442\u043e\u0432.\u003C\/li\u003E\n\u003Cli\u003E\u0414\u043b\u044f \u00ab\u0423\u0442\u0432\u0430\u0440\u0438\u00bb \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0441\u0440\u0430\u0437\u0443 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043a\u0435\u0439\u0441\u043e\u0432.\u003C\/li\u003E\n\u003Cli\u003E\u0418\u0437\u043c\u0435\u043d\u0451\u043d \u0431\u0430\u043b\u0430\u043d\u0441 \u0432\u043e\u043b\u043d\u044b \u00ab\u0411\u0435\u0441\u0441\u043e\u043d\u043d\u044b\u0439 \u043f\u0430\u0440\u0430\u043b\u0438\u0447\u00bb.\u003C\/li\u003E\n\u003Cli\u003E\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u043e\u0448\u0438\u0431\u043a\u0430, \u0438\u0437-\u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043d\u0435 \u0437\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b\u043e\u0441\u044c \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e \u0431\u043e\u0441\u0441\u0430 \u0415\u0433\u043e \u0421\u0438\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e.\u003C\/li\u003E\n\u003Cli\u003E\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d \u0443\u0440\u043e\u043d \u0432 \u0432\u0435\u0440\u0445\u043d\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u043a\u043e\u043b\u043b\u0438\u0437\u0438\u0438 \u0431\u0430\u0440\u0440\u0438\u043a\u0430\u0434.\u003C\/li\u003E\u003C\/ul\u003E\n\n\u003Ch3\u003E\u0414\u0430\u0440\u044b \u041f\u0440\u0430\u0437\u0434\u043d\u0435\u0441\u0442\u0432\u0430\u003C\/h3\u003E\n\u003Cp\u003E\u041f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u0430\u044f \u043f\u043e\u0440\u0430 \u2014 \u0440\u0435\u0434\u043a\u0438\u0439 \u0441\u043b\u0443\u0447\u0430\u0439, \u043a\u043e\u0433\u0434\u0430 \u0417\u043e\u043d\u0430 \u0433\u043e\u0442\u043e\u0432\u0430 \u043f\u043e\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u0441\u0432\u043e\u0438\u043c\u0438 \u0441\u043e\u043a\u0440\u043e\u0432\u0438\u0449\u0430\u043c\u0438. \u041f\u0440\u0430\u0432\u0434\u0430, \u0436\u0434\u0430\u0442\u044c \u043f\u043e\u0434\u0430\u0440\u043a\u043e\u0432 \u043f\u043e\u0434 \u0451\u043b\u043a\u043e\u0439 \u0437\u0434\u0435\u0441\u044c \u043d\u0435 \u043f\u0440\u0438\u043d\u044f\u0442\u043e: \u0437\u0430 \u043f\u0440\u0438\u043f\u0430\u0441\u0430\u043c\u0438 \u0432\u0441\u0451 \u0435\u0449\u0451 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0438\u0434\u0442\u0438 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Cstrong\u003E\u00ab\u0414\u0430\u0440\u044b \u041f\u0440\u0430\u0437\u0434\u043d\u0435\u0441\u0442\u0432\u0430\u00bb \u0443\u0436\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b \u0432\u043e \u0432\u043d\u0443\u0442\u0440\u0438\u0438\u0433\u0440\u043e\u0432\u043e\u043c \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435!\u003C\/strong\u003E 35 000 \u0432\u0430\u043b\u044e\u0442\u044b \u0441\u043e\u0431\u044b\u0442\u0438\u044f, 20 \u044f\u0449\u0438\u043a\u043e\u0432 \u0423\u0442\u0432\u0430\u0440\u044c, 15 \u0441\u0435\u0437\u043e\u043d\u043d\u044b\u0445 \u0443\u0440\u043e\u0432\u043d\u0435\u0439 \u0438 \u0431\u0440\u0435\u043b\u043e\u043a \u00ab\u041a\u0443\u043a\u043b\u0430-\u043e\u0431\u0435\u0440\u0435\u0433\u00bb \u0441 \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0445 \u0440\u0438\u0441\u0443\u043d\u043a\u043e\u0432 \u043b\u0438\u0446\u0430. \u041a\u0430\u043a\u043e\u0439 \u0438\u043c\u0435\u043d\u043d\u043e \u0434\u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u0432\u0430\u043c \u2014 \u0441\u044e\u0440\u043f\u0440\u0438\u0437! \u0410 \u0434\u043e\u043f\u043e\u043b\u043d\u044f\u044e\u0442 \u043d\u0430\u0431\u043e\u0440 \u043a\u0440\u0430\u0441\u043a\u0438 \u00ab\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0432\u043e\u0437\u0437\u0432\u0430\u043d\u0438\u0435\u00bb \u0434\u043b\u044f \u043e\u0440\u0443\u0436\u0438\u044f \u0438 \u0431\u0440\u043e\u043d\u0438.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0410 \u0435\u0441\u043b\u0438 \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u043e\u0433\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0432\u0441\u0451 \u0435\u0449\u0451 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e, \u043f\u0435\u0440\u0432\u044b\u0435 \u043f\u043e\u043a\u0443\u043f\u043a\u0438 \u0436\u0434\u0443\u0442 \u0441\u043e \u0441\u043a\u0438\u0434\u043a\u043e\u0439 \u0434\u043e 60%. \u0417\u043e\u043d\u0430 \u043d\u0435\u0447\u0430\u0441\u0442\u043e \u0431\u044b\u0432\u0430\u0435\u0442 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0449\u0435\u0434\u0440\u043e\u0439, \u0442\u0430\u043a \u0447\u0442\u043e \u043b\u0443\u0447\u0448\u0435 \u043d\u0435 \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u0442\u044c \u0435\u0451 \u0442\u0435\u0440\u043f\u0435\u043d\u0438\u0435.\u003C\/p\u003E\n\n\u003Ch3\u003E\u0424\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u0431\u043e\u0440\u003C\/h3\u003E\n\u003Cp\u003E\u0423 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u043f\u043e \u0417\u043e\u043d\u0435 \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u0439 \u0444\u0438\u043d\u0430\u043b. \u041e\u0434\u043d\u0438 \u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0443\u044e\u0442\u0441\u044f \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u043c \u043f\u043e \u043f\u0443\u0442\u0438, \u0434\u0440\u0443\u0433\u0438\u0435 \u043d\u0435 \u043f\u0440\u0438\u0432\u044b\u043a\u043b\u0438 \u0443\u0445\u043e\u0434\u0438\u0442\u044c \u0441 \u043f\u0443\u0441\u0442\u044b\u043c\u0438 \u0440\u0443\u043a\u0430\u043c\u0438. \u0414\u043b\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 \u043f\u0440\u0438\u043f\u0430\u0441\u0451\u043d \u043e\u0441\u043e\u0431\u044b\u0439 \u043d\u0430\u0431\u043e\u0440 \u2014 \u0438 \u043e\u043d \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Cstrong\u003E\u00ab\u0410\u0432\u0430\u043d\u0433\u0430\u0440\u0434\u00bb, \u00ab\u041f\u0440\u0435\u0441\u0442\u0438\u0436\u00bb \u0438 \u00ab\u0423\u043b\u044c\u0442\u0438\u043c\u0430\u00bb\u003C\/strong\u003E \u2014 \u0442\u0440\u0438 \u0441\u0442\u0443\u043f\u0435\u043d\u0438 \u043a \u0432\u043d\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u0438 \u043d\u0430\u0433\u0440\u0430\u0434. \u0421\u0435\u0437\u043e\u043d\u043d\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438, \u043f\u0440\u0435\u043c\u0438\u0443\u043c, \u041f\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043a\u0438, \u044f\u0449\u0438\u043a\u0438 \u0438 \u044d\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u044b\u0435 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u0441\u0435\u0437\u043e\u043d \u0441 \u0441\u043e\u043b\u0438\u0434\u043d\u044b\u043c \u0437\u0430\u043f\u0430\u0441\u043e\u043c \u0442\u0440\u043e\u0444\u0435\u0435\u0432.\u003Cbr\u003E\n\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0448\u0430\u043d\u0441 \u0437\u0430\u0431\u0440\u0430\u0442\u044c \u043e\u0442 \u0441\u0435\u0437\u043e\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0439 \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c!\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Ch3\u003E\u041f\u0440\u043e\u0447\u0435\u0435\u003C\/h3\u003E\n\n\u003Cul\u003E\u003Cli\u003E\u0421\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430 \u043f\u043e\u043a\u0440\u0430\u0441\u043a\u0430 \u0420\u0428-12 \u0432 \u043e\u0431\u043b\u0438\u043a\u0435 \u00ab\u041d\u0430\u0447\u0435\u0440\u0442\u0430\u043d\u043d\u044b\u0439\u00bb.\u003C\/li\u003E\n\u003Cli\u003E\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043c\u043e\u0434\u0443\u043b\u0435\u0439 \u043d\u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u0440\u0443\u0436\u0438\u0438.\u003C\/li\u003E\u003C\/ul\u003E","renderFailed":false,"editedAt":"2026-11-04T06:13:36+00:00","canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"197510"}},"user":{"data":{"