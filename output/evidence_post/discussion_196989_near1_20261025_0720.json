c\u043a\u043e \u0432 \u0440\u0430\u0441\u0445\u043e\u0434\u043d\u0438\u043a\u0430\u0445: \u0442\u0430\u043a \u0436\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u0437\u0430\u0432\u044b\u0448\u0435\u043d\u043d\u044b\u0435 \u0446\u0435\u043d\u044b \u043d\u0430 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b, \u043a\u0440\u0430\u0444\u0442-\u0440\u0435\u0441\u0443\u0440\u0441\u044b \u0438 \u0442.\u0434.\u003Cbr\u003E\n\u0414\u0430, \u0435\u0441\u0442\u044c \u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430, \u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u0433\u0440\u044b, \u0442\u0440\u0443\u0434\u043d\u043e\u0433\u043e \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u0434\u043d\u044f \u0438 \u0431\u043e\u043a\u0430\u043b\u0430 \u0432\u0438\u043d\u0430 \u0433\u043b\u0430\u0437 \u0437\u0430\u043c\u044b\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u2014 \u0438 \u043d\u0435\u0442-\u043d\u0435\u0442, \u0434\u0430 \u0434\u0440\u043e\u0433\u043d\u0435\u0442 \u0440\u0443\u043a\u0430, \u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0435\u0448\u044c \u043e\u0448\u0438\u0431\u043e\u0447\u043d\u0443\u044e \u043f\u043e\u043a\u0443\u043f\u043a\u0443 \u043f\u043e \u0437\u0430\u0432\u044b\u0448\u0435\u043d\u043d\u043e\u0439 \u0446\u0435\u043d\u0435. \u041e\u0442\u0441\u044e\u0434\u0430 \u043d\u0435\u0433\u0430\u0442\u0438\u0432, \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u0438\u0435, \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0437\u0430\u0431\u0438\u0442\u044c\u2026\u003Cbr\u003E\n\u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u043f\u0440\u043e\u0448\u0443 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432 \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435:\u003C\/p\u003E\n\u003Col style=\u0022list-style-type:decimal\u0022\u003E\u003Cli\u003E\u041a\u0430\u043a \u0431\u044b\u043b\u043e \u0440\u0430\u043d\u044c\u0448\u0435, \u0432\u0432\u0435\u0441\u0442\u0438 \u043d\u0430\u043b\u043e\u0433 \u043d\u0430 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0439 \u0442\u043e\u0432\u0430\u0440: \u043d\u0435\u0432\u0430\u0436\u043d\u043e, \u043f\u0440\u043e\u0434\u0430\u0441\u0442\u0441\u044f \u043e\u043d \u0438\u043b\u0438 \u043d\u0435\u0442 \u2014 \u0441 \u0442\u0435\u0431\u044f \u0441\u043f\u0438\u0448\u0443\u0442 \u0447\u0430\u0441\u0442\u044c \u0441\u0443\u043c\u043c\u044b \u043e\u0442 \u0435\u0433\u043e \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u0438.\u003C\/li\u003E\n\u003Cli\u003E\u0421\u0434\u0435\u043b\u0430\u0442\u044c \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0446\u0435\u043d \u043f\u043e\u0434\u043a\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u043c\u044b\u043c \u2014 \u043a\u0430\u043a \u0432 \u043c\u0435\u043d\u044e \u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u0435\u0436\u0434\u0443 \u0438\u0433\u0440\u043e\u043a\u0430\u043c\u0438, \u0442\u0430\u043a \u0438 \u0432 \u043c\u0435\u043d\u044e \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u0430 (\u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u044d\u0442\u0438 \u043d\u0443\u043b\u0438). \u0427\u0442\u043e\u0431\u044b \u043d\u0430 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u0441\u0440\u0430\u0437\u0443 \u0431\u044b\u043b\u043e \u0432\u0438\u0434\u043d\u043e: \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0446\u0435\u043d\u044b, \u0438\u0441\u0447\u0438\u0441\u043b\u044f\u0435\u043c\u044b\u0435 \u0442\u044b\u0441\u044f\u0447\u0430\u043c\u0438 \u2014 \u0431\u0435\u043b\u044b\u043c, \u0434\u0435\u0441\u044f\u0442\u043a\u0430\u043c\u0438 \u0442\u044b\u0441\u044f\u0447 \u2014 \u0437\u0435\u043b\u0451\u043d\u044b\u043c