044c\u043a\u043e \u0435\u0431\u0430\u043d\u0443\u0442\u043e\u0439, \u0447\u0442\u043e \u0442\u044b \u0443\u0441\u043f\u0435\u0432\u0430\u0435\u0448\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u0435\u0435 \u043f\u0440\u043e\u0436\u0430\u0442\u044c, \u0434\u0443\u043c\u0430\u044f \u0447\u0442\u043e \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0440\u0430\u0437 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u0437\u0430\u0440\u0435\u0433\u0430\u043b\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u0420\u0435\u0433\u0430 \u0432\u0441\u0435 \u0442\u0430\u043a\u0436\u0435 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u0432 \u043f\u0438\u0432\u0435, \u043f\u0438\u043a\u043e\u043c \u0430\u0431\u0441\u0443\u0440\u0434\u0430 \u0431\u044b\u043b \u043e\u0442\u043a\u0430\u0442 \u043d\u0430 15 \u043a\u0430\u0442\u043a\u0435 \u0433\u0434\u0435 \u043f\u043e \u0441\u0430\u0442\u0443\u0440\u043d\u0443 \u0432 \u0443\u043f\u043e\u0440 \u0438\u0437 6 \u0432\u044b\u0441\u0442\u0440\u0435\u043b\u043e\u0432 \u0440\u0435\u0433\u043d\u0443\u043b\u043e \u043b\u0438\u0448\u044c \u0442\u0440\u0438. \u041f\u043b\u044e\u0441 \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0438\u0433\u0440\u0430\u0445 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b \u0430\u0431\u0441\u0443\u0440\u0434 \u0433\u0434\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a \u043f\u043e\u0437\u0436\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u043b \u0441\u0442\u0440\u0435\u043b\u044f\u0442\u044c \u0438\u0437 \u0442\u043e\u0433\u043e \u0436\u0435 \u043e\u0440\u0443\u0436\u0438\u044f \u0447\u0442\u043e \u0438 \u0443 \u043c\u0435\u043d\u044f, \u043d\u043e \u043a\u0430\u043a\u0438\u043c \u0442\u043e \u0447\u0443\u0434\u0435\u0441\u043d\u044b\u043c, \u0431\u043b\u044f\u0442\u044c \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u043f\u0440\u0438 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0440\u0430\u0432\u043d\u043e\u043c \u0430\u0438\u043c\u0435 \u0432\u0441\u0430\u0436\u0438\u0432\u0430\u043b \u0440\u0430\u0437\u0430 \u0432 3 \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u0430\u0442\u0440\u043e\u043d \u0432 \u043c\u0435\u043d\u044f, \u0447\u0435\u043c \u044f \u0432 \u043d\u0435\u0433\u043e. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0432 \u0442\u043e\u043c \u0447\u0442\u043e \u044f \u0441\u044b\u043d \u0441\u0435\u0440\u0432\u0435\u0440\u0430(5\u043f\u0438\u043d\u0433\u0430) \u0438 \u043d\u0443\u0436\u043d\u043e \u0438\u0433\u0440\u0430\u0442\u044c \u0432 60-80\u043f\u0438\u043d\u0433\u0430 \u0440\u0430\u0434\u0438 \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u044b\u0445 \u0440\u0430\u0441\u0441\u0438\u043d\u0445\u0440\u043e\u043d\u043e\u0432.\u003C\/p\u003E\n\n\u003Cp\u003E\u0411\u0430\u0433 \u0441 \u043a\u0438\u0434\u0430\u0435\u043c\u044b\u043c\u0438 \u043e\u0431\u044c\u0435\u043a\u0442\u0430\u043c\u0438 \u0442\u0430\u043a \u0438 \u043d\u0435 \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u043b\u0438, \u0432\u0441\u0435 \u0435\u0449\u0435 \u043d\u0435 \u0440\u0430\u0437 \u043f\u0440\u043e\u0435\u0431\u044b\u0432\u0430\u043b \u0431\u0430\u0442\u043a\u0443 \u0442.\u043a. \u0441\u0442\u043e\u044f\u043b \u043f\u0435\u0440\u0435\u0434 \u0443\u0441\u0442\u043e\u0439, \u043d\u043e \u003Cstrong\u003E\u041a\u0418\u041d\u0423\u0422\u042c\u003C\/strong\u003E \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043a\u0443 \u0432 \u043d\u0435\u0435 \u043d\u0435 \u043c\u043e\u0433.\u003C\/p\u003E\n\n\u003Cp\u003E\u0411\u0430\u0433 \u0441 \u0438\u0441\u0447\u0435\u0437\u0430\u044e\u0449\u0438\u043c \u043f\u043e\u0440\u0442\u0430\u043b\u043e\u043c \u043c\u0435\u0434\u0438\u043a\u0430\/\u0442\u0435\u043b\u0435\u043f\u043e\u0440\u0442\u043e\u043c \u043e\u043f\u0435\u0440\u0430 \u0442\u0430\u043a\u0436\u0435 \u043d\u0435 \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u043b\u0438, \u043a\u0430\u043a \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u043b\u0438 \u043f\u0440\u0438 \u0431\u0440\u043e\u0441\u043a\u0435 \u043d\u0435\u043f\u043e\u043d\u044f\u0442\u043d\u043e \u043f\u043e\u0447\u0435\u043c\u0443, \u0442\u0430\u043a \u0438 \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u044e\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u0422\u0443\u043f\u043e\u0440\u044b\u043b\u0435\u0439\u0448\u0430\u044f \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430, \u0433\u0434\u0435 \u044f \u0438 \u043a\u0435\u043d\u0442 \u0438\u0433\u0440\u0430\u043b\u0438 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e, \u0432\u043e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u044f \u043f\u043e\u043b\u0443\u0447\u0438\u043b 3200 \u0440\u0435\u0439\u0442\u0430, \u0430 \u043e\u043d 1600 \u0442.\u043a. \u044f \u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u043c \u0441\u0435\u0437\u043e\u043d\u0435 \u0431\u044b\u043b \u0432 \u043a\u0440\u0430\u0441\u043d\u043e\u0439, \u0430 \u043e\u043d \u0432 \u0431\u0435\u043b\u043e\u0439 \u043b\u0438\u0433\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0431\u0435\u0449\u0430\u043d\u044b\u0439 \u0441\u043a\u0438\u043d \u043d\u0430 \u0441\u0430\u0442\u0443\u0440\u043d \u0442\u0430\u043a \u0438 \u043d\u0435 \u0437\u0430\u0432\u0435\u0437\u043b\u0438, \u0437\u0430\u0442\u043e \u0434\u0430\u043b\u0438 \u0441\u0442\u043e\u043b \u0437\u0430 10\u043a(\u043b\u043e\u043b \u0437\u0430 \u044d\u0442\u0443 \u0445\u0443\u0439\u043d\u044e \u0435\u0449\u0435 \u0442\u0440\u0435\u0431\u0443\u044e\u0442 \u043f\u043b\u0430\u0442\u0438\u0442\u044c?)\u003C\/p\u003E\n\n\u003Cp\u003E\u0421 \u043b\u0438\u0432\u043e\u043c \u0442\u0430\u043a \u0438 \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u0432\u0440\u043e\u0434\u0435\u003C\/p\u003E \n\n\u003Cp\u003E\u0418\u0437 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e:\u003C\/p\u003E\n\n\u003Cp\u003E\u0417\u0430\u043d\u0435\u0440\u0444\u0438\u043b\u0438 \u043a \u0445\u0443\u044f\u043c \u0442\u0440\u0430\u043d\u043a\u0432\u0438\u043b. \u0423\u0440\u0430, \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043a\u0435\u043d\u0441\u0435\u0440\u043d\u0430\u044f \u0445\u0443\u0439\u043d\u044f \u0431\u044b\u043b\u0430, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0435\u0441\u043b\u0438 \u0443\u043c\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043e\u0434\u0430\u0440\u0435\u043d\u043d\u0430\u044f \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u0430 \u0431\u0435\u0433\u0430\u043b\u0430 \u0441 \u043d\u0438\u043c \u043f\u043e \u043a\u0434. \u041e\u043d \u0432\u0440\u043e\u0434\u0435 \u0438 \u043d\u0435 \u0448\u0438\u0431\u043a\u043e \u0431\u044b\u043b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0438 \u0442\u0438\u043f\u0447\u0438\u043a\u0438 \u043d\u0435 \u043d\u0430\u0431\u0438\u0432\u0430\u043b\u0438 \u0441 \u043d\u0438\u043c \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u043a\u0434, \u043d\u043e \u043e\u043d \u0431\u044b\u043b \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0431\u0435\u0441\u044f\u0447\u0438\u043c \u0438 \u043d\u0435\u0447\u0435\u0441\u043d\u044b\u043c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0423\u0431\u0440\u0430\u043b\u0438 \u0437\u0430\u0431\u043e\u0440\u0447\u0438\u043a\u0438, \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043f\u043e\u0434\u0434\u043e\u043d\u044b, \u0432\u043e\u0442 \u0442\u0443\u0442 \u043a\u043b\u0430\u0441\u0441\u043d\u043e, \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u044d\u0442\u043e \u0434\u0435\u043b\u043e \u0434\u0432\u0443\u0445 \u043c\u0438\u043d\u0443\u0442, \u043d\u043e \u043d\u0430 \u0434\u0443\u0448\u043d\u043e\u0441\u0442\u044c \u0433\u0435\u043c\u043f\u043b\u0435\u044f \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u043b\u0438\u044f\u043b\u043e \u0432 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0441\u0442\u043e\u0440\u043e\u043d\u0443.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0443 \u0438 \u0432\u0440\u043e\u0434\u0435 \u0432\u0441\u0435?\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u0430\u043a \u0437\u0430\u0444\u0430\u0440\u043c \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0439 \u0432\u043c\u0435\u0441\u0442\u043e \u043f\u0432\u0435 \u0438 \u0446\u0430 \u0442\u0430\u0441\u043a\u0430\u043d\u0438\u0439 \u043f\u0430\u043a\u043e\u0432 \u043f\u043e\u0439\u0434\u0435\u0442, \u0432 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u043e\u0442\u0435\u0442\u044c \u0440\u0430\u0434\u0438 \u043b\u0438\u0433\/\u043f\u0430\u0442\u0435\u0440\u043d\u043e\u0432 \u043d\u0435 \u0441\u0442\u043e\u0438\u0442. \u0422\u043e\u043b\u044c\u043a\u043e \u0435\u0441\u043b\u0438 \u0448\u0442\u0443\u0440\u043c\u0430 \u0435\u0441\u0442\u044c \u0438 \u0441\u043a\u0438\u043d\u0447\u0438\u043a \u0437\u0430\u0448\u0435\u043b, \u043d\u043e \u0449\u0430\u0441 \u0432\u0441\u0435 \u043d\u0435\u0434\u043e\u0444\u0430\u0440\u043c\u0438\u0432\u0448\u0438\u0435 \u0431\u0443\u0434\u0443\u0442 \u0431\u0435\u0433\u0430\u0442\u044c \u0432 \u043d\u0435\u043c + \u043a\u0440\u0438\u0432\u043e\u0439 \u0440\u0435\u0439\u0442 \u0438\u0437-\u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0434\u0430\u0436\u0435 \u043c\u0440\u0430\u043a \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u043a\u0440\u0430\u0441\u043d\u0443\u044e \u043b\u0438\u0433\u0443 \u0432\u043e\u0439\u0434\u0435\u0442 \u0442\u0430\u043a \u0447\u0442\u043e \u0441\u043a\u0438\u043d\u0447\u0438\u043a \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u043b\u0438\u0448\u044c \u043a\u0440\u0430\u0441\u043e\u0442\u043e\u0439 \u0430 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u043c \u0441\u043a\u0438\u043b\u0430. \u041f\u043e\u043a\u0430 \u0447\u0442\u043e \u043a\u0440\u043e\u043c\u0435 \u0435\u043a\u0441\u043f\u0430\u043d\u0441\u0430 \u0441\u043a\u0438\u043d\u043e\u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438