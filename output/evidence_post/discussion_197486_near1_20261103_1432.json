a , 3 \u0442\u0438\u0439 \u043f\u043e\u0441\u0442 \u043d\u044b\u0442\u044c\u044f - \u0421\u043a\u043e\u0440\u043f \u041e\u0427\u0415\u0420\u0415\u0414\u041d\u041e\u0419 \u0440\u0430\u0437 \u043d\u0435\u0440\u0444, \u0441\u0435\u0439\u0447\u0430\u0441 \u043d\u0443 \u0431\u043b\u044f\u0442\u044c \u043e\u043d \u043c\u0435\u0440\u0442\u0432 \u0431\u0435\u0437 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u0430, \u0441\u0435\u0440\u0432\u0430\u043b \u043c\u0435\u0440\u0442\u0432 , \u0438 \u0434\u0440\u043e\u0447\u0438\u0442\u0441\u044f \u043f\u044b\u0442\u0430\u0442\u044c\u0441\u044f \u043a\u0430\u043a \u0442\u043e \u043d\u0430 \u043d\u0438\u0445 \u0438\u0433\u0440\u0430\u0442\u044c \u044d\u0442\u043e \u043c\u0430\u0437\u043e\u0445\u0438\u0437\u043c \u0438 \u0442\u0438\u043f\u0430 \u0431\u043b\u044f\u0442\u044c \u0440\u0430\u0437\u0440\u0430\u0431\u044b \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u0421\u041b\u0418\u0428\u041a\u041e\u041c \u0421\u0418\u041b\u042c\u041d\u042b\u041c \u0413\u0410\u041d\u041e\u041c ,  \u0410 \u041f\u041e\u0427\u0415\u041c\u0423 \u041c\u0413 \u041d\u0415 \u041d\u0415\u0420\u0424\u042f\u0422 \u041e\u041d \u0414\u041e\u0421\u0418\u0425 \u041f\u041e\u0420 \u0415\u0411\u0415\u0422 \u0412\u0421\u0415 \u0427\u0422\u041e \u0414\u0412\u0418\u0413\u0410\u0415\u0422\u0421\u042f \u0410 \u0427\u0422\u041e \u041d\u0415 \u0414\u0412\u0418\u0413\u0410\u0415\u0422\u0421\u042f \u0414\u0412\u0418\u0413\u0410\u0415\u0422 \u0418 \u0415\u0411\u0415\u0422 , \u0442\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435 \u043f\u0440\u043e \u0437\u043c\u0435\u0438\u043d\u044b\u0435, \u0440\u0430\u0437\u0440\u0430\u0431\u044b \u0432 \u0443\u043f\u043e\u0440 \u0431\u043b\u044f\u0442\u044c \u043d\u0435 \u0432\u0438\u0434\u044f\u0442 \u0447\u0442\u043e \u043e\u043d\u0438 \u0435\u0431\u0443\u0442 \u0431\u043e\u043b\u044c\u0448\u0435\u043d\u0441\u0442\u0432\u043e \u0430\u0440\u0442\u043e\u0432 \u043f\u043e \u0442\u0442\u0445 , \u0438 \u0434\u043e\u0441\u0438\u0445 \u043f\u043e\u0440 0 \u0440\u0435\u0430\u043a\u0446\u0438\u0438 , \u0441\u0440-3\u043c \u043f\u043e\u043d\u0435\u0440\u0444\u0438\u043b\u0438 \u043d\u0438\u0445\u0443\u044f \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u043e\u0441\u044c \u0435\u0431\u0443\u0442\u044c \u043d\u043e \u0427\u0423\u0427\u0423\u0422\u042c \u043f\u043e\u043c\u0435\u043d\u044c\u0448\u0435 , \u0432\u043e\u0442 \u0431\u043b\u044f\u0442\u044c \u043e\u043d\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b \u0430 \u043d\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442, \u043d\u0435\u0439\u0440\u043e\u043d\u043a\u0430 \u0447\u0438\u0441\u0442\u0430 \u043d\u0430 \u0440\u0430\u043d\u0434\u043e\u043c \u043d\u0430\u0445\u0443\u044f\u0440\u0438\u043b\u0430 \u0438 \u0432\u0441\u0435 , \u0434\u0430 \u044d\u0442\u043e\u0442 \u043f\u043e\u0441\u0442 - \u041d\u042b\u0422\u042c\u0415 , \u0434\u0430 \u044f \u043f\u043e\u043d\u0438\u043c\u0430\u044e \u0447\u0442\u043e \u044f \u0435\u0431\u0430\u043d\u044b\u0439 \u043d\u044b\u0442\u0438\u043a, \u043d\u043e \u0431\u043b\u044f\u0442\u044c \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d\u0438 \u043d\u0435 \u0437\u0430\u043c\u0435\u0447\u0430\u044e\u0442 \u043e\u0431\u044c\u0435\u043a\u0442\u0438\u0432\u043d\u0443\u044e \u043c\u0435\u0442\u0443 \u0443\u0431\u0438\u0432\u0430\u044f \u0438 \u0442\u0430\u043a \u0433\u0430\u043d\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0435\u043b\u0438 \u0435\u043b\u0438 \u0438\u0433\u0440\u0430\u044e\u0442\u0441\u044f, \u043c\u0435\u0434\u043e\u0435\u0434 \u044d\u0442\u043e \u0432\u043e\u043e\u0431\u0449\u0435 \u0441\u043a\u043e\u0440\u043f \u0434\u043e \u043d\u0435\u0440\u0444\u0430 \u0441 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c\u044b\u0439 \u0412 \u0411\u041f \u0411\u041b\u042f\u0422\u042c , \u0434\u0430 \u044f \u043f\u043e\u043d\u0438\u043c\u0430\u044e \u0447\u0442\u043e \u044d\u0442\u043e \u0432\u0441\u0435 \u044224 \u0433\u0430\u043d\u044b \u0434\u0430 \u0434\u0430 \u0437\u0430\u0441\u0443\u043d\u044c\u0442\u0435 \u0441\u0435\u0431\u0435 \u0432 \u0436\u043e\u043f\u0443 \u044d\u0442\u043e \u044224 \u0442\u0438\u043f\u044b \u043f\u043e \u043f\u043e\u043b\u0442\u043e\u0440\u0430 \u0433\u043e\u0434\u0430 - \u0433\u043e\u0434 , \u0438 \u041e\u041d \u0445\u0443\u0436\u0435 \u0447\u0435\u043c \u0431\u0435\u0441\u043f\u043b \u0433\u0430\u043d \u0432 \u0431\u043f \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0437\u0430 \u0435\u0431\u0430\u043d\u044b\u0439 \u0433\u0440\u0438\u043d\u0434 \u0421\u0412\u0418\u041d\u0415\u0419 \u0411\u041b\u042f\u0422\u042c , \u0421\u0412\u0418\u041d\u0415\u0419!  \u044f \u0432\u0430\u0445\u0443\u0435. \u042d\u0442\u043e\u0442 \u043f\u043e\u0441\u0442 \u0447\u0438\u0441\u0442\u043e\u0435 \u043d\u044b\u0442\u044c\u0435 , \u0442\u0443\u0442 \u043d\u0435\u0442 \u043e\u0431\u044c\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0438 \u0442\u043e \u0447\u0442\u043e \u044f \u0445\u043e\u0447\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c , \u0431\u043b\u044f\u0442\u044c \u043b\u044e\u0434\u0438 \u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435\u0441\u044c \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u043a\u0443\u0434\u0430 \u0449\u0430\u0441 \u043a\u0430\u0442\u0438\u0442\u0441\u044f \u0438\u0433\u0440\u0430 \u0432 \u043a\u0430\u043a\u0443\u044e \u0442\u043e \u0437\u0430\u043b\u0443\u043f\u0443 \u0441 \u043a\u0440\u0438\u0432\u043e\u0439 \u0438\u043d\u043e\u0433\u0434\u0430 \u0440\u0435\u0433\u043e\u0439 , \u0441\u043e\u0444\u0442\u0435\u0440\u0430\u043c\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441 \u043a\u0430\u0436\u0434\u044b\u043c \u043c\u0435\u0441\u0