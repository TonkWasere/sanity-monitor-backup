e \u0433\u0438\u0440\u0443?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0430 \u041a\u0443\u0437\u043d\u0435 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 \u043f\u043e\u043b\u0443-\u043c\u0430\u0441\u0442\u0435\u0440\u043e\u043a \u0438 \u0432\u044b\u0448\u0435, \u0442\u043e \u0435\u0441\u0442\u044c \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u0431\u0443\u0434\u0435\u0442 \u043d\u0438\u0436\u0435 \u0434\u043e\u043b\u0436\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f, \u0442\u043e \u0432\u0430\u0441 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0437\u0430\u043a\u0438\u043d\u0435\u0442 \u043a \u0443\u0441\u043b\u043e\u0432\u043d\u044b\u043c \u043f\u043e\u043b\u0443-\u043c\u0430\u0441\u0442\u0435\u0440\u043a\u0430\u043c.\u003C\/p\u003E \n\n\u003Cp\u003E\u0414\u0430\u043d\u043d\u0430\u044f \u043b\u043e\u043a\u0430\u0446\u0438\u044f \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u0434\u043b\u044f \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u043e\u043a\u0430\u0447\u0435\u043d\u043d\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0442\u0430\u043a \u0447\u0442\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u044e \u0432\u044b\u043a\u0430\u0447\u0438\u0432\u0430\u0442\u044c \u043f\u043e\u043a\u0430 \u0447\u0442\u043e \u0443\u0441\u043b\u043e\u0432\u043d\u043e \u043d\u0430 \u043e\u0441\u043f\u0430\u0440\u0438\u0432\u0430\u0435\u043c\u043e\u0439 \u043b\u043e\u043a\u0430\u0446\u0438\u0438.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197072-smeshno\/26\u0022 class=\u0022PostMention\u0022 data-id=\u00224729295\u0022\u003EBanduraM\u003C\/a\u003E \u0411\u043b\u044f, \u0447\u0435\u0441\u0442\u043d\u043e, \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0442\u0430\u043a\u043e\u0435 \u0441\u043b\u044b\u0448\u0443, \u043d\u0430\u0434\u043e \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u0442\u0435\u0441\u0442\u0438\u0442\u044c \u044d\u0442\u0438 \u0441\u043b\u043e\u0432\u0430 \u043d\u0430 \u0434\u043e\u0441\u0443\u0433\u0435, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044e \u0437\u0430 \u043f\u0440\u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0412\u043e\u0442 \u043e\u0434\u043d\u0430 \u003Cstrong\u003E\u0438\u0437 \u0433\u043b\u0430\u0432\u043d\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u003C\/strong\u003E \u0442\u0435\u043a\u0443\u0449\u0435\u0433\u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f - \u0443 \u043d\u0430\u0441 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u043f\u043b\u043e\u0445\u043e (\u0430 \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0438\u0433\u0434\u0435 \u0432 \u0438\u0433\u0440\u0435) - \u043d\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442\u0441\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f. \u0422\u043e\u043b\u044c\u043a\u043e \u043d\u0430 web-\u0440\u0435\u0441\u0443\u0440\u0441\u0430\u0445 \u0438 \u0442\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0430\u0435\u0442, \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0432\u0440\u044f\u0434 \u043b\u0438 \u043d\u043e\u0432\u0438\u0447\u043e\u043a \u043f\u043e\u043b\u0435\u0437\u0435\u0442 \u0438\u0441\u043a\u0430\u0442\u044c \u043f\u043e\u0441\u0442 \u043c\u0435\u0437\u043e\u0437\u043e\u0439\u0441\u043a\u043e\u0439 \u044d\u0440\u044b.\u003C\/p\u003E\n\n\u003Cp\u003E\u0415\u0441\u0442\u044c \u0432 \u043f\u043b\u0430\u043d\u