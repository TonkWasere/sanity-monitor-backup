0446\u0435\u043d\u0438\u043b, \u043d\u0443 \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f \u0445\u0443\u0435\u0442\u0430..\u003Cbr\u003E\n\u0434\u0435\u043b\u043e \u043d\u0435 \u0432 \u043d\u0430\u0433\u0440\u0430\u0434\u0430\u0445, \u0430 \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u0441\u0430\u043c\u043e\u043c \u0438\u0432\u0435\u043d\u0442\u0435, \u0434\u0443\u043c\u0430\u0435\u0448\u044c \u043e\u0442\u0434\u043e\u0445\u043d\u0443\u0442\u044c \u043e\u0442 \u041a\u0410\u041b\u043b\u0438\u0437\u0435\u044f \u0438 \u0421\u0410\u0421\u0418\u0441\u0435\u043e\u043d\u043e\u043a, \u0430 \u0442\u0443\u0442 \u043d\u0430 \u0442\u0435\u0431\u0435 \u041a\u0410\u041b\u043e\u0432\u0430\u044f \u0430\u0440\u0435\u043d\u0430\u003C\/p\u003E\n\n\u003Cp\u003E\u044f \u0445\u0443\u0439 \u0437\u043d\u0430\u0435\u0442, \u043d\u043e \u043f\u0435\u0440\u0432\u0430\u044f \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u043d\u0435\u0434\u043e\u0447\u0435\u0442\u0430\u043c\u0438 \u0430\u0440\u0435\u043d\u0430 \u0431\u044b\u043b\u0430 \u0442\u043e\u043f, \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u0435\u0451 \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u043c, \u0434\u0430\u0436\u0435 \u0432\u043d\u043e\u0441\u044f \u043f\u0440\u0430\u0432\u043a\u0438 \u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f (\u043d\u0430 \u0438\u0445 \u0432\u0437\u0433\u043b\u044f\u0434) \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u043a\u0430\u043b \u0433\u043e\u0432\u043d\u0430\u003Cbr\u003E\n\u043a\u0430\u043a \u0438 \u0432 \u043b\u044e\u0431\u044b\u0445 \u0444\u0438\u043b\u044c\u043c\u0430\u0445 \u0442\u0440\u0438\u043b\u043e\u0433\u0438\u044f\u0445, \u043f\u0435\u0440\u0432\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0442\u043e\u043f\u0447\u0438\u043a, \u0432\u0442\u043e\u0440\u0430\u044f \u043f\u0440\u043e\u0445\u043e\u0434\u043d\u0430\u044f, \u0442\u0440\u0435\u0442\u044c\u044f \u043a\u0430\u043b \u0433\u043e\u0432\u043d\u0430\u003C\/p\u003E\n\n\u003Cp\u003E\u044f \u0445\u0443\u0439 \u0437\u043d\u0430\u0435\u0442, \u043d\u0443 \u0440\u0430\u043d\u0434\u043e\u043c \u0432 \u043f\u043e\u043f\u0435\u043d\u0435, \u0440\u0430\u043d\u0434\u043e\u043c \u0432 \u0441\u0435\u0441\u0441\u0438\u044f\u0445, \u0440\u0430\u043d\u0434\u043e\u043c \u043d\u0430 \u0432\u044b\u0431\u0440\u043e\u0441\u0435, \u0440\u0430\u043d\u0434\u043e\u043c \u043d\u0430 \u041a\u0410\u041b\u043b\u0438\u0437\u0435\u0435, \u0442\u0435\u043f\u0435\u0440\u044c \u0440\u0430\u043d\u0434\u043e\u043c \u043d\u0430 \u041a\u0430\u043b\u043e\u0432\u043e\u0439 \u0430\u0440\u0435\u043d\u0435, \u0430 \u043c\u043e\u0436\u043d\u043e \u0431\u0435\u0437 \u0440\u0430\u043d\u0434\u043e\u043c\u0430 \u0432\u043e\u043e\u0431\u0449\u0435 \u0434\u0435\u043b\u0430\u0442\u044c \u0447\u0442\u043e \u043b\u0438\u0431\u043e \u0432 \u044d\u0442\u0438\u0445 \u0437\u043b\u043e\u043a\u0443\u0431\u0430\u0445?\u003C\/p\u003E\n\n\u003Cp\u003E\u043d\u0443 \u0442\u0438\u043f\u043e, \u043e\u0434\u043d\u0430 \u043a\u0430\u0442\u043a\u0430 \u043f\u0440\u043e\u0435\u0431, \u0434\u0440\u0443\u0433\u0430\u044f \u0432\u0438\u043d \u0438 \u0432\u0441\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0440\u0430\u043d\u0434\u043e\u043c\u0430\u2026 \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0443\u043d\u0434 \u043b\u044e\u0442\u044b\u0439 \u0440\u0430\u043d\u0434\u043e\u043c, \u0432 \u043f\u0435\u0440\u0432\u043e\u0439 \u043a\u0430\u0442\u043a\u0438 \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u0431\u044b\u043b\u043e \u0437\u043e\u043c\u0431\u0435\u0439 \u0432\u044b\u0436\u0438\u0432\u0430\u043b \u043d\u0430\u0448 \u043a\u0430\u043c\u0435\u0448\u0435\u043a \u043d\u0430 \u0438\u0437\u0438, \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u043a\u0430\u0442\u043a\u0435 \u043f\u043e \u043a\u0434 \u0437\u043e\u043c\u0431\u0438 \u0438 \u043a\u0430\u043c\u0