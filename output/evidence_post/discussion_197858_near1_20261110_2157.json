431\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0431\u0435\u0434\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0447\u0435\u043c \u0441 80% \u0437\u0434\u0440\u043e\u0432\u044c\u044f \u0430\u043b\u0442\u0430\u0440\u044f \u041d\u0415\u041f\u0420\u041e\u0425\u041e\u0414\u0418\u041c\u041e\u0415? \u043d\u0430 \u044d\u0442\u0430\u043f\u0435 \u0440\u0430\u043d\u043d\u0438\u0445 \u0442\u0435\u0441\u0442\u043e\u0432 \u043e\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043c\u043e, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0435\u0433\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u0438 \u043c\u043d\u043e\u0433\u0438\u0435 \u0443\u0441\u043f\u0435\u043b\u0438 \u0435\u0433\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u043e \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430, \u043d\u043e \u0432\u043e\u0442 \u043f\u043e\u0442\u043e\u043c.. \u0410, \u0442\u043e \u0435\u0441\u0442\u044c \u043c\u0443\u0442\u0430\u043d\u0442\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u043b\u0438 \u043d\u0430\u043f\u0430\u0434\u0430\u0442\u044c \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044c? \u041d\u0443 \u043b\u043e\u0433\u0438\u0447\u043d\u043e, \u0430 \u0431\u0443\u0434\u0435\u043c \u043b\u0438 \u043c\u044b \u043c\u0435\u043d\u044f\u0442\u044c \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432\u0435\u0434\u044c \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0432\u043e\u0437\u0440\u0430\u0441\u043b\u0430? \u041c \u043d\u0435\u0442 \u043a\u043e\u043d\u0435\u0447\u043d\u043e. \u0418 \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0432\u0430\u043c \u0445\u043e\u0442\u044f \u0431\u044b \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u043d\u0435 100% \u043c\u0443\u0442\u0430\u043d\u0442\u043e\u0432 \u0431\u0435\u0433\u0443\u0442 \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044c \u0430 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0430, \u043d\u043e \u0434\u0430\u0436\u0435 \u0442\u0430\u043a, \u0434\u0430\u0436\u0435 \u0441 \u0445\u043e\u0440\u043e\u0448\u0435\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u043e\u0439, \u0434\u0430\u0436\u0435 70+ \u041f\u041e\u0427\u0422\u0418 \u041d\u0415\u0420\u0415\u0410\u041b\u042c\u041d\u041e \u043f\u043e\u0441\u043b\u0435 15 \u0440\u0430\u0443\u043d\u0434\u0430, \u043a\u0430\u043a\u0438\u0435 80? \u043a\u0430\u043a\u043e\u0439 21 \u0440\u0430\u0443\u043d\u0434? \u043b\u0438\u0431\u043e \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u044f \u0432\u0441\u0435\u043c \u043a\u0442\u043e \u0438\u0433\u0440\u0430\u043b \u0434\u043e \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430, \u043d\u043e \u043d\u0435 \u043f\u0440\u043e\u0448\u0451\u043b \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435, \u043b\u0438\u0431\u043e \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0441\u0430\u043c \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u0438 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0425\u041e\u0422\u042f \u0411\u042b \u0428\u0410\u041d\u0421 \u043d\u0430 80%+ \u043a 21 \u0440\u0430\u0443\u043d\u0434\u0443, \u043b\u0438\u0431\u043e \u043e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 60% \u043d\u0430 20 \u0440\u0430\u0443\u043d\u0434\u0435, \u0438 \u0442\u043e, \u0431\u044b\u043b\u043e \u0431\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043c\u043e, \u043b\u0438\u0431\u043e \u0432\u0441\u0451-\u0442\u0430\u043a\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0442.\u043a. \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435 \u043f\u043e\u0447\u0442\u0438 \u043d\u0435\u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043c\u043e\u0435 (\u0445\u0443\u0434\u0448\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442). \u0415\u0441\u043b\u0438 \u043d\u0435 \u0442\u0435 \u0442\u0435\u0433\u0438, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430 \u043f\u043e\u043f\u0440\u0430\u0432\u044c\u0442\u0435.\u003C\/p\u003E","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"197858"}},"user":{"data":{"type":"users","id":"1703936"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4756498","attributes":{"number":2,"createdAt":"2026-11-10T21:48:20+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u0415\u0441\u043b\u0438 \u0432 \u0444\u0443\u043b \u043f\u0430\u0447\u043a\u0435 \u0441 \u043f\u043e\u043b\u043d\u044b\u043c \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u043c \u0438\u0433\u0440\u044b \u0438 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0443\u0434\u0430\u0447\u0435\u0439 \u0438\u0433\u0440\u0430\u0442\u044c, \u0442\u043e \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043c\u043e\u0435\u003C\/p\u003E\n\n\u003Cp\u003E\u0422\u0430\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0438 \u0432 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0435 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 \u0434\u043e 21 \u0440\u0430\u0443\u043d\u0434\u0430 \u0