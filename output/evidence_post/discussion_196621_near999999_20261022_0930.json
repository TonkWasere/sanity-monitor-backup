42\u043e\u0436 \u0435\u0431\u0443\u0447\u0438\u0439 \u0431\u0430\u0442\u043b\u0444\u0438\u043b\u0434, \u0435\u0441\u043b\u0438 \u0443\u0447\u0435\u0441\u0442\u044c \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u043f\u043e\u0442\u043e\u043a, \u043d\u0435?\u003C\/p\u003E \n\n\u003Cp\u003E\u041c\u0435\u043d\u044f \u0434\u0443\u0448\u0438\u0442 \u043f\u043e 3-5 \u043c\u0438\u043d\u0443\u0442 \u0431\u0435\u0436\u0430\u0442\u044c \u0434\u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0430 \u043d\u0430 \u043a\u0443\u0437\u043d\u0435 \u0438 \u0435\u0449\u0435 2 \u043c\u0438\u043d\u0443\u0442\u044b \u0434\u043e \u0442\u043e\u0447\u043a\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430. \u003Cbr\u003E\n\u041f\u043e\u0434\u0437\u0435\u043c\u043a\u0430 \u043d\u0430 \u0434\u0438\u043a\u0438\u0439 \u0432\u043e\u043e\u0431\u0449\u0435 \u0434\u0435\u043c\u043e\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u0432 \u043d\u0435\u0435 \u0438\u0433\u0440\u0430\u0442\u044c \u0441\u043f\u0443\u0441\u0442\u044f \u043f\u0430\u0440\u0443 \u0437\u0430\u0445\u043e\u0434\u043e\u0432, \u0434\u0443\u0448\u043d\u0438\u043d\u0430 \u0435\u0431\u0443\u0447\u0430\u044f. \u003Cbr\u003E\n\u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043b\u043e\u043a\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0438\u0433\u0440\u0430\u043b \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u043b\u0430 \u043b\u0438\u043c\u043e\u0439 \u043d\u043e \u0434\u0430\u0436\u0435 \u0435\u0435 \u043f\u0443\u0437\u044b\u0440\u044c \u043d\u0430\u0445\u0443\u0439 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u043b\u0438 \u043d\u0430 \u043a\u0440\u0430\u0439 \u043b\u043e\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u0431\u0435\u0436\u0430\u043b \u0442\u0443\u0434\u0430 \u043f\u043e 3 \u043c\u0438\u043d\u0443\u0442\u044b.\u003C\/p\u003E\n \n\u003Cp\u003E\u0414\u0430\u0439\u0442\u0435 \u043b\u044e\u0434\u044f\u043c \u043f\u043e\u0431\u043e\u043b\u044c\u0448