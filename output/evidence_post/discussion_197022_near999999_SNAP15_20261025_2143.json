0441\u0430\u043c\u043e\u0435 \u0441\u043c\u0435\u0448\u043d\u043e\u0435\u003Cbr\u003E\n\u201c\u0421\u043e\u0440\u044f\u043d, \u0447\u0442\u043e \u0442\u044b \u0442\u0430\u043c \u0444\u0438\u0433\u0443\u0440\u0438\u0440\u0443\u0435\u0448\u044c, \u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u0438\u201d\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197022-pravda-pro-obschestvo-raspila-zony-ohota\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224726986\u0022\u003EOYAN\u003C\/a\u003E \u042f \u041d\u0410\u0417\u041d\u0410\u0427\u0410\u042e \u041d\u0410\u0413\u0420\u0410\u0414\u0423 200.000 \u0412\u0410\u041b\u042e\u0422\u042b \u0417\u0410 \u041a\u0410\u0416\u0414\u041e\u0413\u041e \u0423\u0411\u0418\u0422\u041e\u0413\u041e \u0412 \u0411\u0423\u041d\u041a\u0415\u0420\u0415 \u0422\u0412\u0418\u041d\u041a\u0410 \u201c\u041e\u0420\u0417\u201d.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0415\u0431\u0430\u043d\u0443\u0448\u043a\u0430, \u0442\u044b \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u043b \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u043d\u0430 \u0442\u0438\u043f\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0443\u0441\u043a\u0430\u0435\u0442 90% \u043b\u044e\u0434\u0435\u0439 \u0432 \u0431\u0443\u043d\u043a\u0435\u0440 \u0438 \u0438\u0437\u0432\u0438\u043d\u0438\u043b\u0441\u044f \u043f\u0435\u0440\u0435\u0434 \u043d\u0438\u043c.\u003C\/p\u003E\n\n\n\u003Ch1\u003E\u041e\u0431\u0440\u0430\u0442\u043a\u0430\u003C\/h1\u003E\n\n\u003Cp\u003E\u0421\u043c\u043e\u0442\u0440\u0438, \u0435\u0441\u043b\u0438 \u0442\u044b \u043e\u0431\u043e\u0431\u0449\u0430\u0435\u0448\u044c \u0432\u0441\u0451 \u041e\u0420\u0417, \u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u043b\u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e \u0441 \u043c\u043e\u0435\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043e\u0431\u043e\u0431\u0449\u0438\u0442\u044c \u0442\u0435\u0431\u044f \u0438 \u0442\u0432\u043e\u0438\u0445 \u0442\u0438\u043c\u043c\u0435\u0439\u0442\u043e\u0432?\u003Cbr\u003E\n\u0412\u043e\u0442 \u0442\u0432\u043e\u0439 \u0442\u0438\u043c\u043c\u0435\u0439\u0442 \u0436\u0451\u0441\u0442\u043a\u043e \u043e\u0431\u0441\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0440\u0430\u0434\u0438 \u0442\u0435\u0431\u044f. \u041a\u0421\u0422\u0410\u0422\u0418, \u0421 \u041f\u041e\u041b\u041d\u042b\u041c \u041a\u041e\u041d\u0422\u0415\u041a\u0421\u0422\u041e\u041c)))\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-25\/1792962604-680502-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002201328824-53a2-4daa-9083-db851b2e156b\u0022 loading=\u0022lazy\u0022 width=\u00222353\u0022 height=\u0022941\u0022\u003E\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-25\/1792962634-663255-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002275b74fd9-d0d0-415d-9f92-8684f8503c45\u0022 loading=\u0022lazy\u0022 width=\u00222474\u0022 height=\u00221022\u0022\u003E\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-25\/1792962656-731575-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002240482a85-4594-4656-a657-800ff0cc7f97\u0022 loading=\u0022lazy\u0022 width=\u00222427\u0022 height=\u00221149\u0022\u003E\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-25\/1792962674-174382-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002257954405-4e75-4b68-acac-b06a975d48da\u0022 loading