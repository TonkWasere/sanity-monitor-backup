2\u0432\u0435\u0447\u0443 \u043a\u043e\u0440\u043e\u0442\u043a\u043e:\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0435 \u0441 \u0441\u043e\u0431\u0430\u043a\u0435\u043d\u043e\u043c - \u043a\u0440\u0443\u0442\u043e, \u0442\u043e\u043b\u044c\u043a\u043e \u044f \u0441\u0440\u0435\u0437\u0430\u043b \u0432\u0441\u0435, \u0447\u0442\u043e \u043d\u0435 \u043d\u0435\u0441\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0441\u0443\u0442\u044c, \u043e \u0447\u0451\u043c \u0438 \u043d\u0430\u043f\u0438\u0441\u0430\u043b.\u003Cbr\u003E\n\u041f\u043e \u201c\u0438\u0437\u0432\u0438\u043d\u0435\u043d\u0438\u044f\u043c\u201d \u043f\u0435\u0440\u0435\u0434 \u0441\u043e\u0431\u0430\u043a\u0435\u043d\u043e\u043c - \u043d\u0443 \u0434\u0430, \u043f\u043e \u0444\u0430\u043a\u0442\u0443. \u041e\u043d \u043d\u0435\u043f\u043b\u043e\u0445\u043e\u0439 \u043f\u0430\u0440\u0435\u043d\u044c, \u043f\u0443\u0441\u0442\u044c \u0438 \u0438\u043d\u043e\u0433\u0434\u0430 \u0432\u0435\u0434\u0435\u0442 \u0441\u0435\u0431\u044f \u043a\u0430\u043a \u0434\u0443\u0440\u0430\u043a, \u0438 \u043c\u043d\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0434\u0430\u0436\u0435 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0436\u0430\u043b\u044c, \u0447\u0442\u043e \u043e\u043d \u0432 \u044d\u0442\u043e\u043c \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442. \u042f \u043a \u043d\u0435\u043c\u0443 \u0443\u0436\u0435 \u043f\u0440\u0438\u0432\u044b\u043a, \u043c\u044b \u0434\u0430\u0436\u0435 \u0434\u0440\u0443\u0436\u0438\u043c \u0432 \u0431\u0443\u043d\u043a\u0435\u0440\u0435, \u0443\u0436\u0435 \u043d\u0438\u043a\u0438 \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u043b\u0438. \u0422\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435 \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u043c\u043e\u043d\u0441\u0442\u0430 - \u0442\u043e\u0436\u0435 \u043d\u0435\u043f\u043b\u043e\u0445\u043e\u0439 \u043f\u0430\u0440\u0435\u043d\u044c, \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u0435\u0433\u043e \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0443\u0431\u0438\u043b, \u0430 \u043e\u043d \u0431\u0435\u0437 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u0430, \u0448\u0443\u0442\u043a\u0438 \u0448\u0443\u0442\u0438\u0442. \u042f \u0432 \u0441\u0432\u043e\u0451\u043c \u0436\u0435 \u043f\u043e\u0441\u0442\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u043c\u043d\u0435 \u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0445\u043e\u0447\u0435\u0442\u0441\u044f \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0438\u0437-\u0437\u0430 \u043d\u0438\u0445, \u043d\u043e \u043e\u043d\u0438 \u043b\u0438\u0448\u044c \u043a\u043d\u043e\u043f\u043a\u0430 \u0432 \u0431\u0443\u043d\u043a\u0435\u0440\u0435. \u0414\u043e \u0431\u043e\u0433\u043c\u0430\u043d\u0430 \u0438, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0435\u0431\u044f \u0433\u043b\u0443\u043f\u044b\u0448\u043a\u0438, \u043d\u0435 \u0434\u043e\u0445\u043e\u0434\u0438\u0442 \u0441\u043b\u043e\u0432\u0430\u043c\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432\u044b \u044d\u0442\u0438\u043c \u043d\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0435\u0441\u044c. \u0422\u043e\u043b\u044c\u043a\u043e \u0412\u0430\u0448\u0438 \u0436\u0435 \u0440\u0435\u0431\u044f\u0442\u0430 \u043c\u043e\u0433\u0443\u0442 \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u0438\u043c \u0442\u044f\u0436\u0435\u043b\u043e \u0438 \u043d\u0435\u043a\u043e\u043c\u0444\u043e\u0440\u043e\u0442\u043d\u043e \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0432 \u0434\u0430\u043d\u043d\u044b\u0445 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430.\u003C\/p\u003E\n\n\u003Cp\u003E\u0410 \u043f\u0440\u043e \u0418\u0437\u0434\u0430\u043d\u04