32\u0434\u0432\u043e\u0435\u043c. \u041e\u0434\u0438\u043d \u0438\u0433\u0440\u043e\u043a \u043d\u0435\u043f\u043e\u0434\u0432\u0438\u0436\u043d\u043e \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u0432\u043e\u0439 \u043a\u0430\u0448\u0442\u0430\u043d \u043d\u0430 \u0432\u0435\u0440\u0435\u0432\u043a\u0435, \u0430 \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0441\u043a\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0432\u043e\u0439 \u0438 \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f \u0443\u0434\u0430\u0440\u0438\u0442\u044c \u043f\u043e \u043a\u0430\u0448\u0442\u0430\u043d\u0443 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0430. \u041f\u043e\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u0442\u043e\u0442, \u0447\u0435\u0439 \u043a\u0430\u0448\u0442\u0430\u043d \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u0446\u0435\u043b\u044b\u043c.\u003C\/p\u003E\n","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":1,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":1,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196976"}},"user":{"data":{"type":"users","id":"1717648"}},"mentionedBy":{"data":[{"type":"posts","id":"4726071"}]},"likes":{"data":[]}}},{"type":"posts","id":"4726071","attributes":{"number":13,"createdAt":"2026-10-25T09:05:10+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196976-halyava-priydyot\/12\u0022 class=\u0022PostMention\u0022 data-id=\u00224726043\u0022\u003EW