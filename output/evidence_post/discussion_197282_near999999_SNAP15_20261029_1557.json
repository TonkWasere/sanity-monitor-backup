0442\u0438\u043a\u0443 \u043f\u043e \u0433\u0440\u0430\u043d\u0430\u0442\u0430\u043c, \u0431\u0430\u0440\u0440\u0438\u043a\u0430\u0434\u0430\u043c, \u0443\u0440\u043e\u043d\u0443 \u043f\u043e \u043f\u0430\u043b\u0430\u0442\u043a\u0435 \u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c. \u042d\u0442\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0434\u043b\u044f \u0431\u0430\u043d\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f: \u043a\u0442\u043e \u0438\u0433\u0440\u0430\u0435\u0442 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430 \u043b\u0438\u0447\u043d\u044b\u0439 \u0442\u0430\u0431, \u0430 \u043a\u0442\u043e \u0438\u0433\u0440\u0430\u0435\u0442 \u043d\u0430 \u043f\u043e\u0431\u0435\u0434\u0443 \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u043e \u043a\u043e\u043b\u0430\u043c.\u003Cbr\u003E\n\u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u043c\u0435\u0442\u0440\u0438\u043a\u0438:\u003Cbr\u003E\n\u2022 \u0417\u0430\u0445\u0432\u0430\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438; \u043f\u043e \u0442\u0438\u043f\u0443 A \u043f\u043e\u0438\u043d\u0442 876 \u0421 \u043f\u043e\u0438\u043d\u0442 420 \u0438 \u0442\u0434.\u003Cbr\u003E\n\u2022 \u0423\u0440\u043e\u043d \u043f\u043e \u043f\u0430\u043b\u0430\u0442\u043a\u0435;\u003Cbr\u003E\n\u2022 \u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0431\u0430\u0440\u0440\u0438\u043a\u0430\u0434 (\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0434\u0430\u0436\u0435 \u0441 \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u044b\u043c \u043e\