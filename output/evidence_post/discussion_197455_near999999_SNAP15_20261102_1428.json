\u0442\u044c \u044d\u0442\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u044f \u043f\u0440\u043e\u0432\u0451\u043b \u0437\u0430 \u0444\u0430\u0440\u043c\u043e\u043c \u043d\u043f\u0441 \u043d\u0430 \u0431\u0430\u0440\u0435 \u0438 \u0430\u0440\u043c\u0430\u0445, \u043f\u043e\u0437\u0436\u0435 \u043f\u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u043b\u0441\u044f \u0441 \u043b\u044e\u0434\u044c\u043c\u0438, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043d\u0430\u0447\u0430\u043b \u0438\u0433\u0440\u0430\u0442\u044c \u043a\u0432\u0448\u043a\u0438 \u043d\u0430 \u0441\u0432\u0430\u043b\u043a\u0435, \u0436\u0430\u043b\u044c \u0447\u0442\u043e \u043d\u0438 \u0441 \u043a\u0435\u043c \u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b\u043e\u0441\u044c, \u043a\u0440\u043e\u043c\u0435 \u043e\u0434\u043d\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0430 \u0431\u043b\u0438\u0436\u0435 \u043a \u043a\u043e\u043d\u0446\u0443 \u0443\u0448\u0451\u043b \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u0443, \u0441\u0435\u0439\u0447\u0430\u0441 \u044f \u0431\u044b \u043c\u043d\u043e\u0433\u043e\u0435 \u043e\u0442\u0434\u0430\u043b, \u0447\u0442\u043e\u0431\u044b \u0445\u043e\u0442\u044f \u0431\u044b \u043d\u0430 \u043e\u0434\u0438\u043d \u0432\u0435\u0447\u0435\u0440 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u0442\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430, \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0431\u0435\u0433\u0430\u0442\u044c \u043f\u043e \u0441\u0442\u0430\u0440\u044b\u043c \u043b\u043e\u043a\u0430\u0446\u0438\u044f\u043c, \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044c \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0435 \u043d\u0438\u043a\u0438 \u0438 \u0441\u043d\u043e\u0432\u0430 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f \u0442\u0435\u043c \u0434\u0435\u0441\u044f\u0442\u0438\u043b\u0435\u0442\u043d\u0438\u043c \u043f\u0430\u0446\u0430\u043d\u043e\u043c, \u0434\u043b\u044f \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442 \u0431\u044b\u043b \u0446\u0435\u043b\u043e\u0439 \u0436\u0438\u0437\u043d\u044c\u044e.\u003C\/p\u003E\n\n\u003Cp\u003E\u0410 \u043f\u043e\u0442\u043e\u043c \u043d\u0430\u0441\u0442\u0443\u043f\u0438\u043b\u043e \u041e\u0424\u0422, \u043c\u043d\u0435 \u0431\u044b\u043b\u043e 13, \u0438 \u044f \u043f\u043e\u043c\u043d\u044e, \u0441 \u043a\u0430\u043a\u0438\u043c \u043d\u0435\u0442\u0435\u0440\u043f\u0435\u043d\u0438\u0435\u043c \u0436\u0434\u0430\u043b \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f. \u042f \u0441\u043c\u043e\u0442\u0440\u0435\u043b \u0442\u0440\u0435\u0439\u043b\u0435\u0440\u044b, \u043f\u0435\u0440\u0435\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u043b \u0438\u0445 \u0441\u043d\u043e\u0432\u0430 \u0438 \u0441\u043d\u043e\u0432\u0430, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u044f, \u043a\u0430\u043a\u0438\u043c \u0441\u0442\u0430\u043d\u0435\u0442 \u043c\u0438\u0440 \u0438\u0433\u0440\u044b. \u0418 \u043a\u043e\u0433\u0434\u0430 \u0432\u0441\u0451 \u044d\u0442\u043e \u043d\u0430\u043a\u043e\u043d\u0435\u0446 \u043f\u043e\u044f\u0432\u0438\u043b\u043e\u0441\u044c \u0432\u0436\u0438\u0432\u0443\u044e, \u044f \u0431\u044b\u043b \u0432 \u043f\u043e\u043b\u043d\u043e\u043c \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u043e\u0432\u044b\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0438 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043a\u0430\u0437\u0430\u043b\u0438\u0441\u044c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u043c\u0430\u0439\u043d\u0430. \u042f \u043c\u043e\u0433 \u0438\u0433\u0440\u0430\u0442\u044c \u0441\u0443\u0442\u043a\u0430\u043c, \u0448\u043a\u043e\u043b\u0430, \u0434\u0437, \u043e\u0431\u044b\u0447\u043d\u0430\u044f \u0436\u0438\u0437\u043d\u044c - \u0432\u0441\u0451 \u043e\u0442\u0445\u043e\u0434\u0438\u043b\u043e \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u0439 \u043f\u043b\u0430\u043d. \u041e\u0447\u0435\u043d\u044c \u0447\u0430\u0441\u0442\u043e \u044f \u0434\u0430\u0436\u0435 \u043f\u0440\u043e\u0433\u0443\u043b\u0438\u0432\u0430\u043b \u0437\u0430\u043d\u044f\u0442\u0438\u044f \u043f\u043e \u0441\u0440\u0435\u0434\u0430\u043c, \u0447\u0442\u043e\u0431\u044b \u043e\u0434\u043d\u0438\u043c \u0438\u0437 \u043f\u0435\u0440\u0432\u044b\u0445 \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u043d\u043e\u0432\u043e\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435. \u0418 \u0442\u043e\u0433\u0434\u0430 \u043c\u043d\u0435 \u043a\u0430\u0437\u0430\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u0432\u043f\u0435\u0440\u0435\u0434\u0438 \u0435\u0449\u0451 \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0441\u0435\u0433\u043e, \u0447\u0442\u043e \u0438\u0433\u0440\u0430 \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u0438\u0432\u043b\u044f\u0442\u044c \u043c\u0435\u043d\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u0417\u0430\u0442\u0435\u043c \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u043e\u0439\u043a\u0430. \u041c\u043d\u0435 \u0431\u044b\u043b\u043e 16. \u042f \u0440\u0435\u0448\u0438\u043b \u043d\u0438\u043a\u0443\u0434\u0430 \u043d\u0435 \u043f\u043e\u0441\u0442\u0443\u043f\u0430\u0442\u044c \u0438 \u043e\u0441\u0442\u0430\u0442\u044c\u0441\u044f \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0441\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442\u0435, \u0434\u0443\u043c\u0430\u044f \u0447\u0442\u043e \u0432\u0441\u0451 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u0442\u043e\u043c \u0441\u0430\u043c\u043e \u043a\u0430\u043a \u043d\u0438\u0431\u0443\u0434\u044c \u0441\u043b\u043e\u0436\u0438\u0442\u0441\u044f, \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438, \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0431\u044b\u043b\u0438 \u043f\u0440\u043e\u0442\u0438\u0432, \u0438 \u043f\u043e\u0437\u0436\u0435 \u043c\u0435\u043d\u044f \u0432\u0441\u0451 \u0442\u0430\u043a\u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043f\u043e\u0439\u0442\u0438 \u0443\u0447\u0438\u0442\u044c\u0441\u044f. \u041d\u043e \u0434\u0430\u0436\u0435 \u044d\u0442\u043e \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u043e \u043c\u0435\u043d\u044f, \u044f \u043f\u0440\u043e\u0433\u0443\u043b\u0438\u0432\u0430\u043b 90% \u043f\u0430\u0440, \u043b\u0438\u0448\u044c \u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0432 \u0438\u0433\u0440\u0435 \u0435\u0449\u0451 \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u043e\u043d\u0442\u0435\u043d\u0442\u0430 \u0441\u0442\u0430\u043b\u043e \u043c\u0435\u043d\u044c\u0448\u0435, \u044d\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e\u0441\u044c, \u043d\u043e \u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u043b \u0438\u0433\u0440\u0430\u0442\u044c. \u041f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442 \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u0434\u0430\u0432\u043d\u043e \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0433\u0440\u043e\u0439. \u042d\u0442\u043e \u0431\u044b\u043b\u0438 \u043b\u044e\u0434\u0438, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b \u0434\u043d\u0438 \u0438 \u043d\u043e\u0447\u0438. \u042d\u0442\u043e \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f, \u0446\u0435\u043b\u044b\u0435 \u044d\u0442\u0430\u043f\u044b \u0436\u0438\u0437\u043d\u0438 \u0438 \u043c\u043e\u043c\u0435\u043d\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0436\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0442\u0441\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u0418 \u0432\u043e\u0442 \u043c\u043d\u0435 \u043f\u043e\u0447\u0442\u0438 23.\u003C\/p\u003E\n\n\u003Cp\u003E\u0417\u0430 \u043f\u043b\u0435\u0447\u0430\u043c\u0438 \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u0442\u044b\u0441\u044f\u0447 \u0447\u0430\u0441\u043e\u0432. \u0418\u0437 \u043a\u043e\u043b\u043b\u0435\u0434\u0436\u0430 \u043c\u0435\u043d\u044f \u0434\u0430\u0432\u043d\u043e \u043e\u0442\u0447\u0438\u0441\u043b\u0438\u043b\u0438: \u0432\u043c\u0435\u0441\u0442\u043e \u0434\u0438\u043f\u043b\u043e\u043c\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u044f \u0444\u0430\u0440\u043c\u0438\u043b \u043d\u043e\u0432\u043e\u0433\u043e\u0434\u043d\u0438\u0439 \u0438\u0432\u0435\u043d\u0442 \u0438 \u043f\u0435\u0440\u0432\u0443\u044e \u0430\u0440\u0435\u043d\u0443 \u0440\u0443\u0441\u043e\u0432. \u0412 \u0430\u0440\u043c\u0438\u0438 \u044f \u043e\u0442\u0441\u043b\u0443\u0436\u0438\u043b \u0443\u0436\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0435\u0442 \u043d\u0430\u0437\u0430\u0434. \u0417\u0430 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u044f \u0443\u0441\u043f\u0435\u043b \u043f\u043e\u0432\u0437\u0440\u043e\u0441\u043b\u0435\u0442\u044c, \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c\u0441\u044f \u0438, \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u043f\u043e\u0442\u0435\u0440\u044f\u0442\u044c \u0447\u0430\u0441\u0442\u044c \u0442\u043e\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u043e \u0434\u0435\u0442\u0441\u043a\u043e\u0433\u043e \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u0430.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u043e \u044f \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0430\u0445\u043e\u0436\u0443 \u0432 \u0441\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442. \u0412\u0441\u0451 \u0435\u0449\u0451 \u0438\u0449\u0443 \u0447\u0442\u043e-\u0442\u043e \u043d\u043e\u0432\u043e\u0435. \u0412\u0441\u0451 \u0435\u0449\u0451 \u043d\u0430\u0434\u0435\u044e\u0441\u044c, \u0447\u0442\u043e \u043e\u0434\u043d\u0430\u0436\u0434\u044b \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442 \u043c\u0435\u043d\u044f \u0441\u043d\u043e\u0432\u0430 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0442\u043e, \u0447\u0442\u043e \u044f \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0432 10 \u0438\u043b\u0438 13 \u043b\u0435\u0442. \u041a\u043e\u0433\u0434\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043d\u043e\u0432\u044b\u0439 \u0442\u0440\u0435\u0439\u043b\u0435\u0440 \u0431\u044b\u043b \u043e\u0431\u0435\u0449\u0430\u043d\u0438\u0435\u043c \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f, \u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043d\u043e\u0432\u044b\u0439 \u0434\u0435\u043d\u044c \u0432 \u0438\u0433\u0440\u0435 \u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u044b\u043c.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u043e\u043d\u0435\u0447\u043d\u043e, \u044f \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u0447\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043d\u0435 \u0432\u0435\u0440\u043d\u0443\u0442\u044c. \u0423\u0436\u0435 \u043d\u0435\u0442 \u0442\u0435\u0445 \u043b\u044e\u0434\u0435\u0439, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u044f \u043a\u043e\u0433\u0434\u0430-\u0442\u043e \u0438\u0433\u0440\u0430\u043b. \u041d\u0435\u0442 \u043f\u0440\u0435\u0436\u043d\u0438\u0445 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0435\u0439, \u043d\u0435\u0442 \u0442\u043e\u0433\u043e \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0438 \u0441\u0438\u043b, \u0447\u0442\u043e\u0431\u044b \u0441\u043d\u043e\u0432\u0430 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0432 \u0438\u0433\u0440\u0435 \u0446\u0435\u043b\u044b\u0435 \u0441\u0443\u0442\u043a\u0438. \u0418, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0434\u0435\u043b\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0435. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u0440\u043e\u0441.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u043e \u043c\u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0445\u043e\u0447\u0435\u0442\u0441\u044f \u0432\u0435\u0440\u0438\u0442\u044c, \u0447\u0442\u043e \u0441\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442 \u0435\u0449\u0451 \u0441\u043f\u043e\u0441\u043e\u0431\u0435\u043d \u0443\u0434\u0438\u0432\u0438\u0442\u044c \u043c\u0435\u043d\u044f. \u0427\u0442\u043e \u043e\u0434\u043d\u0430\u0436\u0434\u044b \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u043d\u043e\u0432\u044b\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u043d\u043e\u0432\u044b\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0438 \u043d\u043e\u0432\u044b\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u044f\u0442 \u043c\u0435\u043d\u044f \u0441\u043d\u043e\u0432\u0430 \u0437\u0430\u0431\u044b\u0442\u044c \u043e\u0431\u043e \u0432\u0441\u0451\u043c \u0432\u043e\u043a\u0440\u0443\u0433 \u0438 \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f \u0442\u0435\u043c \u0441\u0430\u043c\u044b\u043c \u0440\u0435\u0431\u0451\u043d\u043a\u043e\u043c, \u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0437\u0430\u0448\u0435\u0434\u0448\u0438\u043c \u043d\u0430 \u041e\u0411\u0422.\u003C\/p\u003E\n\n\n\u003Cp\u003E\u0422\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u0442 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0435\u0449\u0451 \u0436\u0434\u0430\u0442\u044c?\u003C\/p\u003E","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":1,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"197455"}},"user":{"data":{"type":"users","id":"21190"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4742868","attributes":{"number":2,"createdAt":"2026-11-02T14:18:14+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u041c\u0430\u0441\u0442\u0443\u0440\u0431\u0430\u0446\u0435\u0439\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cspan class=\u0022spoiler\u0022 onclick=\u0022removeAttribute(\u0027class\u0027)\u0022\u003E\u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0437\u0430\u0431\u0430\u043d\u044f\u0442\u003C\/span\u003E\u003C\/p\u003E ","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0