\u0435 \u0434\u043b\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438,  \u0438 \u0432 \u043e\u0431\u0449\u0435\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0433\u043e \u043a\u043e\u043c\u044c\u044e\u043d\u0438\u0442\u0438 \u0434\u0430\u043d\u043d\u043e\u0439 \u0438\u0433\u0440\u044b \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u0443\u0434\u043e\u0440\u043e\u0436\u043d\u043e-\u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f, \u043d\u043e \u0432\u0441\u0451 \u0436\u0435\u2026 \u042d\u0442\u043e \u0432\u0435\u0434\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u0431\u0441\u0443\u0440\u0434.\u003Cbr\u003E\n\u041a\u0430\u043b\u0438\u0431\u0440\u0443\u0435\u0448\u044c\u0441\u044f \u0442\u044b \u0437\u043d\u0430\u0447\u0438\u0442 \u0441 \u043f\u0430\u0447\u043a\u043e\u0439 \u0432 3000-3500 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430. \u0418\u0433\u0440\u0430\u0435\u0448\u044c \u043f\u0440\u043e\u0442\u0438\u0432 \u0442\u0430\u043a\u043e\u0433\u043e \u0436\u0435 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430, \u0438\u0433\u0440\u0430\u0435\u0448\u044c \u0432 \u043a\u0434, \u0437\u0430 20 \u0438\u0433\u0440 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0448\u044c \u003Cbr\u003E\n1 \u043c\u0435\u0441\u0442\u043e - 2 \u0440\u0430\u0437\u0430\u003Cbr\u003E\n2 \u043c\u0435\u0441\u0442\u043e - 16 \u0440\u0430\u0437\u003Cbr\u003E\n3 \u043c\u0435\u0441\u0442\u043e -1 \u0440\u0430\u0437\u003Cbr\u003E\n4 \u043c\u0435\u0441\u0442\u043e - 1 \u0440\u0430\u0437\u003Cbr\u003E\n\u0418 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c 1400 . \u044f \u043f\u043e\u043d\u0438\u043c\u0430\u044e \u0447\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u0439 \u0441\u0435\u0437\u043e\u043d \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b, \u043a\u043e\u0433\u0434\u0430 \u0432\u0441\u0435 \u0438\u0433\u0440\u0430\u043b\u0438 , \u0438 \u0432\u0441\u0435\u0445 \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0445 \u043a\u0438\u043d\u0443\u043b\u043e \u043d\u0430 \u0442\u043e\u0442 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u043a\u0430\u043a\u043e\u0439 \u0443 \u043d\u0438\u0445 \u0431\u044b\u043b \u0432 \u043a\u043e\u043d\u0446\u0435 \u0441\u0435\u0437\u043e\u043d\u0430( \u043e\u043d\u0438 \u0432\u0441\u0435 \u0438 \u0430\u043f\u043d\u0443\u043b\u0438 \u043f\u043e\u0440\u044f\u0434\u043a\u0430 3\u043a) \u003Cbr\u003E\n\u043d\u043e \u0434\u043b\u044f \u0447\u0435\u0433\u043e \u044f \u0438\u0433\u0440\u0430\u044e \u043d\u0430 \u0442\u043e\u043c \u0436\u0435 \u0443\u0440\u043e\u0432\u043d\u0435 20 \u0438\u0433\u0440 , \u043a\u0430\u0436\u0434\u0443\u044e \u0438\u0433\u0440\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0448\u044c \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e \u043e\u0434\u043d\u0443 \u043f\u0430\u0447\u043a\u0443 \u0438\u0437 \u0442\u043e\u043f\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430 \u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c \u0432\u043e\u0442 \u044d\u0442\u0438 \u0441\u043b\u0430\u0432\u043d\u044b\u0435 1400.\u003Cbr\u003E\n\u041b\u0430\u0434\u043d\u043e \u044d\u0442\u043e, \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0435\u0440\u0448\u0438\u043d\u0430 \u0430\u0439\u0441\u0431\u0435\u0440\u0433\u0430. \u003Cbr\u003E\n\u041d\u0435 \u0434\u043e\u043b\u0433\u043e \u0434\u0443\u043c\u0430\u0432 , \u0440\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u043d\u0430 \u0442\u043e \u0447\u0442\u043e \u0420\u0415\u0419\u0422\u0418\u041d\u0413 \u042d\u0422\u041e \u0412\u0415\u0414\u042c \u041d\u0415 \u041f\u0420\u041e\u0421\u0422\u041e \u0426\u0418\u0424\u0415\u0420\u041a\u0410, \u0434\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432. \u041d\u0435 \u0437\u0440\u044f \u0432\u0435\u0434\u044c \u0434\u0432\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 \u0435\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e, \u0438 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u0439\u0442\u0438 \u043a \u0443\u043c\u043e\u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044e \u0447\u0442\u043e \u043e\u043d \u0434\u043e\u043b\u0436\u0435\u043d \u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435. \u042f \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0435\u0433\u0430\u044e \u0441\u043e\u043b\u043e , \u0432 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u0438 \u043d\u0430 \u0442\u0430\u043a\u0438\u0445 \u0436\u0435 \u0441\u043e\u043b\u043e \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0442\u043e\u0433\u043e \u0436\u0435 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430.\u003Cbr\u003E\n\u0418 \u043e \u0431\u043e\u0436\u0435, \u0447\u0442\u043e \u044f \u0432\u0438\u0436\u0443 \u0437\u0434\u0435\u0441\u044c\u003Cbr\u003E\n\u0412\u043d\u043e\u0432\u044c \u0442\u0435 \u0436\u0435 \u043f\u0430\u0447\u043a\u0438, \u043d\u043e \u0443\u0436\u0435 \u043d\u0435 \u043f\u043e 3\u2026 \u043d\u0435\u0442. \u041f\u043e 2 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430\u003Cbr\u003E\n\u0442\u0435 \u0436\u0435 \u043f\u0430\u0447\u043a\u0438 \u043f\u043e 2 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043d\u043e\u0441\u044f\u0449\u0438\u0435 \u043a\u043b\u0430\u043d \u0442\u0435\u0433\u0438 \u0410-S \u0442\u0438\u0440\u043e\u0432 \u0438 \u0438\u043c\u0435\u044e\u0449\u0438\u0435 \u043f\u043e 3500-4\u043a+ \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430\u003Cbr\u003E\n\u0421\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044f, \u0435\u0441\u043b\u0438 \u0442\u0430\u043a \u0432\u0441\u0451 \u0432\u0441\u0440\u0430\u0442\u043e \u0443\u0441\u0442\u0440\u043e\u0435\u043d\u043e, \u0438 \u043d\u0435 \u0435\u0441\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c \u0441\u0434\u0435\u04