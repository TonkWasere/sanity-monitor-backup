e \u0433\u043e\u0434 \u043f\u0432\u0435 \u0438\u0432\u0435\u043d\u0442\u043e\u0432. \u041a\u043e\u0442\u043e\u0440\u044b\u0435 \u0435\u0449\u0435 \u0438 \u0432 \u0441\u043e\u043b\u043e \u0445\u043e\u0440\u043e\u0448\u043e \u0438\u0433\u0440\u0430\u043b\u0438\u0441\u044c. \u0413\u043e\u0432\u043d\u044f\u043d\u043a\u0430 \u0438 \u0430\u0442\u0430\u043a\u0430 \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0430\u2026 \u0412\u043a\u0443\u0441\u043d\u044f\u0442\u0438\u043d\u0430.\u003C\/p\u003E\n\n\u003Cp\u003E\u0413\u043e\u0432\u043d\u044f\u043d\u043a\u0430 \u0445\u043e\u0442\u044c \u0438 \u0433\u043e\u0432\u043d\u044f\u043d\u043a\u0430, \u043d\u043e \u0442\u044b \u0442\u0443\u0434\u0430 \u0437\u0430\u0445\u043e\u0434\u0438\u043b \u0432 \u0441\u043e\u043b\u043e, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u044f\u043b \u043e\u0447\u043a\u043e \u0438 \u0434\u043e\u043b\u0431\u0438\u043b \u043a\u0430\u0431\u0430\u043d\u043e\u0432 \u043d\u0438 \u043e \u0447\u0435\u043c \u043d\u0435 \u0434\u0443\u043c\u0430\u044f. \u0414\u0430, \u0442\u0430\u043c \u0431\u044b\u043b\u0438 \u0411\u041f\u041b\u0410 \u0441\u043d\u043e\u0440\u043a. \u0411\u044b\u043b\u0438 \u0441\u043f\u043e\u0442\u044b, \u0447\u0442\u043e \u043f\u043e\u0440\u043e\u0439 \u0442\u0435\u0431\u044f \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u043b\u0438 \u043d\u0430 \u0441\u0435\u0439\u0432\u0443. \u042f \u0434\u0430\u0436\u0435 \u043f\u043e\u043c\u043d\u044e \u043a\u0430\u043a \u0443 \u043a\u043e\u0433\u043e-\u0442\u043e, \u0432\u0440\u043e\u0434\u0435 \u043f\u0435\u043a\u0442\u0443\u0441\u0430, \u043a\u0435\u043d\u0442 \u0434\u0430\u043b\u044c\u0442\u043e\u043d\u0438\u043a \u043d\u0435 \u043c\u043e\u0433 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e \u0431\u043e\u0441\u0441\u0430 \u0444\u0430\u0440\u043c\u0438\u0442\u044c, \u0438\u0431\u043e \u043d\u0435 \u0432\u0438\u0434\u0435\u043b \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u0432. \u041d\u043e \u0442\u0430\u043c \u0431\u044b\u043b\u043e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e\u0435 \u043f\u0432\u0435. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u043a\u0443\u0441\u0442\u0430\u0440\u043d\u044b\u0445 \u0436\u0438\u0442\u0435\u043b\u0435\u0439, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0442\u0443\u0441\u043e\u0432\u0449\u0438\u0432\u043a\u043e\u0432 \u043f\u043e \u0442\u0432\u043e\u0435\u0439 \u0441\u0435\u0439\u0432\u0435. \u0417\u0430\u0448\u0451\u043b - \u0432\u044b\u0448\u0435\u043b.\u003C\/p\u003E\n\n\u003Cp\u003E\u0410 \u0430\u0442\u0430\u043a\u0430 \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0430 \u0432\u043e\u043e\u0431\u0449\u0435 \u0441\u043c\u0430\u043a. \u0412\u0440\u043e\u0434\u0435 \u043d\u0435 \u0441\u043e\u043b\u043e, \u043d\u043e \u043d\u0430 \u0442\u0438\u043c\u043c\u0435\u0439\u0442\u043e\u0432 \u0437\u0430\u0431\u0438\u0432\u0430\u0435\u0448\u044c \u0431\u043e\u043b\u0442, \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u0435\u0448\u044c \u043c\u043e\u0437\u0433 \u0438 \u0441\u043f\u0430\u043c\u0438\u0448\u044c \u0444\u0430\u0431-\u0430\u043a\u0430\u0446\u0438\u044f-\u043c\u0430\u043b\u044b\u0448, \u0432\u0438\u0434\u044f \u043a\u0430\u043a \u0442\u043e\u043b\u043f\u044b \u043d\u0435\u043f\u0438\u0441\u0435\u0439 \u0440\u0430\u0441\u0441\u044b\u043f\u0430\u044e\u0442\u0441\u044f. \u0423\u0445 \u0438 \u0432\u043a\u0443\u0441\u043d\u044f\u0442\u0438\u043d\u0430 \u0436\u0435 \u0431\u044b\u043b\u0430\u2026\u003C\/p\u003E\n\n\u003Cp\u003E\u0416\u0430\u043b\u044c \u0447\u0442\u043e \u043f\u043e\u0445\u043e\u0434\u0443 \u0444\u0443\u043b\u043b \u043f\u0432\u0435 \u043c\u044b \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0435 \u0443\u0432\u0438\u0434\u0438\u043c. \u0425\u043e\u0442\u044f \u0432\u043e\u0442 \u0432\u0440\u043e\u0434\u0435 \u0430\u0440\u0435\u043d