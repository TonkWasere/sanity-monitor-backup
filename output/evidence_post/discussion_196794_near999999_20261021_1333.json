u0440\u0444\u0435\u0439\u0441\u0430.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0422\u043e\u0447\u043d\u043e \u0442\u0430\u043a \u0436\u0435 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0437\u043d\u0430\u0447\u0438\u0442 \u043c\u0435\u0442\u0430 \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a\u043e\u0432 \u043a\u0430\u043a \u0432 \u0431\u0430\u0442\u043b\u0444\u0438\u043b\u0434\u0435, \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0441\u0442\u0440\u0435\u043b\u044c\u0431\u044b \u0430\u0448 12 \u0442\u043e\u0436\u0435 \u043a\u0430\u043a \u0432 \u0431\u0430\u0442\u043b\u0444\u0438\u043b\u0434\u0435 (\u0434\u0430\u0436\u0435 \u0441 \u0442\u0435\u043c \u0436\u0435 \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u043e\u043c \u043e\u0442\u0434\u0430\u0447\u0438 \u043b\u043e\u043b), \u043f\u043b\u0430\u0441\u0442\u0438\u043d\u044b \u0438 \u0438\u043d\u044a\u0435\u043a\u0442\u043e\u0440\u044b \u0442\u043e\u0447\u043d\u043e \u043d\u0435 \u0438\u0437 \u0432\u0430\u0440\u0437\u043e\u043d\u0430, \u0437\u0438\u043f\u043b\u0430\u0439\u043d\u044b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e \u043d\u0435 \u0438\u0437 \u0431\u0430\u0442\u043b\u0444\u0438\u043b\u0434\u0430 (\u0441\u043d\u043e\u0432\u0430), \u0431\u0430\u043b\u0430\u043d\u0441 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432  \u0442\u043e\u0447\u043d\u043e \u043d\u0435 \u043a\u0430\u043a \u0432 \u0431\u0430\u0442\u043b\u0444\u0438\u043b\u0434\u0435 (\u043e\u043f\u044f\u0442\u044c), \u0438 \u043c\u043d\u043e\u0433\u043e \u0447\u0435\u0433\u043e \u0435\u0449\u0435 \u0442\u043e\u0447\u043d\u043e \u043d\u0435 \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0433\u0440 \u0441 \u0431\u043e\u043b\u0435\u0435 \u0443\u0434\u0430\u0447\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0435\u0439)))))\u003Cbr\u003E\n\u041e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u043c\u043e \u0447\u0442\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u0441\u043c\u043e\u0442\u0440\u044f\u0442 \u0437\u0430 \u0442\u0440\u0435\u043d\u0434\u0430\u043c\u0438 \u0432 \u0432\u0438\u0434\u0435\u043e\u0438\u0433\u0440\u0430\u0445 \u0438 \u201c\u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u044e\u0442\u0441\u044f\u201d \u0447\u0435\u043c \u043f\u043e \u043a\u0430\u0439\u0444\u0443 \u0437\u0430\u0432\u043e\u0437\u044f \u044d\u0442\u043e \u0432 \u0438\u0433\u0440\u0443 (\u043a\u0430\u043a \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0440\u0435\u0437\u043a\u0438\u0439 \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u0432 \u0441\u0442\u0430\u0442\u0443\u0441 \u044d\u043a\u0441\u0442\u0440\u0430\u043a\u0448\u0435\u043d-\u0448\u0443\u0442\u0435\u0440\u0430 \u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u043e\u0439\u043f\u0430 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0439 \u043c\u0438\u0440 \u043d\u0430 \u0415\u0423 \u043f\u043e\u0441\u043b\u0435 \u0432\u0437\u043b\u0435\u0442\u0430 \u0430\u0440\u043a \u0440\u0435\u0439\u0434\u0435\u0440\u0441\u043e\u0432) \u003Cbr\u003E\n\u0415\u0441\u043b\u0438 \u043f\u043e\u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0433\u0440\u044b \u0438 \u043f\u043e\u0442\u043e\u043c \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0430 \u0441\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442 \u043c\u043e\u0436\u043d\u043e \u0447\u0435\u0442\u043a\u043e \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u0438\u0442\u044c \u0447\u0435\u043c \u0438 \u0433\u0434\u0435 \u0432\u0434\u043e\u0445\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u043e\u0442\u0434\u0435\u043b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u043e\u0442\u0434\u0435\u043b \u0431\u0430\u043b\u0430\u