0435 \u0441 \u043d\u0435\u0439\u0440\u043e\u043d\u043a\u043e\u0439 \u043d\u0430\u0432\u0440\u044f\u0434 \u043b\u0438 \u0441\u0434\u0435\u043b\u0430\u0435\u0442 \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u044b\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u0415\u0441\u043b\u0438 \u0436\u0435 \u0448\u0430\u0440\u044f\u0449\u0438\u0439 \u0447\u0435\u043b \u0432\u043e\u0431\u044a\u0435\u0442 \u0445\u043e\u0440\u043e\u0448\u0438\u0439 \u043e\u0431\u044a\u0451\u043c\u043d\u044b\u0439 \u043f\u0440\u043e\u043c\u0442, \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0432\u0441\u0451, \u0447\u0442\u043e \u043e\u043d \u0437\u0430\u0434\u0443\u043c\u0430\u043b \u0432 \u043d\u0451\u043c, \u0441\u043e \u0432\u0441\u0435\u043c\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u043c\u0438 \u043d\u044e\u0430\u043d\u0441\u0430\u043c\u0438, \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u043c \u0434\u0435\u043b\u0430, \u0430 \u043f\u043e\u0442\u043e\u043c \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u043f\u043e\u043b\u0435\u0437\u0435\u0442 \u043f\u0440\u0430\u0432\u0438\u0442\u044c, \u044d\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u0433\u043e\u0440\u0430\u0430\u0430\u0430\u0437\u0434\u043e \u0431\u044b\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043c \u0435\u0441\u043b\u0438 \u043e\u043d \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u0431\u0443\u0434\u0435\u0442 \u043f\u0438\u0441\u0430\u0442\u044c \u043a\u043e\u0434 \u0441 \u043d\u0443\u043b\u044f, \u0430 \u043d\u0435 \u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0433\u043e\u0442\u043e\u0432\u044b\u0439 \u0440\u0430\u0431\u043e\u0447\u0438\u0439 \u043a\u043e\u0434 \u043e\u0442 \u043d\u0435\u0439\u0440\u043e\u043d\u043a\u0438, \u043d\u0430\u0448\u043a\u0440\u044f\u0431\u0430\u043d\u044b\u0439 \u0437\u0430 \u043f\u0430\u0440\u0443 \u0447\u0430\u0441\u043e\u0432. \u0422\u043e\u0433\u0434\u0430 \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u0437\u0430\u0439\u043c\u0435\u0442 \u043d\u0435 \u0443\u0441\u043b\u043e\u0432\u043d\u044b\u0439 \u0433\u043e\u0434-\u0434\u0432\u0430, \u043f\u043b\u044e\u0441 \u043f\u043e\u043b \u0433\u043e\u0434\u0430 \u043f\u0440\u0430\u0432\u043e\u043a \u0438 \u043e\u0442\u043b\u0430\u0434\u043a\u0438, \u0430 \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043f\u0440\u0430\u0432\u043a\u0430\u043c\u0438 \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0432\u0430 \u0438 \u0431\u043e\u043b\u0435\u0435 \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f. \u041f\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u043a\u043e\u0434\u0435\u0440\u043e\u0432, \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435\u0439\u0440\u043e\u043d\u043a\u0438 \u0441\u0442\u0430\u043b\u0438 \u043e\u0447\u0435\u043d\u044c \u0445\u043e\u0440\u043e\u0448\u043e \u043f\u0438\u0441\u0430\u0442\u044c \u043a\u043e\u0434 \u0441\u0430\u043c\u0438 \u043f\u043e \u0441\u0435\u0431\u0435. \u0410 \u0435\u0449\u0451 \u043b\u0443\u0447\u0448\u0435 \u043e\u043d\u0438 \u0441 \u043d\u0438\u043c \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442.\u003Cbr\u003E\n\u041d\u0435\u0439\u0440\u043e\u043d\u043a\u0430 \u043d\u0435 \u043f\u0430\u043d\u0430\u0446\u0435\u044f, \u043d\u043e \u0443\u0434\u043e\u0431\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u043f\u0440\u043e\u0444\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442 \u0435\u043c\u0443 \u0432\u0440\u0435\u043c\u044f.\u003C\/p\u003E","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":1,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":1,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"