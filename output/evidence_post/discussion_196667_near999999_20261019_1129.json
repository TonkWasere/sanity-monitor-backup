043e \u0435\u0441\u0442\u044c, \u0435\u0441\u043b\u0438 \u043e\u0442 100 \u043e\u0442\u043d\u044f\u0442\u044c 30, \u0430 \u043f\u043e\u0442\u043e\u043c \u043e\u0442 \u0434\u0440\u0443\u0433\u043e\u0439 100 \u043e\u0442\u043d\u044f\u0442\u044c 30, \u0443 \u0442\u0435\u0431\u044f 2 \u0440\u0430\u0437\u043d\u044b\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442\u0441\u044f, \u044f \u0432\u0435\u0440\u043d\u043e \u0442\u0435\u0431\u044f \u043f\u043e\u043d\u044f\u043b?\u003C\/p\u003E\n\n\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196667-ppshki-i-drugoe-2-raznyh-igry\/33\u0022 class=\u0022PostMention\u0022 data-id=\u00224715916\u0022\u003EJencent\u003C\/a\u003E \u041f\u041f \u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u0442\u044c \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u0432 \u0431\u043b\u0438\u0437\u0438, 20 \u043c\u0435\u0442\u0440\u043e\u0432 \u044d\u0442\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u043f\u043e\u0440, \u0432\u044b\u0439\u0434\u0438 \u0432 \u043e\u043f\u0435\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u044c \u043c\u0435\u0442\u043a\u0443 \u0438 \u043e\u0442\u043e\u0439\u0434\u0438 \u043e\u0442 \u043d\u0435\u0435 \u043d\u0430 20\u043c, \u043d\u043e \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043f\u043f \u0432 \u0443\u043f\u043e\u0440 \u0438\u043c\u0435\u044e\u0442 \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e, \u0435\u0441\u043b\u0438 \u0432\u043e\u043e\u0431\u0449\u0435 \u0438\u043c\u0435\u044e\u0442, \u043e\u0431\u044b\u0447\u043d\u043e 0.05-0.09\u043c\u0441, \u0430 \u043f\u043e\u0441\u043b\u0435 20\u043c \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u044e\u0442 \u0443\u0436\u0435 \u043e\u0442 0.15 \u0438 \u0432\u044b\u0448\u0435, \u043a\u0430\u043a \u0431\u044b \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u0431\u0430\u043b\u0430\u043d\u0441, \u043a\u0430\u043c\u0435\u043d\u044c-\u043d\u043e\u0436\u043d\u0438\u0446\u044b-\u0431\u0443\u043c\u0430\u0433\u0430, \u0438\u043b\u0438 \u0442\u044b \u0441\u0447\u0438\u0442\u0430\u0435\u0448\u044c, \u0447\u0442\u043e \u0432\u0441\u0435 \u0433\u0430\u043d\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u0431\u044b\u0442\u044c \u0440\u0430\u0432\u043d\u044b \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u0434\u0438\u0441\u0442\u0435? \u0412\u043f\u043e\u043b\u043d\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e, \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0432 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0443\u043f\u043e\u0440 \u043d\u0430 \u0431\u043b\u0438\u0437\u043a\u0443\u044e \u0434\u0438\u0441\u0442\u0443, \u0432 \u043d\u0435\u0439 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u0442\u044c \u0433\u0430\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0438\u043c\u0435\u0442\u044c \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e \u043d\u0430 \u0431\u043b\u0438\u0437\u043a\u043e\u0439 \u0434\u0438\u0441\u0442\u0435. \u0423\u0434\u0430\u0447\u0438 \u0441 \u0442\u0430\u043a\u0438\u043c\u0438 \u0433\u0430\u043d\u0430\u043c\u0438 \u0432\u043e\u0435\u0432\u0430\u0442\u044c \u043d\u0430 \u0434\u0438\u043a\u043e\u043c \u0441\u0435\u0432\u0435\u0440\u0435. \u0422\u043e\u0442, \u0443 \u043a\u043e\u0433\u043e \u043c\u043d\u043e\u0433\u043e \u0441\u043d\u0430\u0440\u044f\u0433\u0438, \u043f\u043e\u0434 \u0440\u0430\u0437\u043d\u044b\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438, \u0434\u043e\u043b\u0436\u0435\u043d \u0438\u043c\u0435\u0442\u044c \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e \u043d\u0430\u0434 \u0442\u0435\u043c\u0438, \u0443 \u043a\u043e\u0433\u043e \u0441\u043d\u0430\u0440\u044f\u0433\u0438 \u0438\u043b\u0438 \u043d\u0435\u0442, \u0438\u043b\u0438 \u0438\u0433\u0440\u0430\u0435\u0442 \u0441 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0439, \u044d\u0442\u043e \u0431\u0430\u0437\u0430 \u043b\u044e\u0431\u043e\u0439 \u0440\u043f\u0433, \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442. \u041f\u0440\u0438 \u0447\u0435\u043c \u0435\u0441\u043b\u0438 \u0432 \u0440\u043f\u0433 \u0440\u0435\u0447\u044c \u043c\u043e\u0436\u0435\u0442 \u0438\u0434\u0442\u0438 \u043f\u0440\u043e \u0441\u0435\u043a\u0443\u043d\u0434\u044b, \u0442\u043e\u0442 \u0442\u0443\u0442 \u0432\u0441\u0435-\u0442\u0430\u043a\u0438 \u0448\u0443\u0442\u0435\u0440, \u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u043d\u0430\u044e, \u0447\u0442\u043e 99% \u0441\u0438\u0434\u044f\u0449\u0438\u0445 \u043d\u0430 \u0444\u043e\u0440\u0443\u043c\u0435 \u043d\u0435 \u0440\u0435\u0430\u043b\u0438\u0437\u0443\u044e\u0442\u0441\u044f \u0432 \u0438\u0433\u0440\u0435 \u0442\u0430\u043a, \u0447\u0442\u043e \u0431\u044b \u0437\u0430\u043c\u0435\u0442\u0438\u0442\u044c 0.05 \u0442\u0442\u043a \u0440\u0430\u0437\u043d\u0438\u0446\u044b, \u043d\u0430\u0434\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0439\u0442\u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u0443 \u0441\u043b\u0438\u0432\u0430 \u0432 \u0447\u0435\u043c \u0443\u0433\u043e\u0434\u043d\u043e, \u043b\u0438\u0448\u044c \u0431\u044b \u0432 \u0445\u043e\u0434\u0435  \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0435 \u0432\u044b\u0439\u0442\u0438 \u043d\u0430 \u0441\u0435\u0431\u044f\u003C\/p\u003E","renderFailed":false,"mentionedByCount":1,"editedAt":"2026-10-19T11:25:46+00:00","canEdit":false,"canDelete":false,"canHide":false,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":