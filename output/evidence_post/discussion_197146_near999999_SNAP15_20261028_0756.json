43c.\u003C\/p\u003E \n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197146-filosofiya-mudrogo-volka-o-ivente\/17\u0022 class=\u0022PostMention\u0022 data-id=\u00224732606\u0022\u003Ekmkk2063\u003C\/a\u003E \u043f\u0440\u0438\u0448\u043b\u0438 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u043a\u043e\u043c\u0443-\u0442\u043e \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u0431\u0435\u0433\u0430\u0442\u044c \u0437\u0430 \u043a\u0443\u0431\u043e\u043a, \u0430 \u043a\u043e\u043c\u0443-\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0447\u0435\u0442\u0441\u044f \u043f\u043e\u043f\u0438\u043d\u0430\u0442\u044c\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0422\u043e \u0435\u0441\u0442\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0444\u0443\u0442\u0431\u043e\u043b\u0438\u0441\u0442\u0430\u043c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f, \u0433\u0440\u0443\u0431\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439 \u0444\u0443\u0442\u0431\u043e\u043b\u0430. \u0410 \u0442\u044b \u043d\u0435 \u0434\u0443\u043c\u0430\u043b, \u0447\u0442\u043e \u043f\u043e\u0431\u0435\u0434\u0430 - \u0442\u043e\u0436\u0435 \u0447\u0430\u0441\u0442\u044c \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044f \u0444\u0443\u0442\u0431\u043e\u043b\u0430? \u0418 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0444\u0443\u0442\u0431\u043e\u043b\u0438\u0441\u0442\u044b \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442 \u0432 \u044d\u0442\u043e\u0442 \u0441\u043f\u043e\u0440\u0442 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0442\u0430\u043c \u043c\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u0442\u044f\u0442 \u0437\u0430 \u043a\u0443\u0431\u043e\u043a, \u043d\u043e \u0438 \u043f\u043e\u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0438\u043c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u0444\u0443\u0442\u0431\u043e\u043b, \u0447\u0442\u043e \u043e\u043d\u0438 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u0441\u0432\u043e\u0435\u0433\u043e \u043f\u0443\u0442\u0438 \u043d\u0430 \u044d\u043d\u0442\u0443\u0437\u0438\u0430\u0437\u043c\u0435 \u043e\u0442 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430 \u043f\u0440\u043e\u044f\u0432\u0438\u0442\u044c \u043d\u0430\u0432\u044b\u043a \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0437\u0430 \u044d\u0442\u043e \u0432 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u043f\u043e\u0431\u0435\u0434\u0443 \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0438 \u0432\u044b\u0441\u043e\u0442?\u003C\/p\u003E \n\n\u003Cp\u003E\u0422\u043e\u0447\u043d\u043e \u0442\u0430\u043a-\u0436\u0435, \u043a\u0430\u043a \u0432 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0433\u0440\u0430\u0445 \u043f\u043e\u0431\u0435\u0434\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435 \u043d\u0430 \u0440\u0430\u0432\u043d\u0435 \u0441 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u043c \u0441\u0430\u043c\u043e\u0439 \u0438\u0433\u0440\u044b, \u0442\u0430\u043a \u0438 \u0432 \u043c\u043c\u043e-\u0434\u0440\u043e\u0447\u0438\u043b\u044c\u043d\u044f\u0445 \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435 \u043e\u0442 \u0438\u0433\u0440\u044b. \u0418 \u043a\u0430\u043a \u0432 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0433\u0440\u0430\u0445, \u0447\u0435\u043c \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a, \u0446\u0435\u043d\u043d\u0435\u0435 \u043f\u043e\u0431\u0435\u0434\u0430, \u0442\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435\u0435 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435 \u0442\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0448\u044c. \u0412\u043f\u043b\u043e\u0442\u044c \u0434\u043e \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043d\u0430 \u0432\u044b\u0441\u0448\u0435\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435 \u043e\u0442 \u043f\u043e\u0431\u0435\u0434\u044b \u043d\u0435\u0441\u043e\u0438\u0437\u043c\u0435\u0440\u0438\u043c\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f \u043e\u0442 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430, \u0445\u043e\u0442\u044f \u0441\u0430\u043c \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0442\u043e\u0436\u0435 \u0432\u0441\u0435 \u0435\u0449\u0451 \u043f\u0440\u0438\u044f\u0442\u0435\u043d. \u0422\u0430\u043a-\u0436\u0435 \u0438 \u0432 \u043c\u043c\u043e-\u0434\u0440\u043e\u0447\u0438\u043b\u044c\u043d\u044f\u0445 \u0447\u0435\u043c \u0446\u0435\u043d\u043d\u0435\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0430, \u0442\u0435\u043c \u043f\u0440\u0438\u044f\u0442\u043d\u0435\u0435 \u0440\u0430\u0434\u0438 \u043d\u0435\u0451 \u0441\u0442\u0430\u0440\u0430\u0442\u044c\u0441\u044f. \u0415\u0441\u043b\u0438 \u043d\u0435 \u0432\u0435\u0440\u0438\u0448\u044c, \u043f\u043e\u0447\u0438\u0442\u0430\u0439 \u043a\u043d\u0438\u0433\u0438 \u043f\u043e \u0433\u0435\u0439\u043c\u0434\u0438\u0437\u0430\u0439\u043d\u0443, \u0442\u0430\u043c \u043f\u043e-\u043b\u044e\u0431\u043e\u043c\u0443 \u0447\u0442\u043e-\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043e. \u0418\u043b\u0438 \u0432 \u0447\u0435\u043c \u044f \u043e\u0448\u0438\u0431\u0