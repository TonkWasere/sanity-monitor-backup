\u041e\u0442\u0441\u044e\u0434\u0430 \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0435\u0449\u0435 \u043e\u0434\u0438\u043d \u0430\u0431\u0443\u0437. \u0423 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0435\u0441\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043a\u0440\u0443\u0442\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u0432\u044b\u043a\u0438\u0434\u044b\u0432\u0430\u044f \u043d\u0435\u043d\u0443\u0436\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0432 \u043c\u0443\u0441\u043e\u0440\u043a\u0443 (\u0437\u0430\u043b\u043e\u0447\u0438\u0432 \u0438\u0445 \u0442\u0430\u043c \u0434\u043e \u0441\u0431\u0440\u043e\u0441\u0430), \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432 \u0440\u0430\u0437\u044b \u043f\u0440\u043e\u0449\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0441\u0435\u0431\u0435 \u0438 \u0432 \u0440\u0430\u0437\u044b \u0443\u0441\u043b\u043e\u0436\u043d\u044f\u0442\u044c \u043f\u043e\u0438\u0441\u043a \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0443.\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0443 \u044d\u0442\u043e\u0433\u043e:\u003Cbr\u003E\n\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0434\u0435\u043d\u0435\u0433 300+ = \u043c\u043e\u0436\u043d\u043e \u0434\u0435\u043b\u0430\u0442\u044c \u0445\u043e\u0442\u044c \u043a\u0430\u0436\u0434\u0443\u044e \u0432\u043e\u043b\u043d\u0443.\u003Cbr\u003E\n\u041d\u043e \u0441\u0430\u043c\u043e\u0435 \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u043c\u0445\u043e - \u0440\u0430\u0443\u043d\u0434\u044b \u0441 \u0431\u043e\u0441\u0441\u0430\u043c\u0438. \u0421\u043a\u0438\u043d\u0443\u043b\u0438\u0441\u044c \u0432 \u0431\u043e\u0441\u0441\u0430 -\u0026gt; \u0443\u0431\u0438\u043b\u0438 -\u0026gt; \u043d\u0430\u0447\u0430\u043b\u0438 \u043a\u0440\u0443\u0442\u0438\u0442\u044c \u0434\u043e \u0441\u0442\u0430\u0440\u0442\u0430 \u043f\u0432\u043f \u0440\u0430\u0443\u043d\u0434\u0430.\u003Cbr\u003E\n\u0421\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e\u0435 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435 (\u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0440\u0443\u0438\u043d\u0438\u0442\u044c \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443). \u003Cbr\u003E\n\u041a\u0440\u0443\u0442\u044f\u0442 5 \u0447\u0435\u043b\u043e\u0432\u0435\u043a. \u041d\u0430\u0436\u0430\u043b\u0438 \u0440\u0435\u0440\u043e\u043b\u043b -\u0026gt; \u0441\u043a\u0443\u043f\u0438\u043b\u0438 \u0444\u0443\u043b \u043c\u0430\u0433\u0430\u0437 -\u0026gt; \u043f\u0440\u043e\u0434\u0430\u043b\u0438 \u0444\u0443\u043b \u043c\u0430\u0433\u0430\u0437 -\u0026gt; \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u043f\u043e\u043a\u0430 \u043d\u0435 \u043f\u043e\u043f\u0430\u0434\u0435\u0442\u0441\u044f \u043d\u0443\u0436\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u043c\u0435\u0442.\u003Cbr\u003E\n\u041e\u0441\u043d\u043e\u0432\u043d\u0430\u044f \u0441\u0443\u0442\u044c \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043c\u0443\u0441\u043e\u0440\u043a\u0430 \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u043a \u043f\u0432\u043f \u0440\u0430\u0443\u043d\u0434\u0443 \u043d\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u043a\u0443\u043f\u0438\u0442\u044c \u0432\u0441\u0435 \u043d\u0435\u043d\u0443\u0436\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0432 \u043f\u044f\u0442\u0435\u0440\u043e\u043c \u0438 \u0437\u0430\u043f\u0438\u0445\u0430\u0442\u044c \u0438\u0445 \u0432 \u043c\u0443\u0441\u043e\u0440\u043a\u0443.\u003C\/p\u003E\n\n\u003Cp\u003E\u0415\u0441\u043b\u0438 \u0448\u0430\u043d\u0441 \u043d\u0430 \u0433\u0440\u0443\u043f\u043f\u0443 \u0432\u0441\u0435\u0433\u0434\u0430 \u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439, \u0442.\u0435 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c \u043d\u0430 7\u043c \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 4% \u043d\u0430 \u0438\u0441\u043a\u043b. \u0442\u043e \u0432\u044b \u0432\u044b\u043a\u0443\u043f\u0430\u0435\u0442\u0435 \u0432\u0441\u0435 \u043f\u043e\u0434\u0440\u044f\u0434 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0430\u044f \u043c\u0435\u0441\u0442\u043e \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u043f\u043e\u0434 \u0438\u0441\u043a\u043b \u0434\u0440\u043e\u043f + \u0441\u0443\u0436\u0430\u0435\u0442\u0435 \u043f\u0443\u043b \u0441\u0430\u043c\u043e\u0433\u043e \u0438\u0441\u043a\u043b \u0434\u0440\u043e\u043f\u0430 \u0432\u044b\u043a\u0443\u043f\u0430\u044f \u0435\u0433\u043e. \u0414\u0430, \u0447\u0438\u0441\u0442\u043e \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u044b \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430\u043c, \u041d\u041e \u0441\u043e\u0431\u0438\u0440\u0430\u044f \u0442\u043e, \u0447\u0442\u043e \u043d\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442 \u043e\u043d\u0438 \u0443 \u0432\u0430\u0441\u003Cbr\u003E\n1) \u041b\u0443\u0447\u0448\u0435 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430\u003Cbr\u003E\n2) \u0412\u044b \u043f\u043e\u0432\u044b\u0448\u0430\u0435\u0442\u0435 \u0448\u0430\u043d\u0441 \u043d\u0430 \u043d\u0443\u0436\u043d\u0443\u044e \u0433\u0440\u0443\u043f\u