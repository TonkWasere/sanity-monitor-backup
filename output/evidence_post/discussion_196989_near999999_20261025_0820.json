03E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196989-nakipelo\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224725958\u0022\u003E\u0421\u0443\u043f\u0447\u0438\u043a\u003C\/a\u003E \u0421\u0434\u0435\u043b\u0430\u0442\u044c \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u0446\u0435\u043d \u043f\u043e\u0434\u043a\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u043c\u044b\u043c \u2014 \u043a\u0430\u043a \u0432 \u043c\u0435\u043d\u044e \u043e\u0431\u043c\u0435\u043d\u0430 \u043c\u0435\u0436\u0434\u0443 \u0438\u0433\u0440\u043e\u043a\u0430\u043c\u0438, \u0442\u0430\u043a \u0438 \u0432 \u043c\u0435\u043d\u044e \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u0430 (\u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0441\u0447\u0438\u0442\u0430\u0442\u044c \u044d\u0442\u0438 \u043d\u0443\u043b\u0438). \u0427\u0442\u043e\u0431\u044b \u043d\u0430 \u0438\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u0441\u0440\u0430\u0437\u0443 \u0431\u044b\u043b\u043e \u0432\u0438\u0434\u043d\u043e: \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0446\u0435\u043d\u044b, \u0438\u0441\u0447\u0438\u0441\u043b\u044f\u0435\u043c\u044b\u0435 \u0442\u044b\u0441\u044f\u0447\u0430\u043c\u0438 \u2014 \u0431\u0435\u043b\u044b\u043c, \u0434\u0435\u0441\u044f\u0442\u043a\u0430\u043c\u0438 \u0442\u044b\u0441\u044f\u0447 \u2014 \u0437\u0435\u043b\u0451\u043d\u044b\u043c, \u0441\u043e\u0442\u043d\u044f\u043c\u0438 \u0442\u044b\u0441\u044f\u0447 \u2014 \u0441\u0438\u043d\u0438\u043c, \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430\u043c\u0438 \u2014 \u0436\u0451\u043b\u0442\u044b\u043c, \u0434\u0435\u0441\u044f\u0442\u043a\u0430\u043c\u0438 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u2014 \u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u044b\u043c \u0438 \u0442.\u0434.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0435\u0442\u003C\/p\u003E\n\n\u003Cblockquote c