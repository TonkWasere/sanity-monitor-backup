35 \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u043f\u0440\u0435\u0446\u0435\u043d\u0434\u0435\u043d\u0442, \u0447\u0442\u043e \u0438\u0432\u0435\u043d\u0442\u044b - \u044d\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0447\u0442\u043e \u0441\u0442\u043e\u0438\u0442 \u0444\u0430\u0440\u043c\u0438\u0442\u044c. \u0412\u0435\u0441\u044c \u043e\u043f\u0435\u043d \u043d\u0430 \u0444\u043e\u043d\u0435 \u044d\u0442\u043e\u0433\u043e - \u043f\u043e\u043c\u0439\u043a\u0430 \u0438 \u0441\u043c\u0435\u0440\u0442\u044c \u0432 \u043d\u0438\u0449\u0435\u0442\u0435.\u003Cbr\u003E\n\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197348-vremya-dengi\/15\u0022 class=\u0022PostMention\u0022 data-id=\u00224738878\u0022\u003ERaptyKora\u003C\/a\u003E \u041d\u0438 \u0441\u043b\u043e\u0432\u0430 \u043f\u043e \u043c\u043e\u0440\u043e\u0437\u043e\u0434\u0435\u0441\u0430\u043d\u0442\u0441\u043a\u0438. \u0422\u0430\u043a\u043e\u0433\u043e \u0438\u0432\u0435\u043d\u0442 \u0430 \u043d\u0435 \u0431\u044b\u043b\u043e, \u043d\u0430 \u043d\u0435\u043c \u0432\u044b \u043d\u0435 \u0442\u0440\u0430\u0442\u0438\u043b\u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u043e\u0435 \u0432\u0440\u0435\u043c\u044f, \u0442\u0430\u043c \u043d\u0435 \u0431\u044b\u043b\u043e \u0447\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u0433\u0430\u0440\u0430\u043d\u0442\u0430, \u0442\u0430\u043c \u043d\u0435\u043b\u044c\u0437\u044f \u0431\u044b\u043b\u043e \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u043d\u0430\u043c\u043d\u043e\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0435 90\u043a \u0437\u0430 \u043a\u0430\u0442\u043a\u0443, \u0438 \u0442\u0430\u043c \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0435\u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434. \u042d\u0442\u043e \u0432\u0441\u0435 \u043f\u0441\u0438\u043e\u043f \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0445 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0438\u0433\u0440\u0443\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0420\u0435\u0431\u044f\u0442 - \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437 \u043f\u0440\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u0438\u0432\u0435\u043d\u0442\u043e\u0432 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043e\u0442\u043b\u0438\u0447\u0430\u044e\u0442\u0441\u044f \u0438 \u044d\u0442\u043e \u0443\u0436\u0435 \u0441\u0442\u043e\u0438\u0442 \u0432\u0437\u044f\u0442\u044c \u043a\u0430\u043a \u0430\u043a\u0441\u0438\u043e\u043c\u0443. \u0415\u0441\u043b\u0438 \u043a\u0430\u043a\u0430\u044f-\u0442\u043e \u0430\u0442\u0430\u043a\u0430 \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0430, \u0434\u0435\u0441\u0430\u043d\u0442 - \u0445\u0437, \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u0442\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0434\u043e \u043a\u0443\u0447\u0438 - \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u043b\u0438 \u0440\u0443\u0431\u0438\u0442\u044c \u043a\u0443\u0447\u0438 \u0434\u0435\u043d\u0435\u0433, \u0442\u043e \u044d\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e \u0442\u0430\u043a \u0431\u0443\u0434\u0435\u0442 \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u043b\u0438 \u003Cem\u003E\u043f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 \u0432 \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437.\u003C\/em\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u0432\u044b\u0448\u0435 \u043a\u0430\u0441\u0430\u0435\u0442\u0441\u044f \u0438\u043c\u0435\u043d\u043d\u043e \u0447\u0430\u0441\u0442\u044b\u0445 \u003Cem\u003E(\u044f \u0431\u044b \u0441\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u0441\u043b\u0438\u0448\u043a\u043e\u043c)\u003C\/em\u003E \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432, \u0447\u0442\u043e \u041f\u0440\u0430\u0437\u0434\u043d\u0435\u0441\u0442\u0432\u043e \u0434\u0430\u0451\u0442 \u043c\u0430\u043b\u043e \u0438\u0433\u0440\u043e\u0432\u044b\u0445 \u0440\u0443\u0431\u043b\u0435\u0439 - \u043e\u0442\u0432\u0435\u0442 \u0434\u0430\u0451\u0442\u0441\u044f \u0438\u043c\u0435\u043d\u043d\u043e \u043d\u0430 \u044d\u0442\u043e.\u003C\/p\u003E \n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197348-vremya-dengi\/8\u0022 class=\u0022PostMention\u0022 data-id=\u00224738867\u0022\u003Esmenapoc\u003C\/a\u003E \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e \u0443\u0445\u043e\u0434\u0438\u0448\u044c \u0432 \u043c\u0438\u043d\u0443\u0441 \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u0444\u0430\u0440\u043c\u043e\u043c \u043e\u043f\u0435\u043d\u0430 \u0438 \u043d\u0435 \u043b\u0443\u0442\u0430\u0435\u0448\u044c \u043d\u0430\u0433\u0440\u0430\u0434 \u043e\u043f\u0440\u0430\u0432\u0434\u044b\u0432\u0430\u044e\u0449\u0438\u0445 \u044d\u0442\u043e= \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0438\u0440\u0443\u044e\u0442 \u043f\u043e\u0442\u0440\u0430\u0447\u0435\u043d\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0423\u043f\u0443\u0449\u0435\u043d\u043d\u0430\u044f \u0432\u044b\u0433\u043e\u0434\u0430 \u2260 \u0443\u0445\u043e\u0434\u0438\u0442\u044c \u0432 \u043c\u0438\u043d\u0443\u0441.\u003C\/p\u003E \n\n\u003Cp\u003E\u0423\u0445\u043e\u0434\u0438\u0442\u044c \u0432 \u043c\u0438\u043d\u0443\u0441 - \u043f\u043e \u0444\u0430\u043a\u0442\u0443 \u0438\u0441\u043f\u044b\u0442\u044b\u0432\u0430\u0442\u044c \u0440\u0430\u0441\u0445\u043e\u0434 \u0440\u0435\u0441\u0443\u0440\u0441\u0430, \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u044f \u0438\u043b\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u044f \u0447\u0442\u043e-\u0442\u043e \u0432\u0437\u0430\u043c\u0435\u043d. \u041f\u0440\u0430\u0437\u0434\u043d\u0435\u0441\u0442\u0432\u043e \u043d\u0435 \u0441\u043e\u0441\u0451\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0440\u0435\u0441\u0443\u0440\u0441 \u0443 \u0438\u0433\u0440\u043e\u043a\u0430, \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u003Cem\u003E(\u043a\u0430\u043a \u0438 \u043b\u044e\u0431\u0430\u044f \u0434\u0440\u0443\u0433\u0430\u044f \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c)\u003C\/em\u003E.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197348-vremya-dengi\/6\u0022 class=\u0022PostMention\u0022 data-id=\u00224738862\u0022\u003EEbaldar\u003C\/a\u003E \u041d\u0443 \u044d\u0442\u043e \u0442\u043e \u043f\u043e\u043d\u044f\u0442\u043d\u043e, \u0430 \u0437\u0430\u0447\u0435\u043c \u0432 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430\u043c\u043e\u0447\u043a\u0430\u043c\u0438 \u043d\u0430\u0441\u0440\u0430\u043b\u0438? \u041f\u043e\u0447\u0435\u043c\u0443 \u0432\u0441\u0451 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435?\u003Cbr\u003E\n\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197348-vremya-dengi\/27\u0022 class=\u0022PostMention\u0022 data-id=\u00224738924\u0022\u003ERaptyKora\u003C\/a\u003E \u0432 \u0438\u0442\u043e\u0433\u0435 \u043f\u043e\u0447\u0435\u043c\u0443 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0438\u0437 \u044f\u0449\u0438\u043a\u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041f\u043e\u0437\u0436\u0435 \u0434\u0430\u043c \u0431\u043e\u043b\u0435\u0435 \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u0439 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u043