entHtml":"\u003Cp\u003E\u0414\u043e\u0431\u0440\u043e\u0433\u043e \u0432\u0441\u0435\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u0443\u0442\u043e\u043a, \u043d\u0430\u043a\u0438\u0434\u0430\u043b \u043d\u0430 \u0434\u043e\u0441\u0443\u0433\u0435, \u0435\u0441\u043b\u0438 \u043a\u043e\u043c\u0443 \u0442\u043e \u0437\u0430\u0439\u0434\u0435\u0442 \u0438 \u043e\u043d \u0437\u0430\u0445\u043e\u0447\u0435\u0442 \u0447\u0442\u043e \u0431\u044b \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0438 \u0438 \u0432\u043e\u043e\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u043d\u044f\u043b\u0438 \u043a \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044e, \u043f\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0438\u0434\u0435\u0438, \u043b\u0438\u0431\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0441\u0432\u043e\u0438.\u003C\/p\u003E\n\n\u003Ch3\u003E\u003Cstrong\u003E\u041f\u0440\u043e\u043a\u0430\u0447\u043a\u0430 \u043d\u0430\u0432\u044b\u043a\u043e\u0432 \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u0435 \u043e\u0440\u0443\u0436\u0438\u0435\u043c\u003C\/strong\u003E\u003C\/h3\u003E\n\n\u003Cp\u003E\u0412 \u0438\u0433\u0440\u0435 \u0435\u0441\u0442\u044c \u0447\u0435\u0442\u044b\u0440\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0432\u0438\u0434\u043e\u0432 \u043e\u0440\u0443\u0436\u0438\u044f: \u041f\u041f, \u0428\u0412, \u0421\u041d\u041f \u0438 \u0434\u0440\u043e\u0431\u044c. \u0412 \u0445\u043e\u0434\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043b\u0438\u0431\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u043b\u0438\u0431\u043e \u0446\u0435\u043b\u043e\u0439 \u0432\u0435\u0442\u043a\u0438 ( AK-15, \u043b\u0438\u0431\u043e \u0432\u0441\u0435 \u0428\u0412)\u003Cbr\u003E\n\u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0430 \u043d\u0430\u0432\u044b\u043a\u0430 \u0432\u043b\u0430\u0434\u0435\u043d\u0438\u044f \u0434\u0430\u043d\u043d\u044b\u043c \u043e\u0440\u0443\u0436\u0438\u0435\u043c. \u0412\u043e\u0437\u044c\u043c\u0435\u043c \u0432 \u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0445 \u0432\u0435\u0442\u043a\u0438 \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0438\u0433\u0440\u043e\u043a \u0441\u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u043e \u043d\u0435 \u0441\u043c\u043e\u0436\u0435\u0442 \u0438\u0445 \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c: \u0443\u0440\u043e\u043d, \u043e\u0442\u0434\u0430\u0447\u0430 \u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u0440\u044f\u0434\u043a\u0430. \u0421 \u043a\u0430\u0436\u0434\u044b\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438 \u043d\u0430\u0432\u044b\u043a \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u0432\u0430\u0442\u044c N \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0430\u0441\u043f\u0435\u043a\u0442\u0430, \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0430 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442\u044c \u0437\u0430 \u0441\u0447\u0435\u0442 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u041d\u041f\u0421 + \u0438\u0433\u0440\u043e\u043a\u0438, \u0441 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0435\u0439, \u0447\u0435\u043c \u0432\u044b\u0448\u0435 \u0443\u0440\u043e\u0432\u0435\u043d\u044c, \u0442\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e (1\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c 50 \u041d\u041f\u0421 \u0438 10 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, 10\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c 350 \u041d\u041f\u0421 \u0438 70 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0434\u0430\u043d\u043d\u044b\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u043a \u043f\u0440\u0438\u043c\u0435\u0440 \u0438 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f). \u0422\u0430\u043a\u0436\u0435 \u0434\u043b\u044f \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438 \u0443\u0440\u043e\u0432\u043d\u044f \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0431\u0443\u0434\u0435\u0442 \u0432\u0430\u043b\u044e\u0442\u0430 \u0438\u0433\u0440\u044b (+\u0451\u0451 \u0432\u044b\u0432\u043e\u0434 \u0438\u0437 \u043e\u0431\u0438\u0445\u043e\u0434\u0430), N \u0441\u0443\u043c\u043c\u0430 \u0441 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u0435\u043c \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0438. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0442\u0438\u043f\u0430 \u043e\u0440\u0443\u0436\u0438\u044f \u0441\u0432\u043e\u0438\u0445 \u0432\u0435\u0442\u043e\u043a, \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u044f \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043c\u043d\u043e\u0433\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0441\u0431\u0440\u043e\u0441\u0430 \u0432\u0441\u0435\u0439 \u0432\u0435\u0442\u043a\u0438 \u0437\u0430 N \u0441\u0443\u043c\u043c\u0443 \u0432\u0430\u043b\u044e\u0442\u044b \u0441 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u043e\u043c \u043d\u0430 \u0434\u0440\u0443\u0433\u0443\u044e \u0432\u0435\u0442\u043a\u0443. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438 \u0434\u0430\u043d\u043d\u044b\u0445 \u0432\u0435\u0442\u043e\u043a \u0437\u0430 \u0431\u0430\u0433\u0440\u043e\u0432\u044b\u0435 \u0436\u0435\u0442\u043e\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0431\u0443\u0434\u0443\u0442 \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0442\u044c \u043a\u043e\u043b-\u0432\u043e \u0443\u0431\u0438\u0442\u044b\u0445 \u041d\u041f\u0421 \u0438 \u0438\u0433\u0440\u043e\u043a\u043e\u0432.\u003C\/p\u003E\n\n\n\u003Ch3\u003E\u003Cstrong\u003E\u041d\u0430\u0432\u044b\u043a\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430\u003C\/strong\u003E\u003C\/h3\u003E\n\u003Cp\u003E\u041d\u0430\u0432\u044b\u043a\u0438 \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430, \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0439 \u0443\u0440\u043e\u043d \u043f\u043e \u043c\u0443\u0442\u0430\u043d\u0442\u0430\u043c \u0438\u043b\u0438 \u0436\u0435 \u041d\u041f\u0421, \u043e\u0431\u0443\u0441\u043b\u043e\u0432\u043b\u0435\u043d\u043e \u0442\u0435\u043c, \u0447\u0442\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u043e\u043f\u044b\u0442\u043d\u0435\u0435 \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442 \u043a\u0430\u043a \u043b\u0443\u0447\u0448\u0435 \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u0438\u043d\u0435\u0439, \u043a\u0430\u0431\u0430\u043d\u043e\u0432, \u043b\u0438\u0431\u043e \u0436\u0435 \u043b\u044e\u0434\u0435\u0439. \u041f\u0440\u043e\u043a\u0430\u0447\u043a\u0430 \u0442\u0430\u043a \u0436\u0435 \u043a\u0430\u043a \u0438 \u0441 \u043e\u0440\u0443\u0436\u0438\u0435\u043c, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0447\u0435\u043c \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0438\u0433\u0440\u043e\u043a. \u0428\u0430\u043d\u0441 \u043d\u0430\u0439\u0442\u0438 \u0447\u0442\u043e \u043b\u0438\u0431\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432 \u0442\u0430\u0439\u043d\u0438\u043a\u0435, \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0443\u0431\u0438\u0442\u044c \u043c\u0443\u0442\u0430\u043d\u0442\u0430, \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u043e \u0441\u043f\u043e\u0442\u0430, \u0432\u0441\u0435 \u0442\u043e\u0447\u043d\u043e \u0442\u0430\u043a\u0436\u0435 \u0432\u0430\u0440\u0438\u0430\u0442\u0438\u0432\u043d\u043e \u043d\u0430 \u0432\u044b\u0431\u043e\u0440 \u0438\u0433\u0440\u043e\u043a\u0430, \u043d\u043e \u0431\u0435\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 N \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0432\u0435\u0442\u043e\u043a \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e. \u0414\u043e\u043f\u0443\u0441\u0442\u0438\u043c \u0438\u0433\u0440\u043e\u043a \u043a\u043e\u043f\u0430\u0435\u0442 \u043f\u0440\u0438\u043a\u043e\u043f\u044b, \u0441 \u043a\u0430\u0436\u0434\u044b\u043c \u043d\u043e\u0432\u044b\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0448\u0430\u043d\u0441 \u043d\u0430\u0439\u0442\u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u043c\u0430\u044f\u0447\u043a\u043e\u0432 \u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f.\u003C\/p\u003E\n\n\u003Ch3\u003E\u003Cstrong\u003E\u041a\u043b\u0430\u043d\u043e\u0432\u044b\u0435 \u0432\u043e\u0439\u043d\u044b\u003C\/strong\u003E\u003C\/h3\u003E\n\u003Cp\u003E\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 \u0441 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u043c \u0442\u043e\u0447\u0435\u043a, \u0430 \u043f\u0440\u043e\u0440\u044b\u0432, \u043a\u0430\u043a \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0430 \u0438\u0432\u0435\u043d\u0442\u0435 \u0432\u0435\u0441\u043d\u043e\u0439. \u0421\u0434\u0435\u043b\u0430\u0442\u044c \u0442\u043e\u0447\u043a\u0438 \u0440\u0430\u043d\u0434\u043e\u043c\u043d\u044b\u043c\u0438, \u0447\u0442\u043e\u0431\u044b \u043a\u0430\u0436\u0434\u0430\u044f \u0438\u0433\u0440\u0430 \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0430\u0441\u044c \u043e\u0442 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u0439.\u003Cbr\u003E\n\u0418\u0433\u0440\u043e\u043a\u0430\u043c \u043f\u0440\u0438\u0434\u0435\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437 \u043c\u0435\u043d\u044f\u0442\u044c \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044e \u043d\u0430 \u0442\u0435\u0445 \u0438\u043b\u0438 \u0438\u043d\u044b\u0445 \u043a\u0430\u0440\u0442\u0430\u0445, \u0442\u0440\u0438 \u044d\u0442\u0430\u043f\u0430 \u043c\u0430\u0442\u0447\u0430 \u043f\u043e \u0434\u0432\u0435 \u0442\u043e\u0447\u043a\u0438 \u043d\u0430 \u044d\u0442\u0430\u043f, \u0441 \u0442\u0435\u043c\u0438 \u0436\u0435 \u0441\u0430\u043c\u044b\u043c\u0438 \u043f\u0430\u043b\u0430\u0442\u043a\u0430\u043c\u0438, \u0438 \u0432\u0441\u0435\u043c \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u043c, \u043d\u043e \u043f\u0435\u0440\u0432\u0430\u044f \u0442\u043e\u0447\u043a\u0430 \u0432 \u043e\u0434\u043d\u043e\u043c \u043c\u0430\u0442\u0447\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043a\u0430\u043a \u043d\u0430 \u0433\u0430\u0440\u0430\u0436\u0430\u0445, \u0442\u0430\u043a \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c \u043d\u0430 \u0443\u0441\u043b\u043e\u0432\u043d\u043e\u043c \u0440\u0435\u0439\u0445\u0435 (\u044d\u0442\u043e \u0432\u0441\u0435 \u0434\u043b\u044f \u043f\u0440\u0438\u043c\u0435\u0440\u0430 \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f).\u003Cbr\u003E\n\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u043f\u0440\u0435\u0442\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u044b \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0431\u043e\u044f, \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u043c\u0430\u043f-\u043f\u0443\u043b\u0430, \u0434\u043b\u044f \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0445 \u043a\u0430\u0440\u0442 \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u043f\u043e\u0434\u0440\u044f\u0434 \u0437\u0430 \u0434\u0435\u043d\u044c \u0442\u0443\u0440\u043d\u0438\u0440\u0430.\u003C\/p\u003E\n","renderFailed":false,"editedAt":"2026-10-27T17:52:52+00:00","canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"197117"}},"user":{"data":{"type":"users","id":"794757"}},"editedUser":{"data":{"type":"users","id":"794757"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4731485","attributes":{"number":2,"createdAt":