a\u0442 \u043c\u0443\u0442\u0430\u043d\u0442\u043e\u0432 \u0442\u0430\u043a \u0438 \u043d\u0435 \u0431\u044b\u043b \u043f\u043e\u0444\u0438\u043a\u0448\u0435\u043d. \u0423 \u0432\u0430\u0441 \u0442\u0430\u043c \u043a\u0430\u043a \u0431\u044b \u0437\u0430\u0432\u0442\u0440\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f, \u0430 \u0441\u043d\u043e\u0440\u043a\u0438, \u0448\u0430\u0432\u043a\u0438, \u043a\u0430\u0431\u0430\u043d\u044b \u0438 \u0445\u0440\u044e\u0448\u0438 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u0442\u0443\u043f\u044f\u0442 \u0432 \u043a\u043e\u043c\u043e\u0440\u043a\u0430\u0445 \u0434\u043b\u044f \u0441\u043f\u0430\u0432\u043d\u0430, \u0438\u0437 \u0437\u0430 \u0447\u0435\u0433\u043e \u043d\u0430 \u0430\u0440\u0435\u043d\u0443 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u0434\u0430\u0439 \u0431\u043e\u0433 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0430 \u043e\u0442 \u043f\u0430\u0447\u043a\u0438.\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0422\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u043e \u0441\u044b\u0433\u0440\u0430\u043b \u043a\u0430\u0442\u043a\u0443 \u0438 \u0441\u043b\u043e\u0432\u0438\u043b \u043f\u0440\u0438\u043a\u043e\u043b\u0434\u042d\u0441: \u0434\u0432\u0430\u0436\u0434\u044b \u0437\u0430 \u0438\u0433\u0440\u0443 \u043d\u0430\u043c \u0432\u044b\u0440\u043e\u043b\u0438\u043b\u043e \u0442\u0430\u043a, \u0447\u0442\u043e \u043e\u0434\u043d\u0438 \u0438 \u0442\u0435 \u0436\u0435 \u0432\u043e\u043b\u043d\u044b \u0448\u043b\u0438 2 \u0440\u0430\u0437\u0430 \u043f\u043e\u0434\u0440\u044f\u0434. \u042f \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043f\u043e\u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f \u0432 \u043f\u0432\u0435 \u0440\u0430\u0443\u043d\u0434\u0430\u0445 - \u044d\u0442\u043e \u043d\u0435\u043f\u043e\u0441\u0438\u043b\u044c\u043d\u044b\u0439 \u0442\u0440\u0443\u0434 (\u0431\u0435\u0437 \u0441\u0430\u0440\u043a\u0430\u0437\u043c\u0430), \u043d\u043e \u043c\u043e\u0436\u043d\u043e \u0436\u0435 \u0431\u044b\u043b\u043e \u0441\u0442\u0440\u043e\u0447\u0435\u0447\u043a\u0443 \u0432 \u043a\u043e\u0434\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u0442\u044c, \u0447\u0442\u043e\u0431\u044b \u043e\u0434\u043d\u0430 \u0438 \u0442\u0430 \u0436\u0435 \u0432\u043e\u043b\u043d\u0430 \u043d\u0435 \u0441\u0442\u0430\u043a\u0430\u043b\u0430\u0441\u044c \u0434\u0432\u0430\u0436\u0434\u044b \u043f\u043e\u0434\u0440\u044f\u0434 (\u043f\u043e\u043a\u0430 \u043f\u0438\u0441\u0430\u043b \u043f\u043e\u0441\u0442, \u0441\u044b\u0433\u0440\u0430\u043b \u0435\u0449\u0435 \u043e\u0434\u043d\u0443 \u043a\u0430\u0442\u043a\u0443 \u0438 \u0442\u043e\u0447\u043d\u043e \u0442\u0430\u043a\u0430\u044f \u0436\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f, \u043f\u0440\u0438\u0447\u0435\u043c \u0434\u0430\u0436\u0435 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435 \u0431\u044b\u043b\u0438))).\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u041d\u0435 \u0432\u0438\u0434\u0435\u043b, \u0447\u0442\u043e\u0431\u044b \u043e\u0431 \u044d\u0442\u043e\u043c \u043a\u0442\u043e \u0442\u043e \u043d\u0430 \u0444\u043e\u0440\u0443\u043c\u0435 \u043d\u044b\u043b, \u0442\u0430\u043a \u0447\u0442\u043e \u043f\u043e\u043d\u043e\u044e \u044f. \u0421\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e \u0440\u0430\u0437 \u0432 \u043a\u0430\u0442\u043a\u0443 \u043b\u043e\u0432\u043b\u044e \u0444\u0440\u0438\u0437 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430, \u0438\u0437 \u0437\u0430 \u0447\u0435\u0433\u043e, \u043f\u0440\u0438 \u043f\u043e\u043f\u044b\u0442\u043a\u0435 \u043f\u043e\u043d\u0430\u0436\u0438\u043c\u0430\u0442\u044c \u043a\u043d\u043e\u043f\u043e\u0447\u043a\u0438 wasd - \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436 \u043d\u0435 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044f \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u043a\u043e\u043b\u0431\u0430\u0441\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u043c\u0435\u0441\u0442\u0435, \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0437\u0430\u0448\u0435\u043b \u043d\u0430 \u0448\u043a\u043e\u043b\u043e-\u0441\u0435\u0440\u0432\u0435\u0440 \u043c\u0430\u0439\u043d\u043a\u0440\u0430\u0444\u0442\u0430 \u0438 \u043f\u044b\u0442\u0430\u0435\u0448\u044c\u0441\u044f \u0432\u044b\u0439\u0442\u0438 \u0441\u043e \u0441\u043f\u0430\u0432\u043d\u0430, \u043d\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0432\u0448\u0438\u0441\u044c. \u0424\u0438\u043a\u0441\u0438\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u043c\u0435\u0440\u0442\u044c\u044e \u0438\u043b\u0438 \u043a\u043e\u043d\u0446\u043e\u043c \u0440\u0430\u0443\u043d\u0434\u0430. \u0414\u0430 \u0432\u043e\u0442 \u043d\u0435\u0437\u0430\u0434\u0430\u0447\u0430 - \u0432 \u0441\u0432\u043e\u0435\u0439 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u043a\u0430\u0442\u043a\u0435 \u0441\u043b\u043e\u0432\u0438\u043b \u0444\u0440\u0438\u0437 \u043d\u0430 \u043f\u0432\u043f \u0440\u0430\u0443\u043d\u0434\u0435 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0443\u043c\u0435\u0440\u0435\u0442\u044c \u043d\u0435 \u0431\u044b\u043b\u043e)))))) \u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a \u043b\u044e\u0431\u0435\u0437\u043d\u043e \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u043b \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u0440\u043e\u0441\u043a\u043e\u043c\u043d\u0430\u0434\u0437\u043e\u0440\u0430 \u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u0445\u043e\u0434\u0430 \u0432 \u0438\u0433\u0440\u0443 (\u0447\u0442\u043e \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u043c\u043e\u0433\u043b\u043e \u0431\u044b \u043f\u043e\u043c\u043e\u0447\u044c), \u0438\u0437 \u0437\u0430 \u0447\u0435\u0433\u043e \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u0440\u043f\u0435\u0442\u044c.\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043c\u0430\u0442\u0447\u0435\u0439. \u0412\u043e\u0442 \u043c\u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u0430 \u0437\u0430\u0447\u0435\u043c \u044d\u0442\u0430 \u0432\u043a\u043b\u0430\u0434\u043a\u0430 \u0432\u043e\u043e\u0431\u0449\u0435 \u0431\u044b\u043b\u0430 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430? \u041d\u0443 \u0442\u0438\u043f\u043e, \u0432\u043e\u0442 \u0441\u043a\u0440\u0438\u043d:\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-11-03\/1793703331-192812-snimok-ekrana-169.png\u0022 title=\u0022snimok-ekrana-169.png\u0022 alt=\u0022\u0022 data-id=\u00229263eb15-8689-42b1-99e6-acb4e0d93be8\u0022 loading=\u0022lazy\u0022 width=\u00223440\u0022 height=\u00221440\u0022\u003E\u003Cbr\u003E\n\u041a\u0430\u043a\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043d\u0435\u0441\u0435\u0442 \u0432 \u0441\u0435\u0431\u0435 \u044d\u0442\u0430 \u0441\u0432\u043e\u0434\u043a\u0430? \u041d\u0435\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0440\u0435\u043f\u043b\u0435\u044f, \u043d\u0435\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u043e\u0432 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 (\u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0443\u0447\u043d\u043e\u0439 \u0432\u0432\u043e\u0434), \u043d\u0435\u0442 \u0432 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0435 \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438, \u043f\u043e \u0442\u0438\u043f\u0443 % \u0443 \u0438\u0434\u043e\u043b\u0430, \u0438\u043b\u0438 \u0443 \u043a\u043e\u0433\u043e \u043a\u0430\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435. \u0422\u0430\u043a\u043e\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u0432\u043a\u043b\u0430\u0434\u043a\u0443 \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u0447\u0438\u0441\u0442\u043e \u043f\u043e \u043f\u0440\u0438\u043a\u043e\u043b\u0443, \u0438\u043b\u0438 \u201c\u043d\u0443 \u0431\u043b\u044f, \u044d\u0442\u043e \u0436\u0435 \u0432\u043e \u0432\u0441\u0435\u0445 \u043a\u0440\u0443\u0442\u044b\u0445 \u043e\u043d\u043b\u0430\u0439\u043d \u0438\u0433\u0440\u0430\u0445 \u0435\u0441\u0442\u044c - \u0437\u043d\u0430\u0447\u0438\u0442 \u0438 \u0443 \u043d\u0430\u0441 \u0431\u0443\u0434\u0435\u0442!\u201d\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0427\u0438\u0441\u0442\u043e \u043e\u0442 \u0441\u0435\u0431\u044f \u0434\u043e\u0431\u0430\u0432\u043b\u044e: \u0411\u044b\u043b\u043e \u0431\u044b \u043a\u0440\u0443\u0442\u043e, \u0435\u0441\u043b\u0438 \u0431\u044b \u0435\u0449\u0435 \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u043a\u0430\u0447\u043a\u0438 \u0421\u043f\u0430\u0440\u0442\u0430\u043a\u0430 \u043d\u0430 \u0438\u0432\u0435\u043d\u0442\u0435. \u0412\u044b \u0432\u0435\u0434\u044c \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0432\u0432\u0435\u043b\u0438 \u0432\u043c\u0435\u0441\u0442\u043e \u0438\u0432\u0435\u043d\u0442\u0430 \u0442\u0443 \u0436\u0435 \u0441\u0430\u043c\u0443\u044e \u0441\u0435\u0441\u0441\u0438\u043e\u043d\u043a\u0443, \u0441 \u0435\u0434\u0438\u043d\u0441