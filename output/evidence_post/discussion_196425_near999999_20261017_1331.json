\u043e\u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432.\u003C\/p\u003E\n\n\u003Cp\u003E\u0422\u0430\u043a-\u0442\u043e \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0440\u0430\u0441\u0442\u044f\u0433\u0438\u0432\u0430\u0442\u044c \u044d\u0442\u0438 \u041e\u0422\u0421\u044b, \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0435\u043c \u0446\u0435\u043b\u0435\u0432\u044b\u043c \u043d\u0430 \u044d\u0442\u0438 \u0441\u0430\u043c\u044b\u0435 \u041e\u0422\u0421\u044b \u0438\u0433\u0440\u043e\u043a\u0430\u043c \u0434\u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f. \u041c\u043e\u044f \u0438\u0434\u0435\u044f \u043d\u0435 \u043b\u0438\u0448\u0435\u043d\u0430 \u043a\u0430\u043a \u0431\u044b \u0441\u043c\u044b\u0441\u043b\u0430, \u043d\u043e \u0443 \u043d\u0435\u0451 \u0435\u0441\u0442\u044c \u0438 \u043c\u0438\u043d\u0443\u0441\u044b - \u043a\u0442\u043e-\u0442\u043e \u0445\u043e\u0442\u0435\u043b \u0432 \u043f\u043d, \u043a\u0442\u043e-\u0442\u043e \u0432 \u0441\u0440, \u043a\u0442\u043e-\u0442\u043e \u0432\u0441. \u041d\u043e \u043a\u0430\u043a \u0431\u044b \u0437\u0430\u0440\u0430\u043d\u0435\u0435 \u043f\u0440\u0438\u0441\u043b\u0430\u0442\u044c \u0434\u043b\u044f \u043e\u0437\u043d\u0430\u043a\u043e\u043c\u043b\u0435\u043d\u0438\u044f \u0432 \u043a\u0430\u043a\u043e\u0439 \u0434\u0435\u043d\u044c \u0442\u0435\u0431\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u0430\u0434\u0443\u0442 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043c\u0435\u0448\u0430\u0435\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0435 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u043f\u043e\u043b\u043d\u044b\u0439 \u043f\u043b\u0430\u0441\u0442 \u0446\u0435\u043b\u0435\u0432\u043e\u0439 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u0438 (\u044d\u0442\u043e \u0441\u043b\u043e\u0432\u043e\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0435 \u043d\u0435 \u043a\u0430\u043a \u0443\u0449\u0435\u043c\u043b\u0435\u043d\u0438\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e) - \u0442\u0435\u0440\u044f\u0442\u044c \u0444\u0438\u0434\u0431\u0435\u043a \u0438 \u0441\u0440\u043e\u043a\u0438 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u043e\u0442\u043b\u0430\u0434\u043a\u0438 \u043f\u0440\u043e\u0434\u043b\u0435\u0432\u0430\u0442\u044c.\u003C\/p\u003E \n\n\u003Cp\u003E\u041a\u0430\u043a \u0431\u044b \u0438\u043d\u0434\u0443\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0441 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u043c \u043e\u0445\u0432\u0430\u0442\u043e\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043b\u0438\u0448\u043d\u0438\u043c \u043d\u0435 \u0431\u0443\u0434\u0435\u0442, \u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u043d\u0435\u043c\u0430\u043b\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0441\u0441\u044b\u043a\u0430\u0442\u044c \u0445\u043e\u0440\u043e\u0448\u0438\u0439 \u0444\u0438\u0434\u0431\u0435\u043a, \u0445\u043e\u0442\u044f \u0442\u0443\u0442 \u0432\u0441\u0435\u0433\u043e 85 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439 (\u043d\u0430 \u0434\u0430\u043d\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442), \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0444\u0438\u0434\u0431\u0435\u043a\u0430 \u0434\u0430\u0439 \u0431\u043e\u0433 5%, \u043b\u0430\u0434\u043d\u043e \u0445\u043e\u0442\u044c \u043e\u043f\u0440\u043e\u0441 \u0432 \u0438\u0433\u0440\u0435 \u0435\u0441\u0442\u044c.\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0442 \u043e\u0431\u0449\u0435\u0433\u043e (\u0438\u0433\u0440\u043e\u043a\u043e\u0432) \u043a \u0447\u0430\u0441\u0442\u043d\u043e\u043c\u0443 (\u043e\u0448\u0438\u0431\u043a\u0430\u043c, \u0434\u0435\u0444\u0435\u043a\u0442\u0430\u043c, \u043e\u0442\u043a\u0430\u0437\u0430\u043c) 