43d\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u044d\u0442\u043e \u043f\u043e\u0434\u0435\u043b\u0438\u0435, \u0438 \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0441\u0438\u0434\u0435\u0442\u044c 24\/7 \u043e\u0442 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0434\u043e \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u0440\u0435\u0439\u0442\u0430 - \u0437\u0430\u0431\u0440\u0430\u0442\u044c \u0433\u043e\u043b\u0434 \u043b\u0438\u0433\u0443 \u043d\u0430 \u0444\u0443\u043b\u043b \u043f\u043e\u0442\u043d\u0438\u0447\u0430\u0445. \u041d\u043e \u044d\u0442\u043e \u0443\u0436\u0435 \u0441\u0443\u043c\u0430\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u0438\u043c\u0445\u043e.\u003C\/li\u003E\n\u003Cli\u003E\u041d\u0438 \u043e\u0434\u0438\u043d \u0438\u0437 \u043d\u0435\u0434\u043e\u0447\u0451\u0442\u043e\u0432 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e \u0440\u0435\u0439\u0442\u0430 \u0410\u041a\u0410 \u041d\u0435\u0413\u0430\u0422\u0438\u0412\u043d\u042b\u0439 \u0424\u0438\u0414\u0431\u0415\u043a \u043d\u0435 \u0431\u044b\u043b\u0438 \u043f\u043e\u0444\u0438\u043a\u0448\u0435\u043d\u044b. \u041d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e QoL \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0440\u0435\u0436\u0438\u043c\u0430, \u0443\u0432\u0438\u0434\u0435\u043d\u043e \u043c\u043d\u043e\u0439 \u043d\u0435 \u0431\u044b\u043b\u043e, \u043f\u0440\u0438\u0447\u0451\u043c \u044f \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u044e \u043e \u0447\u0451\u043c-\u0442\u043e \u0441\u043b\u043e\u0436\u043d\u043e-\u0440\u0435\u0430\u043b\u0438\u0437\u0443\u0435\u043c\u043e\u043c. \u003Cbr\u003E\n\u041c\u043e\u044f \u043b\u0438\u0447\u043d\u0430\u044f \u043f\u0440\u0435\u0442\u0435\u043d\u0437\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043b\u0430 \u0438 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0432 \u043a\u0430\u043b\u0435\u0447\u043d\u043e\u043c \u043f\u043e\u0434\u0431\u043e\u0440\u0435 \u0442\u0438\u043c\u043c\u0435\u0439\u0442\u043e\u0432, \u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u0440\u0435\u043f\u043e\u0440\u0442\u043e\u0432 \u043d\u0430 \u043e\u0432\u043e\u0449\u0435\u0431\u0430\u0437\u0443 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043a \u0442\u0435\u0431\u0435 \u0437\u0430\u043a\u0438\u043d\u0435\u0442 \u0432 \u0442\u0438\u043c\u0443. \u041d\u0435 \u0441\u043f\u043e\u0440\u044e \u043c\u043d\u0435 \u043f\u043e\u043f\u0430\u0434\u0430\u043b\u0438\u0441\u044c \u0437\u0430\u043c\u0435\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043b\u044e\u0434\u0438, \u043e \u0447\u0443\u0434\u043e, \u043e\u0431\u0449\u0430\u043b\u0438\u0441\u044c \u0438 \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043b\u0435\u0433\u043a\u043e \u0437\u0430\u0431\u0438\u0440\u0430\u043b\u0441\u044f \u0442\u043e\u043f 1, \u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0438\u0433\u0440 \u044d\u0442\u043e \u0441\u0440\u0430\u043d\u044b\u0435 \u043c\u043e\u043b\u0447\u0443\u043d\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u043e\u043d \u0441\u0442\u043e\u043f\u043e\u043c \u0444\u0438\u0434\u044f\u0442 \u0438 \u041e\u0434\u043d\u043e\u043c\u0443 \u0431\u043e\u0433\u0443 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u043a\u0430\u043a\u0438\u043c \u0445\u0435\u0440\u043e\u043c \u0438\u0445 \u043a\u0438\u0434\u0430\u0435\u0442 \u043d\u0430 \u0440\u0435\u0439\u0442 \u041a\u0440\u0430\u0441\u043d\u043e\u0439 \u043b\u0438\u0433\u0438 \u043f\u0440\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438 \u043a\u0430\u043a\u043e\u0433\u043e-\u043b\u0438\u0431\u043e \u0438\u043c\u043f\u0430\u043a\u0442\u0430 \u0432 \u0445\u043e\u0434\u0435 \u043c\u0430\u0442\u0447\u0435\u0439.  \u041a\u0430\u043a \u0432 \u0442\u0430\u043a\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u044c \u0445\u043e\u0442\u044f\u0431\u044b \u0442\u043e\u043f 2 - \u0442\u043e\u043f 3 \u0435\u0441\u043b\u0438 \u0432\u0435\u0441\u044c \u0426\u0438\u043d\u0443\u0441 \u0418\u043d\u0432\u0430\u043b\u0438\u0434\u043e\u0432 \u0437\u0430\u043a\u0438\u043d\u0443\u043b\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u043a \u0442\u0435\u0431\u0435 - \u043d\u0435 \u044f\u0441\u043d\u043e.\u003C\/li\u003E\n\u003Cli\u003E\u0415\u0449\u0451 \u043e\u0434\u0438\u043d \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u0435\u0439\u0448\u0438\u0439 \u043c\u0438\u043d\u0443\u0441 \u044d\u0442\u043e 20 \u0435\u0431\u0430\u043d\u044b\u0445 \u043a\u0430\u0442\u043e\u043a \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0438 \u0437\u0430 \u0447\u0438\u0441\u0442\u044b\u0439 \u0440\u0435\u0441\u043f\u0435\u043a\u0442 \u0438 \u0441\u043f\u043e\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u044e\u0434\u0436\u0435\u0442\u0430 \u041d\u041f\u0421 \u0420\u0435\u043c\u043e\u043d\u0442\u043d\u0438\u043a\u0430.\u003Cbr\u003E\n\u041d\u0443 \u0437\u0430 \u003Csub\u003E40\u003C\/sub\u003E \u0441\u044b\u0433\u0440\u0430\u043d\u043d\u044b\u0445 \u043a\u0430\u0442\u043e\u043a \u0441\u0443\u043c\u043c\u0430\u0440\u043d\u043e \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043e\u043a\u043e\u043b\u043e 20 \u0441 \u0440\u0435\u0439\u0442\u043e\u043c \u044f \u0437\u0430\u0444\u0430\u0440\u043c\u0438\u043b - 1\u043a \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u043e\u0432. \u041a\u0430\u043a\u0438\u043c \u0445\u0443\u0435\u043c \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0444\u0430\u0440\u043c\u0438\u0442\u044c \u044d\u0442\u0443 \u0432\u0430\u043b\u044e\u0442\u0443 \u043f\u0440\u0438 \u0432\u044b\u0448\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u0445 \u043c\u043e\u0436\u043d\u043e - \u044f \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e.\u003C\/li\u003E\n\u003Cli\u003E\u041f\u043e\u0434\u0441\u0442\u0430\u0432\u0443\u0448\u043d\u0438\u043a\u0438\/\u0421\u043c\u0443\u0440\u0444\u044b\/\u0411\u0443\u0441\u0442\u0435\u0440\u044b. \u0412\u0441\u0451 \u0447\u0442\u043e \u0431\u044b\u043b\u043e, \u0435\u0441\u0442\u044c \u0438 \u0431\u0443\u0434\u0435\u0442. \u0421 \u043d\u0438\u043c\u0438 \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e-\u0431\u044b \u0431\u043e\u0440\u043e\u0442\u044c\u0441\u044f, \u041d\u041e \u0435\u0441\u043b\u0438 \u0431\u044b \u0431\u044b\u043b\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0435\u043f\u043e\u0440\u0442\u043e\u0432 \u0432 \u043a\u0430\u0442\u043a\u0435. \u0423\u0432\u044b, \u0442\u0435\u0440\u043f\u0438\u043c \u0442\u0435\u0440\u043f\u0438\u043c \u0442\u0435\u0440\u043f\u0438\u043c\u2026\u003C\/li\u003E\u003C\/ul\u003E\n\n\u003Cp\u003E\u0412 \u0446\u0435\u043b\u043e\u043c, \u0434\u0430\u043b\u044c\u0448\u0435 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u044f\u0442\u044c \u0438 \u0442\u0430\u043a \u0443\u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0432\u0441\u0435\u043c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043d\u0435 \u0432\u0438\u0436\u0443 \u0441\u043c\u044b\u0441\u043b\u0430, \u044f \u043b\u0438\u0448\u044c \u043e\u0442\u043c\u0435\u0442\u0438\u043b \u0442\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e\u043a\u043e\u043d\u0430\u043b\u0438 \u043b\u0438\u0447\u043d\u043e \u043c\u0435\u043d\u044f \u0432 \u0445\u043e\u0434\u0435 \u043c\u043e\u0435\u0439 \u0438\u0433\u0440\u044b \u0432 \u0420\u0435\u0436\u0438\u043c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421\u043e\u0432\u0435\u0442\u0443\u044e-\u043b\u0438 \u044f \u0431\u0435\u0434\u043e\u043b\u0430\u0433\u0430\u043c \u0434\u0440\u043e\u0447\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0440\u0435\u0436\u0438\u043c? \u041d\u0435\u0442. \u0418\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0435\u0441\u043b\u0438 \u0432\u0430\u043c \u0434\u0435\u043b\u0430\u0442\u044c \u043d\u0435\u0445\u0435\u0440, \u0438\u043b\u0438 \u0432\u044b \u043f\u0438\u0437\u0434\u0435\u0446 \u043a\u0430\u043a \u043b\u044e\u0431\u0438\u0442\u0435 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u0443\u044e \u043a\u0430\u0441\u0442\u043e\u043c\u0438\u0437\u0430\u0446\u0438\u044e \u0431\u0443\u0434\u044c \u0442\u043e \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u0438\u043b\u0438 \u043e\u0431\u043b\u0438\u043a\u0430 \u043d\u0430 \u0448\u043c\u043e\u0442\u043a\u0438. \u003Cbr\u003E\n\u041b\u0438\u0447\u043d\u043e \u044f \u043f\u0440\u043e\u0433\u0440\u0435\u043b\u0441\u044f \u043d\u0430 \u0444\u043e\u043d \u0441 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0437\u0430 10\u043a \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u043e\u0432, \u043d\u043e \u0443\u0432\u044b \u0438\u0437 \u0437\u0430 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0438 \u0437\u0430 \u0440\u0435\u0441\u043f\u0435\u043a\u0442, \u0434\u0430 \u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0438\u0434\u0435\u0442\u044c \u0432\u044b\u0434\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044c 4\u043a \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u043e\u0432 \u044f \u043d\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0441\u044c. \u041c\u043d\u0435 \u043c\u043e\u0438 \u0438 \u0442\u0430\u043a \u043f\u043e\u0436\u0443\u0445\u043b\u044b\u0435 \u043e\u0442 \u0440\u0435\u0436\u0438\u043c\u0430 \u043d\u0435\u0440\u0432\u044b \u0434\u043e\u0440\u043e\u0436\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0447\u0435\u043d\u044c \u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0431\u044b \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0442\u0440\u0435\u0434 \u0441\u043b\u043e\u0432\u0430\u043c\u0438:\u003Cbr\u003E\n\u201c\u041d\u0430\u0434\u0435\u044e\u0441\u044c \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 \u0443\u0447\u0442\u0443\u0442 \u0432\u0441\u044e \u043a\u0440\u0438\u0442\u0438\u043a\u0443 \u0438 \u0441\u0434\u0435\u043b\u0430\u044e\u0442 \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430\u0434 \u043e\u0448\u0438\u0431\u043a\u0430\u043c\u0438\u201d\u003Cbr\u003E\n\u041e\u0434\u043d\u0430\u043a\u043e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c \u044d\u0442\u043e\u0433\u043e \u043a\u0440\u0430\u0439\u043d\u0435 \u043c\u0430\u043b\u0430, \u043e\u0431\u044a\u0435\u043a\u0442\u0438\u0432\u043d\u043e. \u003Cbr\u003E\n\u0422\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u044b\u0439 \u201c\u041d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u0444\u0438\u0434\u0431\u0435\u043a\u201d \u0442\u044f\u043d\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u043a\u043e\u0440\u0438\u0447\u043d\u0435\u0432\u044b\u0439 \u0448\u043b\u0435\u0439\u0444 \u0441 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0441\u0435\u0437\u043e\u043d\u0430. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0447\u0442\u043e \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0438\u0433\u0440\u043e\u043a\u0430\u043c \u044d\u0442\u043e \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0441\u0440\u0430\u0442\u044c \u0440\u0435\u0436\u0438\u043c \u0438 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0437\u0430 \u043d\u0435\u0433\u043e, \u0432 \u043d\u0430\u0434\u0435\u0436\u0434\u0435 \u0447\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043a 3\u043c\u0443 \u0441\u0435\u0437\u043e\u043d\u0443, \u0447\u0442\u043e-\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u0441\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u043e\u043e\u0431\u0449\u0435 \u0431\u044b\u043b\u043e-\u0431\u044b \u0441\u043b\u0430\u0432\u043d\u043e \u0447\u0442\u043e\u0431\u044b \u043a\u0442\u043e-\u0442\u043e \u0438\u0437 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0432\u044b\u0448\u0435\u043b \u043d\u0430 \u0441\u0432\u044f\u0437\u044c \u0441 \u043b\u044e\u0434\u044c\u043c\u0438 \u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043c\u0438\u043d\u0438 \u043f\u043e\u0441\u0442\u0438\u043a \u043f\u0440\u043e \u0432\u0441\u044e \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e, \u0447\u0451 \u043f\u043e-\u0447\u0451\u043c, \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u0430\u043a \u0438 \u043d\u0438\u043a\u0430\u043a \u0438\u043d\u0430\u0447\u0435 \u0438 \u0432\u0441\u0451 \u0432 \u044d\u0442\u043e\u043c \u0434\u0443\u0445\u0435. \u041d\u043e \u043e\u043f\u044f\u0442\u044c \u0442\u0430\u043a\u0438, \u0443\u0432\u044b.\u003Cbr\u003E\n\u041d\u0430\u0432\u0435\u0440\u043d\u043e\u0435, \u0435\u0449\u0451 \u043f\u043e\u0434\u0447\u0435\u0440\u043a\u043d\u0443, \u0447\u0442\u043e \u043d\u0435 \u0441\u0442\u043e\u0438\u0442 \u0431\u0435\u0434\u043e\u043b\u0430\u0433\u0430\u043c \u0440\u0443\u043f\u043e\u0440\u0430\u043c \u0438 \u043c\u043e\u0434\u0435\u0440\u0430\u043c \u043d\u0430 \u0441\u0432\u043e\u0439 \u0441\u0447\u0451\u0442 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u044c \u043a\u0440\u0438\u0442\u0438\u043a\u0443, \u0432 \u043a\u0430\u043a\u043e\u0439 \u0431\u044b \u043e\u043d\u0430 \u0444\u043e\u0440\u043c\u0435 \u043d\u0435 \u0431\u044b\u043b\u0430, \u0430 \u0442\u043e \u0435\u0441\u0442\u044c \u0442\u0443\u0442 \u0442\u0430\u043a\u0430\u044f \u0442\u0435\u043d\u0434\u0435\u043d\u0446\u0438\u044f, \u0447\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0437\u0430\u0431\u0430\u0432\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044f \u0447\u0442\u043e \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u043e\u043d\u0438 \u043a \u044d\u0442\u043e\u043c\u0443 \u0434\u0435\u043b\u043e \u0438 \u043d\u0435 \u0438\u043c\u0435\u044e\u0442, \u0438\u0431\u043e \u043e\u043d\u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0449\u0438\u0435 \u0433\u043e\u043b\u043e\u0432\u044b \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e. \u041e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u0441\u044c \u043a \u043a\u0440\u0438\u0442\u0438\u043a\u0435 \u043f\u0440\u043e\u0449\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0430 \u0438\u0434\u0451\u0442 \u043d\u0435 \u0441 \u043f\u0443\u0441\u0442\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430, \u0430 \u043a\u043e\u0433\u0434\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0435\u0441\u0442\u044c \u043e\u0431\u0441\u0451\u0440 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0420\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0430. \u041a\u0430\u043a \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0441\u044f \u0443\u043c\u0435\u0439\u0442\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u0432\u0430\u0442\u044c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0435. \u003Cbr\u003E\n\u041a \u044d\u0442\u0438\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u044f \u043f\u0440\u0438\u0437\u043d\u0430\u044e \u0447\u0442\u043e \u0432 \u0442\u0440\u0435\u0434\u0435 \u043f\u0440\u044f\u043c \u0441\u043e\u043b\u0438\u0434\u043d\u043e \u043d\u0430 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u0438\u043b, \u043d\u0435 \u0431\u0435\u0441\u043f\u043e\u0447\u0432\u0435\u043d\u043d\u043e, \u043d\u043e \u044d\u0442\u043e \u0435\u0441\u0442\u044c \u0445\u043e\u0442\u044c \u0438 \u043d\u0438\u043a\u043e\u0433\u043e \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u043d\u0435 \u043e\u0441\u043a\u043e\u0440\u0431\u043b\u044f\u043b.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0441\u0435\u043c \u0434\u043e\u0431\u0440\u0430, \u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0432 \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u0440\u0435\u0436\u0438\u043c\u044b. \u0410 \u043b\u0438\u0447\u043d\u043e \u044f - \u043f\u043e\u0439\u0434\u0443 \u0436\u0438\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435 \u0436\u0438\u0437\u043d\u044c 