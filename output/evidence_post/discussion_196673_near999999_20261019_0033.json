2\u044e\u043c KIM-X \u201c\u0410\u0442\u043b\u0430\u0441\u201d \u043d\u0430 \u043b\u043e\u043a\u0430\u0446\u0438\u0438 \u041b\u044e\u0431\u0435\u0447-3. \u0421\u043a\u0430\u0436\u0438\u0442\u0435, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u0440\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0435 \u0434\u0430\u043d\u043d\u043e\u0439 \u0446\u0435\u043f\u043e\u0447\u043a\u0438 \u0433\u0435\u0439\u043c\u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440\u044b \u0432\u043e\u043e\u0431\u0449\u0435 \u0434\u0443\u043c\u0430\u043b\u0438 \u043e \u043a\u043e\u043c\u044c\u044e\u043d\u0438\u0442\u0438?\u003Cbr\u003E\n\u041a\u0432\u0435\u0441\u0442 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0434\u0443\u0448\u043d\u044b\u043c. \u041c\u0430\u043b\u043e \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043c\u043d\u043e\u0433\u0438\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043d\u0443\u0436\u043d\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0441\u0442\u0440\u043e\u0433\u043e \u0437\u0430 \u043e\u0434\u043d\u0443 \u043f\u043e\u043f\u044b\u0442\u043a\u0443, \u0442\u0430\u043a \u0435\u0449\u0451 \u0432\u0441\u0451 \u044d\u0442\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439 \u043b\u043e\u043a\u0430\u0446\u0438\u0438 \u0441 PvP, \u0433\u0434\u0435 \u0442\u0435\u0431\u044f \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u0443\u0431\u0438\u0432\u0430\u044e\u0442 \u0432 \u0441\u043f\u0438\u043d\u0443 \u043f\u0440\u044f\u043c\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u0447\u0438\u0441\u0442\u043a\u0438 \u0441\u043f\u043e\u0442\u043e\u0432.\u003Cbr\u003E\n\u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0437\u0430\u0434\u0430\u043d\u0438\u0435 \u043e\u0442 \u041f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430 \u0411 (\u0447\u0430\u0441\u0442\u044c 1): \u043d\u0443\u0436\u043d\u043e \u0443\u0431\u0438\u0442\u044c 20 \u043b\u044e\u0431\u0435\u0447\u0441\u043a\u0438\u0445 \u0448\u0430\u0432\u043e\u043a, 20 \u043a\u0430\u0431\u0430\u043d\u043e\u0432, \u0411\u0443\u0440\u0435\u043b\u043e\u043c\u0430 \u0438 \u0411\u0435\u0441\u0442\u0438\u044e. \u0412\u0441\u0451 \u044d\u0442\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0437\u0430 \u043e\u0434\u043d\u0443 \u0436\u0438\u0437\u043d\u044c, \u0438\u043d\u0430\u0447\u0435 \u0432\u0435\u0441\u044c \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0441\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u043d\u043e\u043b\u044c! \u0422\u0430\u0439\u043c\u0438\u043d\u0433\u0438 \u0438 \u043c\u0435\u0441\u0442\u0430 \u0441\u043f\u0430\u0432\u043d\u0430 \u0411\u0443\u0440\u0435\u043b\u043e\u043c\u0430 \u0438 \u0411\u0435\u0441\u0442\u0438\u0438 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0435\u043f\u043e\u043d\u044f\u0442\u043d\u044b - \u043e\u043d\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0432 \u0440\u0430\u0437\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0438 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u043c\u0435\u0441\u0442\u0430\u0445.\u003Cbr\u003E\n\u041e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u0441\u0442\u043e\u0438\u0442 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u043f\u0440\u043e \u0448\u0430\u0432\u043e\u043a: \u043d\u0430 \u0441\u043f\u043e\u0442\u0430\u0445 \u0441\u043f\u0430\u0432\u043d\u044f\u0442\u0441\u044f \u043a\u0430\u043a \u043e\u0431\u044b\u0447\u043d\u044b\u0435 \u0441\u043e\u0431\u0430\u043a\u0438, \u0442\u0430\u043a \u0438 \u043f\u0441\u0435\u0432\u0434\u043e\u0441\u043e\u0431\u0430\u043a\u0438. \u041f\u0441\u0435\u0432\u0434\u043e\u0441\u043e\u0431\u0430\u043a\u0438 \u043f\u043e\u0447\u0435\u043c\u0443-\u0442\u043e \u0432 \u043a\u0432\u0435\u0441\u0442 \u043d\u0435 \u0437\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f, \u0430 \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u043d\u0430 \u0441\u043f\u043e\u0442\u0435 \u043e\u0442 \u0441\u0438\u043b\u044b 2\u20133 \u0448\u0442\u0443\u043a\u0438. \u0418\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0431\u0435\u0433\u0430\u0442\u044c \u043f\u043e \u0432\u0441\u0435\u0439 \u043b\u043e\u043a\u0430\u0446\u0438\u0438, \u0447\u0442\u043e \u0434\u0438\u043a\u043e \u0434\u0443\u0448\u043d\u0438\u0442, \u0432\u0435\u0434\u044c \u041b\u044e\u0431\u0435\u0447-3 - \u043b\u043e\u043a\u0430\u0446\u0438\u044f \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0430\u044f, \u0430 \u043d\u0430\u043f\u043b\u044b\u0432 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439.\u003Cbr\u003E\n\u0412\u0441\u0451 \u0431\u044b \u043d\u0438\u0447\u0435\u0433\u043e, \u0435\u0441\u043b\u0438 \u0431\u044b \u043f\u0440\u0438 \u0441\u043c\u0435\u0440\u0442\u0438 \u043d\u0435 \u0442\u0435\u0440\u044f\u043b\u0441\u044f \u0432\u0435\u0441\u044c \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441. \u041a \u0442\u043e\u043c\u0443 \u0436\u0435, KIM-X -  \u044d\u0442\u043e \u0434\u0430\u043b\u0435\u043a\u043e \u043d\u0435 \u0442\u043e\u043f\u043e\u0432\u044b\u0439 \u044d\u043d\u0434\u0433\u0435\u0439\u043c-\u043a\u043e\u0441\u0442\u044e\u043c, \u0440\u0430\u0434\u0438 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u0442\u043e\u0438\u0442 \u0442\u0430\u043a \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044c. \u041d\u0430 \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u0435 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u0435 \u0435\u0441\u0442\u044c \u043a\u043e\u0441\u0442\u044e\u043c \u0413\u0430\u043d\u0438\u043c\u0435\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0430\u043c \u0434\u0430\u0436\u0435 \u043b\u0443\u0447\u0448\u0435, \u043d\u043e \u0434\u043e\u0431\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0440\u0430\u0437\u044b \u043f\u0440\u043e\u0449\u0435.\u003Cbr\u003E\n\u0422\u0430\u043a\u0436\u0435 \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u043f\u043e\u043b\u043d\u0443\u044e \u0434\u0443\u0445\u043e\u0442\u0443 \u0441 \u0420\u0443\u043d\u043e\u0439: \u0435\u0451 \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c, \u043f\u043e\u043a\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u0435 \u0437\u0430\u043a\u0440\u043e\u0435\u0448\u044c \u043a\u0432\u0435\u0441\u0442 \u043d\u0430 \u041a\u0418\u041c-\u0425. \u041d\u0443 \u0447\u0442\u043e \u0437\u0430 \u0431\u0440\u0435\u0434? \u0421\u0430\u043c \u043a\u0432\u0435\u0441\u0442 \u043d\u0430 \u0420\u0443\u043d\u0443 \u043b\u0451\u0433\u043a\u0438\u0439 (\u0441\u043e\u0431\u0440\u0430\u043b \u0437\u0430\u043f\u0438\u0441\u043a\u0438, \u043f\u0440\u0438\u0448\u0451\u043b \u0432 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u044c \u043a \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e\u043c\u0443 \u0432\u0440\u0435\u043c\u0435\u043d\u0438), \u043d\u043e \u0438\u0437-\u0437\u0430 \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0438 \u043a \u041a\u0418\u041c-\u0425 \u043e\u043d \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0432 \u043d\u0435\u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043c\u0443\u044e \u0437\u0430\u0434\u0430\u0447\u0443. \u0418 \u044d\u0442\u043e \u044f \u0435\u0449\u0451 \u043c\u043e\u043b\u0447\u0443 \u043f\u0440\u043e \u0442\u043e, \u0447\u0442\u043e \u0440\u0430\u0434\u0438 \u041a\u0418\u041c-\u0425 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0431\u0435\u0433\u0430\u0442\u044c \u043f\u043e \u0432\u0441\u0435\u043c\u0443 \u042e\u0433\u0443 \u0417\u043e\u043d\u044b.\u003Cbr\u003E\n\u0418\u0437-\u0437\u0430 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0445 \u0441\u043c\u0435\u0440\u0442\u0435\u0439 \u0432 \u0441\u043f\u0438\u043d\u0443 \u043d\u0430 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439 \u043b\u043e\u043a\u0430\u0446\u0438\u0438 \u041b\u044e\u0431\u0435\u0447-3 \u0441\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0437\u0430\u043a\u0443\u043f\u0430: \u043f\u0430\u0442\u0440\u043e\u043d\u044b, \u0430\u043f\u0442\u0435\u0447\u043a\u0438, \u0434\u043e\u0440\u043e\u0433\u0438\u0435 \u0431\u0443\u0441\u0442\u044b. \u0412 \u0438\u0442\u043e\u0433\u0435 \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0443\u0445\u043e\u0434\u0438\u0442 \u0432 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439 \u043c\u0438\u043d\u0443\u0441 \u043f\u043e \u0432\u0430\u043b\u044e\u0442\u0435, \u0447\u0442\u043e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0435 \u043e\u043a\u0443\u043f\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u043e\u0439 \u043d\u0430\u0433\u0440\u0430\u0434\u043e\u0439. \u0414\u0430\u043d\u043d\u043e\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u0435 (\u201c\u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0437\u0430 \u043e\u0434\u043d\u0443 \u0436\u0438\u0437\u043d\u044c \u0432 \u043e\u043f\u0435\u043d\u0432\u043e\u0440\u043b\u0434\u0435\u201d) \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043f\u043b\u043e\u0434\u0438\u0442 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0441\u0442\u044c. \u0418\u0433\u0440\u043e\u043a\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u043e\u0439 \u0444\u0440\u0430\u043a\u0446\u0438\u0438 (\u0417\u0430\u0432\u0435\u0442 \u0438\u043b\u0438 \u041d\u0430\u0451\u043c\u043d\u0438\u043a\u0438) \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u0437\u043d\u0430\u044e\u0442, \u0433\u0434\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u044e\u0442\u0441\u044f \u044d\u0442\u0438 \u043a\u0432\u0435\u0441\u0442\u044b. \u041e\u043d\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043a\u0430\u0440\u0430\u0443\u043b\u044f\u0442 \u043b\u044e\u0434\u0435\u0439 \u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u0441\u043b\u0438\u0432\u0430\u044e\u0442 \u0438\u0445 \u0432 \u0441\u043f\u0438\u043d\u0443, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0442\u0435\u0448\u0438\u0442\u044c \u0441\u0432\u043e\u0451 \u044d\u0433\u043e \u0438 \u043e\u0431\u043d\u0443\u043b\u0438\u0442\u044c \u0447\u0443\u0436\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0440\u0430\u0434\u0438 \u0437\u0430\u0431\u0430\u0432\u044b. \u041a\u0432\u0435\u0441\u0442 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u0432 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435 \u0441\u043a\u0438\u043b\u043b\u0430, \u0430 \u0432 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435 \u0443\u0434\u0430\u0447\u0438 - \u043f\u043e\u043f\u0430\u0434\u0451\u0442\u0441\u044f \u0442\u0435\u0431\u0435 \u043f\u0443\u0441\u0442\u043e\u0439 \u0441\u0435\u0440\u0432\u0435\u0440 \u0438\u043b\u0438 \u043d\u0435\u0442.\u003Cbr\u003E\n\u0411\u043e\u043b\u0435\u0435 \u0442\u043e\u0433\u043e, \u0438\u0437-\u0437\u0430 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043d\u0430 \u0441\u043f\u043e\u0442\u0435 \u0441\u043f\u0430\u0432\u043d\u044f\u0442\u0441\u044f \u043a\u0440\u043e\u0445\u0438 \u043d\u0443\u0436\u043d\u044b\u0445 \u043c\u043e\u0431\u043e\u0432, \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0434\u0443\u0448\u043d\u0430\u044f \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0446\u0438\u044f \u0434\u0430\u0436\u0435 \u0441 \u0438\u0433\u0440\u043e\u043a\u0430\u043c\u0438 \u0441\u0432\u043e\u0435\u0439 \u0444\u0440\u0430\u043a\u0446\u0438\u0438. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u043a\u043e\u043e\u043f\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f, \u043b\u044e\u0434\u0438 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d\u044b \u0432\u043e\u0440\u043e\u0432\u0430\u0442\u044c \u0434\u0440\u0443\u0433 \u0443 \u0434\u0440\u0443\u0433\u0430 \u043c\u043e\u0431\u043e\u0432 \u0438\u0437-\u043f\u043e\u0434 \u043d\u043e\u0441\u0430, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u043d\u0443\u0436\u043d\u043e \u043d\u0430\u0431\u0438\u0442\u044c \u0437\u0430\u0432\u0435\u0442\u043d\u044b\u0435 20 \u0448\u0442\u0443\u043a \u0437\u0430 \u043e\u0434\u043d\u0443 \u0436\u0438\u0437\u043d\u044c. \u041b\u0438\u0447\u043d\u043e \u043d\u0430 \u043c\u043e\u0451\u043c \u043e\u043f\u044b\u0442\u0435 \u0438\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u043a\u0432\u0435\u0441\u0442\u0430 \u043c\u043d\u043e\u0433\u0438\u0435 \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u0435 \u0432 \u0438\u0433\u0440\u0435 \u0434\u043e\u0445\u043e\u0434\u0438\u043b\u0438 \u0434\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0445 \u043d\u0435\u0440\u0432\u043d\u044b\u0445 \u0441\u0440\u044b\u0432\u043e\u0432. \u0422\u0430\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u0441\u0438\u043b\u044c\u043d\u043e \u0431\u044c\u044e\u0442 \u043f\u043e \u043d\u0435\u0440\u0432\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u043a\u043e\u043c\u044c\u044e\u043d\u0438\u0442\u0438.\u003Cbr\u003E\n\u041e\u0447\u0435\u043d\u044c \u043c\u043d\u043e\u0433\u043e \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0437\u0430\u0445\u043e\u0434\u044f\u0442 \u0432 \u0438\u0433\u0440\u0443 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u043f\u043e\u0441\u043b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b \u0438\u043b\u0438 \u0443\u0447\u0451\u0431\u044b \u0432\u0441\u0435\u0433\u043e \u043d\u0430 \u043f\u0430\u0440\u0443 \u0447\u0430\u0441\u043e\u0432, \u0443 \u043d\u0438\u0445 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043d\u0430 \u043f\u043e\u0434\u043e\u0431\u043d\u0443\u044e \u0434\u0443\u0445\u043e\u0442\u0443. \u041f\u0443\u0441\u043a\u0430\u0439 \u0442\u0435\u0441\u0442\u0435\u0440\u044b \u0438 \u0433\u0435\u0439\u043c\u0434\u0438\u0437\u0430\u0439\u043d\u0435\u0440\u044b \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u044e\u0442 \u043f\u0440\u043e\u0439\u0442\u0438 \u044d\u0442\u043e\u0442 \u043a\u0432\u0435\u0441\u0442 \u0441\u043e\u043b\u043e \u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c \u0441\u0435\u0440\u0432\u0435\u0440\u0435 \u043a\u0430\u043a \u043e\u0431\u044b\u0447\u043d\u044b\u0435 \u0441\u043e\u043b\u043e-\u0438\u0433\u0440\u043e\u043a\u0438  \u044f \u0431\u044b \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u043b, \u043a\u0430\u043a \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043e\u043d\u0438 \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u0430\u043b\u0438 \u0431\u044b \u044d\u0442\u043e\u0442 \u044d\u0442\u0430\u043f.\u003Cbr\u003E\n\u041a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044e, \u043d\u0435 \u043b\u043e\u043c\u0430\u044f \u0437\u0430\u0434\u0443\u043c\u043a\u0443 \u043a\u0432\u0435\u0441\u0442\u0430 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e: \u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0410: \u0421\u0434\u0435\u043b\u0430\u0442\u044c \u0437\u043e\u043d\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u044d\u0442\u043e\u0433\u043e \u044d\u0442\u0430\u043f\u0430 \u0443\u0441\u043b\u043e\u0432\u043d\u043e-\u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u044b\u043c\u0438 \u043e\u0442 PvP (\u0445\u043e\u0442\u044f \u0431\u044b \u0432 \u043c\u0435\u0441\u0442\u0430\u0445 \u0441\u043f\u0430\u0432\u043d\u0430 \u043a\u0432\u0435\u0441\u0442\u043e\u0432\u044b\u0445 \u043c\u043e\u0431\u043e\u0432) \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0447\u0430\u0441\u0442\u044c \u044d\u0442\u0430\u043f\u0430 \u0432 \u0434\u0430\u043d\u0436-\u043f\u043e\u0434\u0437\u0435\u043c\u043a\u0443.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0411: \u0423\u0431\u0440\u0430\u0442\u044c \u043f\u043e\u043b\u043d\u043e\u0435 \u043e\u0431\u043d\u0443\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430. \u041f\u0443\u0441\u0442\u044c \u043f\u0440\u0438 \u0441\u043c\u0435\u0440\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u043e\u0442\u043a\u0430\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0430 3-5 \u0443\u0431\u0438\u0442\u044b\u0445 \u043c\u043e\u0431\u043e\u0432, \u043d\u043e \u043d\u0435 \u0432 \u043d\u043e\u043b\u044c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0412: \u0421\u0434\u0435\u043b\u0430\u0442\u044c \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u043c\u043e\u0431\u043e\u0432 \u0437\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u043b\u0438\u0441\u044c \u0432\u0441\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u0435, \u0435\u0441\u043b\u0438 \u0438\u0433\u0440\u043e\u043a\u0438 \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u0432 \u043e\u0442\u0440\u044f\u0434\u0435, \u0447\u0442\u043e\u0431\u044b \u0441\u0442\u0438\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0435 \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u0430 \u043d\u0435 \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442 \u0413: \u0421\u0434\u0435\u043b\u0430\u0442\u044c \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u04