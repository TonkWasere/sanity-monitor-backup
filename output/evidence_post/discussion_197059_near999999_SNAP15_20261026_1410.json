003Cp\u003E\u0412\u0441\u0435\u043c \u043f\u0440\u0438\u0432\u0435\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u0425\u043e\u0447\u0443 \u043e\u0431\u0441\u0443\u0434\u0438\u0442\u044c \u043e\u0434\u0438\u043d \u043c\u043e\u043c\u0435\u043d\u0442 \u043f\u043e \u043e\u0431\u043b\u0438\u043a\u0443 \u00ab\u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0430 10\u00bb (\u0442\u043e\u0442, \u0447\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0437\u0430 \u043f\u0430\u0442\u0435\u0440\u043d\u044b \u0432 \u041a\u043e\u043b\u0438\u0437\u0435\u0435).\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0431\u043b\u0438\u043a \u0432\u044b\u0448\u0435\u043b, \u043d\u0430 \u043c\u043e\u0439 \u0432\u0437\u0433\u043b\u044f\u0434, \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u0439. \u0414\u0438\u0437\u0430\u0439\u043d \u0443 \u00ab\u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u044b\u00bb \u043e\u0447\u0435\u043d\u044c \u0441\u0442\u0438\u043b\u044c\u043d\u044b\u0439 \u0438 \u0432\u044b\u0434\u0435\u0440\u0436\u0430\u043d\u043d\u044b\u0439, \u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u043e\u043d \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0421\u0422\u0421. \u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0441\u0442\u044c \u043e\u0434\u0438\u043d \u043d\u044e\u0430\u043d\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043b\u0438\u0447\u043d\u043e \u043c\u0435\u043d\u044f \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412 \u0447\u0451\u043c \u0441\u0443\u0442\u044c \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f:\u003Cbr\u003E\n\u042f \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043e\u0431\u043b\u0438\u043a \u00ab\u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0430 10\u00bb \u0435\u0449\u0451 \u0438 \u043d\u0430 FN FAL.\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e\u0447\u0435\u043c\u0443 \u044d\u0442\u043e \u043b\u043e\u0433\u0438\u0447\u043d\u043e:\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0431\u0449\u0430\u044f \u0431\u0430\u0437\u0430. \u041c\u044b \u0432\u0441\u0435 \u0437\u043d\u0430\u0435\u043c, \u0447\u0442\u043e \u0421\u0422\u0421 \u0438 FN FAL \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u0438\u0432\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u043d\u044b \u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0431\u0430\u0437\u0435 (\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 FAL). \u042d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u00ab\u043f\u043e\u0445\u043e\u0436\u0438\u0435 \u043f\u0443\u0448\u043a\u0438\u00bb, \u0430 \u043f\u043e \u0441\u0443\u0442\u0438 \u0440\u043e\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043e\u0431\u0440\u0430\u0437\u0446\u044b. \u0415\u0441\u043b\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 \u0443\u0436\u0435 \u043f\u043e\u0448\u043b\u0438 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e\u0431\u044b \u0434\u0430\u0442\u044c \u043e\u0434\u043d\u043e\u043c\u0443 \u043e\u0431\u043b\u0438\u043a\u0443 \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0435\u0434\u0438\u043d\u0438\u0446 \u043e\u0440\u0443\u0436\u0438\u044f \u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0431\u0430\u0437\u0435, \u0442\u043e \u043f\u043e\u0447\u0435\u043c\u0443 \u0431\u044b \u043d\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u044d\u0442\u043e \u0438 \u0437\u0434\u0435\u0441\u044c?\u003C\/p\u003E\n\n\u003Cp\u003E\u0423\u0436\u0435 \u0435\u0441\u0442\u044c \u043f\u0440\u0435\u0446\u0435\u0434\u0435\u043d\u0442. \u0412 \u0438\u0433\u0440\u0435 \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043e\u0431\u043b\u0438\u043a \u00ab\u0421\u043b\u0443\u0436\u0438\u0432\u044b\u0439 \u0441\u043e\u043b\u0434\u0430\u0442\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044f \u0438 \u043d\u0430 \u0412\u0421\u0421-\u041c, \u0438 \u043d\u0430 \u0421\u0420-3\u041c. \u042d\u0442\u043e \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u0439 \u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043e\u0434\u0438\u043d \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0439 \u0441\u043a\u0438\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430 \u0434\u0432\u0430 \u0441\u0442\u0432\u043e\u043b\u0430 \u0438\u0437 \u043e\u0434\u043d\u043e\u0439 \u00ab\u0441\u0435\u043c\u044c\u0438\u00bb. \u041f\u043e\u0447\u0435\u043c\u0443 \u0431\u044b \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u044c \u0442\u0430\u043a\u043e\u0439 \u0436\u0435 \u0442\u0440\u044e\u043a \u0441 \u00ab\u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u043e\u0439 10\u00bb \u0438 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u043e\u0439 FAL?\u003C\/p\u003E\n\n\u003Cp\u003E\u0427\u0442\u043e \u044d\u0442\u043e \u0434\u0430\u0441\u0442 \u0438\u0433\u0440\u043e\u043a\u0430\u043c (\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0430\u043c):\u003Cbr\u003E\n\u0421\u0435\u0439\u0447\u0430\u0441 \u00ab\u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0430 10\u00bb \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u0421\u0422\u0421, \u0438 \u044d\u0442\u043e \u0441\u0438\u043b\u044c\u043d\u043e \u0441\u0443\u0436\u0430\u0435\u0442 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044e \u043e\u0431\u043b\u0438\u043a\u0430. \u0415\u0441\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c FN FAL, \u043e\u0431\u043b\u0438\u043a \u0441\u0442\u0430\u043d\u0435\u0442 \u0437\u0430\u043c\u0435\u0442\u043d\u043e \u0431\u043e\u043b\u0435\u0435 \u0432\u043e\u0441\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u2014 \u043b\u044e\u0434\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0421\u0422\u0421, \u043d\u043e \u0438\u0433\u0440\u0430\u044e\u0442 \u0441 \u0424\u0430\u043b\u043e\u043c, \u043d\u0430\u043a\u043e\u043d\u0435\u0446 \u0441\u043c\u043e\u0433\u0443\u0442 \u0435\u0433\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c. \u042f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u0430\u043c \u043e\u0431\u043b\u0438\u043a \u043f\u043e\u043a\u0430 \u043d\u0435 \u0431\u0440\u0430\u043b, \u043d\u043e \u043e\u043d \u043c\u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \u0415\u0441\u043b\u0438 \u0431\u044b \u0435\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u0430 FAL \u2014 \u044f \u0431\u044b 100% \u0435\u0433\u043e \u0432\u0437\u044f\u043b, \u043d\u0435 \u0440\u0430\u0437\u0434\u0443\u043c\u044b\u0432\u0430\u044f. \u0414\u0443\u043c\u0430\u044e, \u044f \u0442\u0430\u043a\u043e\u0439 \u043d\u0435 \u043e\u0434\u0438\u043d: \u043c\u043d\u043e\u0433\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0432\u0438\u0434\u044f\u0442 \u0441\u043c\u044b\u0441\u043b\u0430 \u0431\u0440\u0430\u0442\u044c \u0441\u043a\u0438\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435\u043a\u0443\u0434\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0418\u0442\u043e\u0433:\u003Cbr\u003E\n\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0441\u043f\u0438\u0441\u043a\u0430 \u043e\u0440\u0443\u0436\u0438\u044f \u0434\u043b\u044f \u00ab\u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u044b 10\u00bb \u2014 \u044d\u0442\u043e \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0435, \u043d\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0435 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435. \u041e\u043d\u043e \u043d\u0435 \u043b\u043e\u043c\u0430\u0435\u0442 \u0431\u0430\u043b\u0430\u043d\u0441 (\u044d\u0442\u043e \u0436\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043a\u0438\u043d), \u043d\u043e \u0434\u0430\u0451\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u044b \u0432 \u043a\u0430\u0441\u0442\u043e\u043c\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u0434\u0435\u043b\u0430\u0435\u0442 \u043e\u0431\u043b\u0438\u043a \u0431\u043e\u043b\u0435\u0435 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0434\u043b\u044f \u043f\u043e\u043a\u0443\u043f\u043a\u0438.\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-26\/1793020607-431318-izobrazenie-2026-10-26-181644335.png\u0022 title=\u0022izobrazenie-2026-10-26-181644335.png\u0022 alt=\u0022\u0022 data-id=\u002266c6053c-72cf-46af-a1d8-1d982a6e3b83\u0022 loading=\u0022lazy\u0022 width=\u00221919\u0022 height=\u00221079\u0022\u003E\u003C\/p\u003E\n\n\n\u003Cp\u003E\u0423\u0432\u0430\u0436\u0430\u0435\u043c\u044b\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438, \u0435\u0441\u043b\u0438 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u044d\u0442\u043e \u043d\u0435\u0441\u043b\u043e\u0436\u043d\u043e (\u043a\u0430\u043a \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u0441\u043e \u00ab\u0421\u043b\u0443\u0436\u0438\u0432\u044b\u043c \u0441\u043e\u043b\u0434\u0430\u0442\u043e\u043c\u00bb), \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u044f FN FAL \u0432