8\u0442\u044c \u0440\u0435\u043b\u0438\u043a\u0432\u0438\u044e, \u043a\u043e\u0433\u0434\u0430 \u0431\u043e\u0441\u0441\u0430 \u0442\u044f\u0436\u0435\u043b\u043e \u0434\u0430\u0436\u0435 \u0432 5 \u0443\u0431\u0438\u0442\u044c \u0438\u0437-\u0437\u0430 \u043d\u0435\u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043b-\u0432\u043e \u0445\u043f. \u0422\u0435\u043f\u0435\u0440\u044c \u0434\u0430\u0436\u0435 \u043a\u0440\u044b\u0441\u044b, \u0448\u043d\u044b\u0440\u0438 \u0438 \u0443\u043f\u044b\u0440\u0438 \u043c\u043e\u0433\u0443\u0442 \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u0440\u0435\u043b\u0438\u043a\u0432\u0438\u044e, \u043d\u043e \u0432\u0441\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0432 \u0442\u043e\u043c, \u0427\u0422\u041e \u0411\u041b\u042f\u0422\u042c \u041e\u041d\u0418 \u0418\u0414\u0423\u0422 \u0421 \u041d\u0423\u041b\u0415\u0412\u041e\u0419 \u0425\u0423\u042f\u0420\u0418\u0422\u042c \u0420\u0415\u041b\u0418\u041a\u0412\u0418\u042e \u0412\u0421\u0415\u0419 \u041e\u0420\u0410\u0412\u041e\u0419, \u0430 \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0442\u0435 \u0442\u0430\u043a\u0443\u044e \u0445\u0443\u0439\u043d\u044e, \u0443 \u0432\u0430\u0441 \u0432 \u0440\u0430\u0443\u043d\u0434\u0435 \u0441\u0442\u0440\u0435\u043b\u044f\u044e\u0442 \u041d\u041f\u0421 \u043f\u043e \u0440\u0435\u043b\u0438\u043a\u0432\u0438\u0438, \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043a\u0438\u043d\u0443\u0442\u044c \u0449\u0438\u0442 \u043d\u0430 \u0440\u0435\u043b\u0438\u043a\u0432\u0438\u044e, \u0432 \u044d\u0442\u043e\u0442 \u0449\u0438\u0442 \u0437\u0430\u0445\u043e\u0434\u0438\u0442 15 \u043a\u0440\u044b\u0441, \u043f\u043e\u0442\u043e\u043c \u044d\u0442\u0438 \u0436\u0435 \u043a\u0440\u044b\u0441\u044b \u043f\u043e 2-3 \u043e\u0441\u043e\u0431\u0438 \u0438\u0434\u0443\u0442 \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0438 \u0442\u044b \u0434\u043e\u043b\u0436\u0435\u043d:\u003Cbr\u003E\n1) \u0423\u0441\u043f\u0435\u0432\u0430\u0442\u044c \u043a\u0438\u0434\u0430\u0442\u044c \u0449\u0438\u0442\u003Cbr\u003E\n2) \u0423\u0431\u0438\u0432\u0430\u0442\u044c \u043c\u0443\u0442\u0430\u043d\u0442\u043e\u0432 \u0447\u0442\u043e \u0431\u044c\u044e\u0442 \u0440\u0435\u043b\u0438\u043a\u0432\u0438\u044e \u0432\u043d\u0443\u0442\u0440\u0438 \u0449\u0438\u0442\u0430 \u0438 \u043d\u0435 \u0441\u043b\u043e\u043c\u0430\u0442\u044c \u0441\u0430\u043c \u0449\u0438\u0442\u003Cbr\u003E\n3) \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u043c\u0443\u0442\u0430\u043d\u0442\u043e\u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0431\u0438\u0432\u0430\u044e\u0442 \u0442\u0435\u0431\u044f\u003Cbr\u003E\n4) \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u041d\u041f\u0421 \u0432 \u043e\u043a\u043d\u0430\u0445\u003Cbr\u003E\n\u042d\u0422\u041e \u0414\u0410\u0416\u0415 \u0412 5-\u041e\u041c \u0410\u0425\u0423\u0415\u0422\u042c \u041a\u0410\u041a \u0421\u041b\u041e\u0416\u041d\u041e, \u0442\u0430\u043a \u0436\u0435 \u044f \u043d\u0435 \u0443\u0432\u0438\u0434\u0435\u043b \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u0440\u0435\u0431\u0430\u043b\u0430\u043d\u0441\u0430\u003Cbr\u003E\n\u0410 \u043d\u0443 \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u0441\u0442\u043e\u0438\u0442 \u043b\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043e \u0442\u043e\u043c \u0447\u0442\u043e \u044d\u0442\u043e\u0442 \u0435\u0431\u0430\u043d\u044b\u0439 \u0438\u0432\u0435\u043d\u0442 \u0443\u0436\u0435 \u0432 3 \u0440\u0430\u0437 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u043d\u0430\u0448\u0435\u0439 \u0438\u0433\u0440\u0435 \u0441 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u043c\u0438? \u041b\u0438\u0447\u043d\u043e \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u044d\u0442\u043e\u0442 \u0438\u04