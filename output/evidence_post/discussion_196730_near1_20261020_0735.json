0 \u0447\u0435 \u0442\u0430\u043c \u043f\u043e \u043d\u0430\u0433\u0440\u0430\u0434\u043d\u043e\u043c\u0443 \u0443\u0437\u0438\u043a\u0443? \u0414\u0430\u0434\u0430, \u044d\u0442\u043e \u0442\u043e\u0442 \u0441\u0430\u043c\u044b\u0439 \u0433\u0430\u043d, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0432\u044b \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u0438 \u043d\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043b\u0438. \u0410 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0435\u0441\u0442\u044c \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435:\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0443\u043b\u0435\u0432\u043e\u0439 \u043a\u043e\u043c\u0444\u043e\u0440\u0442. \u041e\u0442\u0434\u0430\u0447\u0430 \u0442\u044f\u043d\u0435\u0442 \u0442\u0435\u0431\u044f \u043a \u043d\u0435\u0431\u0443 \u0434\u0430\u0436\u0435 \u0441\u0442\u0440\u0435\u043b\u044f\u044f \u043e\u0442 \u0431\u0435\u0434\u0440\u0430. \u0417\u0430\u0442\u0440\u0435\u043a\u0430\u0442\u044c \u0432\u0440\u0430\u0433\u0430 \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u044b \u043e\u0431\u043e\u0439\u043c\u044b \u044d\u0442\u043e \u0443\u0436\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f. \u041c\u043e\u0436\u043d\u043e \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043f\u043e\u0432\u0435\u0441\u0438\u0442 \u043e\u043a\u0430\u0435\u043c \u0438 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u0447\u0443\u0442\u044c \u043b\u0443\u0447\u0448\u0435, \u043d\u043e \u0432\u044b \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e\u00bf \u043e\u043a\u0430\u0435\u043c \u043d\u0430 \u0432\u0442\u043e\u0440\u0438\u0447\u043a\u0443???\u003Cbr\u003E\n\u0414\u043e\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 0.5\u00bf\u0430 \u043a\u0442\u043e \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u043d\u0430 \u0410\u041d\u0410\u041b\u041e\u0413\u0415 \u0433\u043b\u043e\u043a\u0430 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u0435 \u0411\u041e\u041b\u042c\u0428\u0415? \u041d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e, \u0447\u0442\u043e \u0444\u043c\u0433, \u0445\u043e\u0442\u044c \u043e\u043d\u0430 \u0438 \u044225 \u0438\u043c\u0435\u0435\u0442 \u0432\u0437\u0430\u043c\u0435\u043d \u043f\u043b\u043e\u0445\u043e\u043c\u0443 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0443 \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0430\u043d\u0438\u044e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0432\u0435\u0448\u0430\u0442\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0438\u0446\u0435\u043b \u0438 \u0437\u0434\u0440\u0430\u0432\u044b\u0435 \u0431\u043e\u0435\u0432\u044b\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438, \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u044b\u0435 \u043e\u0431\u044b\u0447\u043d\u044b\u043c \u043f\u043f\u0448\u043a\u0430\u043c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0414\u041f\u0421 \u0438 \u0442\u0442\u043a. \u0414\u0435\u043c\u0435\u0439\u0434\u0436 \u043f\u0435\u0440 \u0441\u0435\u043a\u043e\u043d\u0434 \u0440\u0430\u0432\u0435\u043d \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0433\u043b\u043e\u043a\u0443 \u043f\u043e \u043c\u043e\u0438\u043c \u043f\u043e\u0434\u0441\u0447\u0435\u0442\u0430\u043c. \u003Cbr\u003E\n\u041d\u0430 \u0441\u0447\u0451\u0442 \u0442\u0442\u043a \u0445\u0437, \u043d\u0435 \u0448\u0430\u0440\u044e \u043a\u0430\u043a \u0435\u0433\u043e \u0441\u0447\u0438\u0442\u0430\u0442\u044c, \u043c\u043e\u0436\u0435\u0442 \u0445\u043e\u0442\u044f \u0431\u044b \u0442\u0443\u0442 \u0443\u0437\u0438\u043a \u0432\u044b\u0438\u0433\u0440\u0430\u0435\u0442, \u0432 \u0447\u0435\u043c \u044f \u0441\u043e\u043c\u043d\u0435\u0432\u0430\u044e\u0441\u044c \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043f\u043e\u0434\u0441\u043a\u0430\u0436\u0438\u0442\u0435. (\u0423\u0440\u043e\u043d 36.75 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0440\u0435\u043b 1100)\u003C\/p\u003E\n\n\u003Cp\u003E\u041c\u043e\u0436\u043d\u043e, \u0430 \u0437\u0430\u0447\u0435\u043c? \u0423\u0436\u0435 3 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u0440\u043e\u0448\u043b\u043e \u0441 \u0440\u0430\u0437\u0434\u0430\u0447\u0438 \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0442\u0432\u043e\u0440\u0435\u043d\u0438\u044f, \u0430 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043f\u043e\u043a\u0440\u0430\u0441\u0438\u0442\u044c \u0435\u0433\u043e \u0442\u0430\u043a \u0438 \u043d\u0435\u043b\u044c\u0437\u044f. \u0412\u044b \u043f\u0440\u0438\u043a\u0438\u043d\u044c\u0442\u0435, \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u043e\u043a\u0440\u0430\u0441\u0438\u0442\u044c \u043f\u0443\u0448\u043a\u0443, \u0432\u043e\u0442 \u043d\u0438\u043a\u0430\u043a \u043d\u0435\u043b\u044c\u0437\u044f. \u041b\u0430\u0434\u043d\u043e \u0431\u0440\u0435\u043b\u043a\u0438 \u043f\u043e \u0433\u043e\u0434\u0443 \u043d\u0430 \u043f\u0443\u0448\u043a\u0438 \u043d\u0435 \u0432\u0435\u0448\u0430\u044e\u0442\u0441\u044f, \u043d\u043e \u0447\u0442\u043e\u0431\u044b \u043a\u0440\u0430\u0441\u043a\u0430\u2026.\u003C\/p\u003E\n\n\u003Cp\u003E\u0410 \u043c\u043e\u0436\u043d\u043e \u0445\u043e\u0442\u044c \u0447\u0442\u043e \u0442\u043e \u0435\u043c\u0443 \u0434\u0430\u0442\u044c? \u0425\u043e\u0447\u0435\u0442\u0441\u044f \u0441 \u043f\u0443\u0448\u043a\u043e\u0439 \u043f\u043e\u0431\u0435\u0433\u0430\u0442\u044c, \u043d\u043e \u043f\u043e\u043a\u0430 \u044d\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0435 \u043d\u0435\u0440\u0432\u043e\u0432, \u043d\u0435\u0436\u0435\u043b\u0438 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cspan class=\