0\u043d\u0434\u043e\u043c\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u043b\u0451\u0442\u0430, \u043b\u0438\u0431\u043e \u043f\u043e\u043f\u0430\u0434\u0430\u043d\u0438\u044f \u043d\u0435 \u043f\u043e \u0431\u0440\u043e\u043d\u0438\u043a\u0443 \u0438\u043b\u0438 \u0436\u0435 \u043a\u0435\u043c\u043f\u0435\u0440\u0430. \u041f\u0435\u0440\u0435\u0431\u043e\u0440 \u0441 \u043b\u0443\u0434\u043a\u043e\u0439. \u0422\u0430\u043a \u0436\u0435 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u0439, \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u0438 \u0438 \u0433\u043e\u043b\u043e\u0434\u0430 \u043f\u043e\u0434\u0434\u0443\u0448\u0438\u0432\u0430\u0435\u0442. \u041d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e. \u0421\u043e\u0438\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e, \u0438\u043d\u0430\u0447\u0435 \u0441\u0432\u043e\u0438 \u0436\u0435 \u043f\u043e\u0434\u0447\u0438\u043d\u0435\u043d\u043d\u044b\u0435 \u0437\u0430\u0433\u0430\u0441\u044f\u0442, \u0430 \u0435\u0441\u043b\u0438 \u043f\u043e\u0442\u0435\u0440\u044f\u0435\u0448\u044c \u043a\u043e\u0433\u043e-\u0442\u043e \u0438\u0437 \u043e\u0442\u0440\u044f\u0434\u0430, \u0442\u043e \u0441 \u0438\u0445 \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f\u043c\u0438 \u043f\u0440\u0438\u0434\u0435\u0442\u0441\u044f \u0434\u0435\u043b\u0430 \u0438\u043c\u0435\u0442\u044c. \u041f\u043b\u044e\u0441 \u043b\u044e\u0434\u0435\u0439 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0445 \u0436\u0430\u043b\u043a\u043e. \u0410, \u0435\u0449\u0451 \u0434\u0440\u043e\u043d\u043e\u0432\u043e\u0434\u043e\u0432 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043c\u043d\u043e\u0433\u043e, \u0447\u0442\u043e \u0437\u0430\u0435\u0431\u044b\u0432\u0430\u0435\u0442, \u0441\u043f\u0430\u0432\u043d\u044f\u0442\u0441\u044f \u0434\u0440\u043e\u043d\u044b \