0022 class=\u0022PostMention\u0022 data-id=\u00224743689\u0022\u003EAnistorm\u003C\/a\u003E \u0427\u0435\u0433\u043e \u0434\u0443\u043c\u0430\u0435\u0442\u0435?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0422\u044b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u0438\u0434\u0435\u044e - \u044d\u0442\u043e \u043a\u0440\u0443\u0442\u043e, \u044d\u0442\u043e \u043f\u043e\u0445\u0432\u0430\u043b\u044c\u043d\u043e. \u041a\u0430\u043a \u0438\u0434\u0435\u044f \u0432 \u043a\u0430\u043a\u043e\u043c-\u043d\u0438\u0431\u0443\u0434\u044c \u043f\u0441\u0435\u0432\u0434\u043e\u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u043e\u043c \u043c\u043e\u0434\u0435 \u043d\u0430 \u0430\u043d\u043e\u043c\u0430\u043b\u0438 \u0438\u043b\u0438 \u0442\u0430\u0440\u043a\u043e\u0432\u0435(\u0442\u0430\u043c \u0438 \u0442\u0430\u043a \u0432\u0440\u043e\u0434\u0435 \u0442\u0435\u0431\u044f \u0445\u0443\u044f\u0447\u0438\u0442) \u043e\u043d\u043e \u0437\u0430\u0439\u0434\u0435\u0442. \u0417\u0430\u0447\u0435\u043c \u044d\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0432 \u0421\u041a?\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197477-novoe-dlya-balansa\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224743689\u0022\u003EAnistorm\u003C\/a\u003E \u0412\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u0435 \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043b\u043e\u043a \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u0441\u044f\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041c\u043d\u0435 \u044d\u0442\u043e\u0433\u043e \u0432\u043e\u0441\u043f\u0440\u0438\u044f\u0442\u0438\u044f \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u044f \u0435\u0431\u0443. \u042d\u0442\u043e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043d\u044b\u0439 \u043f\u0441\u0435\u0432\u0434\u043e\u0430\u0440\u043a\u0430\u0434\u043d\u044b\u0439 \u0448\u0443\u0442\u0435\u0440, \u0433\u0434\u0435 \u043c\u044b \u043f\u043e \u043a\u0443\u0431\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0433\u043e\u043b\u043e\u0432\u0430\u043c \u0441\u0442\u0440\u0435\u043b\u044f\u0435\u043c \u0438 \u0431\u0435\u0433\u0430\u0435\u043c \u043f\u043e\u0434 150 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438, \u0443\u0436\u0435 \u0437\u0430\u0435\u0431\u0430\u043b\u043e, \u0447\u0442\u043e \u043e\u0441\u043d\u043e\u0432\u043d\u0443\u044e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443(\u0441\u0442\u0440\u0435\u043b\u044c\u0431\u0443) \u043f\u043e\u0440\u0442\u044f\u0442 \u0432\u0441\u044f\u043a\u043e\u0439 \u0445\u0443\u0439\u043d\u0435\u0439. \u0422\u043e \u043d\u0430\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u0435, \u0442\u043e \u043f\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u044b, \u0442\u043e \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0430, \u0442\u043e \u043a\u043e\u043c\u0443-\u0442\u043e \u043d\u0435 \u043d\u0440\u0430\u0432\u0438\u0442\u0441\u044f, \u0447\u0442\u043e \u043e\u0440\u0443\u0436\u0438\u0435 \u043d\u0435 \u0442\u0440\u044f\u0441\u0435\u0442 \u043a\u0430\u043a \u043f\u0435\u0440\u0444\u043e\u0440\u0430\u0442\u043e\u0440 \u0432 \u0440\u0443\u043a\u0430\u0445, \u0442\u043e \u0440\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u044b \u043d\u0435\u0440\u0444\u044f\u0442 \u0432 \u0443\u0433\u043e\u0434\u0443 \u0432\u044b\u0434\u0443\u043c\u0430\u043d\u043d\u043e\u0439 \u0445\u0443\u0439\u043d\u0435 \u0432 \u0433\u043e\u043b\u043e\u0432\u0435, \u0442\u043e \u0441\u0442\u0430\u0431\u0443 \u0440\u0435\u0436\u0443\u0442\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197477-novoe-dlya-balansa\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224743689\u0022\u003EAnistorm\u003C\/a\u003E \u0438\u043c\u043f\u0430\u043a\u0442 \u043f\u0443\u0448\u0435\u043a \u0441\u0442\u0430\u043d\u0435\u0442 \u0431\u043e\u043b\u0435\u0435 \u043e\u0449\u0443\u0442\u0438\u043c\u044b\u043c\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u201c\u0418\u043c\u043f\u0430\u043a\u0442 \u043f\u0443\u0448\u0435\u043a\u201d, \u043f\u043e \u043c\u043e\u0435\u043c\u0443 \u0441\u043a\u0440\u043e\u043c\u043d\u043e\u043c\u0443 \u043c\u043d\u0435\u043d\u0438\u044e 1\u043a\u0434 \u0434\u043e\u0445\u043e\u0434\u044f\u0433\u0438, \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u0442\u0440\u043e\u0438\u0442\u044c\u0441\u044f \u043d\u0435 \u043d\u0430 \u0435\u0431\u0430\u043d\u043e\u0439 \u0442\u0440\u044f\u0441\u043a\u0435 \u044d\u043a\u0440\u0430\u043d\u0430 \u0438 \u043c\u043e\u0434\u0435\u043b\u044c\u043a\u0438 \u0432 \u0440\u0443\u043a\u0430\u0445, \u043d\u0435 \u043d\u0430 \u0435\u0431\u0430\u043d\u043e\u043c \u0443\u0432\u043e\u0434\u0435 \u0441\u0442\u0432\u043e\u043b\u0430 \u0432 \u0441\u0442\u0440\u0430\u0442\u043e\u0441\u0444\u0435\u0440\u0443(\u0443\u0442\u0440\u0438\u0440\u0443\u044e), \u0430 \u0432 \u0442\u043e\u043c \u043a\u0430\u043a \u0443\u0434\u043e\u0431\u043d\u043e \u0441 \u043d\u0438\u043c\u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0438 \u043a\u0430\u043a \u0445\u043e\u0440\u043e\u0448\u043e \u043e\u043d\u0438 \u0443\u0431\u0438\u0432\u0430\u044e\u0442\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197477-novoe-dlya-balansa\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224743689\u0022\u003EAnistorm\u003C\/a\u003E \u041c\u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0447\u0435\u0442\u0441\u044f, \u0447\u0442\u043e\u0431\u044b \u0438\u0433\u0440\u0430 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043b\u0430\u0441\u044c\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0422\u0430\u043a \u044d\u0442\u043e \u043d\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435, \u044d\u0442\u043e \u201c\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0440\u0430\u0434\u043