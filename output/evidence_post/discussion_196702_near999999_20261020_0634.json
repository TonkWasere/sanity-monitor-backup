2 \u0442\u0435\u0431\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a \u0421\u041a, \u0447\u0442\u043e \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0431\u0440\u0435\u0434\u043e\u043c \u0435\u0431\u0430\u043d\u044b\u043c. \u0427\u0442\u043e \u0437\u0430 \u0445\u0443\u0439\u043d\u044f? \u0415\u0441\u043b\u0438 \u0432\u044b \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0442\u0435 \u0438\u0433\u0440\u0443 \u043f\u043e\u0434 \u043f\u0430\u0447\u043a\u0438, \u043d\u0443 \u0435\u043f\u0442\u0430 - \u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0430\u0432\u0442\u043e\u043f\u043e\u0434\u043e\u0431\u043e\u0440 \u043b\u044e\u0434\u0435\u0439 \u043f\u043e \u0432\u044b\u0445\u043e\u0434\u0443 \u0438\u0437 \u0431\u0430\u0437\u044b. \u0427\u0435 \u0437\u0430 \u043f\u0440\u0438\u043a\u043e\u043b, \u0434\u0435\u043b\u0430\u0442\u044c \u0438\u0433\u0440\u0443 \u043f\u043e\u0434 \u043f\u0430\u0447\u043a\u0438, \u043f\u0438\u0445\u0430\u0442\u044c \u0432\u0435\u0437\u0434\u0435 \u0441\u043e\u0446\u0438\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e, \u043d\u043e \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u043e\u043b\u043e \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439?  \u0422\u0438\u043f\u0430, \u0442\u0435\u0440\u043f\u0438\u0442\u0435-\u0441\u043e\u0441\u0438\u0442\u0435?  \u0427\u0442\u043e \u0437\u0430 \u043f\u0440\u0438\u043d\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0442\u043e? \u041c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0449\u0435 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u043e\u043c \u0442\u0435\u0431\u0435 \u043b\u044e\u0434\u0435\u0439 \u0432 \u043f\u0430\u0447\u043a\u0443 \u0437\u0430\u043a\u0438\u0434\u044b\u0432\u0430\u0442\u044c? \u0418 \u043d\u0438\u043a\u043e\u0433\u043e \u043d\u0435 \u043d\u0430\u0434\u043e \u043f\u0440\u0438\u043d\u0443\u0443\u0436\u0434\u0430\u0442\u044c \u043d\u0438 \u043a \u0447\u