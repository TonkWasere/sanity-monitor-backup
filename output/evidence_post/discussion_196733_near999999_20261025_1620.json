c\u043e\u0437\u0433\u0430\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196733-drobovik-derya-mk-12\/50\u0022 class=\u0022PostMention\u0022 data-id=\u00224722725\u0022\u003E\u0410\u0441\u0442\u0440\u043e\u043b\u044f\u0431\u0443\u0441\u003C\/a\u003E \u042f \u043f\u043e\u043d\u044f\u043b \u0447\u0442\u043e \u0443\u0440\u043e\u043d \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u0443 \u0442\u0435\u0431\u044f \u043d\u0435\u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0441\u043c\u043e\u0442\u0435\u0440\u0442\u044c \u043d\u0430 \u043b\u044e\u0431\u044b\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u0442\u0430\u0442\u044b, \u043d\u0443, \u043b\u0430\u0434\u043d\u043e, \u0441\u0434\u0435\u043b\u0430\u0439 \u043a\u0441-23, \u0442\u0430\u043c \u0443\u0440\u043e\u043d\u0430 \u0435\u0449\u0435 \u0431\u043e\u043b\u044c\u0448\u0435, \u043a\u0430\u0431\u0430\u043d\u043e\u0432 \u0442\u043e\u0436\u0435 \u0431\u0443\u0434\u0435\u0442 \u0448\u043e\u0442\u0438\u0442\u044c, \u0430 \u0442\u043e \u0447\u0442\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0440\u0435\u043b\u0430 \u043c\u0430\u043b\u043e \u044d\u0442\u043e \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e, \u0432\u0435\u0434\u044c \u0443\u0440\u043e\u043d\u0430 \u0442\u043e \u043c\u043d\u043e\u0433\u043e, \u0432\u043e\u0442 \u043e\u043d \u0443\u0436 \u0442\u043e\u0447\u043d\u043e \u0437\u0430 2 \u043f\u043e\u043b\u043e\u0436\u0438\u0442 \u0442\u0438\u043f\u0430.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u042f \u043f\u0438\u0441\u0430\u043b \u043f\u0440\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0438 \u043d\u0430\u0434\u0451\u0436\u043d\u043e\u0441\u0442\u044c, \u0443 \u0441\u043f\u0430\u0441\u0430 \u044d\u0442\u043e\u0433\u043e \u043d\u0438\u0445\u0443\u044f \u043d\u0435\u0442\u0443, \u043d\u0435 \u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0435\u0