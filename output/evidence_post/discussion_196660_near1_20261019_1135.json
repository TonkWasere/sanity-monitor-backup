043d\u0435 \u0441\u0443\u0442\u044c, \u0442\u0430\u043a \u0432\u043e\u0442, \u0442\u0430\u043c \u044f \u043d\u0430\u0442\u043a\u043d\u0443\u043b\u0441\u044f \u043d\u0430 \u0441\u0442\u0430\u0442\u044c\u044e \u043f\u0440\u043e \u043e\u0440\u0443\u0436\u0438\u0435 \u201c\u003Cstrong\u003E\u0422\u0435\u0441\u043b\u0430\u003C\/strong\u003E\u201d. \u0421\u0442\u0430\u0442\u044c\u044f, \u043a \u0441\u043b\u043e\u0432\u0443, \u0434\u0430\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f 2018 \u0433\u043e\u0434\u043e\u043c. \u0415\u0451 \u0430\u0432\u0442\u043e\u0440 \u0443\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0443\u0448\u0451\u043b \u0441 \u0432\u0438\u043a\u0438, \u0430 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432 \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b.\u003C\/p\u003E \n\n\u003Cp\u003E\u041d\u0435\u0434\u0430\u0432\u043d\u043e, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430\u0434 \u044d\u0442\u043e\u0439 \u0432\u0438\u043a\u0438, \u044f \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u043b \u043e \u0442\u0435\u0441\u043b\u0435 \u0438 \u043c\u043d\u0435 \u041e\u0427\u0415\u041d\u042c \u043d\u0443\u0436\u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c \u043e\u043b\u0434\u043e\u0432 \u0438 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0437\u043d\u0430\u044e\u0449\u0438\u0445 \u0445\u043e\u0442\u044f \u0431\u044b \u0447\u0442\u043e-\u0442\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421\u0430\u043c\u043e \u043e\u0440\u0443\u0436\u0438\u0435 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043a\u0430\u043a \u041f\u041f P-90. \u0424\u043e\u0442\u043e \u043d\u0438\u0436\u0435. \u0421\u043a\u0440\u0438\u043d \u0441\u0442\u0430\u0442\u044c\u0438 \u0442\u043e\u0436\u0435. \u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-18\/179233