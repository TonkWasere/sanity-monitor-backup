\u043e 1.5\u043a\u043a \u0432 \u0447\u0430\u0441 \u043d\u0430 \u043a\u0443\u0437\u043d\u0435, \u043d\u0443 \u0438\u043b\u0438 \u0447\u0443\u0442\u044c \u043c\u0435\u043d\u044c\u0448\u0435, \u043a\u0430\u043a \u043f\u043e\u0432\u0435\u0437\u0451\u0442. \u041f\u043e\u0447\u0435\u043c\u0443 \u044f \u0437\u0430 10 \u043c\u0438\u043d\u0443\u0442 \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0439 \u0432\u044b\u043b\u0430\u0437\u043a\u0438 \u043d\u0430 \u043a\u0443\u0437\u043d\u044e \u043f\u043e\u043b\u0443\u0447\u0430\u044e 300 \u0442\u044b\u0441\u044f\u0447, \u0430 \u0437\u0430 \u0447\u0430\u0441 \u0438\u0432\u0435\u043d\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0435\u0449\u0451 \u0438 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u0447\u0442\u0438 \u043f\u043e\u043b\u0433\u043e\u0434\u0430 \u044f \u043f\u043e\u043b\u0443\u0447\u0430\u044e \u043f\u043b\u0435\u0432\u043e\u043a \u0432 \u043b\u0438\u0446\u043e? \u0421\u0430\u043c \u0438\u0432\u0435\u043d\u0442 - \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043c\u0430. \u042f \u043f\u043e\u0438\u0433\u0440\u0430\u043b \u0432\u0441\u0435\u0433\u043e 10 \u0438\u0433\u0440 \u0438 \u043c\u043d\u0435 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435 \u0445\u043e\u0447\u0435\u0442\u0441\u044f \u0432 \u043d\u0435\u0433\u043e \u0437\u0430\u0445\u043e\u0434\u0438\u0442\u044c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0441\u043c\u044b\u0441\u043b\u0430 \u0438\u0433\u0440\u0430\u0442\u044c \u0431\u0435\u0437 \u0434\u0435\u043d\u0435\u0433, \u043b\u0438\u0431\u043e \u043c\u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u0441\u0430\u043c \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439, \u0430 \u043c\u043e\u0436\u0435\u0442 \u0432\u0441\u0451 \u0432\u043c\u0435\u0441\u0442\u0435. \u0412\u043e\u0442 \u043f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435, \u043b\u044e\u0434\u0438. \u0427\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u043e\u0442 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0432 \u0438\u0433\u0440\u0435 \u0431\u0443\u0434\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u0435\u043d\u0435\u0433? \u0412\u044b\u0440\u0430\u0441\u0442\u0443\u0442 \u0446\u0435\u043d\u044b. \u041f\u043b\u043e\u0445\u043e \u043b\u0438 \u044d\u0442\u043e? \u041e\u0442 \u0447\u0430\u0441\u0442\u0438 \u0434\u0430, \u043d\u0443\u0436\u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0433\u0440\u0438\u043d\u0434\u0438\u0442\u044c, \u043d\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u043b\u0438, \u0447\u0442\u043e \u043f\u043e\u043b\u043d\u044b\u0439 \u043d\u043e\u0432\u0438\u0447\u043e\u043a \u0437\u0430\u0445\u043e\u0434\u044f\u0449\u0438\u0439 \u0432 \u0438\u0433\u0440\u0443 \u0437\u0430 100 \u0447\u0430\u0441\u043e\u0432 \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442 \u043c\u0430\u0441\u0442\u0435\u0440\u043a\u0443 +15 \u0438 \u0441\u0431\u043e\u0440\u043a\u0443 \u0437\u0430 30 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432 \u0438 \u0432\u0441\u0451, \u0438\u0433\u0440\u0430 \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u0430\u2026 \u0423 \u043d\u0430\u0441 \u043d\u0430 \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u0435 \u0431\u0440\u043e\u043d\u044f \u043f\u043e 10 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u043e\u0432, \u043f\u0440\u0438\u0447\u0451\u043c \u0442\u0430\u043a\u0430\u044f, \u0447\u0442\u043e \u043f\u043e\u043a\u0430 \u043d\u0435\u0442 \u0448\u0442\u0443\u0440\u043c\u044b \u043c\u043e\u0436\u043d\u043e \u0431\u0435\u0433\u0430\u0442\u044c \u0432 \u043d\u0435\u0439, \u0442\u043e \u0435\u0441\u0442\u044c \u043d\u0430 9-12 \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0438\u0433\u0440\u044b \u0435\u0451 \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u041d\u0443 \u0445\u043e\u0440\u043e\u0448\u043e, \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 \u0440\u0435\u0448\u0438\u043b\u0438, \u0447\u0442\u043e \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0430\u043b\u044e\u0442\u0443 \u0438\u0432\u0435\u043d\u0442\u043e\u0432 \u043f\u043b\u043e\u0445\u0430\u044f \u0438\u0434\u0435\u044f, \u043d\u043e \u0432\u0435\u0434\u044c \u0432 \u0438\u0432\u0435\u043d\u0442\u0430\u0445 \u0443\u0436\u0435 \u0431\u044b\u043b\u0438 \u044f\u0449\u0438\u043a\u0438!!! \u041f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0435!!! \u041e\u043d\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u043c\u0435\u043b\u0438 \u0441\u0432\u043e\u044e \u0446\u0435\u043d\u0443, \u043a\u0442\u043e \u0445\u043e\u0442\u0435\u043b - \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u043b, \u043a\u0442\u043e \u0445\u043e\u0442\u0435\u043b - \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u043b \u0438 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043e\u043a \u0431\u044b\u043b \u0438 \u043a\u0435\u0439\u0441\u044b \u0431\u044b\u043b\u0438 \u0438 \u0432\u0430\u043b\u044e\u0442\u044b \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u043e\u0441\u044c \u043d\u0435 \u0442\u0430\u043a \u043c\u043d\u043e\u0433\u043e\u2026 \u041d\u043e \u0441\u0435\u0439\u0447\u0430\u0441 \u043c\u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0441\u0440\u0430\u043b\u0438 \u0432 \u0440\u043e\u0442 \u0438 \u0441\u043a\u0430\u0437\u0430\u043b\u0438, \u0447\u0442\u043e \u0438\u0432\u0435\u043d\u0442 \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0443\u0442\u043e\u0439 \u0431\u0443\u0434\u0435\u0442, \u043d\u0435 \u0431\u044b\u043b\u043e \u0435\u0433\u043e \u043f\u043e\u043b\u0433\u043e\u0434\u0430, \u0442\u0440\u0435\u0439\u043b\u0435\u0440\u044b, \u0431\u0435\u0442\u0430 \u0442\u0435\u0441\u0442\u044b, \u043e\u0442\u0441\u2026 \u0418 \u043f\u043e\u0441\u043b\u0435 \u0432\u0441\u0435\u0433\u043e \u044d\u0442\u043e\u0433\u043e \u044f \u0437\u0430\u0445\u043e\u0436\u0443 \u0432 \u0438\u0433\u0440\u0443 \u0438 \u0443 \u043c\u0435\u043d\u044f \u043d\u0430 \u0432\u043e\u043b\u043d\u0435 \u0443\u0441\u043b\u043e\u0436\u043d\u0435\u043d\u0438\u0435, \u0441\u043f\u0430\u0432\u043d\u044f\u0442\u0441\u044f \u043f\u0440\u043e\u0442\u043e\u044d\u043b\u0435\u043a\u0442\u0440\u044b, \u0430 \u043e\u043d\u0438 \u0441\u043f\u0430\u0432\u043d\u044f\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0446\u0435\u043d\u0442\u0440\u0435, \u0443 \u0441\u0430\u043c\u043e\u0433\u043e \u043e\u0431\u0435\u0440\u0435\u0433\u0430\u2026 \u0412\u0438\u0434\u043d\u043e, \u0447\u0442\u043e \u0434\u0430\u0436\u0435 \u043d\u0430 \u044d\u0442\u043e\u0442 \u0438\u0432\u0435\u043d\u0442 \u043f\u043e\u043b\u043e\u0436\u0438\u043b\u0438 \u043a\u043e\u0440\u043e\u0431\u043a\u0443 \u0431\u043e\u043b\u0442\u043e\u0432, \u043f\u043e \u043e\u0434\u043d\u043e\u043c\u0443 \u043e\u0442 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0430. \u0418 \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u044f \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u044e \u0441\u043b\u043e\u0432\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0432: \u201c\u0427\u0442\u043e \u0434\u0430\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0430\u043c, \u0443 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0432\u0441\u0451 \u0435\u0441\u0442\u044c? \u041a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0443!\u201d \u042d\u0442\u043e \u043f\u043e\u043b\u043d\u044b\u0439 \u043f\u043e\u0437\u043e\u0440. \u0422\u0430\u043a\u0430\u0430\u0430\u0430\u044f \u043a\u0440\u0443\u0442\u0430\u044f \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0430, \u043d\u0430 \u043a\u0437 \u0431\u043b\u044f\u0442\u044c 4, \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0437\u043e\u0440\u043d\u044b\u0439, \u0445\u0443\u0434\u0448\u0438\u0439 \u0431\u0440\u043e\u043d\u0438\u043a \u0432 \u0438\u0433\u0440\u0435. \u0423 \u0432\u0430\u0441 \u0442\u0438\u043f\u0430 \u0432\u0441\u0451 \u0435\u0441\u0442\u044c! \u041d\u0443 \u0442\u0430\u043a \u0438 \u0448\u0442\u0443\u0440\u043c\u0430 \u0435\u0441\u0442\u044c. \u0418\u043b\u0438 \u0437\u0438\u0432\u043a\u0430. \u041d\u0430\u043c \u043e\u0431\u043b\u0438\u043a \u043d\u0430 \u043a\u0437-4 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u043d\u0443\u0436\u0435\u043d, \u044d\u0442\u043e \u0434\u043b\u044f \u043d\u043e\u0432\u0438\u0447\u043a\u043e\u0432. qbu? \u0412\u0440\u043e\u0434\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u0442\u043e, \u0447\u0442\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0432 \u0438\u0433\u0440\u0435? \u0418 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u0432\u044b \u0432\u0438\u0434\u0435\u043b\u0438 qbu \u0432 \u043e\u043f\u0435\u043d\u0435? \u042f \u043d\u0438 \u0440\u0430\u0437\u0443 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u043c\u0435\u0441\u044f\u0446\u2026 \u0422\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u043e\u043a \u0431\u043e\u043b\u0435\u0435 \u043c\u0435\u043d\u0435\u0435 \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u0439, \u043d\u043e \u0434\u0430\u0436\u0435 \u0442\u0430\u043a \u0443 \u043d\u0430\u0441 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0432\u044b\u0431\u043e\u0440 \u0432\u0442\u043e\u0440\u0438\u0447\u0435\u043a \u0432 \u0438\u0433\u0440\u0435 \u0438 \u043e\u0431\u043b\u0438\u043a \u043d\u0430 \u0433\u043b\u043e\u043a \u0431\u044b\u043b \u0431\u044b \u043b\u043e\u0433\u0438\u0447\u0435\u043d \u0437\u0438\u043c\u043e\u0439, \u043a\u0430\u043a \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u043b\u0438 \u0432 \u043f\u0440\u043e\u0448\u043b\u044b\u0439 \u0440\u0430\u0437 \u0441 \u0442\u043e\u0447\u043a\u043e\u0439 \u043d\u0443\u043b\u044f. \u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u043e\u0440\u0443\u0436\u0438\u0435 \u0432 \u0431\u043f \u0438\u043b\u0438 \u043a\u0435\u0439\u0441\u0430\u0445 - \u0434\u0435\u043b\u0430\u0435\u0442\u0435 \u043e\u0431\u043b\u0438\u043a, \u043d\u0443 \u0438 \u043f\u0440\u043e \u0431\u0430\u0440\u0442\u0435\u0440 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0442\u0435.\u003C\/p\u003E \n\n\u003Cp\u003E\u0412 \u043e\u0431\u0449\u0435\u043c \u043a\u0430\u043a \u0438\u0433\u0440\u043e\u043a, \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u0441\u0451 \u0435\u0441\u0442\u044c \u044f \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0432\u0438\u0436\u0443 \u0441\u043c\u044b\u0441\u043b\u0430 \u0432 \u044d\u0442\u043e\u0439 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0435. \u041c\u0430\u043b\u043e \u0442\u043e\u0433\u043e, \u043e\u043d\u0438 \u0435\u0449\u0451 \u0438 \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-29\/1793278600-326514-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u00223e8ec5ca-9257-4f67-90e4-70865204f825\u0022 loading=\u0022lazy\u0022 width=\u0022887\u0022 height=\u0022220\u0022\u003E\u003Cbr\u003E\n\u0412\u041e\u0422 \u042d\u0422\u041e \u041f\u041e\u0417\u041e\u0420\u0418\u0429\u0415. \u041f\u043e\u0438\u0433\u0440\u0430\u0439 \u0432 \u0438\u0432\u0435\u043d\u0442 \u0447\u0430\u0441\u043e\u0432 10 \u0438 \u043a\u0443\u043f\u0438 \u0441\u0435\u0431\u0435 \u043f\u0443\u0433\u0430\u043b\u043e \u0432 \u0443\u0431\u0435\u0436\u0438\u0449\u0435, \u0440\u0430\u0437\u0440\u0430\u0431\u044b \u0441\u043e\u0432\u0441\u0435\u043c \u0438\u0434\u0438\u043e\u0442\u044b? \u0423 \u043d\u0438\u0445 \u0436\u0435 \u0435\u0441\u0442\u044c \u043c\u0435\u0442\u0440\u0438\u043a\u0438, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043e\u043d\u0438 \u0432\u0438\u0434\u044f\u0442, \u0447\u0442\u043e \u044d\u0442\u043e\u0442 \u0445\u043b\u0430\u043c \u0432 \u0443\u0431\u0435\u0436\u043a\u0443 \u0434\u0430\u0436\u0435 \u0437\u0430 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u043d\u0435 \u043d\u0443\u0436\u0435\u043d, \u0432\u0441\u0435\u0433\u0434\u0430, \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u043b\u0438 \u043e\u043d \u0431\u044b\u043b \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u044b\u043c, \u0448\u0440\u0430\u043c\u044b \u0432\u043e\u0439\u043d\u044b - \u043c\u0443\u0441\u043e\u0440 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u043e\u0431\u043b\u0438\u043a\u043e\u0432 \u0434\u043b\u044f \u0443\u0431\u0435\u0436\u0438\u0449\u0430 \u0432 \u0438\u0433\u0440\u0443 \u043d\u0435 \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u044e\u0442 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c, \u043d\u043e \u0432\u0441\u044f\u043a\u0438\u0439 \u0445\u043b\u0430\u043c \u0432\u0440\u043e\u0434\u0435 \u0442\u0430\u043d\u0447\u0438\u043a\u043e\u0432, \u043f\u0443\u0433\u043e\u043b, \u0440\u0430\u043a\u0435\u0442 - \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430. \u0412\u044b \u0436\u0435 \u043d\u0435 \u0437\u0430\u0431\u044b\u043b\u0438, \u043a\u0430\u043a \u043f\u043e\u0441\u043b\u0435 \u043f\u0430\u0442\u0447\u043d\u043e\u0443\u0442\u0430 \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 \u041f\u0415\u0427\u0410\u0422\u041d\u0423\u042e \u041c\u0410\u0428\u0418\u041d\u041a\u0423 \u0443 \u043d\u0430\u0441 \u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044e \u0438\u043b\u0438 \u043d\u0430 \u0434\u0432\u0435 \u0441\u043b\u043e\u043c\u0430\u043b\u0430\u0441\u044c \u043f\u043e\u0447\u0442\u0430, \u0434\u0430 \u0438 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u0433\u0440\u0430 \u0432 \u0446\u0435\u043b\u043e\u043c? \u0418 \u044d\u0442\u043e \u0431\u044b\u043b \u043f\u0435\u0440\u0432\u044b\u0439 \u043f\u0430\u0442\u0447 \u043f\u043e\u0441\u043b\u0435 \u043f\u0438\u0441\u044c\u043c\u0430 \u0437\u0438\u0432\u0430\u2026\u003C\/p\u003E \n\n\u003Cp\u003E\u041d\u0435\u0443\u0436\u0435\u043b\u0438 \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u043b\u0430\u0442\u0438\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0430\u043c \u0437\u0430 \u0438\u0445 \u0432\u0440\u0435\u043c\u044f \u0434\u043e\u0441\u0442\u043e\u0439\u043d\u043e? \u0424\u0430\u0440\u043c 1 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430 \u0432 \u0447\u0430\u0441 \u0441\u0435\u0439\u0447\u0430\u0441 \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u0430\u0437\u043e\u0432\u044b\u0439 \u043c\u0438\u043d\u0438\u043c\u0443\u043c, \u0435\u0441\u043b\u0438 \u0444\u0430\u0440\u043c\u0438\u0442\u0435 \u043c\u0435\u043d\u044c\u0448\u0435, \u0442\u043e \u0447\u0442\u043e-\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442\u0435 \u043d\u0435 \u0442\u0430\u043a, \u0434\u0430\u0436\u0435 \u043f\u0435\u0442\u044f \u0438\u0437 7\u0431 \u0441 0,7 \u043a\u0434 \u0441 \u044d\u0442\u0438\u043c \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u0441\u044f. \u0410 \u0432\u0435\u0434\u044c \u044d\u0442\u043e \u044f \u0435\u0449\u0451 \u043d\u0435 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u043b \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430 \u0442\u043e\u043f\u2026 \u041a\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u043b nbts - \u0443 \u043d\u0430\u0441 \u0437\u0430 \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434 \u0434\u0430\u044e\u0442 \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u044f \u0437\u0430\u043d\u044f\u043b \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0442\u043e\u043f \u0432 \u0438\u0433\u0440\u0435. \u0412\u043e\u0442 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430 \u0442\u043e\u043f \u0434\u043e \u0440\u043e\u0437\u043e\u0432\u043e\u0439 \u043b\u0438\u0433\u0438 \u0432 \u0438\u0433\u0440\u0435 \u043c\u0435\u043d\u044c\u0448\u0435, \u0447\u0435\u043c \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0430\u043b\u0438 \u043a \u044d\u0442\u043e\u043c\u0443 \u0441\u043e\u0431\u044b\u0442\u0438\u044e (\u0432\u043e\u043e\u0431\u0449\u0435 \u0434\u0430\u0436\u0435 \u0437\u0430 \u043a\u0440\u0430\u0441\u043d\u0443\u044e \u043b\u0438\u0433\u0443 \u043c\u0435\u043d\u044c\u0448\u0435, \u043d\u043e \u0442\u0430\u043c \u0435\u0449\u0451 \u043f\u0440\u043e\u0448\u043b\u044b\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f, \u0442\u0430\u043a \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0435\u043c \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u043e\u0431\u043b\u0430\u0436\u043a\u0443)\u2026 \u0410 \u0432\u0435\u0434\u044c \u0435\u0449\u0451 \u0442\u043e\u043f 250, \u043d\u0443 \u0437\u043d\u0430\u0435\u0442\u0435, \u0442\u043e\u043f 250 \u0438\u0437 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 100 \u0442\u044b\u0441\u044f\u0447 \u0438\u0433\u0440\u043e\u043a\u043e\u0432. \u0418 \u043d\u0430\u0433\u0440\u0430\u0434\u0430 - \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u044b\u0439 \u043d\u043e\u0436\u0438\u0447\u0435\u043a \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0430\u043d\u0438\u043c\u043a\u0430\u043c\u0438, \u0442\u0430\u043a \u0435\u0449\u0451 \u0438 \u043e\u0445\u043e\u0442\u043d\u0438\u0447\u0438\u0439\u2026 \u0418\u043b\u0438 \u043c\u0430\u0433\u0430\u0437\u0438\u043d 5.45? \u0414\u043b\u044f \u0434\u0432\u0443\u0445 \u043f\u0443\u0448\u0435\u043a??? \u0410 \u0432\u0435\u0434\u044c \u0431\u044b\u043b\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0430, \u043a\u043e\u0433\u0434\u0430 \u043c\u043e\u0434\u0443\u043b\u0438 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b\u0438 \u0438 \u0437\u0430 \u0440\u043e\u0437\u043e\u0432\u0443\u044e \u043b\u0438\u0433\u0443\u2026 \u0410 \u0442\u0443\u0442 \u043f\u043e\u0442\u0435\u0435\u0448\u044c \u0440\u0430\u0434\u0438 \u043f\u043e\u