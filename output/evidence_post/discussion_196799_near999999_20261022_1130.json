442 4 \u0434\u043e 25 \u043a\u043a, \u043c\u043f7 \u0447\u0443\u0442\u044c \u043f\u043e\u0434\u043e\u0440\u043e\u0436\u0430\u043b \u0432\u0440\u043e\u0434\u0435 \u043a\u0430\u043a \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0435\u0433\u043e \u0432\u044b\u0432\u0435\u043b\u0438, \u043d\u043e \u043d\u0435 \u0441\u0443\u0442\u044c. \u0414\u0430\u0436\u0435 \u043e\u0440\u0443\u0436\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u044f \u201c\u0433\u043e\u0432\u043d\u0438\u0449\u0435 \u0435\u0431\u0430\u043d\u043e\u0435 \u0441 \u043a\u0443\u0447\u0435\u0439 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043e\u0432\u201d \u0412\u0421\u0415 \u0415\u0429\u0415 \u0441\u0442\u043e\u0438\u0442 4 \u043a\u043a, \u0445\u043e\u0442\u044f \u0435\u0433\u043e, \u0435\u043c\u043d\u0438\u043f, \u0432\u044b\u0432\u0435\u043b\u0438 \u0438\u0437 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043d\u0430 \u0434\u0430\u043d\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442. \u0412\u043e\u0437\u044c\u043c\u0435\u043c \u0446\u0438\u0444\u0440\u0443 \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u0432 5-6 \u043a\u043a.\u003C\/p\u003E \n\n\u003Cp\u003E\u0421\u043c\u043e\u0442\u0440\u0438\u043c \u0446\u0435\u043d\u0443 \u0447\u0430\u0441\u0442\u0438 \u043d\u0430 \u0441\u0438\u0433\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0448\u043c\u043e\u0442\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-22\/1792667337-911991-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002282d68bcb-6e7b-482d-a553-0ad4e0d3ccf1\u0022 loading=\u0022lazy\u0022 width=\u0022607\u0022 height=\u0022496\u0022\u003E\u003Cbr\u003E\n\u0443\u043c\u043d\u043e\u0436\u0430\u0435\u043c \u0435\u0435 \u043d\u0430 20 - \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c \u043d\u0438\u0449\u0438\u0435 2\u043a\u043a \u0437\u043