\u044b\u0432\u0430\u043b\u0430, \u0434\u0435\u0442\u0441\u043a\u0438\u0439 \u0441\u0430\u0434 \u043b\u0438\u0448\u044c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043b, \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0413\u0420\u0410\u0416\u0414\u0410\u041d\u0418\u041d! \u043d\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u044e\u0449\u0438\u0439 \u201c\u0445\u043e\u0440\u043e\u0448\u043e\u201d \u0438 \u201c\u043f\u043b\u043e\u0445\u043e\u201d, \u0441\u043e \u0441\u0442\u0435\u0440\u0442\u044b\u043c\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u043e \u0440\u0430\u043c\u043a\u0430\u0445 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u043e\u0433\u043e, \u0433\u0435\u0434\u043e\u043d\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439, \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u0438\u0441\u0442, \u0447\u0442\u043e-\u0442\u043e \u043e\u0434\u043d\u043e \u0438\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e: \u043c\u0430\u0442\u0435\u0440\u0438\u0442\u0441\u044f, \u043a\u0440\u0430\u0441\u0438\u0442 \u0432\u043e\u043b\u043e\u0441\u044b, \u043a\u0443\u0440\u0438\u0442, \u0441\u0434\u0435\u043b\u0430\u043b \u0442\u0430\u0442\u0443, \u043f\u0438\u043d\u0430\u0435\u0442 \u0431\u0443\u0442\u044b\u043b\u043a\u0443, \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0445 \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c \u0447\u0430\u0442\u0430\u0445, \u043f\u043e\u043a\u0443\u043f\u0430\u0435\u0442 \u0430\u0439\u0444\u043e\u043d. \u0411\u0430\u0431\u0443\u0448\u043a\u0430 \u0441 \u0434\u0435\u0434\u0443\u0448\u043a\u043e\u0439 \u043f\u044b\u0442\u0430\u043b\u0438\u0441\u044c, \u043d\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u0434\u0443\u043c\u0430\u044e\u0442, \u0447\u0442\u043e \u0438\u0445 \u0432\u043d\u0443\u0447\u0435\u043a \u0437\u043e\u043b\u043e\u0442\u0446\u0435, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0435 \u0432\u0438\u0434\u0435\u043b\u0438 \u0435\u0433\u043e \u0436\u0438\u0432\u043e\u0433\u043e. \u003Cbr\u003E\n.  \u041c\u0430\u043b\u044c\u0447\u0438\u043a \u043e\u043f\u0440\u043e\u043a\u0438\u043d\u0443\u043b \u043c\u0443\u0441\u043e\u0440\u043a\u0443 \u043d\u0430 \u0441\u043a\u0430\u043c\u0435\u0439\u043a\u0435 \u0432 \u041f\u0435\u0442\u0435\u0440\u0433\u043e\u0444\u0435 . \u043c\u043d\u0438\u043c\u044b\u0435 \u0441\u0438\u043c\u0443\u043b\u044f\u043a\u0440\u044b \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445. \u041d\u0430\u043f\u0440\u043e\u0442\u0438\u0432 \u041d\u0438\u0436\u043d\u0435\u0433\u043e \u043f\u0430\u0440\u043a\u0430 \u0441\u043e\u0431\u0440\u0430\u043b\u0430\u0441\u044c \u043c\u0430\u0441\u0441\u043e\u0432\u043a\u0430, \u0438\u043b\u0438 \u0433\u0440\u0443\u043f\u043f\u0430 \u0432\u043e\u043b\u043e\u043d\u0442\u0435\u0440\u043e\u0432, \u0438\u043b\u0438 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0430\u043a\u0446\u0438\u0438, \u0436\u0434\u0443\u0449\u0438\u0435 \u0432\u043d\u0443\u043a\u043e\u0432 \u0441 \u043f\u043e\u0435\u0437\u0434\u0430. \u041f\u0440\u0430\u0437\u0434\u043d\u0438\u043a \u0443 \u0433\u0440\u0430\u0436\u0434\u0430\u043d. \u0443\u0436\u0435 \u043d\u0435 \u0444\u043e\u043d\u0442\u0430\u043d\u044b, \u0443\u0436\u0435 \u043d\u0435 \u0444\u043e\u043d\u0442\u0430\u043d\u044b , \u0430 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0435 \u0432 \u0447\u0435\u0440\u043d\u044b\u0445 \u0434\u044b\u0440\u044f\u0432\u044b\u0445 \u043a\u0443\u0440\u0442\u043a\u0430\u0445 ,\u0432\u043c\u0435\u0441\u0442\u043e \u0445\u043b\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0432\u043e\u0434\u044b \u0432\u044b\u043f\u043b\u0435\u0432\u044b\u0432\u0430\u043b\u0438 \u0433\u0443\u0441\u0442\u0443\u044e, \u0440\u0436\u0430\u0432\u0443\u044e \u0436\u0435\u0440\u0449\u0438\u043d\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0435 \u043d\u0430\u0448\u043b\u0430 \u043c\u0435\u0441\u0442\u0430, \u0438\u0441\u0445\u043e\u0434\u0438\u043b \u0437\u0430\u043f\u0430\u0445 \u043f\u0440\u043e\u043c\u043e\u043a\u0448\u0435\u0433\u043e \u0432\u043e\u043b\u043a\u0430, \u0443 \u0436\u0435\u043d\u0449\u0438\u043d\u044b , \u043d\u0435 \u043d\u0430\u0448\u0435\u0434\u0448\u0435\u0439 \u043c\u0435\u0441\u0442\u0430,\u0432 \u043a\u0430\u0440\u043c\u0430\u043d\u0435 \u043a\u0443\u0440\u0442\u043a\u0438 \u0431\u0435\u0437 \u0443\u043c\u043e\u043b\u043a\u0443 \u0442\u0440\u0435\u0449\u0430\u043b \u0431\u0443\u0434\u0438\u043b\u044c\u043d\u0438\u043a, \u0436\u0435\u043d\u0449\u0438\u043d\u0430 \u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044c \u0435\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438\u043b\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0441 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u043e\u043c \u043d\u0430 \u043a\u0443\u0437\u043d\u0435\u0446\u043a\u043e\u043c \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0430 \u043a\u0440\u0430\u0441\u043d\u044b\u0439 \u0441\u0432\u0435\u0442. \u041f\u0440\u0430\u0437\u0434\u043d\u0438\u043a. \u0437\u0430\u0431\u0438\u0442\u044b\u0439 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u043c\u0438 \u0441 \u0444\u043e\u0440\u0443\u043c\u0430, \u0442\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0444\u0430\u043a\u0442 \u043f\u043e\u0432\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0430 \u043b\u0435\u0432\u043e\u043c \u0431\u0435\u0440\u0435\u0433\u0443 \u0435\u0435 \u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0441\u0438\u0431\u0438\u0440\u0441\u043a\u043e\u0433\u043e \u0433\u043e\u0440\u043e\u0434\u0430 \u043d\u0435 \u0432\u043f\u043e\u043b\u043d\u0435 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b\u043c\u0438 \u043f\u043e\u0432\u0435\u0441\u0442\u043a\u0430\u043c\u0438 ,\u0430 \u043d\u0430 \u043f\u0440\u0430\u0432\u043e\u043c \u0431\u0435\u0440\u0435\u0433\u0443 \u0430\u043b\u043a\u043e\u0433\u043e\u043b\u0438\u0437\u043c\u043e\u043c \u0441 \u0440\u0430\u0437\u043e\u0434\u0435\u0442\u044b\u043c\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u0430\u043c\u0438 \u2013 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0430\u043c\u0438 \u2013 \u043f\u0440\u044f\u043c\u043e \u043f\u043e\u0441\u0440\u0435\u0434\u0438 \u0417\u0430\u0442\u0443\u043b\u0438\u043d\u043a\u0438, \u0443\u0436\u0435 \u0434\u0440\u0443\u0433\u043e\u0439 \u043c\u043e\u0441\u0442,\u0432\u0435\u0441\u044c \u0432 \u043f\u0440\u043e\u0431\u043a\u0435, \u043a\u043e\u0433\u0434\u0430 \u0441\u0435\u0440\u0432\u0435\u0440 \u044f\u043d\u0434\u0435\u0445\u0430 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442, \u043a\u0430\u043a \u0438 \u0441\u0430\u043c \u0432\u0438\u0440\u0443\u0441-\u043f\u043e\u0434\u0434\u0435\u043b\u043a\u0430-\u0442\u0440\u043e\u044f\u043d \u2026 \u2026 \u2026 \u2026 \u0438 \u0442.\u0434 , \u0447\u0442\u043e \u0438\u0437 \u0441\u0435\u0431\u044f \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u044f\u043d\u0434\u0435\u0445. \u0413\u0420\u0410\u0416\u0414\u0410\u041d\u041a\u0410 \u041d\u0415 \u0412\u0418\u0414\u0418\u0422 \u041f\u0420\u041e\u0411\u041b\u0415\u041c\u042b\u2026\u2026\u2026\u2026.\u0420\u0410\u0417\u0414\u0410\u0412\u0428\u0410\u042f\u0421\u042f, \u041f\u0423\u0425\u041b\u0410\u042f, \u0421 \u0413\u041e\u0420\u0414\u042b\u041c \u0424\u041b\u0410\u0413\u041e\u041c \u041d\u0410 \u0421\u0422\u0415\u041d\u0415 \u0418 \u0426\u0415\u041b\u042b\u041c \u042f\u0429\u0418\u041a\u041e\u041c \u041a\u041e\u041d\u0424\u0415\u0422 \u0418 \u041f\u041e\u0414\u0421\u041e\u041b\u041d\u0415\u0427\u041d\u041e\u0413\u041e \u041c\u0410\u0421\u041b\u0410, \u0412\u0421\u0415 \u0420\u0410\u0417\u041b\u0418\u041b\u0410, \u0425\u041e\u0417\u042f\u042e\u0428\u041a\u0410 \u0421 \u041f\u0410\u0422\u0420\u0418\u041e\u0422\u0418\u0427\u041d\u042b\u0425 \u0418 \u041d\u0410\u0414\u041f\u0418\u0421\u042f\u041c\u0418 \u041d\u0410 \u0421\u0422\u0420\u0410\u041d\u0418\u0426\u0415 \u0412\u041a\u041e\u041d\u0422\u0410\u041a\u0422\u0415 \u0418 \u201c\u042f \u041d\u0415 \u0422\u0410\u041a\u0410\u042f\u201d ..\u041f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0438 \u0441\u043a\u0430\u0437\u0430\u043b\u0438, \u0438\u043c\u0435\u044e\u0442 \u0446\u0435\u043b\u044c \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0447\u0442\u043e-\u0442\u043e \u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0435, \u0447\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u043d\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043b\u044e\u0434\u044f\u043c. \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u0430 \u0441 \u041a\u0443\u0437\u043d\u0435\u0446\u043a\u043e\u0433\u043e \u043c\u043e\u0441\u0442\u0430 \u0441\u0442\u0430\u043b\u0430 \u043e\u0431\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044c\u0441\u044f, \u043a\u0430\u043a \u0442\u0430 \u0441\u0430\u043c\u0430\u044f \u0431\u0430\u0448\u043a\u0430, \u0442\u043e\u043b\u044c\u043a\u043e \u0431\u044b\u043b\u043e \u0443\u0436\u0435 \u043f\u043e\u0437\u0434\u043d\u043e. \u0423\u0447\u0451\u043d\u044b\u0439 \u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u0432\u043f\u0435\u0440\u0451\u0434, \u043f\u0440\u043e\u0434\u0430\u0432\u0435\u0446 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e, \u0434\u0432\u043e\u0440\u043d\u0438\u043a \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u043c\u0443\u0441\u043e\u0440, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a \u0432\u043e\u0434\u0438\u0442 \u043c\u0435\u043b\u043e\u043c \u0438\u043b\u0438 \u0438\u0437\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430\u0434 \u043b\u044e\u0434\u044c\u043c\u0438. \u041f\u0440\u0430\u0437\u0434\u043d\u0438\u043a. \u003Cbr\u003E\n\u041f\u0440\u0438\u043c\u0430\u0441\u0440\u043e\u0442 , \u0441\u043e\u0432\u0435\u0442 \u043f\u0440\u0438\u043c\u0443\u0441\u043e\u0432, \u043e\u0442\u043e\u0440\u0432\u0430\u043d\u043d\u044b\u0439 \u043e\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0442\u043e\u043b\u044c\u043a\u043e \u0438 \u043d\u0435 \u0434\u0443\u043c\u0430\u0435\u0442, \u0447\u0442\u043e \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043e\u043a \u0431\u0443\u0434\u0435\u0442 \u0441\u043e\u0447\u0438\u043d\u044f\u0442\u044c \u043d\u0438\u043a\u043e\u043c\u0443 \u043d\u0435 \u043d\u0443\u0436\u043d\u044b\u0439 \u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u043e\u0432\u044b\u0439 \u0440\u044d\u043f \u043f\u0440\u043e \u201c\u043b\u044e\u0431\u0438\u043c\u0443\u044e\u201d, \u201c\u043f\u043e\u0446\u0435\u043b\u0443\u0439\u201d, \u201c\u0445\u043e\u0447\u0443\u201d \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435, \u043e\u043d \u0441\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043e \u0432\u0441\u0435\u043c \u044d\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e,\u044c\u0434\u0430\u0436\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u043c \u043b\u044e\u0434\u044f\u043c. \u041a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u043f\u0430\u0440\u043d\u0438 \u0443\u0441\u0442\u0440\u043e\u0438\u043b\u0438 \u0433\u0440\u044f\u0437\u043d\u0443\u044e \u0442\u0443\u0441\u043e\u0432\u043a\u0443 \u0441 \u0438\u0437\u0434\u0435\u043b\u0438\u044f\u043c\u0438 \u043d\u0430 \u0440\u0430\u0441\u0442\u044f\u0436\u043a\u0435, \u0437\u0430\u043f\u0430\u0445 \u043f\u0435\u0440\u0435\u0433\u0430\u0440\u0430 (\u0438\u043b\u0438 \u0432\u043e\u043d\u044c), \u043f\u043e\u0442\u043d\u044b\u0435 \u043b\u0430\u0434\u043e\u043d\u0438, \u0437\u0430\u0448\u0442\u043e\u0440\u0435\u043d\u043d\u044b\u0435 \u043e\u043a\u043d\u0430, \u043a\u0430\u043a\u0430\u044f-\u0442\u043e \u201c\u043d\u0435 \u0417\u041e\u0416\u201d \u043a\u043e\u043c\u043f\u0430\u0448\u043a\u0430 , \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0430\u0441\u0441\u043e\u0446\u0438\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0441 \u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u044b\u043c\u0438 \u043b\u0430\u043c\u043f\u0430\u043c\u0438 \u043d\u0430 \u043f\u043e\u0434\u043e\u043a\u043e\u043d\u043d\u0438\u043a\u0435 \u0438 \u043b\u043e\u0437\u0430\u043c\u0438 \u0438\u0437 \u0433\u043e\u0440\u0448\u043a\u043e\u0432, \u0431 \u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u0442\u044f\u043d\u0435\u0442 \u043a \u0441\u0435\u0431\u0435 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c \u043a \u0438\u043d\u0441\u0442\u0438\u043d\u043a\u0442\u0430\u043c \u0438\u043b\u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0435. \u043d\u043e \u0440\u0435\u0447\u044c \u043f\u043e\u0439\u0434\u0435\u0442 \u043d\u0435 \u043e \u043f\u0430\u0440\u043d\u044f\u0445 \u0432 \u0445\u043e\u0440\u043e\u0448\u0435\u0439 \u0444\u043e\u0440\u043c\u0435 \u0438 \u0431\u0435\u043b\u044c\u0435 \u041a\u0430\u043b\u044c\u0432\u0438\u043d \u043a\u043b\u044f\u0439\u043d\u0435.  \u041a\u0440\u0438\u0447\u0430\u0449\u0438\u0439 \u0431\u0435\u0437\u0443\u043c\u043d\u044b\u0439, \u0431\u0435\u0437\u0443\u043c\u043d\u043e \u0442\u0443\u043f\u043e\u0439 \u0440\u044d\u043f. \u0418 \u0426\u0418\u0422\u0410\u0422\u0410 \u041d\u0410 \u0415\u0413\u041e \u0421\u0422\u0420\u0410\u041d\u0418\u0426\u0415 \u0412\u041a: \u201c\u2026\u2026.\u201d\u003Cbr\u003E\n \u0420\u0436\u0430\u0432\u0430\u044f \u0411\u0430\u0431\u0430.  \u043e\u0433\u0440\u043e\u043c\u043d\u0430\u044f, \u0434\u044b\u0440\u044f\u0432\u0430\u044f \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u044f \u0438\u0437 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u044b\u0445 \u0434\u0430\u0440\u043e\u0432, \u043e\u0431\u0440\u0435\u0437\u043a\u043e\u0432 \u043c\u0443\u0447\u043d\u044b\u0445 \u0438\u0437\u0434\u0435\u043b\u0438\u0439 \u0438  \u043f\u043e\u0434\u0441\u043e\u043b\u043d\u0435\u0447\u043d\u043e\u0433\u043e \u043c\u0430\u0441\u043b\u0430. \u0415\u0451 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043b\u0430\u0441\u0442\u0438\u043b\u0438\u043d\u043e\u0432\u043e\u0435 \u043b\u0438\u0446\u043e, \u043f\u0438\u0440\u0441\u0438\u043d\u0433 \u0438 \u043a\u0440\u0430\u0448\u0435\u043d\u044b\u0435 \u0432\u043e\u043b\u043e\u0441\u044b, \u0441\u043b\u0438\u043f\u0448\u0438\u0435\u0441\u044f \u0440\u0435\u0441\u043d\u0438\u0446\u044b \u0438 \u0442\u0443\u043f\u043e\u0439 , \u043d\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0432\u0437\u0433\u043b\u044f\u0434 \u0441\u043f\u043b\u0435\u0442\u043d\u0438\u0446\u044b, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432 \u0436\u0438\u0437\u043d\u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0443\u043c\u0435\u0435\u0442 \u043a\u0440\u043e\u043c\u0435 \u0441\u043a\u0440\u043e\u043b\u043b\u0438\u043d\u0433\u0430 \u0442\u0438\u043a\u0442\u043e\u043a\u0430 \u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u0447\u0435\u0440\u0432\u044f\u0447\u043a\u0430\u043c\u0438, \u0442\u0440\u0435\u0441\u043a\u0430\u043b\u043e\u0441\u044c, \u0434\u043e \u0431\u043e\u043b\u0438 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u043b\u043e \u0436\u0438\u0432\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0436\u0438\u0432\u0443\u044e \u0434\u0435\u0432\u043e\u0447\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0433\u0434\u0435-\u0442\u043e \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u0438\u043b\u0438 \u043f\u0432\u0437, \u0441\u0435\u0439\u0447\u0430\u0441 \u043e\u043d\u0430 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0435\u0442 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0433\u0440\u044f\u0437\u0438\u043d\u044b, \u043d\u0430\u0433\u043b\u043e\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f, \u043c\u043e\u0436\u0435\u0442, \u043a\u0430\u043a \u0438 \u043e\u043d\u0430, \u0441\u0438\u0434\u0438\u0442 \u0432 \u0438\u043d\u0441\u0442\u0430\u0433\u0430\u043c\u0430\u0445 \u0438 \u0432\u0435\u0434\u0451\u0442 \u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c-\u043a\u0430\u043d\u0430\u043b\u044b \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u0444\u043e\u0442\u043e \u043f\u0435\u0440\u0435\u0434 \u0437\u0435\u0440\u043a\u0430\u043b\u043e\u043c \u0438 \u0432 \u0442\u0443\u0430\u043b\u0435\u0442\u0430\u0445. \u041f\u0440\u043e\u0445\u043e\u0436\u0438\u0435 \u0432 \u0431\u043b\u0435\u0432\u0448\u043c\u043e\u0442\u043a\u0430\u0445 \u0437\u0430\u0441\u0442\u044b\u043b\u0438  , \u043f\u043e\u043a\u0430 \u0420\u0436\u0430\u0432\u0430\u044f \u0411\u0430\u0431\u0430 \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e \u043f\u043e\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u043f\u0443\u0441\u0442\u0443\u044e \u0431\u0430\u0448\u043a\u0443, \u0432\u043d\u0443\u0442\u0440\u0438 \u043a\u0440\u0443\u0442\u0438\u043b\u0430\u0441\u044c \u043c\u044b\u0441\u043b\u044c \u043e \u043a\u0440\u0435\u0434\u0438\u0442\u0435.\u003Cbr\u003E\n \u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043c\u0441\u044f \u0432\u043d\u0438\u0437\u0443 \u043d\u0430 \u0411\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435, \u0438 \u0438\u0437 \u0435\u0451 \u043a\u043e\u0436\u0438 \u0440\u0430\u0437\u043b\u0438\u043b\u0438\u0441\u044c \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0444\u0440\u0430\u043a\u0446\u0438\u0438, \u0441\u0430\u043c\u044b\u0435 \u0433\u0430\u0434\u043a\u0438\u0435 \u0430\u043b\u044c\u0434\u0435\u0433\u0438\u0434\u044b, \u043f\u0440\u0438\u0432\u043a\u0443\u0441 \u043c\u044b\u043b\u0430 \u0438 \u043c\u0435\u0442\u0430\u043b\u043b\u0430, \u043d\u0435\u043b\u044c\u0437\u044f \u0431\u044b\u043b\u043e \u043d\u0435 \u0441\u043c\u044b\u0442\u044c \u043f\u043b\u0430\u0441\u0442\u0438\u043b\u0438\u043d \u0441 \u043b\u0438\u0446\u0430 \u0434\u0435\u0432\u043e\u0447\u043a\u0438.\u003Cbr\u003E\n\u041a\u0440\u0430\u0441\u043d\u044b\u0439 \u043f\u0440\u043e\u0441\u043f\u0435\u043a\u0442 \u043d\u0430\u043f\u043e\u043b\u043d\u0438\u043b\u0430 \u043e\u0440\u0430\u0432\u0430 \u0438\u0437 \u0430\u043a\u0430\u0434\u0435\u043c\u0433\u043e\u0440\u043e\u0434\u043a\u0430. \u041f\u0440\u0430\u0437\u0434\u043d\u0438\u043a. \u0421\u0443\u043c\u0430\u0441\u0448\u0435\u0434\u0448\u0438\u0435 \u043f\u0440\u0430\u0432\u043e\u0433\u043e \u0442\u043e\u043b\u043a\u0430 \u0438\u0437 \u0444\u0440\u0430\u0442\u0435\u0440\u0430\u0441  \u201c\u0440\u0435\u0442\u0435\u0440\u0438\u043a\u0430\u201d \u0441\u0435\u043a\u0442\u0430\u043d\u0442\u044b \u0441\u0442\u043e\u044f\u043b\u0438 \u043d\u0430 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430\u0445, \u043e\u0436\u0438\u0434\u0430\u044f \u0442\u0440\u0430\u043c\u0432\u0430\u0439, \u043e\u0431\u0441\u0443\u0436\u0434\u0430\u043b\u0438 \u043a\u0430\u043a\u043e\u0435-\u0442\u043e \u043d\u0435\u0443\u043b\u043e\u0432\u0438\u043c\u043e\u0435, \u0437\u043b\u043e\u0435 \u0441\u0432\u0438\u043d\u0441\u0442\u0432\u043e. \u041d\u0430 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u0432\u044b\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u0439 \u043e\u043d \u043d\u0430\u043f\u044f\u043b\u0438\u043b \u0441\u0435\u0431\u0435 \u0442\u0440\u0438\u043a\u043e\u043b\u043e\u0440 \u0420\u041e\u0421\u0421\u0418\u0419\u0421\u041a\u041e\u0419 \u0418\u041c\u041f\u0415\u0420\u0418\u0418.\u043f\u043e\u0434\u0440\u043e\u0441\u0442\u043a\u0438, \u043a\u0430\u043a \u0438 \u043f\u0440\u0435\u0436\u043d\u044f\u044f \u0434\u0435\u0432\u043e\u0447\u043a\u0430, \u043d\u0430\u0440\u0438\u0441\u043e\u0432\u0430\u043b\u0438 \u0441\u0435\u0431\u044f \u043f\u0441\u0438\u0445\u0438\u0430\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0438\u0430