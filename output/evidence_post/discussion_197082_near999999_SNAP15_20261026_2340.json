437\u044f \u0434\u0430\u0432\u0430\u0442\u044c \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u044b \u0437\u0430 \u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u043a\u0430\u043b\u0438\u0437\u0435\u0439 \u0438 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0443 , \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0430 \u0440\u0435\u0439\u0442 , \u043d\u0443 \u0442\u0438\u043f\u043e \u0432\u043e\u0437\u044c\u043c\u0435\u043c \u0438\u0433\u0440\u043e\u043a\u0430 \u043a\u0430\u043b\u0438\u0437\u0435\u044f , \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432 \u043d\u0435\u0433\u043e \u0437\u0430\u0434\u0440\u043e\u0442\u0438\u0442  , \u043d\u0443 \u043e\u043d \u0432 \u043b\u0443\u0447\u0448\u0435\u043c \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u0435 \u0437\u0430\u043b\u0443\u0442\u0430\u0435\u0442 12-15\u043a \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u043e\u0432 ( \u0438 \u0442\u043e , \u044d\u0442\u043e \u043e\u0447\u0435\u043d\u044c \u043e\u043f\u0442\u0438\u043c\u0438\u0441\u0442\u0438\u0447\u043d\u044b\u0439 \u0440\u0430\u0441\u043a\u043b\u0430\u0434 ) \u0441 \u0443\u0447\u0435\u0442\u043e\u043c \u043a\u0440\u0430\u0441\u043d\u043e\u0439 \u043b\u0438\u0433\u0438 , \u0441\u0435\u0439\u0447\u0430\u0441 \u0430\u0441\u0441\u043e\u0440\u0442\u0438\u043c\u0435\u043d\u0442 \u043a\u0430\u043b\u0438\u0437\u0435\u0439 \u0441\u0442\u043e\u0438\u0442 160\u043a+ , \u0438 \u043e\u043d \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043f\u043e\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f , \u0442\u043e \u0435\u0441\u0442\u044c \u0447\u0442\u043e\u0431\u044b \u043a\u0443\u043f\u0438\u0442\u044c \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u0430\u0441\u0441\u043e\u0440\u0442\u0438\u043c\u0435\u043d\u0442 , \u0438\u0433\u0440\u043e\u043a \u0434\u043e\u043b\u0436\u0435\u043d \u0438\u0433\u0440\u0430\u0442\u044c +- 2-3 \u0433\u043e\u0434\u0430 , \u043d\u0443 \u0442\u0438\u043f\u043e \u0434\u0430\u0436\u0435 \u0441\u0430\u043c\u044b\u0439 \u043b\u044e\u0