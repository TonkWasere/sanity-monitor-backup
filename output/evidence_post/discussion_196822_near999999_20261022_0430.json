\u0435\u0440\u0432\u044b\u0435 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u0439 \u0438\u0432\u0435\u043d\u0442:\u003Cbr\u003E\n\u0418\u0433\u0440\u043e\u043a\u0430\u043c \u0432\u044b\u0434\u0430\u044e\u0442 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0432 \u0432\u0438\u0434\u0435 \u0434\u0440\u0430\u0433\u043e\u0446\u0435\u043d\u043d\u044b\u0445 \u0442\u0430\u043b\u043e\u043d\u043e\u0432, \u043f\u0443\u0442\u0435\u043c \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u043d\u0438\u0439, \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u0430\u043b\u0438 \u043d\u0430 \u044d\u0442\u043e \u043a\u0443\u0447\u0443, \u0442\u0430\u043a \u0435\u0449\u0435 \u043d\u0430\u043a\u043e\u043d\u0435\u0446-\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u041f\u0412\u041f \u0438 \u041f\u0412\u0415 \u0431\u0443\u043b\u043e\u043a.\u003Cbr\u003E\n\u0421\u0430\u043c\u0438 \u0437\u0430\u0434\u0430\u0447\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u043c \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u0432\u043f\u043e\u043b\u043d\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043c\u044b\u0435. \u0414\u0430 \u0441\u0435\u0439\u0447\u0430\u0441 \u043e\u043f\u044f\u0442\u044c \u043d\u0430\u0431\u0435\u0433\u0443\u0442 \u0432\u0441\u044f\u043a\u0438\u0435 \u0433\u0440\u0435\u043c\u043b\u0438\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0432\u0435\u0437\u0434\u0435 \u0432\u0438\u0434\u043d\u0430 \u0440\u0443\u0442\u0438\u043d\u0430 \u0438 \u0434\u0443\u0445\u043e\u0442\u0430. \u041d\u043e \u043e\u043d\u0438 \u0432\u043f\u043e\u043b\u043d\u0435 \u0441\u0435\u0431\u0435 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u0435 \u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0438\u043c\u044b\u0435, \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430\u0434\u043e \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u0442\u044c \u043d\u0430 \u043d\u0438\u0445 \u0432\u0440\u0435\u043c\u044f. \u042f \u043d\u0435 \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044c \u043f\u0440\u044f\u043c \u043c\u043e\u0449\u043d\u043e\u0433\u043e \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u043e\u0433\u043e \u041f\u0412\u041f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432 \u041a\u043e\u043b\u0438\u0437\u0435\u0439 \u043e\u0441\u043e\u0431\u043e \u043d\u0435 \u0445\u043e\u0434\u0438\u043b \u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b \u0437\u0430\u0434\u0430\u0447\u0438 \u0432 \u043e\u043f\u0435\u043d\u0435.\u003Cbr\u003E\n\u0411\u043e\u0436\u0435, \u043a\u0430\u043a \u043f\u0440\u0438\u044f\u0442\u043d\u043e \u044d\u0442\u043e \u0431\u044b\u043b\u043e. \u041c\u0430\u043b\u043e \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0443\u0431\u0440\u0430\u043b\u0438 \u044d\u0442\u0443 \u0431\u0435\u0448\u0435\u043d\u043d\u0443\u044e \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0446\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0443\u0436\u0435 \u043d\u0430\u0434\u043e\u0435\u043b\u0430 \u0432\u0435\u0437\u0434\u0435 \u0438 \u0434\u0443\u0448\u0438\u0442 \u043f\u043e\u0445\u043b\u0435\u0449\u0435, \u0447\u0435\u043c \u044d\u0442\u0438 \u0432\u0430\u0448\u0438 \u043e\u0434\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438, \u0442\u0430\u043a \u0435\u0449\u0435 \u0438 \u0438\u0433\u0440\u043e\u043a\u0438 \u043a\u0430\u043a-\u0431\u0443\u0434\u0442\u043e \u0441\u043f\u043b\u043e\u0442\u0438\u043b\u0438\u0441\u044c. \u0414\u0430, \u0431\u044b\u043b\u0438 \u043c\u043e\u043c\u0435\u043d\u0442\u044b \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0435, \u043a\u043e\u0433\u0434\u0430 \u0442\u043e \u0441\u043f\u043e\u0442 \u0443\u0432\u0435\u0434\u0443\u0442 \u0438\u0437 \u043f\u043e\u0434 \u043d\u043e\u0441\u0430, \u0442\u043e \u043f\u0430\u0447\u043a\u0430 \u0442\u0435\u0431\u044f \u0433\u0434\u0435-\u0442\u043e \u043f\u043e\u0439\u043c\u0430\u0435\u0442, \u043d\u043e \u0432 \u0446\u0435\u043b\u043e\u043c \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0435. \u041f\u0440\u0438\u044f\u0442\u043d\u043e \u0432\u0438\u0434\u0435\u0442\u044c \u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432 \u043e\u043f\u0435\u043d\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0447\u0443\u0440\u0430\u044e\u0442\u0441\u044f \u043f\u043e\u043c\u043e\u0447\u044c \u0442\u0435\u0431\u0435, \u0435\u0441\u043b\u0438 \u043d\u0430\u0434\u043e. \u0421\u043e\u044e\u0437\u043d\u0438\u043a\u0438 \u043f\u0440\u0438\u043a\u0440\u044b\u0432\u0430\u044e\u0442, \u043f\u0430\u043a\u0435\u0440\u043e\u0432 \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u044e\u0442. \u0420\u0430\u0434 \u0432\u043e\u0437\u0440\u043e\u0436\u0434\u0435\u043d\u0438\u044e \u044d\u0442\u0438\u043a\u0435\u0442\u0430 \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u043f\u0430\u043a\u0435\u0440\u043e\u0432, \u0445\u043e\u0442\u044c \u0438 \u0441\u043e \u0441\u0432\u043e\u0438\u043c\u0438 \u043d\u044e\u0430\u043d\u0441\u0430\u043c\u0438, \u043d\u043e \u044d\u0442\u043e \u0432\u0441\u0435 \u043c\u0435\u043b\u043e\u0447\u0438.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0430 \u0430\u0432\u0430\u043d\u043f\u043e\u0441\u0442\u044b \u0441\u0442\u0430\u043b\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u0435\u0435 \u0431\u0435\u0433\u0430\u0442\u044c. \u041f\u043e\u043a\u0430 \u0438\u0434\u0435\u0442 \u044d\u0442\u043e\u0442 \u043c\u0438\u043a\u0440\u043e-\u0438\u0432\u0435\u043d\u0442, \u043e\u043d\u0438 \u043a\u0430\u043a-\u0431\u0443\u0434\u0442\u043e \u043e\u0436\u0438\u043b\u0438. \u0418\u0433\u0440\u0430\u044f \u0437\u0430 \u043d\u0430\u0439\u043c\u043e\u0432, \u044f \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u043f\u0440\u044f\u043c \u0412\u0410\u0423 \u044d\u0444\u0444\u0435\u043a\u0442: \u0437\u0430 \u0434\u043e\u043b\u0433\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0417\u0430\u0440\u0438 \u0438 \u041d\u0430\u0435\u043c\u043d\u0438\u043a\u043e\u0432 \u043d\u0430 \u0430\u0432\u0430\u043d\u043f\u043e\u0441\u0442\u0435 \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u043b\u043e\u0441\u044c. \u0411\u043e\u043b\u044c\u0448\u0435 \u044d\u0442\u043e \u043d\u0435 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442, \u043a\u0430\u043a \u0432\u0435\u0447\u043d\u0430\u044f \u043e\u0441\u0430\u0434\u0430 \u0438\u043b\u0438 \u043e\u0442\u0431\u0438\u0432\u0430\u043d\u0438\u0435 \u0432\u043e\u043b\u043d \u043e\u0442 \u003Cdel\u003E\u0437\u0435\u0440\u0433\u043e\u0432\u003C\/del\u003E \u0413\u043e\u043d\u0447\u0438\u0445. \u0422\u0435\u043f\u0435\u0440\u044c \u044d\u0442\u043e \u0432\u043f\u043e\u043b\u043d\u0435 \u0441\u0435\u0431\u0435 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u0433\u043e\u0440\u044f\u0447\u0430\u044f \u0442\u043e\u0447\u043a\u0430, \u0433\u0434\u0435 \u0443 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0435\u0441\u0442\u044c \u0448\u0430\u043d\u0441 \u043e\u0442\u0431\u0438\u0442\u044c \u0438\u043b\u0438 \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044c. \u0423 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0435\u0441\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0441\u0442\u0440\u0435\u043b\u044f\u0442\u044c \u043f\u043e \u0442\u0438\u043f\u0430\u043c \u0438 \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u0438\u0445, \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u044d\u0442\u043e\u0433\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u044f.\u003C\/p\u003E \n\n\u003Cp\u003E\u0412 \u0446\u0435\u043b\u043e\u043c \u043f\u043e\u0431\u043e\u043b\u044c\u0448\u0435 \u0431\u044b \u0442\u0430\u043a\u043e\u0433\u043e. \u0427\u0438\u044