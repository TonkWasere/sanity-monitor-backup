u0440\u043e\u0432\u0430\u043d \u043e\u043d \u0442\u0443\u043f\u043e. \u0415\u0441\u043b\u0438 \u0431\u0440\u0430\u0442\u044c \u043f\u043e\u043b\u043d\u0443\u044e \u0446\u0435\u043f\u043e\u0447\u043a\u0443 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0430\u0442\u043b\u0430\u0441\u043e\u043c \u0438 \u0440\u0443\u043d\u043e\u0439, \u0442\u043e \u043e\u043d \u0435\u0449\u0451 \u0438 \u043e\u0442 \u0440\u0430\u043d\u0434\u043e\u043c\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u0442.\u003Cbr\u003E\n\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u043e\u0434\u044b \u0434\u043b\u044f \u0441\u0435\u0439\u0444\u043e\u0432 - \u0435\u0449\u0451 \u043a\u0443\u0434\u0430 \u043d\u0438 \u0448\u043b\u043e, \u043d\u0435\u043f\u043b\u043e\u0445\u043e \u0441\u0434\u0435\u043b\u0430\u043d\u043e. \u041d\u043e \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435, \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0438\u0437\u0434\u0435\u0446) \u0437\u0430 \u0447\u0442\u043e \u043c\u043e\u0433\u0443 \u043f\u043e\u0445\u0432\u0430\u043b\u0438\u0442\u044c, \u0442\u0430\u043a \u044d\u0442\u043e \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u0432\u0441\u0435 \u043a\u043e\u043c\u044c\u044e\u043d\u0438\u0442\u0438 \u0442\u043e\u0439 \u0442\u0435\u043c\u044b \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0445\u0443\u044f\u0447\u0438\u043b\u043e \u043f\u043e \u0432\u0441\u0435\u0439 \u043a\u0430\u0440\u0442\u0435, \u0434\u0435\u043b\u0438\u043b\u043e\u0441\u044c \u043d\u0430\u0445\u043e\u0434\u043a\u0430\u043c\u0438 \u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u043b\u0438 \u043f\u0435\u0440\u0435\u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0442\u044c \u0432\u0441\u0451. \u041a\u043e\u0433\u0434\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0442\u0432\u0438\u043d\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430 \u0434\u0435\u04