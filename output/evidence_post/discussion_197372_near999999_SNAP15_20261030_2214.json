33\u043e\u0432\u043e\u0440\u0438\u043b\u0438, \u0447\u0442\u043e \u043d\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0443 \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u0438\u0432\u0435\u043d\u0442\u043e\u0432 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u043a\u0430\u043a \u0410\u041f) \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432. \u041d\u043e \u0442\u043e\u0433\u0434\u0430 \u0438 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u0435\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430, \u0431\u0435\u0437 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0438\u0432\u0435\u043d\u0442\u044b \u043c\u043e\u0433\u0443\u0442 \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c\u0441\u044f \u0441\u0440\u0435\u0434\u043d\u0438\u043c\u0438 \u0438\u043b\u0438 \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e \u0441\u043b\u0430\u0431\u044b\u043c\u0438, \u0447\u0442\u043e \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044e \u0438 \u0431\u044b\u0432\u0430\u0435\u0442.\u003Cbr\u003E\n\u041d\u0430 \u043c\u043e\u0439 \u0432\u0437\u0433\u043b\u044f\u0434, \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u0439 \u0438\u0432\u0435\u043d\u0442 \u043a\u0430\u043a \u0440\u0430\u0437 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u0441\u0440\u0435\u0434\u043d\u0438\u043c. \u041e\u043d \u0441\u043a\u0443\u0447\u043d\u044b\u0439, \u043d\u0435\u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u044b\u0439 \u0438 \u043e\u0434\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0439. \u0423\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u043f\u044f\u0442\u0438 \u043c\u0430\u0442\u0447\u0435\u0439 \u0442\u044b \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0443\u0432\u0438\u0434\u0435\u043b \u0432\u0441\u0451, \u0447\u0442\u043e