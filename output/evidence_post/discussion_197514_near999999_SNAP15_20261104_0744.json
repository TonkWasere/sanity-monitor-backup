u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0443\u043c\u043d\u044b\u0435 \u0434\u043b\u044f \u0442\u0430\u043a\u043e\u0433\u043e, \u043e\u043d\u0438 \u043d\u0435 \u0434\u043e\u043b\u0431\u0430\u0451\u0431\u044b, \u0430 \u0432\u043e\u0442 \u043a\u0430\u043a\u043e\u0439-\u043d\u0438\u0431\u0443\u0434\u044c \u0441\u0431\u0435\u0440 \u0433\u0438\u0433\u0430\u0447\u0430\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u0413\u042b\u0413\u042b\u0413 \u0413\u0418\u0413\u0418\u0427\u0410\u0414 \u043f\u043e\u043d\u044f\u043b\u0438 \u043c\u0435\u043c, \u0434\u0430? \u0414\u0410 \u0423\u0417\u041d\u0410\u041b\u0418? \u0421\u0411\u0415\u0420\u0411\u0410\u041d\u041a \u0413\u041e\u0412\u041d\u041e \u0415\u0411\u0410\u041d\u041e\u0415 (\u044f \u043a\u043e\u0440\u043e\u0447\u0435 \u0434\u0430\u043b 100 \u0440\u0443\u0431\u043b\u0435\u0439 \u0418\u0418\u0448\u043a\u0435 \u0441\u0431\u0435\u0440\u0430 \u043f\u043e \u0440\u043e\u0444\u043b\u0443, \u0442\u0438\u043f\u043e \u0432 \u0430\u043a\u0446\u0438\u0438 \u0432\u043b\u043e\u0436\u0438\u0442\u044c, \u0443 \u043d\u0438\u0445 \u0435\u0441\u0442\u044c \u0442\u0430\u043a\u043e\u0435, \u0434\u0430, \u043f\u0440\u044f\u043c \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438, \u043e\u043d \u044d\u0442\u0438 100 \u0440\u0443\u0431\u043b\u0435\u0439 \u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0435\u0431\u0430\u043b, \u044f \u043e\u0436\u0438\u0434\u0430\u043b \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435, \u043d\u043e \u044f \u0447\u0451\u0442 \u043d\u0435 \u0434\u0443\u043c\u0430\u043b \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0431\u044b\u0441\u0442\u0440\u043e)\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197514-opisanie-v-stime\/10\u0022 class=\u0022PostMention\u0022 data-id=\u00224744872\u0022\u003EAndGun\u003C\/a\u003E \u0431\u0435\