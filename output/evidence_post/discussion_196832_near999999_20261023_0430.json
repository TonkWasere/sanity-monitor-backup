22\u003EPghalk\u003C\/a\u003E \u044d\u0442\u043e \u0436\u0435 \u0448\u0443\u043c\u043d\u043e \u043a\u0430\u043a\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0442\u0430\u043a \u044f \u0438 \u043d\u0435 \u0438\u0433\u0440\u0430\u044e \u043d\u043e\u0447\u044c\u044e+\u0443 \u043c\u0435\u043d\u044f \u043c\u0438\u043d\u0438 \u0431\u0430\u0440(\u0431\u043b\u044f, \u044d\u0442\u043e \u0445\u043e\u043b\u043e\u0434\u043e\u0441 \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u043c \u0441 \u043c\u0438\u043d\u0438-\u0431\u0430\u0440) \u0438 \u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u041d\u041e\u0420\u041c\u0410\u041b\u042c\u041d\u042b\u0419 \u0445\u043e\u043b\u043e\u0434\u043e\u0441. \u0422\u044b \u0434\u0443\u043c\u0430\u0435\u0448\u044c \u044f \u0432\u0438\u043d\u0442\u044b \u044d\u0442\u0438 \u0441\u043b\u044b\u0448\u0443?\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196832-pamagite-pk\/101\u0022 class=\u0022PostMention\u0022 data-id=\u00224722257\u0022\u003EProstoduke_fan\u003C\/a\u003E \u0417\u0430\u0447\u0435\u043c? \u0421\u0430\u043c\u0430\u044f \u0434\u0435\u0448\u0451\u0432\u0430\u044f \u043c\u0430\u0442\u044c \u043f\u043e\u0439\u0434\u0435\u0442\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0434\u0432\u0430 \u0441\u043b\u043e\u0442\u0430 \u043c2+\u0446\u0435\u043f\u0438 \u043f\u0438\u0442\u0430\u043d\u0438\u044f+\u043f\u0441\u0438\u0435 4.0 \u043d\u0430\u0434\u043e)\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196832-pamagite-pk\/101\u0022 class=\u0022PostMention\u0022 data-id=\u00224722257\u0022\u003EProstoduke_fan\u003C\/a\u003E \u0411\u0435\u0434\u043e\u043b\u0430\u0433\u0430 \u043c\u0430\u043c\u043e\u043d\u0442 \u043a\u0430\u043a \u0438 \u044f\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u043a\u0430\u043a \u0440\u0430\u0437 \u0442\u0430\u043a\u0438 \u0438\u0437-\u0437\u0430 \u0440\u0435\u043a\u0441\u044b. \u0423 \u043d\u0435\u0451 \u0438\u0434\u0451\u0442 16x \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435(\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442 \u0432\u0438\u0434\u044e\u0445), \u043d\u043e \u0441\u0443\u043a\u0430 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043f\u043e 4x. \u041a\u0440\u0447 \u0438\u0437-\u0437\u0430 \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u043e pcie 4.0, \u0432\u0435\u0440\u0441\u0438\u044f 3.0 \u0432 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u0443 \u0440\u0435\u0436\u0435\u0442 \u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-23\/1792720792-924697-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u002201f48324-bb26-45f9-8f55-ff0441edb4da\u0022 loading=\u0022lazy\u0022 width=\u0022349\u0022 height=\u0022187\u0022\u003E\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196832-pamagite-pk\/101\u0022 class=\u0022PostMention\u0022 data-id=\u00224722257\u0022\u003EProstoduke_fan\u003C\/a\u003E \u041a\u0443\u043b\u0435\u043a \u0437\u0430 2\u043a, \u0432 \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0435 70 -80 \u043c\u0430\u043a\u0441 \u0433\u0440\u0430\u0434\u0443\u0441\u043e\u0432\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-23\/1792720871-131972-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022\u0022 data-id=\u00228ace0546-caf9-4e4d-877e-1ec83793ad0c\u0022 loading=\u0022lazy\u0022 width=\u00221064\u0022 height=\u0022154\u0022\u003E\u003Cbr\u003E\n\u043a\u043e\u0440\u043e\u0447\u0435 \u0442\u0430\u043a\u043e\u0439 \u0432\u0437\u044f\u043b. \u041f\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430\u043c+\u043e\u0445\u043b\u0430\u0434\u0443 \u043f\u043e\u0439\u0434\u0451\u0442. \u0422\u0410\u043a \u0447\u0442\u043e \u043f\u043e\u0445\u0443\u0439\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196832-pamagite-pk\/105\u0022 class=\u0022PostMention\u0022 data-id=\u00224722387\u0022\u003EIgorLaser\u003C\/a\u003E \u043d\u043e \u043e\u0442\u0441\u0442\u0430\u043b \u0443\u0436\u0435 \u043e\u0442 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043e\u0447\u0435\u043d\u044c \u0438 \u043e\u0447\u0435\u043d\u044c \u0441\u0438\u043b\u044c\u043d\u043e, \u0432 \u0438\u0433\u0440\u0430\u0445\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0435\u0441\u043b\u0438 \u0431\u044b \u044f \u0438\u0433\u0440\u0430\u043b \u043f\u0440\u044f\u043c \u0432 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435. \u041c\u043d\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b+\u0444\u043e\u043d\u043e\u0432\u044b\u0445 \u0437\u0430\u0434\u0430\u0447.  \u041c\u043e\u0439 3 3100 \u0430\u0445\u0443\u0435\u0432\u0430\u0435\u0442 \u043d\u0430 \u0441\u0432\u043e\u0438\u0445 4 \u044f\u0434\u0440\u0430\u0445 \u0438 8 \u043f\u043e\u0442\u043e\u043a\u0430\u0445. \u0410 \u043f\u0440\u043e \u0441\u043a \u0432\u0449 \u043c\u043e\u043b\u0447\u0443. \u041d\u0443 \u0442\u0443\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432 \u0441\u043a \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b. \u0418\u0431\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u044e(\u0431\u0440\u0430\u0443\u0437\u0435\u0440+\u043f\u0440\u043e\u0433\u0430 \u0434\u043b\u044f \u0437\u0432\u043e\u043d\u043a\u043e\u0432) \u0438 \u0442\u0443\u043d\u0434\u0440\u0430 \u043d\u0430 \u0444\u043e\u043d\u0435 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u043d\u0435\u0442. \u0421\u043a \u0436\u0435 \u0432\u044b\u0434\u0430\u0451\u0442 \u043f\u0440\u0438\u043a\u043e\u043b\u044b \u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043c\u043d\u0435 \u201c\u0430 \u043d\u0430\u0445\u0443\u0439 \u043f\u043e\u0439\u0442\u0438?\u201d. \u0418\u0437 \u0438\u0433\u0440 \u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u044f\u043c \u0415\u0411\u0410\u0422\u042c \u041d\u041e\u0412\u0418\u041d\u041a\u0418 \u041d\u0410 \u0423\u041b\u042c\u0422\u0420\u0410\u0425 \u043d\u0435 \u0438\u0433\u0440\u0430\u044e, \u0434\u0430 \u0438 \u0431\u0443\u0434\u0443 \u043b\u0438?\u003C\/p\u003E \n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196832-pamagite-pk\/101\u0022 class=\u0022PostMention\u0022 data-id=\u00224722257\u0022\u003EProstoduke_fan\u003C\/a\u003E \u0411\u0435\u0434\u043e\u043b\u0430\u0433\u0430 \u043c\u0430\u043c\u043e\u043d\u0442 \u043a\u0430\u043a \u0438 \u044f\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u043d\u0443 \u0438 \u043a\u0430\u043a \u044f \u0433\u043e\u0432\u043e\u0440\u0438\u043b \u0432\u044b\u0448\u0435. 3050 \u0438\u043b\u0438 6500 \u0445\u0442 \u043d\u0430 8 \u0433\u0431. \u041a\u0430\u043a \u0431\u044b \u0440\u0430\u0437\u043d\u0438\u0446\u0430 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u0430. \u0411\u044b\u043b\u0438 \u0431\u044b \u0444\u0438\u043d\u0430\u043d\u0441\u044b \u043d\u0430 \u0434\u0440\u0443\u0433\u0443\u044e \u0432\u0438\u0434\u044e\u0445\u0443- \u043f\u043e\u043a\u0443\u043f\u0430\u043b \u0431\u044b \u0435\u0451)\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196832-pamagite-pk\/104\u0022 class=\u0022PostMention\u0022 data-id=\u00224722384\u0022\u003E\u041c\u041e\u0419_\u0413\u041e\u0421\u041f\u041e\u0414\u0418\u041d\u003C\/a\u003E \u043a\u0443\u043f\u0438 \u0434\u0440\u0443\u0433\u043e\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u044f \u0437\u043d\u0430\u044e, \u0443 \u0430\u043c\u0443\u0434\u0435 \u0441\u0430\u043f\u0444\u0438\u0440 \u043e\u0434\u043d\u0430 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u043f\u0438\u0437\u0434\u0430\u0442\u044b\u0445 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0439. \u0418\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e \u043c\u0435\u0447\u0442\u0430\u043b \u0437\u0430 30-40\u043a(\u043d\u0430 \u043c\u0430\u0439-\u0438\u044e\u043d\u044c 2025) \u043a\u0443\u043f\u0438\u0442\u044c 7600 \u0445\u0442 \u0438\u043b\u0438 \u043a\u0430\u043a\u0443\u044e-\u0442\u043e \u0438\u0437 7000 \u0441\u0435\u0440\u0438\u0438. \u041d\u043e \u043e\u043d\u0430 \u043e\u0442 \u0433\u0438\u0433\u0430\u0431\u0443\u0442\u0435.\u003C\/p\u003E\n\n\u003Cp\u003EP.S. \u0445\u0443\u0439 \u0437\u043d\u0430\u0435\u0442 \u043a\u0442\u043e \u043a\u0430\u043a, \u043d\u043e \u044f \u0444\u0430\u043d\u0430\u0442 \u043c\u0441\u0438 \u0438 \u0431\u044b\u043b \u0431\u044b \u043a\u0430\u0439\u0444 \u0432\u043e\u043e\u0431\u0449\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043e\u0442 \u043d\u0438\u0445 \u0438\u043c\u0435\u0442\u044c, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0435\u0431\u0430\u0442\u044c\u0441\u044f. \u041d\u043e \u0443\u0432\u044b \u0438 \u0430\u0445\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196832-pamagite-pk\/110\u0022 class=\u0022PostMention\u0022 data-id=\u00224722419\u0022\u003EelPapito\u003C\/a\u003E \u041d\u043e \u0432 \u0438\u0434\u0435\u0430\u043b\u0435 \u0431\u044b \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0437\u0430\u0442\u0435\u0440\u043f\u0435\u0442\u044c+\u043f\u043e\u0434\u043a\u043