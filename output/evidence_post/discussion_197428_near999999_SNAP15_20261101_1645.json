u0448\u043a\u0430, \u0445\u043e\u0440\u043e\u0448\u0430\u044f \u0448\u0432 \u043f\u043e\u0434 \u0443\u043f\u043e\u0440\u0447\u0438\u043a. \u0415\u0439 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c \u043f\u0430\u0442\u0447\u0435 \u0434\u0430\u043b\u0438 0.5 \u0438 \u0437\u0430\u0438\u0433\u0440\u0430\u043b\u0430.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197428-posovetuyte-oruzhie-ili-sborku-dlya-pvp\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224741516\u0022\u003EAidka\u003C\/a\u003E 2)\u0421\u0442\u043e\u0438\u0442 \u043b\u0438 \u043a\u0440\u0430\u0444\u0442\u0438\u0442\u044c \u0426\u0435\u043d\u0442\u0443\u0440\u0438\u043e\u043d \u0441 \u0443\u0447\u0451\u0442\u043e\u043c \u0442\u043e\u0433\u043e \u0447\u0442\u043e \u0443 \u043c\u0435\u043d\u044f \u0443\u0436\u0435 \u0435\u0441\u0442\u044c SBA TANK \u0438\u043b\u0438 \u0432\u0441\u0451 \u0436\u0435 \u0441\u043a\u0440\u0430\u0444\u0442\u0438\u0442\u044c \u0426\u0435\u043d\u0442\u0443 \u0434\u043b\u044f \u0410\u0432\u0430\u043d\u043f\u043e\u0441\u0442\u043e\u0432 \u0438 PVP \u0432 \u043e\u043f\u044b\u043d\u0435 ?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0414\u0430, \u0446\u0435\u043d\u0442\u0430 \u0445\u043e\u0440\u043e\u0448\u0438\u0439 \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u044b\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u043c\u0435\u0436\u0434\u0443 \u043b\u0435\u0433\u043a\u0438\u043c\u0438 \u0431\u043e\u0435\u0432\u043a\u0430\u043c\u0438(\u041a\u0417-4. \u0410\u0432\u0430\u043d\u0433\u0430\u0440\u0434) \u0438 \u0441\u0432\u0435\u0440\u0445\u0442\u044f\u0436\u0430\u043c\u0438(\u0422\u0430\u043d\u043a, \u0410\u043f\u043e\u0441\u0442\u043e\u043b), \u0446\u0435\u043d\u0442\u0430 \u0432 \u043d\u0435\u043a\u043e\u043c \u0440\u043e\u0434\u0435 \u0437\u043e\u043b\u043e\u0442\u0430\u044f \u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0430, \u043d\u043e \u0442\u0430\u043c \u043e\u0442\u044b\u0433\u0440\u043e\u0432\u043a\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0442 \u043a\u043e\u043c\u0431\u043e\/\u0436\u0438\u0440 \u0441\u0431\u043e\u0440\u043a\u0438 \u0438 \u0442\u043e\u043b\u044c\u043a\u043e \u0441 \u043f\u0443\u043b\u0435\u043c\u0435\u0442\u0430\u043c\u0438\/\u0448\u0432 \u0441 \u0431\u0430\u0440\u0430\u0431\u0430\u043d\u0430\u043c\u0438. \u041f\u043e\u0434 \u043f\u043f\/\u0448\u0432 \u0441 \u044d\u0440\u0433\u043e\u043c\u0430\u0433\u0430\u043c\u0438 \u0438 \u043a\u043e\u043c\u0431\u043e\u0441\u0431\u043e\u0440\u043a\u0443 \u043b\u0443\u0447\u0448\u0435 \u0431\u0440\u0430\u0442\u044c \u043b\u0435\u0433\u043a\u0438\u0435 \u0431\u043e\u0435\u0432\u043a\u0438.\u003C\/p\u003E\n\n\n\n\n\n\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197428-posovetuyte-oruzhie-ili-sborku-dlya-pvp\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224741516\u0022\u003EAidka\u003C\/a\u003E 3)\u0421\u0431\u043e\u0440\u043a\u0430 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u043e\u0432 \u0447\u0442\u043e \u0432 \u041a\u0420\u0410\u0411\u2019\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u043b\u0438 \u0441\u0442\u043e\u0438\u0442 \u0447\u0442\u043e-\u0442\u043e \u043f\u043e\u043c\u0435\u043d\u044f\u0442\u044c?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0443, \u0435\u0441\u043b\u0438 \u0442\u0435\u0431\u0435 \u0434\u043b\u044f \u043a\u0430\u0440\u0430\u0442\u0435\u043b\u044f, \u0442\u043e \u0442\u0430\u043c \u0442\u043e\u043b\u044c\u043a\u043e \u0436\u0438\u0440 -\u003C\/p\u003E \n\n\u003Cp\u003E\u044e\u043b\u0430\u003Cbr\u003E\n\u043c\u0430\u0433\u043c\u0430\/\u0447\u0435\u0440\u043d\u0430\u044f \u0434\u044b\u0440\u0430\u003Cbr\u003E\n\u0444\u0430\u0440\u0435\u043d\u0433\u0435\u0439\u0442\u003Cbr\u003E\n\u043f\u0440\u0438\u0437\u043c\u0430\/\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0435\u0436\u0438\u043a\u0438 x3\/\u003C\/p\u003E \n\n\n\u003Cp\u003E\u0430\u0442\u043e\u043c \u003Cbr\u003E\n\u043e\u043f\u0430\u043b\u003Cbr\u003E\n\u0437\u0432\u0435\u043d\u043e\u003Cbr\u003E\n\u043c\u0430\u0433\u043c\u0430\u003Cbr\u003E\n\u0440\u043e\u0437\u0430 \u0438\u0437\u043d\u0430\u043d\u043a\u0438\u003C\/p\u003E\n\n\u003Cp\u003E\u0438 \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0435 \u0435\u043c\u0443 \u0441\u0431\u043e\u0440\u043a\u0438. \u0411\u0443\u0431\u043b\u044c \u0435\u0441\u043b\u0438 \u0447\u0442\u043e \u0432\u0430\u0449\u0435 \u043d\u0435 \u0432 \u0442\u0435\u043c\u0443.\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e\u0434 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u0443\u044e \u0431\u0440\u043e\u043d\u044e \u0440\u0430\u0441\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0434\u043e\u043b\u0433\u043e, \u0442\u0430\u043a \u0447\u0442\u043e \u043b\u0443\u0447\u0448\u0435 \u0442\u0443\u0442 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u0442\u044c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0410 \u0442\u0430\u043a, \u0443 \u0442\u0435\u0431\u044f \u0435\u0441\u0442\u044c \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u043e\u0440\u0443\u0436\u0438\u0435: \u043c\u0435\u0434\u043e\u0435\u0434, \u0431\u0435\u0440\u0435\u0442\u0442\u0430, \u043c\u043f7, \u0432\u043e\u0437\u0434\u0443\u0445\u0430\u043d, \u043f\u0437\u0431, \u043c\u04333.\u003Cbr\u003E\n\u0425\u043e\u0442\u044f \u043c\u043e\u0436\u0435\u0448\u044c \u0432\u043e\u043e\u0431\u0449\u0435 \u0432 \u0446\u0435\u043b\u043e\u043c \u0443\u0433\u043e\u0434\u043d\u043e \u0438\u0433\u0440\u0430\u0442\u044c, \u0432 \u043e\u043f\u0435\u043d\u0435 \u0445\u043e\u0440\u043e\u0448\u043e \u0438\u0433\u0440\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0447\u0442\u0438 \u0432\u0441\u0435, \u0438 \u043d\u0438\u0447\u0435 \u043d\u0435\u0440\u0444\u0438\u0442\u044c \u043e\u0441\u043e\u0431\u043e \u043d\u0435 \u0431\u0443\u0434\u0443\u0442.\u003C\/p\u00