\u0434\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u043e\u0433\u0434\u0430 \u0432\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0448\u044c \u0437\u0438\u043c\u0443 2023\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041e\u0445 \u0443\u0436 \u044d\u0442\u0430 \u0437\u0438\u043c\u0430 2022-2023, \u043a\u043e\u0433\u0434\u0430 \u0434\u0435\u043b\u0430\u0442\u044c \u0431\u044b\u043b\u043e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0435\u0445\u0443\u0439, \u0430\u043a\u0440\u043e\u043c\u044f \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u043f\u043e\u0434\u0430\u0440\u043a\u0438 \u043d\u0430 \u0441\u043f\u0435\u0440\u043c\u0430\u0447\/\u0433\u0438\u0442\u0430\u0440\u0443 \u0434\u0430 \u043f\u0438\u0437\u0434\u0438\u0442\u044c \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435 \u0441\u043f\u043e\u0442\u044b (\u0434\u0430\u0436\u0435 \u0431\u0443\u0440\u0438 \u043d\u0435 \u0431\u044b\u043b\u043e XDXDXD), \u0438\u043b\u0438 \u0442\u044b \u043f\u0440\u043e \u0437\u0438\u043c\u0443 2023-2024, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0437\u0438\u043c\u043e\u0439 2024-2025 \u0438 2025-2026 \u0431\u0435\u0437 \u0430\u0445\u0443\u0435\u0432\u0448\u0435\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u044b\u0445 \u0438\u0434\u0435\u0439 (\u043a\u0440\u043e\u043c\u0435 \u0431\u043e\u0441\u0441\u0430 \u043d\u0430 2 \u043c\u0438\u043d\u0443\u0442\u044b \u0431\u0435\u0437 \u043d\u043e\u0440\u043c \u043d\u0430\u0433\u0440\u0430\u0434, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0434\u0430\u0436\u0435 \u043d\u0430 \u043c\u0430\u0441\u0442 \u0443\u0440\u043e\u0432\u043d\u0438 \u043f\u043e \u043a\u0434 \u043f\u0438\u043d\u0430\u043b\u0438 \u043d\u043e\u0432\u0438\u0447\u043a\u0438 \u0441 \u0441\u0430\u0432\u043a\u043e\u043c \u043f\u0440\u0438\u0447\u0435\u043c \u044