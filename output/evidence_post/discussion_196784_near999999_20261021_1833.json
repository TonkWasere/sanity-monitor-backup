0432\u0435\u043d\u043d\u0430\u044f \u043c\u0435\u0440\u0437\u043e\u0441\u0442\u044c \u0435\u0431\u0430\u043d\u0430\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043c\u043e\u0439 \u0433\u043b\u0430\u0437 \u0434\u0451\u0440\u0433\u0430\u0442\u044c\u0441\u044f - \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0440\u044f\u0441\u043a\u0430. \u041d\u0435 \u0437\u043d\u0430\u044e \u043a\u0430\u043a \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c + \u0432\u043f\u0430\u0434\u043b\u0443 \u043e\u0442\u043a\u0430\u0442 \u0434\u0435\u043b\u0430\u0442\u044c. \u041a\u0430\u0440\u043e\u0447\u0435, \u0431\u0435\u0436\u0438\u0448\u044c \u0432 \u0440\u0443\u043a\u0430\u0445 \u0441 \u043d\u0438\u043c \u0443 \u0442\u0435\u0431\u044f \u043a\u0430\u043a \u0441 \u043b\u044e\u0431\u044b\u043c \u0434\u0440\u0443\u0433\u0438\u043c \u0433\u0430\u043d\u043e\u043c \u044d\u043a\u0440\u0430\u043d \u0432\u043f\u0440\u0430\u0432\u043e-\u0432\u043b\u0435\u0432\u043e \u0442\u0440\u044f\u0441\u0435\u0442\u0441\u044f, \u043d\u043e \u0435\u0441\u043b\u0438 \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0441\u043d\u0430\u0439\u043f\u0430\u043c\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c (\u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0438 \u0442\u044f\u0436\u0435\u043b\u0430\u044f \u0451\u0431\u0430\u043d\u044c \u043f\u0437\u0431) \u0442\u044b \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0448\u044c\u0441\u044f \u0438 \u0432\u0441\u0451 \u0442\u0438\u043f-\u0442\u043e\u043f, \u0442\u043e \u0443 \u0432\u043e\u0437\u0434\u0443\u0445\u0430\u043d\u0430 \u0435\u0441\u0442\u044c \u043f\u043e\u0441\u0442-\u044d\u0444\u0444\u0435\u043a\u0442 \u0443\u0431\u043b\u044e\u0434\u0441\u043a\u0438\u0439 \u0441 \u0442\u0440\u044f\u0441\u043a\u043e\u0439. \u0422\u043e \u0435\u0441\u0442\u044c:\u003Cbr\u003E\n\u0422\u044b \u0