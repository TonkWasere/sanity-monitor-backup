43c\u0435\u043d\u0438. \u041f\u0440\u0438 \u0447\u0435\u043c \u043d\u043e\u0432\u044b\u0435 \u043d\u0435\u0439\u0440\u043e\u043d\u043a\u0438, \u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u043f\u0440\u043e\u043c\u0442, \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0442 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u043e\u0431\u0435\u0437\u044c\u044f\u043d\u044b \u043f\u0435\u0440\u0435\u0434 \u043a\u043e\u043c\u043f\u043e\u043c, \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f, \u0447\u0442\u043e \u0431\u044b \u043d\u0435 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c \u043f\u0440\u043e\u0433\u0443, \u0442\u0435\u0441\u0442\u0438\u0440\u0443\u044e\u0442 \u0440\u0430\u0437\u043d\u044b\u0435 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0438 \u0438 \u043c\u043e\u0433\u0443\u0442 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0442\u043e, \u0447\u0442\u043e \u043d\u0435 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u043d\u043e \u043e\u0447\u0435\u043d\u044c \u043d\u0443\u0436\u043d\u043e. \u0413\u043b\u0430\u0432\u043d\u043e\u0435 \u043d\u0435 \u043f\u0435\u0440\u0435\u0431\u043e\u0440\u0449\u0438\u0442\u044c \u0441 \u043f\u0440\u043e\u043c\u0442\u043e\u043c\u2026\u003C\/p\u003E\n\n\u003Cp\u003E\u0418\u0437 \u043d\u043e\u0432\u043e\u0433\u043e, \u0432\u0441\u0435 \u0432\u0438\u0434\u0435\u043b\u0438 \u0437\u0430\u043a\u0440\u0435\u043f. \u0423 \u043c\u0435\u043d\u044f \u041e\u0427\u0415\u041d\u042c \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u043d\u0438\u044f, \u0447\u0442\u043e \u044d\u0442\u043e \u0432\u0441\u0435 \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u043d\u0435\u0439\u0440\u043e\u043d\u043a\u0430. \u0417\u043d\u0430\u044f \u044d\u043a\u0441\u0431\u043e, \u044f \u0441\u043e\u043c\u043d\u0435\u0432\u0430\u044e\u0441\u044c \u0447\u0442\u043e \u043e\u043d\u0438 \u0431\u044b \u043f\u043e\u0434\u043e\u0448\u