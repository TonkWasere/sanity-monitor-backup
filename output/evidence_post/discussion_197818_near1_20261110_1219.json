7\u0430\u0441\u0442\u0435\u0439 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u0446\u0435\u043b\u043e\u0432 \u043d\u0430 \u0414\u0438\u043a\u043e\u043c \u0421\u0435\u0432\u0435\u0440\u0435. \u003Cbr\u003E\n\u0412\u043e\u043f\u0440\u043e\u0441 \u0440\u0443\u043f\u043e\u0440\u0430\u043c \u0438\u043b\u0438 \u0442\u0435\u043c, \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442 \u0447\u0442\u043e-\u0442\u043e \u043e\u0431 \u044d\u0442\u043e\u043c -  \u041a\u0430\u043a\u043e\u0432 \u0432\u043e\u043e\u0431\u0449\u0435 \u0448\u0430\u043d\u0441 \u0432\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u0446\u0435\u043b\u043e\u0432 \u041e\u0431\u044b\u0447\u043d\u044b\u0445 \u0441\u0442\u043e\u044f\u043d\u043e\u043a \/ \u043e\u0442\u0440\u044f\u0434\u043e\u0432 \u0428\u0451\u043f\u043e\u0442\u0430? \u0411\u0430\u0437 \u0428\u0451\u043f\u043e\u0442\u0430? \u041f\u0440\u0438\u043c\u0435\u0440\u043d\u044b\u0439 \u0445\u043e\u0442\u044f \u0431\u044b . \u0411\u044b\u043b\u0438 \u043b\u0438 \u0432\u0432\u0435\u0434\u0435\u043d\u044b \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a\u0438\u0435-\u0442\u043e \u043f\u0440\u0430\u0432\u043a\u0438 \u0432\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u044f \u044d\u0442\u0438\u0445 \u0447\u0430\u0441\u0442\u0435\u0439? \u003Cbr\u003E\n\u041d\u0435\u0434\u0435\u043b\u044e \u043d\u0430\u0437\u0430\u0434 , \u043b\u0443\u0442\u0430\u044f \u0420\u044b\u0436\u0438\u0439 \u041b\u0435\u0441 \u044f \u0437\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u043f\u0440\u0438\u0446\u0435\u043b\u044b \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u043f\u0430\u0434\u0430\u044e\u0442 \u00bc - 1 \u043f\u0440\u0438\u0446\u0435\u043b \u043d\u0430 4 \u0441\u043f\u043e\u0442\u0430. \u0412\u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438. \u003Cbr\u003E\n\u041d\u0430 \u042f\u043d\u043e\u0432\u0435 \u0438 \u0417\u0430\u0442\u043e\u043d\u0435 \u044d\u0442\u0438 \u0448\u0430\u043d\u0441\u044b \u0431\u044b\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 1\/15-20 \u041c\u0418\u041d\u0418\u041c\u0423\u041c. \u003Cbr\u003E\n\u0421\u0435\u0439\u0447\u0430\u0441 \u0436\u0435 \u0431\u0435\u0433\u0430\u044f \u043f\u043e \u0420\u044b\u0436\u0435\u043c\u0443 \u041b\u0435\u0441\u0443 \u043c\u043d\u0435 \u043f\u0430\u0434\u0430\u044e\u0442 \u043f\u0440\u0438\u0446\u0435\u043b\u044b 1\/20, \u0441\u0435\u0440\u044c\u0435\u0437\u043d\u043e, \u044f \u0437\u0430 2.5 \u0447\u0430\u0441\u0430 \u0437\u0430\u0431\u0440\u0430\u043b 2 \u0447\u0430\u0441\u0442\u0438 \u041d\u0410 \u0417\u0410\u0422\u041e\u041d\u0415 \u0441 1 \u0441\u043f\u043e\u0442\u0430. \u0411\u043e\u043b\u044c\u0448\u0435 \u043c\u043d\u0435 \u0438\u0445 \u043d\u0435 \u043f\u0430\u0434\u0430\u043b\u043e \u0442\u0430\u043c \u0435\u0449\u0435 \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043c\u0438\u043d\u0443\u0442 50. \u041f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u044f \u0432\u044b\u0448\u0435\u043b \u0438\u0437 \u0438\u0433\u0440\u044b. \u003Cbr\u003E\n\u041c\u043e\u0436\u0435\u0442 \u043a\u0442\u043e \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0433\u0434\u0435 \u0432\u044b\u0433\u043e\u0434\u043d\u0435\u0435 \u0438\u043b\u0438 \u043a\u0430\u043a \u043f\u0440\u043e\u0449\u0435 \u043b\u0443\u0442\u0430\u0442\u044c \u044d\u0442\u0438 \u043f\u0440\u0438\u0446\u0435\u043b\u044b? \u041c\u043e\u0436\u0435\u0442 \u0435\u0441\u0442\u044c \u043a\u0430\u043a\u0438\u0435 \u0442\u043e \u0441\u0445\u0435\u043c\u044b, \u043c\u0435\u0442\u043e\u0434\u044b \u0438\u043b\u0438 \u0434\u0435\u0442\u0430\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043b\u0438\u044f\u044e\u0442 \u043d\u0430 \u0438\u0445 \u0432\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u0435? \u0422\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u