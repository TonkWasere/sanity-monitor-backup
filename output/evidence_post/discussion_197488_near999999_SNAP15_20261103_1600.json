41\u043d\u044b\u0445 \u0448\u043c\u043e\u0442\u043e\u043a \u043d\u0435 \u0432\u044b\u043f\u0430\u0434\u0435\u0442, \u043f\u043e\u0432\u0442\u043e\u0440\u043e\u043a \u043d\u0435 \u0431\u0443\u0434\u0435\u0442. \u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0440\u0430\u0437\u0440\u0430\u0431 \u0437\u0430 \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0435 \u041d\u0410\u0415\u0411\u0410\u041b\u041e\u0412\u041e \u0438 \u0434\u0432\u0430 \u044e\u0437\u043b\u0435\u0441\u0441 \u043c\u0430\u0433\u0430\u0437\u0430 \u043d\u0430 \u043f\u0443\u0448\u043a\u0438, \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0443\u0442\u043e \u043b\u0443\u0442\u0430\u0442\u044c \u043a\u0430\u043b, \u0432\u043c\u0435\u0441\u0442\u043e \u0445\u043e\u0442\u044f \u0431\u044b +\/- \u044e\u0437\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u0445(\u043d\u043e\u0436\u0438\u043a, \u043e\u0431\u043b\u0438\u043a\u0438 \u043d\u0430 \u043a\u0431\u0443 \u0433\u043b\u044b\u043a) \u043d\u0430\u0433\u0440\u0430\u0434.\u003C\/p\u003E\n\n\u003Cp\u003E\u0410 \u043d\u0443 \u0438 \u0434\u0430, \u0441\u043f\u0430\u0441\u0438\u0431\u043e \u0435\u0449\u0451, \u0447\u0442\u043e \u044d\u0442\u0438 \u043a\u0435\u0439\u0441\u044b \u0441 \u043a\u0430\u043a\u043e\u0433\u043e-\u0442\u043e \u0445\u0443\u044f \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043f\u043e-\u0443\u0435\u0431\u0430\u043d\u0441\u043a\u0438, \u0430 \u043d\u0435 \u043a\u0430\u043a \u0432\u0441\u0435 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e, \u043a\u0430\u043a \u0436\u0435 \u0442\u0430\u043a? \u0410\u0445 \u0434\u0430, \u0443 \u043d\u0430\u0441 \u0436\u0435 \u0432\u0430\u0441\u044f\u043d\u0441\u043a\u0430\u044f \u0441\u0431\u043e\u0440\u043a\u0430 \u043c\u043e\u0434\u043e\u0432, \u0433\u0434\u0435 \u044f\u0449\u0438\u043a\u0438 \u043a\u0430\u043a\u043e\u0433\u043e-\u0442\u043e \u0445\u0443\u044f \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043d\u0435\u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e. \u0421\u043f\u0435\u0446\u043e\u043c \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435 \u0442\u0430\u043a \u0445\u0443\u0451\u0432\u043e \u0441\u0434\u0435\u043b\u0430\u043b\u0438, \u0447\u0442\u043e\u0431 \u043d\u0435\u0433\u0430\u0442\u0438\u0432 \u0443 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432\u044b\u0437\u044b\u0432\u0430\u0442\u044c, \u0438\u043d\u0430\u0447\u0435 \u044f \u0445\u0437 \u043f\u043e\u0447\u0435\u043c\u0443 \u044f\u0449\u0438\u043a\u0438 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043d\u0435 \u043f\u043e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442 \u0441\u0445\u0435\u043c\u0435.\u003C\/p\u003E ","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":1,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"197488"}},"user":{"data":{"type":"users","id":"62053"}},"mentionedBy":{"data":[{"type":"posts","id":"4744292"}]},"likes":{"data":[]}}},{"type":"posts","id":"4744292","attributes":{"number":68,"createdAt":"2026-11-03T15:53:18+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197488-ne-smogli-smeritsya-s-porazheniem-ne-ponyatno\/66\u0022 class=\u0022PostMention\u0022 data-id=\u00224744290\u0022\u003E_VorT_\u003C\/a\u003E \u0442\u0443\u0442 \u043f\u043b\u044e\u0441\u0443\u044e\u003C\/p\