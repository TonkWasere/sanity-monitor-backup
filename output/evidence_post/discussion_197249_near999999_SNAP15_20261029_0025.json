E\u003C\/blockquote\u003E\n\n\u003Ch3\u003E\u0411\u0443\u0434\u0442\u043e \u0431\u044b \u0434\u0435\u0444\u043e\u043b\u0442\u2026\u003C\/h3\u003E\n\u003Cp\u003E\u0427\u0430\u0441\u0442\u0435\u043d\u044c\u043a\u043e \u0442\u043e\u0436\u0435 \u043f\u043e\u043f\u0430\u0434\u0430\u043b\u0438\u0441\u044c \u0442\u0430\u043a\u0438\u0435 \u0447\u0438\u043f\u0441\u0438\u043a\u0438. \u0427\u0435\u0441\u0442\u043d\u043e \u043d\u0435 \u0437\u043d\u0430\u044e, \u043a\u0430\u043a \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0443 \u0442\u0430\u043a\u043e\u0435 \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c, \u044f \u0434\u0430\u0436\u0435 \u0438\u0434\u0435\u0439 \u043d\u0435 \u043d\u0430\u043c\u0435\u0447\u0443. \u0420\u0430\u043d\u0434\u043e\u043c \u0441\u0443\u0440\u043e\u0432, \u043d\u043e \u044d\u0442\u043e \u0440\u0430\u043d\u0434\u043e\u043c. \u041d\u0430\u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u0441 \u0434\u0435\u0441\u044f\u0442\u043e\u043a \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e\u0442, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c, \u0438 \u0442\u0435, \u043a\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0431\u0435\u0433\u0430\u044e\u0442 \u0438 \u0444\u0438\u0434\u044f\u0442, \u0430 \u043f\u043e\u0442\u043e\u043c \u0432 \u0432\u043e\u0439\u0441 \u043f\u043b\u0430\u0447\u0443\u0442\u0441\u044f \u0438 \u0433\u043e\u0432\u043e\u0440\u044f\u0442, \u0447\u0442\u043e\u0431\u044b \u0438\u0433\u0440\u0443 \u0443\u0434\u0430\u043b\u0438\u043b\u0438, \u0445\u043e\u0442\u044f \u0442\u0430\u043c \u043a\u0440\u0430\u0431\u0438\u043a: \u0444\u0440\u0430\u0433 \u043d\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044c \u0434\u0435\u0437\u043e\u0432. \u0414\u0430, \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e, \u043d\u043e \u0432\u043e \u0432\u0441\u0435\u0445 \u0438\u0433\u0440\u0430\u0445 \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442\u0441\u044f.\u003C\/p\u003E \n\u003Ch3\u003E\u0412 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0438\u0433\u0440\u0435 \u043f\u0435\u0440\u0435\u0434 \u0432\u044b\u0445\u043e\u0434\u043e\u043c \u043f\u043e\u043f\u0430\u043b\u0441\u044f \u0446\u0435\u043b\u0435\u0432\u0438\u0447\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439:\u003C\/h3\u003E\n\u003Cp\u003E\u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u043c\u043e\u043b, \u0438\u0433\u0440\u0430\u0435\u0442 \u0432 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435, \u0438 \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0435 \u0445\u043e\u0447\u0435\u0442 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043a\u043e\u043c\u0430\u043d\u0434\u0435\u2026 \u044d\u044d\u044d\u2026 \u043d\u0443\u2026 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u043e\u043d \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435 \u044f\u0432\u043d\u043e\u0435, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e \u043e\u0431\u0449\u0435\u043c\u0443 \u043f\u0440\u043e\u0444\u0438\u043b\u044e \u0438 \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u0443 \u0438\u0433\u0440\u044b \u043e\u043d \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u0436\u0438\u0433\u0443\u043b\u0438. \u042f \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u043e\u0432\u0435\u0440\u044e \u0432 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0438\u0433\u0440\u0430\u0435\u0442 \u043d\u0430 \u0440\u0443\u043b\u0435, \u0430 \u043f\u0435\u0434\u0430\u043b\u0438 \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u043c\u0435\u0441\u0442\u043e \u043c\u044b\u0448\u043a\u0438. \u0418\u0431\u043e \u043d\u0435 \u043c\u043e\u0433\u0443 \u043d\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u0440\u0438\u0447\u0438\u043d \u0442\u0430\u043a\u043e\u0433\u043e \u043f\u043b\u043e\u0445\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u0432 PvPvE \u0440\u0435\u0436\u0438\u043c\u0435, \u0433\u0434\u0435 \u0435\u0433\u043e \u043a\u0440\u044b\u0441\u043a\u0438 \u0434\u0430\u0436\u0435 \u0433\u0440\u044b\u0437\u0443\u0442, \u0431\u0435\u0434\u043e\u043b\u0430\u0433\u0430.\u003C\/p\u003E\n\n\u003Ch3\u003E\u041d\u0435\u043c\u043d\u043e\u0433\u043e \u043f\u043e\u0433\u043b\u044f\u0434\u0435\u043b\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043f\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u0438\u0433\u0440 \u0438 \u043f\u0440\u0438\u0448\u043b\u0438 \u043a \u0442\u043e\u043c\u0443\u2026 \u0447\u0442\u043e\u2026\u003C\/h3\u003E\n\u003Cp\u003E\u041f\u0430\u0442\u0442\u0435\u0440\u043d \u0431\u0443\u0434\u0442\u043e \u0431\u044b \u0442\u0430\u043a\u043e\u0432, \u0447\u0442\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043e\u0442\u0447\u0430\u0441\u0442\u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0433\u0440\u044b, \u043e\u0442\u0447\u0435\u0433\u043e \u043f\u043e\u0431\u0435\u0434\u044b \u043f\u0440\u0438\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043a \u0447\u0438\u0441\u043b\u0443 \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u0439. \u041f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u0431\u0449\u0435\u043c \u043f\u044f\u0442\u044c\u0434\u0435\u0441\u044f\u0442 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043e\u0432 \u0432\u0438\u043d\u0440\u0435\u0439\u0442.\u003C\/p\u003E\n\n\u003Ch3\u003E\u0414\u043e\u0431\u0430\u0432\u043b\u044e \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0442\u0435\u0439\u043a:\u003C\/h3\u003E\n\u003Cp\u003E\u0427\u0435\u0442\u0432\u0435\u0440\