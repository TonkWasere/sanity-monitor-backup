38 \u0440\u0430\u0437\u0443 \u043d\u0435 \u0441\u0434\u0430\u043b\u0438\u0441\u044c, \u0434\u0430\u0436\u0435 \u043a\u043e\u0433\u0434\u0430 \u0448\u0430\u043d\u0441\u043e\u0432 \u043d\u0430 \u043f\u043e\u0431\u0435\u0434\u0443 0.\u003Cbr\u003E\n\u0415\u0441\u043b\u0438 \u0442\u044b \u043f\u043e\u043f\u0430\u043b\u0441\u044f \u0441 \u043f\u0438\u0432\u0430\u0441\u043e\u0441\u0430\u043c\u0438, \u0442\u043e \u044d\u0442\u0430 \u043a\u043d\u043e\u043f\u043a\u0430 \u043d\u0435 \u043f\u043e\u043c\u043e\u0436\u0435\u0442, \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0438\u0433\u0440\u0430\u0442\u044c \u0434\u043e \u043a\u043e\u043d\u0446\u0430.\u003Cbr\u003E\n\u0423 \u043c\u0435\u043d\u044f \u0431\u044b\u043b\u0430 \u043a\u0430\u0442\u043a\u0430 \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0447\u0435\u043b\u044b \u0437\u0430\u0448\u043b\u0438 \u0441 \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a\u0430\u043c\u0438 \u043f\u043e\u0441\u0442\u0440\u0435\u043b\u044f\u0442\u044c \u043a\u0430\u0431\u0430\u043d\u0447\u0438\u043a\u043e\u0432. \u042f \u0432 \u043f\u0435\u0440\u0432\u043e\u043c \u0440\u0430\u0443\u043d\u0434\u0435 \u0443\u0432\u0438\u0434\u0435\u043b \u0447\u0442\u043e \u043f\u0430\u0440\u043e\u0447\u043a\u0430 \u0432\u0437\u044f\u043b\u0430 \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a\u0438, \u044f \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b \u0441\u043c\u0435\u043d\u0438\u0442\u044c \u043d\u0430 \u043b\u044e\u0431\u043e\u0435 \u0434\u0440\u0443\u0433\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435. \u041d\u0430 \u0447\u0442\u043e \u0447\u0435\u043b \u0441\u043a\u0430\u0437\u0430\u043b \u0447\u0442\u043e \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a \u043a\u0430\u0447\u043d\u0435\u0442 \u0434\u043e \u041a\u043e\u043c\u0440\u0430\u0434\u0430, \u0430 \u043f\u043e\u0442\u043e\u043c \u0432\u043e\u0437\u044c\u043c\u0435\u0442 \u0434\u0440\u0443\u0433\u043e\u0439 \u0433\u0430\u043d (\u043a\u0430\u043a?) \u0438 \u0447\u0442\u043e \u0432\u043e\u043e\u0431\u0449\u0435 \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a \u0438\u043c\u0431\u0430)))\u003Cbr\u003E\n\u041a\u043e\u0433\u0434\u0430 \u044f \u0443\u0432\u0438\u0434\u0435\u043b \u0446\u0438\u0444\u0440\u044b \u0441\u0442\u0430\u0442\u044b \u043f\u043e\u0441\u043b\u0435 2 \u041f\u0412\u041f \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 2 \u043a\u0438\u043b\u043b\u0430, 14 \u0441\u043c\u0435\u0440\u0442\u0435\u0439, 2000 \u0443\u0440\u043e\u043d\u0430 \u043f\u043e \u0440\u0435\u043b\u0438\u043a\u0432\u0438\u0438 \u0437\u0430 2 \u041f\u0412\u041f \u0440\u0430\u0443\u043d\u0434\u0430, \u0442\u043e \u0441\u043f\u0440\u043e\u0441\u0438\u043b \u0435\u0433\u043e, \u0433\u0434\u0435 \u0436\u0435 \u0438\u043c\u0431\u043e\u0432\u043e\u0441\u0442\u044c \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a\u0430. \u0410 \u043e\u043d \u043e\u0442\u0432\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u043a\u0430\u0431\u0430\u043d\u0447\u0438\u043a\u043e\u0432 \u0448\u043e\u0442\u0430\u0435\u0442)) \u0418 \u0442\u0430\u043a\u0438\u0445 \u0431\u044b\u043b\u043e \u0432\u0440\u043e\u0434\u0435 2, \u0441\u0434\u0430\u0432\u0430\u0442\u044c\u0441\u044f \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u043e\u043d\u0438 \u043d\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0438\u0441\u044c, \u043a\u0430\u0431\u0430\u043d\u044b \u0435\u0449\u0435 \u043d\u0435 \u0432\u0441\u0435 \u043e\u0442\u0441\u0442\u0440\u0435\u043b\u0435\u043d\u044b.\u003C\/p\u003E","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":2,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,