0447\u0442\u043e\u0431\u044b \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0442\u044c, \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0442\u044c, \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0442\u044c \u0438 \u043d\u0430\u0439\u0442\u0438 \u0438\u0434\u0435\u0430\u043b. \u041d\u0435\u0442.\u003Cbr\u003E\n\u0412 \u0438\u0433\u0440\u0435 \u0443\u0441\u0442\u0440\u043e\u0435\u043d\u043e \u0442\u0430\u043a, \u0447\u0442\u043e \u0432 \u043e\u0434\u0438\u043d \u0442\u0430\u0439\u043c\u0438\u043d\u0433 \u0445\u043e\u0440\u043e\u0448\u0438 \u0432\u043e\u0442 \u044d\u0442\u0438 \u043f\u0443\u0448\u043a\u0438, \u0442\u044b \u0438\u0445 \u0431\u0430\u0440\u0442\u0435\u0440\u0438\u0448\u044c\/\u043f\u043e\u043a\u0443\u043f\u0430\u0435\u0448\u044c\/\u0432\u044b\u0431\u0438\u0432\u0430\u0435\u0448\u044c\/\u0442\u043e\u0447\u0438\u0448\u044c \u0438 \u0438\u0433\u0440\u0430\u0435\u0448\u044c \u0441 \u043d\u0438\u043c\u0438. \u0412 \u0434\u0440\u0443\u0433\u043e\u0439 \u0442\u0430\u0439\u043c\u0438\u043d\u0433 - \u0434\u0430\u0435\u043c \u043f\u043e\u0438\u0433\u0440\u0430\u0442\u044c \u0440\u0435\u0431\u044f\u0442\u0430\u043c \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0433\u0430\u043d\u0430\u043c\u0438, \u043f\u043e\u043d\u0438\u0437\u0438\u0432 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0435.\u003Cbr\u003E\n\u0418 \u0442\u044b, \u0431\u0435\u0433\u0430\u044f \u0437\u0430 \u0442\u043e\u0439 \u0441\u0430\u043c\u043e\u0439 \u201c\u043c\u0435\u0442\u043e\u0439\u201d, \u043c\u043e\u0436\u0435\u0448\u044c \u0438 \u0441\u0430\u043c \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u0442\u044c, \u043a\u0430\u043a \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0445\u0435\u0440\u043e\u0432\u0443 \u0442\u0443\u0447\u0443 \u0433\u0430\u043d\u043e\u0432 (\u043a\u0430\u043a \u044f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440) \u0438 \u043a\u043e\u0433\u0434\u0430 \u043d\u0430\u0441\u0442\u0430\u0435\u0442 \u0442\u043e\u0442 \u0441\u0430\u043c\u044b\u0439 \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u044b\u0439 \u043f\u0430\u0442\u0447, \u0442\u043e \u0442\u044b \u0435\u0433\u043e \u0436\u0434\u0435\u0448\u044c \u0431\u0435\u0437 \u043a\u0430\u043a\u043e\u0439-\u043b\u0438\u0431\u043e \u0442\u0440\u044f\u0441\u043a\u0438, \u043d\u0435 \u0431\u043e\u0438\u0448\u044c\u0441\u044f, \u0447\u0442\u043e \u0442\u0432\u043e\u0439 \u043b\u044e\u0431\u0438\u043c\u044b\u0439 \u0433\u043e\u0440\u043e\u0445\u043e\u0441\u0442\u0440\u0435\u043b \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439 \u0440\u0430\u0437 \u043c\u0430\u043a\u043d\u0443\u0442, \u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043e\u0441\u0442\u0430\u0435\u0448\u044c \u0434\u0440\u0443\u0433\u0443\u044e \u043f\u0443\u0448\u043a\u0443 \u0441 \u043f\u0435\u0440\u0441. \u0441\u043a\u043b\u0430\u0434\u0430, \u043d\u0430\u0434\u0435\u0432\u0430\u0435\u0448\u044c \u043d\u0430 \u043d\u0435\u0435 \u043e\u0431\u0432\u0435\u0441\u044b \u0438 \u0431\u0435\u0433\u0430\u0435\u0448\u044c \u0434\u043e \u043d\u0435\u043a\u0441\u0442 \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u043e\u0433\u043e \u043f\u0430\u0442\u0447\u0430.\u003Cbr\u003E\n\u0418\u0437 \u0440\u0430\u0437\u0430 \u0432 \u0440\u0430\u0437 \u0432\u0441\u0435 \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0435\u0442\u0441\u044f. \u003Cspan class=\u0022spoiler\u0022 onclick=\u0022removeAttribute(\u0027class\u0027)\u0022\u003E\u0412\u044b \u0437\u043d\u0430\u0435\u0442\u0435 \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0431\u0435\u0437\u0443\u043c\u0438\u0435, \u043a\u0441\u0442\u0430?\u003C\/span\u003E\u003Cbr\u003E\n\u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u0444\u0438\u0433\u0430\u0447 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u043e\u0433\u043e \u0440\u043e\u0434\u0430 \u043f\u0443\u0448\u043a\u0438 (\u0434\u0430\u0436\u0435 \u0441\u043a\u043e\u0440\u0435\u0435 \u043d\u0435 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0443\u0448\u043a\u0438, \u0430 \u0438\u0445 \u0448\u0430\u0431\u043b\u043e\u043d\u044b), \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0442\u043e\u043c \u0432\u043e\u0442 \u0442\u0430\u043a \u043d\u0435 \u0433\u043e\u0440\u0435\u0432\u0430\u0442\u044c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0417\u0430 \u0421\u043a\u043e\u0440\u043f\u0438\u043e\u043d \u043e\u0431\u0438\u0434\u043d\u043e, \u0442\u0443\u0442 \u0441\u044b\u0433\u043b\u044b. \u041a \u0442\u043e\u043c\u0443 \u043c\u043e\u043c\u0435\u043d\u0442\u0443, \u043a\u043e\u0433\u0434\u0430 \u044f \u0435\u0433\u043e \u0432\u044b\u0431\u0438\u043b, \u0442\u043e \u043e\u043d \u0443\u0436\u0435 \u043a\u0440\u044f\u0445\u0442\u0435\u043b. \u041f\u0435\u0440\u0435\u0434 \u043b\u0430\u0441\u0442 \u0431\u0430\u043b\u0430\u043d\u0441\u043d\u044b\u043c \u044f \u0435\u0449\u0435 \u0432\u0435\u0440\u0438\u043b \u0435\u043c\u0443. \u0422\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0432\u0435\u0440\u044e. \u041c\u043e\u0436\u0435\u0442 \u044d\u0442\u043e \u043d\u0435 \u0442\u0430\u043a \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e \u0438 \u0432\u0441\u0435 \u0442\u0430\u043a\u043e\u0435. \u041d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0445\u043e\u0447\u0443 \u0435\u0433\u043e \u0431\u0440\u0430\u0442\u044c \u0432 \u0440\u0443\u043a\u0438.\u003Cbr\u003E\n\u0410 \u0435\u0441\u043b\u0438 \u043e \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u043c, \u0442\u043e \u043e \u043c\u043e\u043c\u0435\u043c\u0443 \u043c\u043d\u0435\u043d\u0438\u044e \u0433\u0440\u0430\u0434\u0430\u0446\u0438\u044f \u0433\u0430\u043d\u043e\u0432 \u043e\u0442 \u0431\u043e\u043b\u044c\u0448\u0435\u0433\u043e \u043a \u043c\u0435\u043d\u044c\u0448\u0435\u043c\u0443 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u0442\u0430\u043a\u043e\u0432\u0430 \u0438 \u043e\u0442 \u043d\u0435\u0435 \u043d\u0443\u0436\u043d\u043e \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0431\u0430\u043b\u0430\u043d\u0441:\u003Cbr\u003E\n\u0413\u0430\u043d\u044b \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0439 \u0441\u0435\u0440\u0438\u0438 (\u0440\u0430\u0437\u0434\u0430\u0447\u0430 \u0431\u0430\u0440\u043e\u043d\u0430, \u0437\u0430\u043a\u0430\u0437 \u0438\u0437-\u0437\u0430 \u041f\u0435\u0440\u0438\u043c\u0435\u0442\u0440\u0430)\u003Cbr\u003E\n\u0413\u0430\u043d\u044b \u0441 \u041a\u0412 \u0438 \u0433\u0430\u043d\u044b \u0441 \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432\u003Cbr\u003E\n\u0411\u0430\u0440\u0442\u0435\u0440\u043d\u044b\u0435 \u0433\u0430\u043d\u044b\u003Cbr\u003E\n\u0413\u0430\u043d\u044b \u0441 \u043a\u0435\u0439\u0441\u043e\u0432\u003Cbr\u003E\n\u0413\u0430\u043d\u044b \u0437\u0430 \u0431\u043f, \u0438\u0432\u0435\u043d\u0442\u044b\u003Cbr\u003E\n\u041d\u043e \u0442\u0430\u043a \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0438 \u044f \u0443\u0436\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043f\u043e\u0447\u0435\u043c\u0443. \u0418\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e, \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0433\u043e \u0431\u0430\u043b\u0430\u043d\u0441\u0430 \u043d\u0435-\u0431\u0443-\u0434\u0435\u0442. \u041f\u0440\u043e\u0441\u0442\u043e \u043a\u043e\u0433\u0434\u0430 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043d\u0443\u0442 \u0431\u0435\u0433\u0430\u0442\u044c \u0441 \u0442\u043e\u0439 \u0438\u043b\u0438 \u0438\u043d\u043e\u0439 \u043f\u0443\u043a\u0430\u043b\u043a\u043e\u0439, \u0434\u0430 \u0434\u0430\u0436\u0435 \u0441 \u0442\u0435\u043c \u0436\u0435 \u0421\u043a\u043e\u0440\u043f\u043e\u043c, \u0442\u043e \u043c\u044b \u0435\u0433\u043e \u0441\u043d\u043e\u0432\u0430 \u0443\u0432\u0438\u0434\u0438\u043c \u0436\u0438\u0432\u0435\u043d\u044c\u043a\u0438\u043c \u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u0435\u043d\u044c\u043a\u0438\u043c. \u041f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 \u044f \u043d\u0430 \u044d\u0442\u043e \u043d\u0430\u0434\u0435\u044e\u0441\u044c.\u003C\/p\u003E\n","renderFailed":false,"canEdit":false,"canDe