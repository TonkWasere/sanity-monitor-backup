40\u043e\u0432\u0430\u0432\u044b\u0439 \u0434\u043e\u0436\u0434\u044c:\u003C\/strong\u003E \u0438\u0437-\u0437\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439 \u043a\u0440\u044b\u0448\u0438 \u0430\u0440\u0435\u043d\u044b \u0438\u0434\u0451\u0442 \u044d\u0444\u0444\u0435\u043a\u0442 \u00ab\u043a\u0440\u043e\u0432\u0430\u0432\u043e\u0433\u043e \u0434\u043e\u0436\u0434\u044f\u00bb, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043a\u0430\u043a \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b \u0443\u043c\u0438\u0440\u0430\u044e\u0449\u0435\u0439 \u0432\u0438\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u044b - \u0440\u0435\u0437\u043a\u0438\u0435 \u043a\u0440\u0430\u0441\u043d\u044b\u0435 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u043b\u043e\u0441\u044b. \u042d\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u0451\u0442 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435, \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u0431\u0430\u0433\u0438 \u0443\u0441\u0443\u0433\u0443\u0431\u043b\u044f\u044e\u0442 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435 \u043d\u0435\u0434\u043e\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u043e\u0441\u0442\u0438 \u0440\u0435\u0436\u0438\u043c\u0430 \u0438 \u043f\u043e\u0440\u0442\u044f\u0442 \u043e\u0431\u0449\u0443\u044e \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u0421\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u043e\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435:\u003C\/strong\u003E \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u044f \u043e\u043a\u0443\u043f\u0430\u044e\u0442\u0441\u044f \u043e\u0447\u0435\u043d\u044c \u0434\u043e\u043b\u0433\u043e. \u0412 \u0438\u0433\u0440\u0430\u0445 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e 15-25 \u0440\u0430\u0443\u043d\u0434\u043e\u0432 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u044f \u043f\u043e\u0447\u0442\u0438 \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u044b, \u0442\u0430\u043a \u043a\u0430\u043a \u0440\u0430\u0437\u043d\u0438\u0446\u0430 \u0432 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0438 \u0438 \u0435\u0433\u043e \u0433\u0440\u0435\u0439\u0434\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043f\u043e\u0433\u0440\u0435\u0448\u043d\u043e\u0441\u0442\u0438, \u043d\u043e \u043e\u043d\u0438 \u043e\u0442\u043d\u0438\u043c\u0430\u044e \u043f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e \u043d\u0430 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u0430\u0443\u043d\u0434\u0430\u0445.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u041d\u0430\u0433\u0440\u0430\u0434\u044b:\u003C\/strong\u003E \u0437\u0430 20-35 \u043c\u0438\u043d\u0443\u0442 \u0438\u0433\u0440\u044b \u0432\u044b\u0434\u0430\u0451\u0442\u0441\u044f 70-90 \u0442\u044b\u0441\u044f\u0447 \u0440\u0443\u0431\u043b\u0435\u0439, \u0447\u0442\u043e \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u0441\u043a\u0443\u0434\u043d\u043e, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b \u0438 \u043e\u0431\u0432\u0435\u0441\u044b (\u043c\u0430\u0433\u0430\u0437\u0438\u043d \u043d\u0430 45 \u043f\u0430\u0442\u0440\u043e\u043d\u043e\u0432, \u0438\u0434\u0443\u0449\u0438\u0439 \u043d\u0430 \u0434\u0432\u0430 \u043e\u0440\u0443\u0436\u0438\u044f, \u0438 \u0431\u0443\u0434\u0443\u0447\u0438 \u043b\u0443\u0447\u0448\u0435 \u043b\u0438\u0448\u044c \u043d\u0430 0,3% \u043b\u0443\u0447\u0448\u0435 \u0431\u0430\u0440\u0442\u0435\u0440\u043d\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u043e\u0433\u0430, \u043d\u0435 \u0432 \u0441\u0447\u0451\u0442). \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u0434\u043e\u0445\u043e\u0434, \u0447\u0442\u043e\u0431\u044b \u0443 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0431\u044b\u043b \u0441\u0442\u0438\u043c\u0443\u043b \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u0430\u0440\u044b \u043c\u0430\u0442\u0447\u0435\u0439.\u003Cbr\u003E\n\u003Cstrong\u003E\u0414\u0438\u0441\u0431\u0430\u043b\u0430\u043d\u0441 \u0442\u0430\u043a\u0442\u0438\u043a:\u003C\/strong\u003E \u0438\u0433\u0440\u043e\u043a\u0438 \u0438\u0437 PvP-\u0440\u0430\u0443\u043d\u0434\u0430 \u0447\u0430\u0441\u0442\u043e \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044e\u0442 \u0431\u043e\u0439 \u0432 \u00ab\u0441\u043f\u0443\u0441\u0442\u0438\u0441\u044c \u0432\u043d\u0438\u0437 \u0432 \u0431\u0438\u043e, \u0432\u0441\u0442\u0430\u043d\u044c \u043d\u0435\u0437\u0430\u043c\u0435\u0442\u043d\u043e \u0438 \u043d\u0430\u0441\u0442\u0443\u043a\u0438\u0432\u0430\u0439 \u0441 \u041f\u041a\u041f\u00bb. \u042d\u0442\u043e \u0441\u043d\u0438\u0436\u0430\u0435\u0442 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435 \u0438 \u0434\u0435\u043b\u0430\u0435\u0442 PvP \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u044b\u043c \u0438 \u043f\u043e\u043e\u0449\u0440\u044f\u0435\u0442 \u043a\u0435\u043c\u043f\u0438\u043d\u0433.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u0411\u044b\u0441\u0442\u0440\u043e\u0435 \u0432\u044b\u0433\u043e\u0440\u0430\u043d\u0438\u0435:\u003C\/strong\u003E \u043f\u0435\u0440\u0432\u044b\u0435 3 \u0438\u0433\u0440\u044b \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0437\u0430\u0431\u0430\u0432\u043d\u044b\u043c\u0438, \u043d\u043e \u0434\u0430\u043b\u0435\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0435 \u043c\u0435\u0441\u0438\u0432\u043e \u043c\u0443\u0442\u0430\u043d\u0442\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043c\u043e\u0433\u0443\u0442 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0443, \u043d\u043e \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u044e\u0442 \u0441\u043f\u0430\u0432\u043d\u043e\u043c \u0441\u043d\u0430\u0439\u043f\u0435\u0440\u043e\u0432 \u043d\u0430 2-\u043c \u044d\u0442\u0430\u0436\u0435. \u042d\u0442\u043e \u0441\u0438\u043b\u044c\u043d\u043e \u0437\u0430\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439: \u2157 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043e\u0449\u0443\u0449\u0430\u044e\u0442\u0441\u044f \u043a\u0430\u043a \u0440\u0443\u0442\u0438\u043d\u0430. (\u0418\u043c\u0445\u043e \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u044c \u043a\u043e\u043b-\u0432\u043e \u0440\u0430\u0443\u043d\u0434\u043e\u0432 \u0434\u043e 3 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 PvE-\u0411\u043e\u0441\u0441-PvP \u0438\u043b\u0438 \u0434\u043e 4 \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 PvE-\u0411\u043e\u0441\u0441-PvP-\u0414\u0443\u044d\u043b\u044c \u044d\u0442\u043e \u0434\u0430\u0441\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438, \u0430 \u043d\u0430\u0433\u0440\u0430\u0434\u0443 \u0437\u0430 \u0432\u044b\u0440\u0435\u0437\u0430\u043d\u043d\u044b\u0435 \u0440\u0430\u0443\u043d\u0434\u044b \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044f)\u003C\/p\u003E\n\n\u003Cp\u003E\u0412 \u0446\u0435\u043b\u043e\u043c \u0431\u0430\u043b\u0430\u043d\u0441 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e\u0432\u0435\u0440\u044f\u0442\u044c \u0418\u0418-\u0430\u0433\u0435\u043d\u0442\u0443, \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u0441\u0443\u0434\u044f \u043f\u043e \u0432\u0441\u0435\u043c\u0443, \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u043b \u0440\u0435\u0436\u0438\u043c \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u0435 \u0441\u0442\u043e\u0438\u0442. \u041f\u0440\u043e\u0439\u0434\u0435\u043c\u0441\u044f \u043f\u043e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f\u043c:\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u0411\u0440\u043e\u043d\u044f\u003C\/strong\u003E - \u0432\u0440\u043e\u0434\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e, \u043d\u043e \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u043e\u0433\u043e \u0431\u0440\u043e\u043d\u0435\u0436\u0438\u043b\u0435\u0442\u0430.\u003Cbr\u003E\n\u003Cstrong\u003E\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435\u003C\/strong\u003E \u2010 \u0432\u0435\u0442\u043a\u0438 \u043d\u0435 \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u044b, \u043e\u0440\u0443\u0436\u0438\u044f \u043c\u0430\u043b\u043e. \u041d\u0438\u043a\u0442\u043e \u043d\u0435 \u043c\u0435\u0448\u0430\u0435\u0442 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0438\u0437 \u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u043e\u0433\u043e \u0433\u0430\u043d\u0430 \u0434\u0432\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0438\u0445 \u043e\u0440\u0443\u0436\u0438\u044f (\u0443\u0441\u043b\u043e\u0432\u043d\u043e). \u0421\u0443\u043f\u0435\u0440\u0441\u0438\u0442\u0443\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u043f\u0443\u0448\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0447\u0442\u0438 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442 (\u043f\u0440\u0438\u0432\u0435\u0442 SIG MPX), \u0438 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442 - \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0435 (\u043f\u0440\u0438\u0432\u0435\u0442 \u0421\u0430\u0439\u0433\u0430 \u0438 \u041f\u041a\u041f). \u0421 \u0431\u0430\u043b\u0430\u043d\u0441\u043e\u043c \u0438 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435\u043c \u0431\u0435\u0434\u0430.\u003Cbr\u003E\n\u003Cstrong\u003E\u041d\u043e\u0436\u003C\/strong\u003E - \u0434\u0443\u043c\u0430\u044e, \u0432\u0441\u0435 \u043f\u0440\u043e\u0434\u0430\u044e\u0442 \u0435\u0433\u043e \u0432 \u043d\u0430\u0447\u0430\u043b\u0435, \u0438 \u0432\u0441\u0435\u043c \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e. \u0422\u0430\u043a \u0447\u0442\u043e \u0434\u0430, \u043d\u043e\u0436\u0438 \u043d\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u0440\u043e\u043b\u0438.\u003Cbr\u003E\n\u003Cstrong\u003E\u0412\u0442\u043e\u0440\u0438\u0447\u043a\u0430\u003C\/strong\u003E - \u0432\u044b\u043f\u0430\u043b\u0430 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0430\u044f \u0432\u0442\u043e\u0440\u0438\u0447\u043a\u0430, \u043a\u043e\u0433\u0434\u0430 \u0443 \u0432\u0441\u0435\u0445 \u0432 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u043f\u043e \u043f\u0430\u043b\u0430\u0442\u0435 \u0441\u0438\u043d\u0438\u0439 \u0433\u0430\u043d +10 \u2014 \u0438 \u0432\u0441\u0451, \u0434\u0432\u0443\u0448\u043e\u0442-\u0443\u0431\u0438\u0439\u0446\u0430 \u043b\u0435\u0442\u0438\u0442 \u043f\u043e \u043a\u0430\u0440\u0442\u0435. \u0411\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u044b\u0439 \u043a\u043b\u0438\u043d \u043f\u0435\u0440\u043d\u0430\u0447\u0430 \u0438 \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u0414\u0438\u0433\u043b, \u043d\u0430\u043f\u043e\u043c\u043d\u044e: \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043e (TTK) \u044d\u0442\u043e\u0433\u043e \u043f\u0438\u0441\u0442\u043e\u043b\u0435\u0442\u0430 \u0432 \u0443\u043f\u043e\u0440\u0435 \u043b\u0443\u0447\u0448\u0435, \u0447\u0435\u043c \u0443 \u041b\u042e\u0411\u041e\u0413\u041e \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043e\u0440\u0443\u0436\u0438\u044f.\u003Cbr\u003E\n\u003Cstrong\u003E\u0410\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b\u003C\/strong\u003E - \u0432\u0435\u0441\u044c \u0444\u0430\u043d \u0441 \u00ab\u043e\u0442\u0441\u00bb \u043f\u043e\u0440\u0435\u0437\u0430\u043b\u0438. \u0415\u0441\u043b\u0438 \u0432\u0430\u043c\u043f\u0438\u0440\u0438\u0437\u043c \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u043d\u043e \u043f\u043e\u043d\u0435\u0440\u0444\u0438\u043b\u0438, \u0442\u043e \u0437\u0430\u0447\u0435\u043c \u0442\u0440\u043e\u0433\u0430\u0442\u044c \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c? \u0414\u0430 \u0438 \u0441\u0430\u043c \u0432\u043c\u043f\u0438\u0440\u0438\u0437\u043c \u043c\u043e\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u043e\u0440\u0435\u0437\u0430\u0442\u044c \u043d\u0435 \u0434\u043e 25%, \u0430 \u0438\u043d\u0430\u0447\u0435.\u003Cbr\u003E\n\u0410\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b, \u0434\u0430\u044e\u0449\u0438\u0435 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0435\u0431\u0430\u0444\u0444\u044b, \u0437\u0430\u0447\u0435\u043c: \u0432\u044b \u0436\u0435 \u043d\u0435 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u043c \u043c\u0438\u0440\u0435 \u0438\u0445 \u0432\u0432\u043e\u0434\u0438\u0442\u0435. \u0414\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b \u0431\u0435\u0437 \u0434\u0435\u0431\u0430\u0444\u0444\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0436\u043d\u043e \u043a\u043e\u043c\u0431\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u0430\u043a \u0443\u0433\u043e\u0434\u043d\u043e. \u041d\u0435\u0442 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0439 - \u043d\u0435\u0442 \u043f\u0440\u0438\u0447\u0438\u043d \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u042f\u0442\u044c - \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u0430\u044f \u0442\u0435\u043c\u0430, \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u0432\u044b\u043f\u0430\u0432\u0448\u0438\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442 \u0434\u0430\u0435\u0442 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 power spike. \u0417\u0430\u0447\u0435\u043c \u0443\u0440\u0435\u0437\u0430\u0442\u044c \u0440\u0435\u0438\u0433\u0440\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0431\u0435\u0437 \u0442\u043e\u0433\u043e \u0443\u043d\u044b\u043b\u043e\u0433\u043e \u0438\u0432\u0435\u043d\u0442\u0430?\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u0414\u0438\u043d\u0430\u043c\u0438\u043a\u0430\u003C\/strong\u003E - \u043e\u0447\u0435\u043d\u044c \u0442\u0443\u0441\u043a\u043b\u0430\u044f \u0438\u0437-\u0437\u0430 \u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u0442\u0443\u0433\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0438\u0438, \u0441\u043c\u0435\u0448\u0435\u043d\u0438\u044f PvP \u0438 PvE, \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u0434\u0443\u044d\u043b\u0435\u0439.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u041e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u043e \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u003C\/strong\u003E - \u0438\u0432\u0435\u043d\u0442 \u0441 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u043c, \u0438 \u043f\u0438\u0441\u0430\u0442\u044c, \u0447\u0442\u043e PvE-\u043a\u0440\u0430\u0431\u0438\u043a \u0432 \u0434\u0443\u044d\u043b\u0438 \u043f\u0440\u043e\u0438\u0433\u0440\u0430\u0435\u0442 - \u0431\u0435\u0441\u0441\u043c\u044b\u0441\u043b\u0435\u043d\u043d\u043e. \u0421\u0443\u0442\u044c \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u0432\u044b \u0431\u0443\u0434\u0435\u0442\u0435 \u0441\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u0441 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0440\u0430\u0432\u043d\u044b\u043c \u043f\u043e \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0443 \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u043c \u0435\u0441\u043b\u0438 \u0436\u0435 \u0432\u044b \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u0435\u0442\u0435 \u0434\u0443\u044d\u043b\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0442\u043e \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u0432\u0430\u0448 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u0438 \u0432\u0430\u0441 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u043e\u0442\u0430\u0449\u0438\u043b\u0438. \u0417\u0430 300 \u043c\u0430\u0442\u0447\u0435\u0439 \u0432 \u041a\u043e\u043b\u0438\u0437\u0435\u0435 (\u043e\u0442\u043a\u0443\u0434\u0430 \u0441\u043b\u0438\u0437\u0430\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430) \u043c\u043d\u0435 \u043d\u0438 \u0440\u0430\u0437\u0443 \u043d\u0435 \u043f\u043e\u043f\u0430\u0434\u0430\u043b\u0441\u044f \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a \u0441 \u0431\u043e\u043b\u044c\u0448\u0438\u043c \u0440\u0430\u0437\u0431\u0440\u043e\u0441\u043e\u043c - \u0435\u0441\u043b\u0438 \u0442\u044b, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043d\u0435 \u0430\u0431\u044c\u044e\u0437\u0435\u0440. \u0420\u0435\u0438\u0433\u0440\u0430\u0431\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0447\u0442\u0438 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u043e \u043f\u0440\u0438\u0447\u0438\u043d\u0430\u043c, \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u043c \u0432\u044b\u0448\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u0414\u0435\u0444\u0438\u0446\u0438\u0442 \u0442\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043a\u0430\u0441\u0442\u043e\u043c\u0438\u0437\u0430\u0446\u0438\u0438, \u0432\u044b\u0434\u0430\u0439\u0442\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043c\u0435\u043d\u044f\u0442\u044c \u043f\u0430\u0442\u0440\u043e\u043d\u044b \u0438 \u043c\u043e\u0434\u0443\u043b\u0438 \u043d\u0430 \u043b\u044e\u0431\u044b\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0435\u0441\u0442\u044c \u0432 \u0438\u0433\u0440\u0435 \u0438 \u043f\u0440\u0438\u0432\u044f\u0436\u0438\u0442\u0435 \u0440\u0430\u043d\u0433 \u043c\u043e\u0434\u0443\u043b\u0435\u0439 \u043a \u0440\u0430\u043d\u0433\u0443 \u043e\u0440\u0443\u0436\u0438\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u041d\u0435\u0442 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u043e\u0439 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0438 - \u041a\u0440\u043e\u043c\u0435 \u0434\u0435\u043d\u0435\u0433 \u0438 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447 \u043d\u0435\u0442 \u0447\u0435\u043b\u043b\u0435\u043d\u0434\u0436\u0435\u0439 \u0438 \u043f\u0440\u0438\u0447\u0438\u043d \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f.\u003C\/p\u003E \n\n\u003Cp\u003E\u0418\u0442\u043e\u0433 \u043f\u0440\u043e\u0441\u0442, \u0438\u0432\u0435\u043d\u0442 \u043d\u0435 \u043f\u043b\u043e\u0445\u043e\u0439, \u043e\u043d \u0441\u043a\u0443\u0447\u043d\u044b\u0439, \u043d\u0435\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0438, \u043d\u0435\u0442 \u0430\u0437\u0430\u0440\u0442\u0430, \u043d\u0435\u0442 \u0441\u0442\u0438\u043c\u0443\u043b\u0430, \u0438\u0442\u043f. \u042f \u0431\u044b \u0441\u043a\u0430\u0437\u0430\u043b \u0442\u0430\u043a, \u0438\u0432\u0435\u043d\u0442 \u0440\u0430\u0434\u0438 \u0438\u0432\u0435\u043d\u0442\u0430. \u041d\u0430\u0434\u0435\u044e\u0441\u044c \u