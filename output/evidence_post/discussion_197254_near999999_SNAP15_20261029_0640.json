4f\u0442\u0441\u044f, \u0430 \u043d\u0435 \u0438\u0437-\u0437\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430\u003Cbr\u003E\n\u043f\u0435\u0440\u0432\u044b\u0439 \u043a\u0435\u043d\u0442 \u043b\u0438\u0432\u043d\u0443\u043b \u043d\u0430 \u0431\u0430\u0440\u0435, \u0437\u0430\u0435\u0431\u0430\u043b\u0441\u044f \u0434\u043e\u043b\u0431\u0438\u0442\u044c \u043e\u0447\u0435\u043d\u044c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e \u0441\u043f\u043e\u0442\u044b \u043d\u0430 \u043a\u0440\u0430\u0444\u0442 \u0445\u0443\u0439\u043d\u0438, \u0441\u043a\u0438\u043f\u043d\u0443\u0442\u044c \u0431\u043e\u043b\u043e\u0442\u043d\u0438\u043a \u0442\u0438\u043f \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442, \u0434\u0430\u0436\u0435 \u043d\u0430 \u0432\u0435\u0442 \u0448\u043c\u043e\u0442 \u0441 \u0430\u0440\u043c\u043e\u0432, \u043d\u0443\u0436\u043d\u043e \u043e\u043a\u043e\u043b\u043e \u0431\u043b\u044f\u0442\u044c 5-10\u043a \u043e\u0431\u043c\u0435\u043d\u043e\u043a, \u0442\u0438\u043f \u0441 \u043d\u0443\u043b\u0435\u0432\u044b\u043c \u0430\u043a\u043a\u043e\u043c \u0438\u0445 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u003Cbr\u003E\n\u0432\u0442\u043e\u0440\u043e\u0439 \u043b\u0438\u0432\u043d\u0443\u043b \u0438\u0437-\u0437\u0430 \u0430\u0445\u0443\u0435\u043d\u043d\u043e \u0440\u0435\u0433\u0438 + \u0432\u0435\u0447\u043d\u043e\u0433\u043e \u043f\u0432\u043f \u043d\u0430 \u0435\u0431\u0430\u043d\u043e\u043c \u0431\u0430\u0440\u0435\u003Cbr\u003E\n\u0442\u0440\u0435\u0442\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438 \u0436\u0438\u0437\u043d\u0438, \u043d\u043e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e, \u0447\u0442\u043e \u0438\u0433\u0440\u0430\u0435\u0442 \u043e\u043d\u043b\u0438 \u043d\u0433 \u0438 \u041e\u0427\u0415\u0415\u041d\u042c \u041e