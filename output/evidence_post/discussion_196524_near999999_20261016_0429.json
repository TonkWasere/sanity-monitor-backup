043f\u043e \u0443\u0448\u0438 \u043f\u043e\u0432\u044f\u0437\u0430\u043d \u0432 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f\u0445 \u0438 \u043d\u0430 \u0442\u0435\u0431\u044f \u0443 \u043a\u0443\u0447\u0438 \u043b\u044e\u0434\u0435\u0439 \u0435\u0441\u0442\u044c \u043a\u043e\u043c\u043f\u0440\u043e\u043c\u0430\u0442, \u043d\u0443\u0436\u043d\u043e \u0441\u0438\u0434\u0435\u0442\u044c \u0442\u0438\u0445\u043e \u0438 \u043d\u0435 \u043e\u0442\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0442\u044c, \u043d\u0430\u0434\u0435\u044f\u0441\u044c, \u0447\u0442\u043e \u043d\u0435 \u0441\u043f\u0430\u043b\u044f\u0442. \u0427\u0442\u043e\u0431\u044b \u0432\u0435\u0441\u0442\u0438 \u0441\u0435\u0431\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0433\u043b\u043e \u0438 \u0441\u0430\u043c\u043e\u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043d\u0430 100% \u0447\u0438\u0441\u0442\u044b\u043c, \u0447\u0442\u043e\u0431\u044b \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043c\u043e\u0433 \u0442\u0435\u0431\u044f \u043d\u0438 \u0432 \u0447\u0435\u043c \u0443\u043f\u0440\u0435\u043a\u043d\u0443\u0442\u044c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043f\u0440\u0438 \u0442\u0430\u043a\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u201c\u0445\u0435\u0439\u0442\u0435\u0440\u043e\u0432\u201d \u0432\u043e\u0437\u043d\u0438\u043a\u043d\u0435\u0442 \u043e\u0447\u0435\u043d\u044c \u043c\u043d\u043e\u0433\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u043d \u0436\u0435 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0440\u043c\u0442\u0448\u0438\u043b, \u0432\u0441\u0435\u043c \u043e\u0431 \u044d\u0442\u043e\u043c \u043f\u0438\u0441\u0430\u043b, \u0431\u0440\u0430\u043b \u0434\u043e\u043b\u0433\u0438, \u0437\u0430\u0431\u0438\u0432\u0430\u043b \u043d\u0430 \u043d\u0438\u0445 \u0438 \u043d\u0435 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b, \u043d\u043e \u0432\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0445\u043e\u0442\u044c \u043a\u0430\u043a\u0438\u0435 \u0442\u043e \u0432\u044b\u0432\u043e\u0434\u044b, \u0440\u0435\u0448\u0438\u043b \u0431\u044b\u0447\u0438\u0442\u044c \u043d\u0430 \u0442\u0435\u0445, \u043a\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0435\u0433\u043e \u0441\u043b\u0438\u0442\u044c.\u003C\/p\u003E\n\n\u003Cp\u003E\u042f \u043d\u0435 \u0437\u043d\u0430\u044e, \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0431\u0430\u0437\u043e\u0432\u044b\u0435 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u0437\u0434\u0440\u0430\u0432\u043e\u0433\u043e \u0441\u043c\u044b\u0441\u043b\u0430? \u041d\u0430\u0440\u0443\u0448\u0438\u043b - \u0442\u0435\u0431\u044f \u0440\u0430\u043d\u043e \u0438\u043b\u0438 \u043f\u043e\u0437\u0434\u043d\u043e \u043f\u043e\u0439\u043c\u0430\u044e\u0442, \u043d\u0435 \u0445\u043e\u0447\u0435\u0448\u044c \u044d\u0442\u043e\u0433\u043e - \u043d\u0435 \u043d\u0430\u0440\u0443\u0448\u0430\u0439, \u043d\u0430\u0440\u0443\u0448\u0438\u043b - \u0431\u0443\u0434\u044c \u0433\u043e\u0442\u043e\u0432 \u043a \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u043c. \u0415\u0441\u043b\u0438 \u0432\u0441\u0435 \u0436\u0435 \u043d\u0430\u0440\u0443\u0448\u0438\u043b - \u0441\u0438\u0434\u0438 \u0442\u0438\u0445\u043e, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u0448\u0430\u043d\u0441 \u043e\u0441\u0442\u0430\u0442\u044c\u0441\u044f \u043d\u0435\u043f\u043e\u0439\u043c\u0430\u043d\u043d\u044b\u043c \u043f\u043e\u0434\u043e\u043b\u044c\u0448\u0435. \u0425\u043e\u0447\u0435\u0448\u044c \u043d\u0430\u0433\u043b\u0435\u0442\u044c - \u043d\u0435 \u043d\u0430\u0440\u0443\u0448\u0430\u0439 \u043d\u043