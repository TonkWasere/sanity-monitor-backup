44b\u0440\u0435\u0439 \u0438 \u0437\u0430\u0444\u043e\u0440\u0441\u0438\u043b \u0448\u0438\u0437\u0443 \u043f\u0440\u043e \u0442\u0430\u0440\u0430\u043a\u0430\u043d\u043e\u0432 \u044f\u043a\u043e\u0431\u044b \u043e\u0442 \u201c\u0414\u044e\u043a\u0430\u201d \u043f\u043e\u043c\u0435\u043d\u044f\u0432 \u043a\u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u043d\u0430 \u0444\u043e\u0440\u043c\u0435, \u0447\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0438\u0437 \u044d\u0442\u043e\u0433\u043e \u043c\u0435\u043c \u0441 \u043f\u0430\u0446\u0430\u043d\u0430\u043c\u0438. \u0418\u043c\u0435\u043b \u0437\u0430\u0441\u043b\u0443\u0436\u0435\u043d\u043d\u0443\u044e \u0440\u043e\u043b\u044c \u201c\u0421\u043c\u0435\u0448\u0430\u0440\u0438\u043a\u0430\u201d \u0438 \u043f\u043e\u043c\u043e\u0433\u0430\u043b \u043a\u043e\u043c\u044c\u044e\u043d\u0438\u0442\u0438 \u0432 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0435 \u0442\u0435\u043e\u0440\u0438\u0439, \u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0432 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u043c \u043a\u0430\u043d\u0430\u043b\u0435 \u003Cem\u003E(\u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043e - \u043f\u043e\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u0420\u0430\u0432\u0438\u0445\u0432\u044b, \u0441 \u043c\u043e\u0438\u043c\u0438 \u0434\u0440\u0443\u0433\u0430\u043d\u0430\u043c\u0438 - nxtg, Dmitry_Yarosh, Justement, \u0427\u0435\u0440\u043d\u043e\u0435\u0418\u0437\u0434\u0430\u043d\u0438\u0435, DeadshotMine \u0438 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u0440\u0435\u0431\u044f\u0442\u0430\u043c\u0438)\u003C\/em\u003E.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421\u0435\u0439\u0447\u0430\u0441 \u2014 \u044f \u043f\u0440\u043e\u0434\u0430\u044e \u043f\u0440\u043e\u0445\u043e\u0434\u043a\u0443 \u0432 \u0431\u0443\u043d\u043a\u0435\u0440: \u0432 \u043b\u044e\u0431\u043e\u0435 \u0432\u0440\u0435\u043c\u044f, \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0439 \u0444\u0440\u0430\u043a\u0446\u0438\u0438.\u003Cbr\u003E\n\u041b\u044e\u0434\u0438 \u043f\u043b\u0430\u0442\u044f\u0442 \u043c\u043d\u0435 \u0437\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c, \u0441\u0435\u0440\u0432\u0438\u0441 \u0441 \u043f\u043e\u043b\u043d\u044b\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435\u043c, \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435\u043c \u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0435\u043c \u043f\u043e\u043f\u0443\u0442\u043d\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c.\u003C\/p\u003E\n\n\u003Ch3\u003E\u003Cstrong\u003E\u003Cem\u003E\u041d\u0430\u0447\u0430\u043b\u043e \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430\u003C\/em\u003E\u003C\/strong\u003E\u003C\/h3\u003E\n\n\u003Cp\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-25\/1792954990-362377-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022{\u041c\u0435\u043d\u044f \u0431\u0430\u043d\u044f\u0442 \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435 \u0026quot;\u041e\u0420\u0417\u0026quot; \u0441 \u0434\u0438\u0441\u043a\u043e\u0440\u0434-\u0442\u0432\u0438\u043d\u043a\u0430 \u0026quot;\u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0448\u043a\u0438\u0026quot;}\u0022 data-id=\u00221ace51c7-3eaf-4785-b913-99393c6b7ab3\u0022 loading=\u0022lazy\u0022 width=\u0022571\u0022 height=\u0022114\u0022\u003E\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u0411\u0435\u0437 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f\u003C\/strong\u003E \u043f\u0440\u0438\u0447\u0438\u043d \u0438 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u0430\u0432\u0438\u043b: \u044f \u003Cstrong\u003E\u043d\u0438\u043a\u043e\u0433\u0434\u0430\u003C\/strong\u003E \u043d\u0435 \u043f\u0438\u0441\u0430\u043b \u043b\u044e\u0434\u044f\u043c \u0438\u0437 \u0442\u0438\u043a\u0435\u0442\u043e\u0432 \u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442