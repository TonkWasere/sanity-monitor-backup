43a\u0430\u0436\u0443 \u0441\u0443\u0442\u044c:\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003E\u042f:\u003C\/strong\u003E \u041c\u0435\u043d\u044f \u0437\u0430\u0431\u0430\u043d\u0438\u043b\u0438 \u0431\u0435\u0437 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439, \u0437\u0430 \u0441\u0430\u043c \u0444\u0430\u043a\u0442 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u044f \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e \u0431\u0443\u043d\u043a\u0435\u0440 \u0437\u0430 \u0434\u0435\u043d\u044c\u0433\u0438 \u2014 \u0432\u044b \u0434\u0435\u043b\u0430\u0435\u0442\u0435 \u0442\u043e \u0436\u0435 \u0441\u0430\u043c\u043e\u0435, \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u201c\u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u043e-\u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439\u201d \u0444\u043e\u0440\u043c\u0435, \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u044f \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043a \u0441\u0432\u043e\u0435\u043c\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443 (\u043c\u0430\u0439\u043d\u043a\u0440\u0430\u0444\u0442 \u0441\u0435\u0440\u0432\u0435\u0440) \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u044f \u043f\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u201c\u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f\u201d: \u043d\u0443, \u043d\u0435 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u043d\u043e \u0441\u043a\u0438\u043d\u044c \u043f\u043e\u0436\u0430\u043b\u0441\u0442\u0430. \u041f\u043e\u0447\u0435\u043c\u0443 \u044f \u0445\u0443\u0436\u0435?\u003Cbr\u003E\n\u003Cstrong\u003E\u0411\u043e\u0433\u043c\u0430\u043d:\u003C\/strong\u003E \u041d\u0443, \u0442\u044b \u043f\u0440\u043e\u0434\u0430\u0435\u0448\u044c \u043f\u0440\u043e\u0445\u043e\u0434\u003Cbr\u003E\n\u003Cstrong\u003E\u042f:\u003C\/strong\u003E \u042f \u0431\u0435\u0440\u0443 \u0434\u0435\u043d\u044c\u0433\u0438 \u0437\u0430 \u0441\u0435\u0440\u0432\u0438\u0441, \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435, \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0438 babysitter\u2019\u0441\u0442\u0432\u043e. \u041c\u043e\u0439 \u0438\u043d\u0442\u0435\u0440\u0435\u0441 \u0432 \u0434\u0435\u043d\u044c\u0433\u0430\u0445, \u0435\u0441\u043b\u0438 \u044f \u043d\u0435 \u043f\u0438\u0448\u0443 \u043b\u044e\u0434\u044f\u043c \u0438\u0437 \u0442\u0438\u043a\u0435\u0442\u043e\u0432 \u0438 \u043d\u0435 \u0440\u0435\u043a\u043b\u0430\u043c\u0438\u0440\u0443\u044e \u0441\u0432\u043e\u0438 \u0443\u0441\u043b\u0443\u0433\u0438 \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e \u043e\u0440\u0437 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u044f\u0442\u044c, \u0441\u0442\u043e\u0438\u0442 \u043b\u0438 \u0434\u043e\u0436\u0438\u043c\u0430\u0442\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0438\u043b\u0438 \u043e\u043d \u043f\u043e\u0448\u0435\u043b \u043a \u0412\u0430\u043c. \u0420\u0430\u0437\u0431\u0430\u043d\u044c \u043c\u0435\u043d\u044f, \u0432\u0441\u0435\u043c \u0436\u0435 \u0431\u0443\u0434\u0435\u0442 \u043b\u0435\u0433\u0447\u0435\u003Cbr\u003E\n\u003Cstrong\u003E\u0411\u043e\u0433\u043c\u0430\u043d:\u003C\/strong\u003E \u0431\u0430\u043d\u0438\u0442 \u043c\u043e\u044e \u043e\u0441\u043d\u043e\u0432\u0443\u003C\/p\u003E\n\n\u003Cp\u003E\u0417\u0430\u043d\u0430\u0432\u0435\u0441.\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438, \u043c\u043d\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b\u043e 3 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0441 \u041e\u0420\u0417, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043b\u0438 \u2014 \u043c\u044b \u0435\u0433\u043e \u043f\u043e\u0437\u0438\u0446\u0438\u044e \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c, \u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441 \u044d\u0442\u0438\u043c \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u0435\u043c.\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-25\/1792956965-334588-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022{\u041e\u0434\u0438\u043d \u0438\u0437 \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432 \u0431\u043e\u043b\u0435\u0435 \u0431\u0435\u0437\u043e\u0431\u0438\u0434\u043d\u043e\u0439 \u0438 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0435 \u0438 \u043c\u043e\u0439 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u043f\u043e \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438}\u0022 data-id=\u0022a454cde8-47a5-47b7-a317-32f487d9ffa9\u0022 loading=\u0022lazy\u0022 width=\u00221171\u0022 height=\u0022591\u0022\u003E\u003Cbr\u003E\n\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-10-25\/1792957373-422300-image.png\u0022 title=\u0022image.png\u0022 alt=\u0022{\u0412\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u0438\u043c\u0435\u0440, \u0442\u0443\u0442 \u043d\u0438\u0447\u0435\u0433\u043e \u0442\u0430\u043a\u043e\u0433\u043e \u043d\u0435\u0442}\u0022 data-id=\u0022a33c6aed-32d9-479b-a303-0011cfcfeda9\u0022 loading=\u0022lazy\u0022 width=\u0022294\u0022 height=\u0022506\u0022\u003E\u003C\/p\u003E\n\n\u003Ch3\u003E\u003Cstrong\u003E\u003Cem\u003E\u0412\u044b\u0432\u043e\u0434\u044b + \u0447\u0435\u043b\u043b\u0435\u043d\u0434\u0436\u003C\/em\u003E\u003C\/strong\u003E\u003C\/h3\u003E\n\n\u003Cp\u003E\u042f \u043f\u043e\u0441\u0438\u0434\u0435\u043b. \u042f \u043e\u0431\u0434\u0443\u043c\u0430\u043b. \u042f \u0433\u043e\u0442\u043e\u0432 \u043e\u0437\u0432\u0443\u0447\u0438\u0442\u044c \u0441\u0432\u043e\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e.\u003C\/p\u003E\n\n\u003Cp\u003E\u0414\u043b\u044f \u043c\u0435\u043d\u044f \u0442\u0430\u043a\u043e\u0439 \u0444\u043e\u0440\u043c\u0430\u0442 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b\u043c. \u0415\u0441\u043b\u0438 \u0442\u044b \u0434\u0435\u043b\u0430\u0435\u0448\u044c \u044d\u0442\u043e \u043d\u0430 \u0431\u043b\u0430\u0433\u043e \u043a\u043e\u043c\u044c\u044e\u043d\u0438\u0442\u0438, \u043d\u0435 \u0442\u044b\u043a\u0430\u0439 \u0432 \u043b\u0438\u0446\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u0432\u044f\u0442\u043e\u0441\u0442\u044c\u044e \u0438 \u0443\u0431\u0435\u0440\u0438 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f, \u0438\u043d\u0430\u0447\u0435 \u043f\u043e\u043f\u0440\u043e\u0448\u0430\u0439\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u0434 \u043f\u0440\u0435\u0434\u043b\u043e\u0433\u043e\u043c \u201c\u0431\u043b\u0430\u0433\u043e\u0439 \u0446\u0435\u043b\u0438\u201d \u0438 \u043e\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0442\u0435\u0445, \u043a\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u044d\u0442\u043e \u0437\u0430 \u0434\u0435\u043d\u044c\u0433\u0438 \u2014 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043d\u0435\u043b\u0435\u043f\u043e \u0438\u003C\/p\u003E \n\n\u003Cp\u003E\u041c\u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0436\u0430\u043b\u044c, \u0447\u0442\u043e \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u0435, \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u0440\u0435\u0431\u044f\u0442\u0430 (\u0430 \u0441\u0440\u0435\u0434\u0438 \u043d\u0438\u0445 \u0435\u0441\u0442\u044c \u0438 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u003Cstrong\u003E\u0432\u043e\u043b\u043e\u043d\u0442\u0451\u0440\u044b\u003C\/strong\u003E), \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044c \u0437\u0430 \u043e\u0448\u0438\u0431\u043a\u0438 \u0438 \u0434\u0435\u0442\u0441\u043a\u0443\u044e \u043f\u043e\u0437\u0438\u0446\u0438\u044e \u003Ca href=\u0022https:\/\/forum.exbo.net\/u\/bogman\u0022 class=\u0022UserMention\u0022\u003E@bogman\u003C\/a\u003E, \u043d\u043e \u0432\u0438\u0434\u0438\u043c\u043e \u0434\u043e \u043d\u0435\u0433\u043e \u043f\u043e-\u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u043d\u0435 \u0434\u043e\u043d\u0435\u0441\u0442\u0438 \u0432\u0430\u0436\u043d\u043e\u0441\u0442\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u043a \u043b\u044e\u0434\u044f\u043c \u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u201c\u0441\u043b\u044b\u0448\u0430\u0442\u044c\u201d \u0438 \u0441\u0432\u043e\u0438\u0445, \u0438 \u0447\u0443\u0436\u0438\u0445.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0437\u0440\u043e\u0441\u043b\u044b\u0439 \u0438 \u0443\u043c\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u2014 \u044d\u0442\u043e \u0442\u043e\u0442, \u043a\u0442\u043e \u0441\u0442\u043e\u0438\u0442 \u043d\u0430 \u0432\u0435\u0449\u0438 \u0441 \u0440\u0430\u0437\u043d\u044b\u0445 \u0441\u0442\u043e\u0440\u043e\u043d, \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f \u0441\u0432\u043e\u0438\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442 \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u044b\u0439 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u0432\u0430\u0440\u0438\u0430\u043d\u0442, \u043f\u043e\u0434\u0430\u0432\u043b\u044f\u044f \u0441\u0432\u043e\u0438 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u044b \u0438 \u0430\u043c\u0431\u0438\u0446\u0438\u0438, \u043d\u043e \u043f\u043e\u043a\u0430 \u003Ca href=\u0022https:\/\/forum.exbo.net\/u\/bogman\u0022 class=\u0022UserMention\u0022\u003E@bogman\u003C\/a\u003E \u043a \u044d\u0442\u043e\u043c\u0443 \u0432\u0438\u0434\u0443 \u043e\u0442\u043d\u0435\u0441\u0442\u0438 \u0441\u0435\u0431\u044f \u043d\u0435 \u043c\u043e\u0436\u0435\u0442, \u043f\u043e\u044d\u0442\u043e\u043c\u0443:\u003C\/p\u003E\n\n\u003Ch3\u003E\u042f \u041d\u0410\u0417\u041d\u0410\u0427\u0410\u042e \u041d\u0410\u0413\u0420\u0410\u0414\u0423 200.000 \u0412\u0410\u041b\u042e\u0422\u042b \u0417\u0410 \u041a\u0410\u0416\u0414\u041e\u0413\u041e \u0423\u0411\u0418\u0422\u041e\u0413\u041e \u0412 \u0411\u0423\u041d\u041a\u0415\u0420\u0415 \u0422\u0412\u0418\u041d\u041a\u0410 \u201c\u041e\u0420\u0417\u201d.\u003C\/h3\u003E\n\u003Cp\u003E\u0421\u043e\u0437\u0434\u0430\u0451\u0442\u0435 \u0442\u0438\u043a\u0435\u0442 \u2014 \u043f\u043e\u043f\u0430\u0434\u0430\u0435\u0442\u0435 \u0432 \u0431\u0443\u043d\u043a\u0435\u0440 \u2014 \u0443\u0431\u0438\u0432\u0430\u0435\u0442\u0435 \u0442\u0432\u0438\u043d\u043a\u0430.\u003Cbr\u003E\n\u0415\u0441\u043b\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u0443\u0431\u0438\u0432\u0430\u0442\u044c \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u043b\u044e\u0434\u044c\u043c\u0438, \u043a\u043e\u0433\u043e \u0432\u0435\u0434\u0443\u0442 - \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u044b \u043f\u0440\u0435\u043c\u0438\u0438, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043a\u0430\u0436\u0434\u043e\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438. \u0427\u0435\u043c \u043a\u0440\u0430\u0441\u0438\u0432\u0435\u0435 - \u0442\u0435\u043c \u043b\u0443\u0447\u0448\u0435. \u003Cbr\u003E\n\u041b\u0438\u0431\u043e \u0436\u0435 \u0446\u0435\u043b\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e \u0440\u043e\u043b\u0438\u0442\u0435 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u0438\u0435 \u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u043d\u043e \u043a\u0430\u043a \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u044d\u0442\u043e \u043d\u0430 \u0434\u0435\u043c\u043a\u0435 - \u043d\u0435 \u0437\u043d\u0430\u044e, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u0442\u044c. \u041d\u0438\u043a\u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0448\u0435\u043a \u043c\u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b.\u003C\/p\u003E\n\n\u003Cp\u003E\u041e\u0442\u043a\u0430\u0442\u044b \u0437\u0430\u043b\u0438\u0432\u0430\u0442\u044c \u044e\u0442\/\u0440\u0442\/\u0434\u0441 \u0438 \u0437\u0430\u043a\u0438\u0434\u044b\u0432\u0430\u0442\u044c \u043c\u043d\u0435 \u0432 \u043b\u0438\u0447\u043a\u0443: bunker_runa . \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0412\u0430\u0448 \u0442\u0438\u043a\u0435\u0442 \u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u044b\u0441\u0442\u043e\u0440\u0438\u044e \u0438 \u0437\u0430\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u0442\u044c \u043c\u043e\u043c\u0435\u043d\u0442 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0441, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u0444\u043b\u0435\u0439\u043c\u043e\u043c. \u041a\u0430\u0436\u0434\u044b\u0439 \u0432\u0438\u0434\u043e\u0441 \u044f \u0431\u0443\u0434\u0443 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044c, \u0432\u0441\u0435 \u0432\u0430\u0448\u0438 \u0432\u0437\u0430\u0438\u043c\u043e\u0441\u0432\u044f\u0437\u0438 \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u0442\u044c \u0438 \u0437\u0430 \u043f\u043e\u0434\u0441\u0442\u0430\u0432\u043d\u044b\u0435 \u0440\u043e\u043b\u0438\u043a\u0438 \u043d\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c, \u0432\u0441\u0435 \u043c\u043e\u0438 \u0434\u0440\u0443\u0437\u044c\u044f, \u0430 \u0438\u0445, \u0441\u043b\u0430\u0432\u0430 \u0431\u043e\u0433\u0443, \u0437\u0430 \u0432\u0440\u0435\u043c\u044f \u043c\u043e\u0435\u0439 \u0438\u0433\u0440\u044b \u043d\u0435 \u043c\u0430\u043b\u043e, \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u043c\u043d\u0435 \u0432 \u044d\u0442\u043e\u0439 \u043d\u0435\u043b\u0435\u0433\u043a\u043e\u0439 \u0431\u043e\u0440\u044c\u0431\u0435, \u043f\u043e\u043a\u0430 \u0434\u043e \u003Ca href=\u0022https:\/\/forum.exbo.net\/u\/bogman\u0022 class=\u0022UserMention\u0022\u003E@bogman\u003C\/a\u003E \u043d\u0435 \u0434\u043e\u0439\u0434\u0435\u0442.\u003C\/p\u003E\n\n\u003Ch3\u003E\u003Cstrong\u003E\u003Cem\u003E\u0423\u0421\u041b\u041e\u0412\u0418\u042f \u041f\u0420\u0415\u041a\u0420\u0410\u0429\u0415\u041d\u0418\u042f \u041e\u0425\u041e\u0422\u042b\u003C\/em\u003E\u003C\/strong\u003E\u003C\/h3\u003E\n\u003Cp\u003E\u0411\u043e\u0433\u043c\u0430\u043d \u0434\u043e\u043b\u0436\u0435\u043d \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e \u043e\u0442 \u043b\u0438\u0446\u0430 \u043a\u043e\u043c\u044c\u044e\u043d\u0438\u0442\u0438 \u0438\u0437\u0432\u0438\u043d\u0438\u0442\u044c\u0441\u044f \u043f\u0440\u0435\u0434\u043e \u043c\u043d\u043e\u0439 \u043e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\u0438\u0435\u043c \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435 \u0438 \u0440\u0430\u0437\u0431\u0430\u043d\u0438\u0442\u044c \u043e\u0431\u0430 \u043c\u043e\u0438\u0445 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430. \u042d\u0442\u043e \u0432\u043e\u0439\u043d\u0430 \u0447\u0435\u0441\u0442\u0438 \u0438 \u044f \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u044e \u043d\u0438\u0447\u0435\u0433\u043e, \u043a\u0440\u043e\u043c\u0435 \u043f\u0440\u0430\u0432\u043e\u0441\u0443\u0434\