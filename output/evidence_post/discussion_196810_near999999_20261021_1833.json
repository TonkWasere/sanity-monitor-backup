3d\u044e \u043f\u0438\u0441\u0430\u043b \u043f\u0440\u043e \u201c\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0438 \u0440\u0435\u0439\u0442, \u0447\u0442\u043e\u0431 \u0446\u0435\u043b\u0435\u0432\u043e\u0439 \u0440\u0435\u0436\u0438\u043c\u0430 \u043b\u0443\u0442\u0430\u043d\u0443\u043b \u043d\u0430\u0433\u0440\u0430\u0434\u0443\u201d\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e \u043d\u043e\u0432\u044b\u0439 \u0441\u0435\u0437\u043e\u043d \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430 \u041a\u043e\u043b\u0438\u0437\u0435\u044f \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b\u0441\u044f \u201c\u043a\u0430\u043a \u0444\u0430\u043a\u0442\u201d. \u0411\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e - \u0432 \u043d\u0435\u043c \u043d\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u003Cem\u003E(\u043e\u043f\u0443\u0441\u0442\u0438\u043c \u0442\u0430\u0441\u043e\u0432\u043a\u0443 \u043d\u0430\u0433\u0440\u0430\u0434 \u0437\u0430 \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u044b \u0438 \u043d\u0430\u0433\u0440\u0430\u0434 \u0437\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433)\u003C\/em\u003E, \u0438\u0445 \u043d\u0435 \u0437\u0430\u0432\u0435\u0437\u043b\u0438. \u042d\u0442\u043e, \u0432 \u043e\u0431\u0449\u0435\u043c-\u0442\u043e, \u0438 \u0435\u0441\u0442\u044c \u0432\u0430\u0436\u043d\u0430\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0435\u043a\u0443\u0449\u0435\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u041a\u043e\u043b\u0438\u0437\u0435\u044f. \u041f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u0430\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196810-razrab-krasava\/27\u0022 class=\u0022PostMention\u0022 data-id=\u00224720347\u0022\u003EWindReaper\u003C\/a\u003E \u0412\u044b \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044c \u0432\u043e\u043e\u0431\u0449\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0438\u043b\u0438 \u043a\u0430\u043a? \u0410 \u0442\u043e \u0447\u0442\u043e-\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u043f\u043e\u044f\u0432\u0438\u043b\u043e\u0441\u044c, \u0447\u0442\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0442\u0443\u0434\u0430 \u043e\u043d\u043b\u0438 \u043a\u043e\u0441\u043c\u0435\u0442\u0438\u043a\u0443 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c, \u043f\u0440\u0438\u0447\u0435\u043c \u0443\u0435\u0431\u0430\u043d\u0441\u043a\u0443\u044e \u0438 \u043d\u0435\u043d\u0443\u0436\u043d\u0443\u044e \u0434\u043b\u044f \u0442\u043e\u043f240\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0424\u0430\u043a\u0442\u043e\u0440 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u043d\u0430\u0433\u0440\u0430\u0434 \u0442\u0435\u0441\u043d\u043e \u0441\u0432\u044f\u0437\u0430\u043d \u0441 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c \u0441\u0430\u043c\u043e\u0433\u043e \u041a\u043e\u043b\u0438\u0437\u0435\u044f, \u0435\u0433\u043e \u0434\u043e\u0440\u0430\u0431\u043e\u0442\u043a\u043e\u0439 \u003Cem\u003E(\u043f\u043e\u043c\u0438\u043c\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0430)\u003C\/em\u003E. \u0412 \u044d\u0442\u043e\u0442 \u0440\u0430\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u043d\u0435 \u0431