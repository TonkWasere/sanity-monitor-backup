40\u0442\u043e\u0439,\u0434\u0430? \u0422\u0430\u043a \u0432\u043e\u0442 \u043a\u0430\u043a \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u044d\u0442\u0438 \u0432\u044b\u043b\u0430\u0437\u044b \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442 \u0438 \u0431\u0443\u0434\u0443\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c,\u0435\u0441\u043b\u0438 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0433\u0434\u0435 \u043e\u043d\u0438 \u0442\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u0441\u0442\u0440\u0430\u0448\u043d\u043e\u0433\u043e \u0432 \u043d\u0438\u0445 \u043d\u0435\u0442,\u0431\u0430\u043d\u0438\u0442\u044c \u0437\u0430 \u043f\u043e\u043a\u0430\u0437 \u0437\u0430\u043a\u0430\u0440\u0442\u044c\u044f \u043a\u0430\u043a \u043f\u043e \u043c\u043d\u0435 \u0438\u0434\u0438\u043e\u0442\u0438\u0437\u043c,\u0430 \u0432\u043e\u0442 \u0437\u0430 \u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u043f\u043e \u0432\u043e\u0437\u0434\u0443\u0445\u0443 \u043d\u0430 \u0411\u0430\u0440\u0435,\u043a\u0430\u043a \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u043b \u044f \u044d\u0442\u043e \u0434\u0430 \u0441\u0442\u043e\u0438\u0442 \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0441\u043d\u0435\u0441\u0442\u0438 \u0430\u043a\u043a\u0430\u0443\u043d\u0442, \u0438 \u0434\u0430 \u0432 \u0441\u0442\u0430\u0440\u043e\u043c \u043c\u0443\u0432\u043c\u0435\u043d\u0442\u0435 (\u0434\u043b\u044f \u043f\u043b\u0435\u0441\u0435\u043d\u0438 \u0434\u043e 2024,\u0434\u043d\u044f \u0425\u0435) \u0431\u044b\u043b \u0431\u0430\u0433 \u0441 \u043f\u0440\u043e\u0432\u0430\u043b\u043e\u043c \u0432 \u0431\u043b\u043e\u043a \u043d\u0438\u0436\u0435,\u0435\u0433\u043e \u043d\u0435 \u043f\u043e\u0444\u0438\u043a\u0441\u0438\u043b\u0438 \u0434\u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e \