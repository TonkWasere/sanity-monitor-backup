entifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196627"}},"user":{"data":{"type":"users","id":"1700553"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4713863","attributes":{"number":36,"createdAt":"2026-10-18T03:47:48+00:00","contentType":"comment","contentHtml":"\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196627-ya-ne-znayu-chto-delat\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224713692\u0022\u003ESlamience\u003C\/a\u003E \u041a\u0430\u043a \u0431\u044b \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b\u0438 \u0432\u044b? \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b\u0438 \u0431\u044b \u0438\u0433\u0440\u0430\u0442\u044c, \u043f\u0435\u0440\u0435\u0441\u0438\u043b\u0438\u0432\u0430\u044f \u0441\u0435\u0431\u044f, \u0440\u0430\u0434\u0438 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e \u0434\u043e\u0444\u0430\u043c\u0438\u043d\u0430 \u043f\u0440\u0438 \u0432\u044b\u043d\u043e\u0441\u0435. \u041f\u043e\u0441\u0442\u0430\u0440\u0430\u043b\u0438\u0441\u044c \u0431\u044b \u0432\u043b\u0438\u0442\u044c\u0441\u044f \u0432 \u043f\u0430\u0447\u043a\u0443, \u0438\u043b\u0438 \u0437\u0430\u0431\u0440\u043e\u0441\u0438\u0442\u044c \u0438\u0433\u0440\u0443?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u042f \u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0441\u043e\u043b\u043e. \u041c\u043d\u0435 \u0441\u0430\u043c\u043e\u043c\u0443 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u043e \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u043f\u0430\u0447\u043a\u0435, \u043a\u043e\u0433\u0434\u0430 \u043c\u043e\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043c\u043e\u0433\u0443\u0442 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0435\u0441\u043b\u0438 \u044d\u0442\u043e \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u044b\u043c\u0438 \u0441\u043e\u0432\u0435\u0442\u0430\u043c\u0438 \u0438 \u043a\u0440\u0438\u0442\u0438\u043a\u043e\u0439.\u003C\/p\u003E\n\n\u003Cp\u003E\u0415\u0441\u043b\u0438 \u0442\u0435\u0431\u0435 \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0438\u043c\u0435\u043d\u043d\u043e \u043c\u043e\u0440\u0430\u043b\u043a\u0438, \u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u043d\u0430\u0439\u0442\u0438 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e \u0438\u0433\u0440\u0430\u0442\u044c. \u0418 \u043d\u0435\u0432\u0430\u0436\u043d\u043e, \u043a\u0430\u043a\u043e\u0439 \u0443 \u043d\u0435\u0433\u043e \u041a\u0414 \u0438 \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0445\u043e\u0440\u043e\u0448\u043e \u043e\u043d \u043e\u0442\u044b\u0433\u0440\u044b\u0432\u0430\u0435\u0442. \u041b\u0443\u0447\u0448\u0435 \u0443\u0436 \u0438\u0433\u0440\u0430\u0442\u044c \u0441 \u0431\u0430\u043b\u0431\u0435\u0441\u043e\u043c, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0441\u043c\u0435\u044f\u0442\u044c\u0441\u044f \u0438 \u043f\u0440\u0438\u044f\u0442\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0432\u0440\u0435\u043c\u044f, \u0447\u0435\u043c \u0441 \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u044b\u043c \u0447\u0441\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0444\u0430\u0439\u0442\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u0441\u0432\u043e\u0438\u043c \u0434\u043e\u043b\u0433\u043e\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u0442\u0435\u0431\u0435, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u044b \u0445\u0443\u0451\u0432\u043e \u0438\u0433\u0440\u0430\u0435\u0448\u044c.\u003C\/p\u003E\n\n\u003Cp\u003E\u042f \u0432\u043e\u043e\u0431\u0449\u0435 \u0441\u0447\u0438\u0442\u0430\u044e, \u0447\u0442\u043e \u0438 \u0432 \u0441\u043e\u043b\u043e \u043c\u043e\u0436\u043d\u043e \u0432\u043f\u043e\u043b\u043d\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u0438\u0433\u0440\u0430\u0442\u044c, \u0435\u0441\u043b\u0438 \u043d\u0435 \u043f\u044b\u0442\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0432 \u0438\u0433\u0440\u0435 \u043f\u043e \u043f\u043e\u043b\u0434\u043d\u044f. \u041f\u043e \u0447\u0430\u0441\u0443 \u0432 \u0434\u0435\u043d\u044c - \u0432\u043f\u043e\u043b\u043d\u0435 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e, \u0435\u0441\u043b\u0438 \u0431\u044b \u0435\u0449\u0451 \u0441\u0430\u043c\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 \u043d\u0435 \u0434\u0443\u0448\u0438\u043b\u0438 \u0441\u043e\u043b\u043e.\u003C\/p\u003E\n\n\u003Cp\u003E\u0421\u0430\u043c \u044f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0434\u0443\u043c\u0430\u043b \u043d\u0430\u0439\u0442\u0438 \u0442\u0438\u043c\u043c\u0435\u0439\u0442\u0430 \u0434\u043b\u044f \u041a\u043e\u043b\u0438\u0437\u0435\u044f, \u043d\u043e \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0438\u0433\u0440 \u043f\u0435\u0440\u0435\u0434\u0443\u043c\u0430\u043b. \u0412 \u043e\u0434\u043d\u043e\u043c \u0438\u0437 \u043c\u0430\u0442\u0447\u0435\u0439 \u0442\u0438\u043f\u043e\u043a \u0437\u0430\u043f\u0443\u0448\u0438\u043b \u0443\u0441\u0442\u0443, \u044f \u0435\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u043d\u044f\u043b, \u0438 \u0432 \u043e\u0442\u0432\u0435\u0442 \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0446\u0435\u043b\u0443\u044e \u043b\u0435\u043a\u0446\u0438\u044e \u043e \u0442\u043e\u043c, \u043a\u0430\u043a\u043e\u0439 \u044f \u0445\u0443\u0451\u0432\u044b\u0439 \u0438\u0433\u0440\u043e\u043a. \u0427\u0435\u043b\u043e\u0432\u0435\u043a \u0443\u0441\u043f\u0435\u043b \u043f\u0440\u043e\u0439\u0442\u0438\u0441\u044c \u043f\u043e \u043c\u043e\u0435\u043c\u0443 \u0440\u043e\u0434\u043e\u0441\u043b\u043e\u0432\u043d\u043e\u043c\u0443 \u0434\u0440\u0435\u0432\u0443, \u043f\u043e\u0432\u0435\u0434\u0430\u0442\u044c \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043c\u043d\u0435 \u0442\u0430\u0439\u043d\u044b \u0438 \u0437\u0430\u043e\u0434\u043d\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c, \u043a\u0430\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u0438\u0433\u0440\u0430\u0442\u044c, \u043f\u0440\u0438\u0447\u0451\u043c \u0432 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u201c\u0434\u0440\u0443\u0436\u0435\u043b\u044e\u0431\u043d\u043e\u0439\u201d \u0444\u043e\u0440\u043c\u0435. \u0421\u0430\u043c\u043e\u0435 \u0437\u0430\u0431\u0430\u0432\u043d\u043e\u0435, \u0447\u0442\u043e \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b \u043e\u043d \u0441 \u041a\u0414 0.3.\u003C\/p\u003E\n\n\u003Cp\u003E\u0418 \u0432\u043e\u0442 \u043f\u043e\u0441\u043b\u0435 \u0442\u0430\u043a\u0438\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0439 \u0432\u043e\u043e\u0431\u0449\u0435 \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0438\u0441\u043a\u0430\u0442\u044c \u0442\u0438\u043c\u043c\u0435\u0439\u0442\u043e\u0432. \u0422\u044b \u0437\u0430\u0445\u043e\u0434\u0438\u0448\u044c \u0432 \u0438\u0433\u0440\u0443 \u043e\u0442\u0434\u043e\u0445\u043d\u0443\u0442\u044c \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435, \u0430 \u0432 \u0438\u0442\u043e\u0433\u0435 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u0432\u044b\u0441\u043b\u0443\u0448\u0438\u0432\u0430\u0442\u044c \u043f\u0440\u0435\u0442\u0435\u043d\u0437\u0438\u0438 \u043e\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430. \u041d\u0435 \u0441\u043e\u0432\u0435\u0442\u0443\u044e \u0438\u0441\u043a\u0430\u0442\u044c \u0442\u0435\u0445, \u043a\u0442\u043e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043f\u043e\u0442\u0435\u0435\u0442 \u0438 \u0433\u043e\u043d\u0438\u0442\u0441\u044f \u0437\u0430 \u043b\u0443\u0442\u043e\u043c \u0438 \u041a\u0414. \u0412 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u0442\u0430\u043a\u0438\u0435 \u043b\u044e\u0434\u0438 \u0431\u0443\u0434\u0443\u0442 \u0438\u0441\u043a\u0430\u0442\u044c \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u0438\u044f \u0441\u0432\u043e\u0438\u043c \u043f\u043e\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u0445 \u0442\u0438\u043c\u043c\u0435\u0439\u0442\u043e\u0432.\u003C\/p\u003E\n\n\u003Cp\u003E\u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u044f \u0431\u044b \u043d\u0430 \u0442\u0432\u043e\u0451\u043c \u043c\u0435\u0441\u0442\u0435 \u043d\u0435 \u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0435\u0441\u0438\u043b\u0438\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f \u0440\u0430\u0434\u0438 \u0438\u0433\u0440\u044b. \u041f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u043b \u0431\u044b \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0441\u043e\u043b\u043e \u0432 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e\u043c \u0442\u0435\u043c\u043f\u0435, \u0430 \u0435\u0441\u043b\u0438 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u0441\u044f \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0438\u044f\u0442\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u044c \u0432\u0440\u0435\u043c\u044f, - \u0443\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u0434\u0443\u043c\u0430\u0442\u044c \u043e \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0438\u0433\u0440\u0435. \u041d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0446\u0435\u043b\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e \u0438\u0441\u043a\u0430\u0442\u044c \u043f\u0430\u0447\u043a\u0443 \u0438 \u043f\u044b\u0442\u0430\u0442\u044c\u0441\u044f \u0432 \u043d\u0435\u0451 \u0432\u043b\u0438\u0442\u044c\u0441\u044f \u043b\u044e\u0431\u043e\u0439 \u0446\u0435\u043d\u043e\u0439.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412 \u043a\u043e\u043d\u0446\u0435 \u043a\u043e\u043d\u0446\u043e\u0432, \u0438\u0433\u0440\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u044c \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0442\u044c\u0441\u044f \u0432\u043e \u0432\u0442\u043e\u0440\u0443\u044e \u0440\u0430\u0431\u043e\u0442\u0443(\u0412\u043e \u0447\u0442\u043e \u0438 \u043f\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u0441\u0442\u0430\u043b\u043a\u0440\u0430\u0444\u0442), \u0433\u0434\u0435 \u0442\u0435\u0431\u044f \u0435\u0449\u0451 \u0438 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u044e\u0442. \u0415\u0441\u043b\u0438 \u0436\u0435 \u0434\u0430\u0436\u0435 \u0432 \u0441\u043e\u043b\u043e \u0438\u0433\u0440\u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0432\u044b\u0437\u044b\u0432\u0430\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0447\u0435\u043c \u0440\u0430\u0434\u043e\u0441\u0442\u0438. \u041d\u0435\u0442 \u0441\u043c\u044b\u0441\u043b\u0430 \u0432\u044b\u0433\u043e\u0440\u0430\u0442\u044c \u0440\u0430\u0434\u0438 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0