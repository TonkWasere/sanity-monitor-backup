2\u0435\u0441\u0442\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432\u201d.\u003Cbr\u003E\n\u0420\u0430\u043d\u0434\u043e\u043c \u0442\u0438\u043f: \u201c\u0411\u043b\u044f \u0431\u0440\u043e\u0443, \u0443 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443\u043b\u044c\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043c\u043e\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0432 \u043a\u0430\u043a\u043e\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u003Cspan class=\u0022spoiler\u0022 onclick=\u0022removeAttribute(\u0027class\u0027)\u0022\u003E\u044f \u0442\u0435\u0431\u044f \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u003C\/span\u003E\u043d\u0430 \u0430\u0443\u043a\u0446\u0438\u043e\u043d \u0431\u0443\u0434\u0435\u0442 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u0440\u0435\u043f\u044f\u0445 \u043d\u0435 \u0437\u0430 1\u043a \u0438\u0433\u0440\u043e\u0432\u043e\u0439 \u0432\u0430\u043b\u044e\u0442\u044b, \u0430 \u0437\u0430 999, \u0447\u0442\u043e\u0431\u044b \u0442\u044b \u0441\u043c\u043e\u0433 \u0436\u043e\u0441\u043a\u0430 \u003Cspan class=\u0022spoiler\u0022 onclick=\u0022removeAttribute(\u0027class\u0027)\u0022\u003E\u043d\u0430\u0441\u0440\u0430\u0442\u044c \u0432 \u0448\u0442\u0430\u043d\u044b \u0438 \u043f\u043b\u0430\u043a\u0430\u0442\u044c, \u043f\u043e\u043a\u0430 \u044f \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044e \u0442\u0432\u043e\u0439 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u003C\/span\u003E \u043d\u0430\u0432\u0430\u0440\u0438\u0442\u044c\u0441\u044f. \u0421\u043a\u043e\u0440\u0435\u0435 \u043a\u0430\u0447\u0430\u0439 \u003Cstrong\u003E\u0422\u043e\u0447\u043d\u043e\u041d\u0435\u041d\u0430\u0435\u0431.\u0435\u0445\u0435\u003C\/strong\u003E\u201d.\u003Cbr\u003E\n\u041c\u0430\u043c\u043e\u043d\u0442: \u201c\u0411\u043b\u044f \u0431\u0440\u0430\u0442\u0430\u043d, \u0431\u0440\u0430\u0442