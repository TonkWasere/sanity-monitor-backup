043d\u0442 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0441\u044f \u0432 \u0433\u043e\u0432\u043d\u043e-\u0431\u0443\u0440\u0438 \u043d\u0435\u0434\u043e\u0432\u044b\u0431\u0440\u043e\u0441\u044b.\u003C\/p\u003E\n\n\u003Cp\u003E(\u0410\u0440\u0435\u043d\u044b)\u003Cbr\u003E\n\u041e\u0442 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0433\u043e \u0441\u043e\u0440\u0435\u0432\u043d\u043e\u0432\u0430\u043d\u0438\u044f, \u043f\u0435\u0440\u0435\u0448\u043b\u0438 \u043a \u0432\u0435\u0441\u0435\u043b\u043e\u0439 \u043a\u043b\u043e\u0443\u043d\u0430\u0434\u0435 (\u0430\u0440\u0435\u043d\u0430 \u043f\u0435\u0440\u0434\u0443\u043d\u0430) \u0430 \u0437\u0430\u0442\u0435\u043c \u043a \u044d\u0442\u043e\u043c\u0443(\u043d\u044b\u043d\u0435)\u003Cbr\u003E\n\u041f\u043e \u043f\u0443\u0442\u0438 \u0432\u044b\u0440\u0435\u0437\u0430\u043b\u0438 \u043c\u043e\u0434\u0443\u043b\u0438 (\u0430\u043b\u044f \u043b\u0438\u043d\u0447\u0435\u0432\u0430\u0442\u0435\u043b\u044c \u0438 \u0442.\u043f.) \u0438 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0435\u0442\u043a\u0438 \u043e\u0440\u0443\u0436\u0438\u0439 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u0435 \u0436\u0435 \u0431\u043e\u043b\u0442\u043e\u0432\u043a\u0438).\u003Cbr\u003E\n\u041d\u0430 \u0444\u043e\u043d\u0435 \u044d\u0442\u043e\u0433\u043e \u0443\u0431\u0438\u0432 \u043d\u0430\u0433\u0440\u0430\u0434\u044b (\u043a\u0430\u043a \u0434\u0435\u043d\u0435\u0436\u043d\u044b\u0435 \u0442\u0430\u043a \u0438 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435)\u003C\/p\u003E\n\n\u003Cp\u003E(\u0418\u0437\u043d\u0430\u043d\u043a\u0430)\u003Cbr\u003E\n\u0411\u044b\u043b \u0441\u044e\u0436\u0435\u0442\u043d\u043e-\u043f\u0432\u0435 \u043e\u043f\u0435\u043d \u0432\u043e\u0440\u043b\u0434 \u0441 \u043a\u0432\u0435\u0441\u0442\u0430\u043c\u0438 \u0438 \u0431\u0430\u0437\u0430\u043c\u0438 \u0438 \u043b\u043e\u0433\u0438\u0447\u043d\u044b\u043c\u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u043c\u0438.\u003Cbr\u003E\n\u041f\u0435\u0440\u0435\u0448\u043b\u043e \u0432 \u0434\u0443\u043c \u0430\u0440\u0435\u043d\u0443 \u0434\u043b\u044f \u0444\u0430\u0440\u043c\u0430 \u043a\u0430\u0431\u0430\u043d\u0447\u0438\u043a\u043e\u0432 \u0433\u0434\u0435 \u0437\u0430\u0445\u043e\u0434 \u0438 \u0432\u044b\u0445\u043e\u0434 \u0431\u044b\u043b \u0430\u043b\u044f \u0441\u0435\u0441\u0438\u043e\u043d\u043a\u0430, \u0441\u044e\u0436\u0435\u0442\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u043e\u0441\u0440\u0430\u043d\u0430, \u0430 \u043e\u043f\u0435\u043d\u0432\u043e\u0440\u043b\u0434 \u0438\u0434\u0435\u044f \u0441 \u043f\u043e\u0445\u043e\u0434\u043e\u043c \u043d\u0430 \u044e\u0433 \u0443\u0431\u0438\u0442\u0430.\u003Cbr\u003E\n\u0418 \u0437\u0430\u0442\u0435\u043c - \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u043f\u044f\u0442\u044c \u0432\u044b\u0441\u0435\u0440 \u0432 \u0432\u0438\u0434\u0435 \u043d\u0435\u0434\u043e-\u043e\u043f\u0435\u043d\u0430 \u0441 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430\u043c\u0438 \u043a\u0430\u043a \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0441 \u0431\u0443\u0440\u0430\u043d\u0430\u043c\u0438.\u003C\/p\u003E\n\n\n\u003Cp\u003E\u0418 \u0437\u0430\u0442\u0435\u043c \u043e\u0442\u0432\u0435\u0442\u044c\u0442\u0435 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#23acaf;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u0420\u0443\u043f\u043e\u0440\u044b\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-bullhorn\u0022\u003E\u003C\/i\u003E\u003C\/span\u003E \u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#22b7f7;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u044b\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-yin-yang\u0022\