3b\u0435, \u043f\u043e \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u043c \u0434\u0430\u043d\u043d\u044b\u043c \u0418\u0418 \u0432 \u043a\u043e\u0434\u0435 \u043d\u0438\u0445\u0435\u0440\u0430 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442, \u0435\u0441\u043b\u0438 \u044f\u0437\u044b\u043a \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043d\u0443\u0436\u043d\u044b\u0439 \u0432 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0435, \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u043c\u0430\u0441\u0441\u043e\u0432\u043e.\u003C\/p\u003E \n\n\u003Cp\u003E\u043a\u043e\u0440\u043e\u0447\u0435, \u043d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0439, \u0447\u0442\u043e \u0440\u0430\u0437\u0440\u0430\u0431\u044b \u042d\u043a\u0441\u0431\u043e \u0431\u044b\u043b\u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u044b \u0418\u041c\u0415\u041d\u041d\u041e \u041e\u0411\u042a\u0415\u041c\u0410\u041c\u0418 \u043a\u043e\u0434\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0430\u0434\u043e \u043f\u0438\u0441\u0430\u0442\u044c \u0434\u043b\u044f \u0421\u041a, \u0430 \u0418\u0418 \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e \u0432\u044b\u0441\u0438\u0440\u0430\u0435\u0442 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u044b \u0441\u0442\u0440\u043e\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 \u042d\u043a\u0441\u0431\u043e \u043d\u0438\u043a\u0442\u043e \u0447\u0438\u0442\u0430\u0442\u044c \u043d\u0435 \u0431\u0443\u0434\u0435\u0442, \u0430 \u0435\u0441\u043b\u0438 \u0438 \u0431\u0443\u0434\u0435\u0442, \u0442\u043e \u043d\u0435 \u043f\u043e\u0439\u043c\u0435\u0442.\u003C\/p\u003E\n\n\u003Cp\u003E\u043d\u0443 \u0438 \u043a\u0430\u043a\u0430\u044f \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u043e\u043b\u0443\u0447