043e\u043f\u0430\u0434\u0430\u044e\u0441\u044c \u0441 \u003Ca href=\u0022https:\/\/forum.exbo.net\/u\/Kikizo\u0022 class=\u0022UserMention\u0022\u003E@Kikizo\u003C\/a\u003E \u043f\u0440\u0438\u0447\u0435\u043c \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0432\u0440\u0430\u0433\u0430, \u0438 \u043e\u0434\u0438\u043d \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0441\u043e\u044e\u0437\u0430. \u0422\u043e \u0435\u0441\u0442\u044c \u0432 \u0440\u0435\u0439\u0442 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u043c\u0430\u043b\u043e \u0438\u0433\u0440\u0430\u0435\u0442 \u043b\u044e\u0434\u0435\u0439, \u0447\u0442\u043e \u044f \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u043a\u0430\u0436\u0434\u0443\u044e \u043a\u0430\u0442\u043a\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e \u0442\u0438\u043f\u043e\u0432 \u0438\u0437 \u043f\u0440\u043e\u0448\u043b\u043e\u0439, \u043f\u0440\u0438\u0447\u0435\u043c \u0441 \u043f\u0435\u0440\u0435\u0442\u0430\u0441\u043e\u0432\u043a\u043e\u0439 \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u0435 \u043e\u0434\u043d\u043e\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u044b.\u003C\/p\u003E \n\n\u003Cp\u003E\u041e\u0431\u0438\u0434\u043d\u043e \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043d\u043e \u043f\u043e\u0445\u043e\u0434\u0443 \u0440\u0435\u0436\u0438\u043c \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442 \u0441\u0443\u0434\u044c\u0431\u0443 \u041c\u0412 \u0438 \u041e\u043f\u0435\u0440\u0430\u0446\u0438\u0439, \u043f\u0440\u0438\u0447\u0435\u043c \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u0438\u043a\u043e\u0432.\u003C\/p\u003E","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":2,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":3,"canReact":false,"canDeleteP