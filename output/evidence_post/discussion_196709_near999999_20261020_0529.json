\u0435\u043c \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 - \u043d\u0438 \u043e\u0434\u0438\u043d \u043d\u0435 \u0440\u0435\u0448\u0438\u043b\u0438 \u043a \u044d\u0442\u043e\u043c\u0443 \u0441\u0435\u0437\u043e\u043d\u0443\u003Cbr\u003E\n\u0427\u0435\u043b\u0430\u043c \u0433\u043e\u0432\u043e\u0440\u044f\u0442, \u0447\u0442\u043e \u0431\u0435\u0437 \u043d\u043e\u0440\u043c \u043d\u0430\u0433\u0440\u0430\u0434 \u0432 \u044d\u0442\u0443 \u0445\u0443\u0439\u043d\u044e \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0438\u0433\u0440\u0430\u0435\u0442 - \u043f\u043e\u0445\u0443\u0439, \u0434\u0435\u043b\u0430\u0435\u043c 2\u0439 \u0441\u0435\u0437\u043e\u043d \u0433\u0434\u0435 \u0438\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0431\u044b\u043b\u0438 \u0442\u043e\u043a \u0447\u0443\u0442\u044c \u043f\u043e\u043d\u0435\u0440\u0444\u043b\u0435\u043d\u043d\u044b\u0439 \u0442\u0440\u0430\u043d\u043a\u0432\u0438\u043b\u003Cbr\u003E\n\u0441\u0442\u0435\u043d\u043a\u0438 \u0438  \u043e\u043a\u043d\u0430 \u043a\u0430\u043a \u043c\u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043b\u043e\u043c\u0430\u044e\u0442\u0441\u044f \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u043e\u0439\u003Cbr\u003E\n\u041d\u043e\u0432\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430 \u0432 \u043c\u0430\u0433\u0430\u0437 \u043d\u0435 \u0434\u043e\u0431\u0430\u0432\u0438\u043b\u0438 (\u043a\u0440\u043e\u043c\u0435 \u0445\u0443\u0439\u043d\u0438 \u0434\u043b\u044f \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u043d\u043e\u0439 \u0443\u0431\u0435\u0436\u043a\u0438 \u0437\u0430 10\u043a, \u0441\u043f\u0430\u0441\u0438\u0431\u043e, \u0438 \u0434\u0430\u0440\u043e\u043c \u043d\u0435 \u043d\u0430\u0434\u043e), \u0434\u0430 \u0438 \u0435\u0441\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u044f\u0442 \u0442\u043e \u0431\u0443\u0434\u0435\u0442 100\u044b\u0439 \u043e\u0431\u043b\u0438\u043a \u0434\u043b\u044