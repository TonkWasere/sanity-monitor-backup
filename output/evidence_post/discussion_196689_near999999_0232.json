0443\u0440\u0438\u043a\u0430 \u0432 \u0438\u0445 \u0434\u0438\u0441\u043a\u043e\u0440\u0434\u0435 \u044f \u0442\u0443\u043f\u043e \u043b\u0438\u0432\u043d\u0443\u043b. \u0423 \u043d\u0438\u0445 \u0442\u0443\u043f\u043e \u0431\u044b\u043b\u043e \u043c\u0435\u0440\u0437\u043a\u043e \u0438\u0433\u0440\u0430\u0442\u044c. \u041e\u0440\u0443\u0449\u0438\u0439 \u043a\u043e\u043b\u043b\u0435\u0440 \u0438 \u043b\u0438\u0434\u0435\u0440 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0440\u0435\u0442 \u201c\u0448\u0442\u0440\u0430\u0444\u201d - \u043e\u043c\u0435\u0440\u0437\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043a\u043e\u043c\u0431\u043e.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041d\u0443 \u0434\u0435\u043b\u0430\u2026 \u003Cbr\u003E\n\u041c\u043d\u0435 \u0434\u0430\u0436\u0435 \u043d\u0435\u0447\u0435\u0433\u043e \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430 \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435. \u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0434\u043d\u043e. \u041d\u0430 \u0447\u0442\u043e \u0443\u0445\u043e\u0434\u0438\u043b\u0438 \u0448\u0442\u0440\u0430\u0444\u044b.\u003C\/p\u003E\n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196689-nayti-klan-missiya-nevypolnima\/108\u0022 class=\u0022PostMention\u0022 data-id=\u00224717250\u0022\u003ENeath_A\u003C\/a\u003E \u041d\u0443 \u0438 \u043b\u0438\u0434\u0430\u043a \u0437\u0430 \u043d\u0435\u0433\u043e \u043a\u0440\u0435\u043f\u043a\u043e \u0434\u0435\u0440\u0436\u0430\u043b\u0441\u044f.\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041c\u043e\u0433\u0443 \u0435\u0433\u043e \u043f\u043e\u043d\u044f\u0442\u044c. \u003Cbr\u003E\n\u0425\u0430\u0439\u0442\u0430\u0431\u044b \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044e \u043a\u0430\u043a \u0440\u0430\u0437 \u0442\u044f\u043d\u0443\u0442 \u044d\u0442\u0430\u043f\u044b \u043d\u0430 \u0441\u0435\u0431\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u0415 \u0442\u0438\u0440\u0435. \u003Cbr\u003E\n\u0423 \u043d\u0430\u0441 \u0431\u044b\u043b\u043e \u043d\u0435\u0447\u0442\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435, \u043a \u043d\u0430\u043c \u0437\u0430\u0448\u0451\u043b \u043f\u0430\u0440\u0435\u043d\u044c, A-S \u0442\u0438\u0440 \u0438\u0433\u0440\u043e\u043a, \u043d\u043e \u043d\u0430 EY \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u0445. \u003Cbr\u003E\n\u041d\u0430 \u0440\u0443 \u0436\u0435, \u043e\u043d \u043f\u043e\u0448\u0451\u043b \u043a \u043d\u0430\u043c \u0432 C \u0442\u0438\u0440. \u0411\u044b\u043b \u0445\u0430\u0439\u0442\u0430\u0431\u043e\u043c, \u043d\u043e \u0435\u0433\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u2026 \u003Cbr\u003E\n\u041e\u043d \u0441\u0447\u0438\u0442\u0430\u043b, \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u043e\u043d \u0445\u0430\u0439\u0442\u0430\u0431, \u0442\u043e \u0438 \u0434\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u043e \u0435\u043c\u0443 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435. \u003Cbr\u003E\n\u0422\u0430\u043a \u0432\u043e\u0442, \u043c\u044b \u043f\u043e\u0447\u0442\u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0440\u0435\u0433\u0430\u0435\u043c \u043f\u043e\u0442\u0430\u0441\u043e\u0432\u043a\u0438, \u043e\u043d\u0438, \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e, \u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435. \u041d\u043e \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043b\u0438\u0448\u044c \u043e\u0434\u043d\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u043e: \u0435\u0441\u043b\u0438 \u0437\u0430\u0448\u0451\u043b, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u0438\u0433\u0440\u0430\u0439, \u043d\u0430\u0431\u0435\u0440\u0438 \u043a\u0430\u043a\u043e\u0435-\u0442\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u0447\u043a\u043e\u0432. \u0418 \u0432 \u0446\u0435\u043b\u043e\u043c, \u0432\u0441\u0435 \u0431\u044b\u043b\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u044b \u0438 \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044e \u0440\u0435\u0431\u044f\u0442\u0430 \u0441\u0430\u043c\u0438 \u0441\u043c\u043e\u0442\u0440\u0435\u043b\u0438 \u0432 \u0442\u0430\u0431 \u0438 \u0432\u044b\u0434\u0430\u0432\u0430\u043b\u0438 \u0437\u0430\u043f\u0430\u0441\u043d\u043e\u0433\u043e \u0442\u0435\u043c, \u043a\u0442\u043e \u0437\u0430\u0448\u0451\u043b \u0438 \u0432\u044b\u0448\u0435\u043b \u0440\u0430\u0434\u0438 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0445 \u0433\u0438\u043b\u044c\u0437.\u003Cbr\u003E\n\u0412 \u043e\u0434\u0438\u043d \u0438\u0437 \u0434\u043d\u0435\u0439, \u044d\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e \u0441 \u044d\u0442\u0438\u043c \u043f\u0430\u0440\u043d\u0435\u043c, \u043e\u043d \u0441\u0440\u0430\u0437\u0443 \u043c\u043d\u0435 \u043d\u0430\u043f\u0438\u0441\u0430\u043b, \u0447\u0442\u043e \u0435\u0433\u043e \u043d\u0435 \u0446\u0435\u043d\u044f\u0442, \u043d\u0435 \u0432\u0438\u0434\u044f\u0442, \u0447\u0442\u043e \u043e\u043d \u0445\u0430\u0439\u0442\u0430\u0431 \u0438 \u043a\u0430\u043a \u043c\u043d\u043e\u0433\u043e \u043e\u043d \u0434\u0435\u043b\u0430\u0435\u0442 \u0434\u043b\u044f \u043a\u043b\u0430\u043d\u0430, \u0438 \u0447\u0442\u043e \u043e\u043d \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u0440\u043f\u0435\u0442\u044c \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u043d\u0435\u0443\u0432\u0430\u0436\u0435\u043d\u0438\u0435 \u0438 \u043b\u0438\u0432\u043d\u0451\u0442.\u003Cbr\u003E\n\u042f \u043f\u043e\u0448\u0451\u043b \u043d\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443. \u0421\u043a\u0430\u0437\u0430\u043b, \u0447\u0442\u043e \u0442.\u043a. \u0434\u043e \u043a\u043e\u043d\u0446\u