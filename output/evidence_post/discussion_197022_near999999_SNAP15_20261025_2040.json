"type":"posts","id":"4727070"}]},"likes":{"data":[]}}},{"type":"posts","id":"4727070","attributes":{"number":16,"createdAt":"2026-10-25T20:37:01+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197022-pravda-pro-obschestvo-raspila-zony-ohota\/13\u0022 class=\u0022PostMention\u0022 data-id=\u00224727066\u0022\u003EOYAN\u003C\/a\u003E \u0422\u0430\u043a \u0441\u0442\u0440\u0430\u0448\u043d\u043e, \u043f\u0440\u044f\u043c \u043d\u0430\u043f\u0443\u0433\u0430\u043b \ud83e\udd23\u003C\/p\u003E\n\n","renderFailed":false,"mentionedByCount":0,"canEdit":false,"canDelete":false,"canHide":false,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"user":{"data":{"type":"users","id":"791588"}},"discussion":{"data":{"type":"discussions","id":"197022"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4727068","attributes":{"number":14,"createdAt":"2026-10-25T20:36:32+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u0422\u044b, \u041f\u043e\u043f\u0443\u0449, \u0447\u0451\u0440\u0442 \u0444\u043e\u0440\u0443\u043c\u0441\u043a\u0438\u0439, \u0438 \u043f\u0440\u043e\u043a\u043b\u044f\u0442\u043e\u0433\u043e \u0447\u0451\u0440\u0442\u0430 \u0431\u0440\u0430\u0442 \u0438 \u0442\u043e\u0432\u0430\u0440\u0438\u0449, \u0441\u0430\u043c\u043e\u0433\u043e \u041b\u044e\u0446\u0438\u0444\u0435\u0440\u0430 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u044c! \u041a\u0430\u043a\u043e\u0439 \u0442\u044b \u043a \u0447\u0451\u0440\u0442\u0443 \u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c \u0434\u0432\u0435\u0440\u0438, \u043a\u043e\u0433\u0434\u0430 \u0433\u043e\u043b\u043e\u0439 \u0436\u043e\u043f\u043e\u0439 \u043b\u0438\u043f\u0443 \u043d\u0435 \u0443\u0431\u044c\u0451\u0448\u044c? \u0427\u0451\u0440\u0442 \u0442\u044b, \u0441\u0440\u0430\u0442\u044c \u0442\u0432\u043e\u0439 \u043a\u0430\u0442. \u041d\u0435 \u0431\u0443\u0434\u0435\u0448\u044c \u0442\u044b \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u0440\u0430\u0441\u043f\u0430\u0434\u0430 \u043f\u043e\u0434 \u0441\u043e\u0431\u043e\u0439 \u0438\u043c\u0435\u0442\u044c, \u0442\u0432\u043e\u0435\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430 \u043c\u044b \u043d\u0435 \u0431\u043e\u0438\u043c\u0441\u044f, \u0437\u0435\u043c\u043b\u0451\u0439 \u0438 \u0432\u043e\u0434\u043e\u0439 \u0431\u0443\u0434\u0435\u043c \u0431\u0438\u0442\u044c\u0441\u044f \u0441 \u0442\u043e\u0431\u043e\u0439, \u0440\u0430\u0441\u043f\u0440\u043e\u043a\u043b\u044f\u0442\u044b\u0439 \u0442\u044b \u0441\u044b\u043d!\u003C\/p\u003E\n\n\u003Cp\u003E\u0418\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u0441\u043a\u0438\u0439 \u0442\u044b \u043f\u043e\u0432\u0430\u0440, \u0411\u0430\u0440\u044c\u0435\u0440\u043d\u044b\u0439 \u043a\u043e\u043b\u0451\u0441\u043d\u0438\u043a, \u0425\u0440\u043e\u043f\u0438\u0432\u043d\u044b\u0439 \u043f\u0438\u0432\u043e\u0432\u0430\u0440, \u0421\u0435\u0440\u043f\u0430\u043d\u0442\u0438\u043d\u0441\u043a\u0438\u0439 \u043a\u043e\u0437\u043e\u043b\u0443\u043f, \u0441\u0432\u0438\u043d\u043e\u0439 \u0442\u044b \u041a\u0430\u043f\u0438\u0434\u0440\u043e\u043a\u0438\u0439 \u0438 \u0434\u0438\u043a\u043e-\u0441\u0435\u0432\u0435\u0440\u043d\u044b\u0439 \u0441\u0432\u0438\u043d\u043e\u043f\u0430\u0441, \u041d\u0430\u0451\u043c\u043d\u0438\u0447\u0442\u0439 \u0431\u0440\u043e\u0434\u044f\u0433\u0430, \u0417\u0430\u0432\u0435\u0442\u043e\u0432\u0441\u043a\u0438\u0439 \u0441\u0430\u0433\u0430\u0439\u0434\u0430\u043a, \u041f\u043e\u0434\u0437\u0430\u043b\u0443\u043f\u043d\u044b\u0439 \u043f\u0430\u043b\u0430\u0447, \u0432\u0441\u0435\u0433\u043e \u0441\u0432\u0435\u0442\u0430 \u0438 \u043f\u043e\u0434\u0441\u0443\u0434\u043a\u0430 \u0434\u0443\u0440\u0430\u043a, \u0441\u0430\u043c\u043e\u0433\u043e \u0430\u0441\u043f\u0438\u0434\u0430 \u0432\u043d\u0443\u043a \u0438 \u043d\u0430\u0448\u0435\u0433\u043e \u0445\u0443\u044f \u043a\u0440\u044e\u043a. \u0421\u0432\u0438\u043d\u0430\u044f \u0442\u044b \u043c\u043e\u0440\u0434\u0430, \u043a\u043e\u0431\u044b\u043b\u0438\u043d\u0430\u044f \u0441\u0440\u0430\u043a\u0430, \u043c\u044f\u0441\u043d\u0438\u0446\u043a\u0430\u044f \u0441\u043e\u0431\u0430\u043a\u0430, \u043d\u0435\u043a\u0440\u0435\u0449\u0451\u043d\u044b\u0439 \u043b\u043e\u0431, \u043c\u0430\u0442\u044c \u0442\u0432\u043e\u044e \u0442\u0430\u043a!\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u043e\u0442 \u0442\u0430\u043a \u041e\u0420\u0417\u0448\u043d\u0438\u043a\u0438 \u0442\u0435\u0431\u0435 \u043e\u0431\u044a\u044f\u0432\u0438\u043b\u0438, \u043f\u043b\u044e\u0433\u0430\u0432\u043e\u043c\u0443. \u041d\u0435 \u0431\u0443\u0434\u0435\u0448\u044c \u0442\u044b \u0441\u044b\u043d\u043e\u0432\u0435\u0439 \u041e\u0420\u0417 \u043f\u043e\u0434 \u0441\u043e\u0431\u043e\u0439 \u0438\u043c\u0435\u0442\u044c. \u0427\u0438\u0441\u043b\u0430 \u043d\u0435 \u0437\u043d\u0430\u0435\u043c, \u043f\u043e\u0442\u043e\u043c\u0443 \u043a\u0430\u043a \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044f \u043d\u0435 \u0438\u043c\u0435\u0435\u043c, \u043c\u0435\u0441\u044f\u0446 \u0432 \u043d\u0435\u0431\u0435, \u0433\u043e\u0434 \u0432 \u043a\u043d\u0438\u0433\u0430\u0445, \u0430 \u0434\u0435\u043d\u044c \u0443 \u043d\u0430\u0441 \u0442\u0430\u043a\u043e\u0439 \u0436\u0435, \u043a\u0430\u043a \u0438 \u0443 \u0432\u0430\u0441, \u0437\u0430 \u0447\u0442\u043e \u0446\u0435\u043b\u0443\u0439 \u0432 \u0436\u043e\u043f\u0443 \u043d\u0430\u0441!\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.