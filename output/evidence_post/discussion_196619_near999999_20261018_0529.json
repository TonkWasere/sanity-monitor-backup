u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0441 \u0440\u0430\u0434\u0430\u043c\u0438. \u0418\u043d\u0432\u0438\u0437, \u0440\u0430\u0434\u0430\u0440. \u0427\u0435\u0442 \u0434\u043e\u0445\u0443\u044f \u043d\u0435? \u0418 \u0438\u043d\u0432\u0438\u0437 \u043c\u043e\u043c\u0435\u043d\u0442\u043e\u043c \u043f\u0440\u043e\u0436\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u0438 \u0432\u0441\u0435. \u041e\u043d \u0438\u0441\u043f\u0430\u0440\u0438\u043b\u0441\u044f. \u041c\u0435\u0439\u0431\u0438 \u0442\u0430\u043c \u043d\u0443 \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u044e \u0434\u0430\u0442\u044c \u0447\u0442\u043e\u0431\u044b 0,5 \u0441\u0435\u043a \u0431\u044b\u043b\u043e? \u041d\u0435\u0442 \u0432\u0430\u0439\u0431\u0430? \u0415\u0449\u0435 \u0438 \u043f\u0435\u0440\u0435\u043b\u0438\u0442\u044c \u0432 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0431\u0435\u0433\u0430 \u0435\u0433\u043e \u043f\u0430\u0441\u0441\u0438\u0432\u043a\u0443 \u0438\u0437 \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f. \u0410\u0434\u0430\u0434 \u0447\u0435\u043b +10% \u0438\u043c\u0435\u0435\u0442, \u043a\u043e\u043c\u043e\u043d\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0422\u043e \u043b\u0438 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u043f\u0438\u0434\u043e\u0440\u0430\u0441, \u0442\u043e \u043b\u0438 \u0447\u0442\u043e.. \u043d\u043e \u0440\u0435\u0433\u0430. \u0415\u0431\u0435\u0439\u0449\u0430\u044f \u0440\u0435\u0433\u0430. \u0427\u0435\u043b \u0431\u0435\u0440\u0435\u0442 \u043c\u04333, \u0445\u0443\u044f\u0440\u0438\u0442 7 \u0433\u043e\u043b\u043e\u0432 11 \u043f\u0443\u0437\u0430- \u0443\u0431\u0438\u0432\u0430\u0435\u0442. \u0421\u043c\u043e\u0442\u0440\u0438\u0448\u044c \u0441\u0442\u0430\u0442\u0443 \u043f\u043e\u043f\u0430\u0434\u0430\u043d\u0438\u0439- \u0442\u044b 2 \u043f\u0443\u043b\u0438. \u0412\u043e\u0442 \u043a\u0442\u043e \u043f\u0438\u0434\u043e\u0440\u0430\u0441 \u0438 \u0434\u0443\u043c\u0430\u0439\u2026.\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u043e\u0432\u044b\u0445 \u043f\u043e\u0434\u043a\u043b\u0430\u0441\u0441\u043e\u0432? \u041d\u0443 \u0442\u0438\u043f\u0430 \u0442\u0430\u043d\u043a\u0443 \u044f \u0445\u0437, \u0432\u043e\u043e\u0431\u0449\u0435 \u0432 \u0440\u0435\u0439\u0442\u0435 \u0432\u0438\u0434\u0435\u043b \u043f\u0430\u0440\u0443 \u0440\u0430\u0437. \u041e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0432\u0441\u0435 \u0442\u0430\u043a \u0436\u0435 \u043a\u0430\u043a \u0438 \u043d\u0430 \u043f\u0435\u0440\u0432\u043e\u043c \u0441\u0435\u0437\u043e\u043d\u0435- \u0448\u0442\u0443\u0440\u043c\u044b\/\u043d\u0430\u0443\u0447\u043a\u0438.\u003C\/p\u003E \u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u041f\u043e\u0447\u0435\u043c\u0443 \u043d\u0435 \u0431\u044b\u043b\u043e \u0438\u043d\u0444\u044b \u0438 \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u0435 \u0434\u0430\u043b\u0438 \u043f\u043e \u043d\u043e\u0432\u044b\u043c \u0446\u0438\u0444\u0440\u0430\u043c? \u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u0430\u0435\u0442 \u0437\u0430\u043f\u0438\u043a \u044f\u0439\u0446\u0430, \u0443\u0441\u0442\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0443\u043d\u0434 \u0438 \u0442\u0434\u003Cbr\u003E\n\u042f \u0437\u0430\u0445\u043e\u0436\u0443 \u0432 \u0440\u0435\u0439\u0442 \u0438 \u0432\u0438\u0436\u0443 \u043d\u043e\u0432\u044b\u0435 \u0447\u0438\u0441\u043b\u0430 \u043d\u0430\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f. \u041d\u0435\u0442, \u043e\u043d\u0438 \u043f\u0438\u0437\u0434\u0430\u0442\u044b\u0435, \u043d\u0435 \u0434\u0430\u044e\u0442 \u043a\u043e\u043c\u0430\u043d\u0434\u0435 \u043e\u0442\u043e\u0440\u0432\u0430\u0442\u044c\u0441\u044f \u0441\u0438\u043b\u044c\u043d\u043e \u0432\u043d\u0430\u0447\u0430\u043b\u0435 \u0438 \u0434\u043e\u0433\u043d\u0430\u0442\u044c, \u0443\u0436\u04