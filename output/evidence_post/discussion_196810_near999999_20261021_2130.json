u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0430\u0447\u043a\u0438 \u0438\u0433\u0440\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u043a\u0430\u043a \u043e\u0432\u0435\u0440\u0445\u0430\u0439 \u0441\u0438\u043b\u044c\u043d\u044b\u0445. \u0410 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u043f\u0442\u0441 \u0442\u0430\u043a\u0430\u044f, \u0447\u0442\u043e \u0441\u0438\u043b\u044c\u043d\u044b\u043c - \u043c\u0430\u043b\u043e, \u0441\u043b\u0430\u0431\u044b\u043c - \u043c\u043d\u043e\u0433\u043e. \u0412 \u0438\u0442\u043e\u0433\u0435 \u0435\u0441\u043b\u0438 \u201c\u0441\u043b\u0430\u0431\u0430\u0447\u043a\u0438\u201d \u0431\u0435\u0440\u0443\u0442 1 \u043c\u0435\u0441\u0442\u043e, \u0442\u043e \u0438\u043c, \u043a \u043f\u0440\u0438\u043c\u0435\u0440\u0443, +150\u043f\u0442\u0441. \u0410 \u0435\u0441\u043b\u0438 \u0442\u043e\u043f 1 \u0432\u043e\u0437\u043c\u0435\u0442 \u043b\u044e\u0431\u0430\u044f \u0434\u0440\u0443\u0433\u0430\u044f \u043f\u0430\u0447\u043a\u0430 \u0438\u0437 \u044d\u0442\u043e\u0433\u043e \u043b\u043e\u0431\u0431\u0438, \u0442\u043e \u0438\u043c \u0445\u0440\u0435\u043d\u0430 \u043b\u044b\u0441\u043e\u0433\u043e \u0438 \u0434\u0430\u0439 \u0431\u043e\u0433 +15-20 \u043d\u0430 \u0441\u0434\u0430\u0447\u0443. \u003Cbr\u003E\n \u0418 \u0432\u0434\u043e\u0432\u0435\u0441\u043e\u043a \u043d\u0435\u043c\u043d\u043e\u0433\u043e \u0441\u044e\u0440\u0430, \u0435\u0441\u043b\u0438 \u201c\u0441\u043b\u0430\u0431\u0430\u0447\u043a\u0438\u201d \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0437\u0430\u0431\u0435\u0440\u0443\u0442 3 \u043c\u0435\u0441\u0442\u043e, \u0442\u043e \u0438\u043c \u0434\u0430\u0441\u0442, \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e, + \u043f\u0442\u0441, \u0430 \u201c\u0441\u0438\u043b\u0430\u0447\u0430\u043c\u201d \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043c\u0438\u043d\u0443\u0441.\u003C\/p\u003E\n\n\u003Cp\u003E\u042d\u0442\u043e \u0442\u043e\u0447