40\u0434\u0435\u0442\u044c \u043f\u043e\u0441\u0440\u0430\u0442\u044c \u0443\u043c\u044b\u0442\u044c\u0441\u044f \u0438 \u0432\u0441\u0451 \u0442\u0430\u043a\u043e\u0435, \u0438 \u0441\u0440\u0430\u0437\u0443 \u0441\u0435\u043b \u0433\u0440\u0438\u043d\u0434\u0438\u0442\u044c, \u043e\u043d \u0434\u043e \u043f\u043e\u043b\u0443\u043d\u043e\u0447\u0438 \u0443\u0441\u043f\u0435\u0432\u0430\u0435\u0442 \u0432 \u0438\u0434\u0435\u0430\u043b\u0435 \u003Csub\u003E8\u003C\/sub\u003E \u043a\u0430\u0442\u043e\u043a. \u041d\u041e \u0434\u0430\u0432\u0430\u0439 \u0431\u0443\u0434\u0435\u043c \u0447\u0435\u0441\u0442\u043d\u044b, \u0442\u0443\u0442 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0440\u043e\u0431\u043e\u0442 \u043a\u0440\u043e\u043c\u0435 \u0448\u043a\u043e\u043b\u044c\u043d\u0438\u043a\u043e\u0432 \u043d\u0430 \u043a\u0430\u043d\u0438\u043a\u0443\u043b\u0430\u0445 \u0438 \u043d\u0435 \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u0435\u0431\u0430\u0448\u0438\u0442\u044c \u0434\u043e \u043f\u043e\u043b\u0443\u043d\u043e\u0447\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0435\u043c\u0443 \u0443\u0442\u0440\u043e\u043c \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044c \u0440\u0430\u043d\u043e \u043d\u0430 \u0440\u0430\u0431\u0441\u043a\u0443\u044e \u043a\u0430\u0442\u043e\u0440\u0433\u0443. \u0420\u0435\u0439\u0442\u0438\u043d\u0433 \u0434\u043b\u0438\u0442\u0441\u044f \u0434\u0432\u0435 \u043d\u0435\u0434\u0435\u043b\u0438, \u0443\u0431\u0435\u0440\u0435\u043c \u0434\u0432\u0430 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0435\u043d\u044c\u044f, \u043f\u043e\u043b\u0443\u0447\u0438\u043c 12*8=96 \u043a\u0430\u0442\u043e\u043a. \u041e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u003Csub\u003E70\u003C\/sub\u003E \u043a\u0430\u0442\u043e\u043a \u043d\u0430\u0434\u043e \u043d\u0430\u0445\u0443\u044f\u0440\u0438\u0442\u044c \u043d\u0430 \u044d\u0442\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 + \u0432 \u0442\u0435 \u0434\u0432\u0430 \u0432\u043e\u0441\u043a\u0440\u0435\u0441\u0435\u043d\u044c\u044f. \u0418 \u044d\u0442\u043e, \u043f\u043e\u0432\u0442\u043e\u0440\u044e\u0441\u044c, \u0434\u0430\u0436\u0435 \u043d\u0435 \u0442\u0440\u0435\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434. \u041c\u0430\u0442\u0447 \u0440\u0435\u0439\u0445\u0441\u0442\u0430\u0433\u0430 \u0434\u043b\u0438\u043b\u0441\u044f \u043c\u0435\u043d\u044c\u0448\u0435 + \u0441\u0430\u043c \u0438\u0432\u0435\u043d\u0442 \u0448\u0435\u043b \u0434\u043e\u043b\u044c\u0448\u0435 + \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u043e\u0432 \u043d\u0435 \u0431\u044b\u043b\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u043d\u043e \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0438 \u043f\u043e \u0446\u0435\u043d\u043d\u0438\u043a\u0430\u043c \u0438\u0437-\u0437\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432\u043e\u0439 \u043b\u0438\u0433\u0438 \u0440\u0435\u0439\u0445\u0441\u0442\u0430\u0433\u0430. \u041e\u0442\u0442\u0443\u0434\u0430 \u0438 \u0433\u0430\u0440\u0430\u043d\u0442\u044b \u0432\u044b\u0444\u0430\u0440\u043c\u043b\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u0443\u0441\u043f\u0435\u0432\u0430\u043b\u0438.\u003C\/p\u003E \n\n\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/197235-nagrady-za-ivent\/3\u0022 class=\u0022PostMention\u0022 data-id=\u00224734945\u0022\u003EThe_Creatorr\u003C\/a\u003E \u041e\u043d\u0438 \u043f\u043e-\u0442\u0432\u043e\u0435\u043c\u0443 \u0445\u043e\u0442\u044c \u043a\u043e\u0433\u0434\u0430 \u0442\u043e \u0441\u043a\u0438\u0434\u044b\u0432\u0430\u043b\u0438 \u0446\u0435\u043d\u044b \u043d\u0430 \u0433\u0430\u0440\u0430\u043d\u0442?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0412\u0441\u0451 \u0431\u044b\u0432\u0430\u0435\u0442 \u0432 \u0