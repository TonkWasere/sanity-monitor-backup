actionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":1,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"user":{"data":{"type":"users","id":"1712966"}},"discussion":{"data":{"type":"discussions","id":"197786"}},"mentionedBy":{"data":[{"type":"posts","id":"4753346"}]},"likes":{"data":[]}}},{"type":"posts","id":"4753325","attributes":{"number":22,"createdAt":"2026-11-09T15:33:26+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u042f \u0445\u0443\u0439 \u0437\u043d\u0430\u0435\u0442 \u0437\u0430\u0447\u0435\u043c \u043f\u0438\u0441\u0430\u0442\u044c, \u0447\u0442\u043e \u043f\u0440\u043e\u0435\u043a\u0442 \u043c\u0435\u0440\u0442\u0432\u044b\u0439. \u041f\u043e \u0444\u0430\u043a\u0442\u0443 \u0442\u0443\u0442 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u043e\u0432\u0430\u044f \u0438\u0433\u0440\u0430, \u0447\u0442\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u043d\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438 \u0441\u0442\u0430\u043b\u043a\u0435\u0440 \u2014 \u043f\u0440\u0438\u0447\u0438\u043d\u0430, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043c\u043d\u043e\u0433\u0438\u0435 \u0441\u0442\u0430\u0440\u0438\u0447\u043a\u0438 \u043f\u0440\u0438\u0448\u043b\u0438 \u0432 stalcraft.\u003Cbr\u003E\n\u0414\u0443\u043c\u0430\u044e \u044d\u0442\u043e \u0436\u0435 \u043a\u0440\u0443\u0442\u043e, \u043a\u043e\u0433\u0434\u0430 \u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u0432\u043c\u0435\u0441\u0442\u043e \u043e\u0434\u043d\u043e\u0433\u043e \u0432\u044b\u0431\u043e\u0440\u0430 Stalcraft, \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0435\u0449\u0451 \u043e\u0434\u0438\u043d:\u003Cbr\u003E\n\u0410) (Stalzone) \u0418\u0433\u0440\u0430-\u0441\u0430\u043c\u043e\u0434\u0435\u043b\u043a\u0430, \u0447\u0442\u043e \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f \u043e\u0442\u043e\u0439\u0442\u0438 \u043e\u0442 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u0438 \u0441\u0442\u0430\u043b\u043a\u0435\u0440\u0430, \u0443\u0442\u0440\u0430\u0442\u0438\u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0435\u0439, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u043d\u0435 \u043f\u043e\u043d\u044f\u0442\u043d\u043e, \u0447\u0442\u043e \u0438\u0437 \u0441\u0435\u0431\u044f \u0445\u043e\u0447\u0435\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0438\u0433\u0440\u0430 \u0432 \u0446\u0435\u043b\u043e\u043c.\u003Cbr\u003E\n\u0411) (Anoma) \u0418\u0433\u0440\u0430, \u0447\u0442\u043e \u0432\u044b\u0435\u0437\u0436\u0430\u0435\u0442 \u043d\u0430 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0435 \u0441\u0442\u0430\u043b\u043a\u0435\u0440\u0430, \u043f\u044b\u0442\u0430\u044f\u0441\u044c \u0446\u0435\u043f\u043b\u044f\u0442\u044c \u0441\u0442\u0430\u0440\u0438\u0447\u043a\u043e\u0432, \u043d\u043e \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u043c\u0438\u043d\u0443\u0441, \u0447\u0442\u043e \u0432\u0441\u0451 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0432 \u0437\u0430\u0435\u0437\u0436\u0430\u043d\u043d\u044b\u0445 \u043a\u0443\u0431\u0430\u0445 \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442 \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043a\u0430\u043a \u0441\u0443\u043f\u0435\u0440 \u043e\u0447\u0435\u0440\u0435\u0434\u043d\u043e\u0439 \u043c\u043e\u0434 \u043d\u0430 \u043c\u0430\u0439\u043d\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u0440\u0447, \u0441\u0447\u0438\u0442\u0430\