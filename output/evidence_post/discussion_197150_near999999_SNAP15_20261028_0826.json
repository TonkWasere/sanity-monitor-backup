43b\u0435\u0435 \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u0445 \u0434\u043e \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0445:\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442 1 (\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0449\u0438\u0439, \u043d\u043e \u0447\u0435\u0441\u0442\u043d\u044b\u0439):\u003Cbr\u003E\n\u00ab\u0421\u043b\u0443\u0448\u0430\u0439, \u044f, \u0447\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u0434\u0430\u0436\u0435 \u043d\u0435 \u0437\u043d\u0430\u044e, \u0447\u0442\u043e \u0442\u0443\u0442 \u0441\u043a\u0430\u0437\u0430\u0442\u044c. \u0421 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b, \u0442\u044b \u043f\u0440\u0430\u0432 \u2014 \u0442\u0440\u0430\u0432\u043b\u044f \u0437\u0430 \u0442\u0438\u0440\u0435 \u0438\u043b\u0438 \u0441\u043b\u043e\u0432\u043e \u201c\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f\u201d \u0443\u0436\u0435 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442 \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u0437\u0434\u0440\u0430\u0432\u043e\u0433\u043e \u0441\u043c\u044b\u0441\u043b\u0430, \u0438 \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u0442\u044c\u0441\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e. \u0421 \u0434\u0440\u0443\u0433\u043e\u0439 \u2014 \u044f \u043d\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u043e \u0433\u043b\u0443\u0431\u043e\u043a\u043e \u0432 \u0442\u0435\u043c\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c, \u0433\u0434\u0435 \u0437\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u044f. \u0422\u0430\u043a \u0447\u0442\u043e \u0442\u0443\u0442 \u044f \u043f\u0430\u0441, \u0443 \u043c\u0435\u043d\u044f \u043d\u0435\u0442 \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0433\u043e \u043e\u0442\u0432\u0435\u0442\u0430\u00bb.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442 2 (\u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0438 \u0441\u043e\u043b\u0438\u0434\u0430\u0440\u043d\u044b\u0439):\u003Cbr\u003E\n\u00ab\u0414\u0430 \u0445\u0440\u0435\u043d \u0435\u0433\u043e \u0437\u043d\u0430\u0435\u0442. \u042f \u0442\u043e\u0436\u0435 \u0442\u0435\u0440\u044f\u044e\u0441\u044c, \u043a\u043e\u0433\u0434\u0430 \u0432\u0438\u0436\u0443, \u043a\u0430\u043a \u043b\u044e\u0434\u0435\u0439 \u043a\u043b\u0435\u0439\u043c\u044f\u0442 \u0437\u0430 \u201c\u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u043d\u044b\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0438\u201d. \u041d\u043e \u043a\u0430\u043a \u044d\u0442\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0438\u043b\u0438 \u0433\u0434\u0435 \u0442\u0430 \u0441\u0430\u043c\u0430\u044f \u0433\u0440\u0430\u043d\u044c \u2014 \u044f \u0431\u0435\u0437 \u043f\u043e\u043d\u044f\u0442\u0438\u044f\u00bb.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442 3 (\u0441 \u0430\u043a\u0446\u0435\u043d\u0442\u043e\u043c \u043d\u0430 \u0431\u0435\u0441\u0441\u0438\u043b\u0438\u0435):\u003Cbr\u003E\n\u00ab\u042f \u043d\u0435 \u0437\u043d\u0430\u044e. \u0421\u0435\u0440\u044c\u0435\u0437\u043d\u043e, \u0442\u0443\u0442 \u044f \u043d\u0435 \u044d\u043a\u0441\u043f\u0435\u0440\u0442. \u041c\u043e\u0433\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e, \u0447\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u044d\u0442\u043e \u0432\u0441\u0451 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0442\u0440\u0430\u043d\u043d\u043e \u0438 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e, \u043d\u043e \u043a\u0430\u043a \u0442\u0443\u0442 \u0431\u044b\u0442\u044c \u2014 \u0443\u043c\u0430 \u043d\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0443\u00bb.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442 4 (\u0444\u0438\u043b\u043e\u0441\u043e\u0444\u0441\u043a\u0438\u0439):\u003Cbr\u003E\n\u00ab\u0417\u043d\u0430\u0435\u0448\u044c, \u044f \u043d\u0435 \u0437\u043d\u0430\u044e. \u041c\u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u044d\u0442\u043e \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u043e\u0431\u0449\u0438\u0439 \u0441\u0434\u0432\u0438\u0433 \u043f\u0430\u0440\u0430\u043d\u043e\u0439\u0438 \u0432 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435, \u0438 \u044f \u043d\u0435 \u043c\u043e\u0433\u0443 \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u0442\u044c \u044d\u0442\u043e\u043c\u0443 \u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435. \u0422\u0430\u043a \u0447\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043e\u0433\u043b\u0430\u0448\u0443\u0441\u044c, \u0447\u0442\u043e \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0430\u0431\u0441\u0443\u0440\u0434\u043d\u0430\u044f, \u043d\u043e \u0447\u0442\u043e \u0441 \u043d\u0435\u0439 \u0434\u0435\u043b\u0430\u0442\u044c \u2014 \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u0437\u0430\u0433\u0430\u0434\u043a\u0430\u00bb.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0430\u0440\u0438\u0430\u043d\u0442 5 (\u0441\u0430\u043c\u044b\u0439 \u043b\u0430\u043a\u043e\u043d\u0438\u0447\u043d\u044b\u0439):\u003Cbr\u003E\n\u00ab\u042f \u043d\u0435 \u0437\u043d\u0430\u044e, \u0435\u0441\u043b\u0438 \u0447\u0435\u0441\u0442\u043d\u043e. \u0422\u0443\u0442 \u0442\u044b \u043c\u0435\u043d\u044f \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u0432 \u0442\u0443\u043f\u0438\u043a\u00bb.\u003C\/p\u003E","renderFailed":false,"mentionedByCount":0,"canEdit":false,"canDelete