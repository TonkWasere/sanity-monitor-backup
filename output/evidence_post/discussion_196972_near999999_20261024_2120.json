\u0435 \u043c\u043e\u0433\u0443\u0442 \u0441\u0438\u043b\u044c\u043d\u043e \u0432\u043b\u0438\u044f\u0442\u044c \u043d\u0430 \u0432\u044b\u0431\u043e\u0440 \u0438\u0433\u0440\u043e\u043a\u0430 (\u043a\u043e\u043b-\u0432\u043e \u0443\u0440\u043e\u043d\u0430 \u0432 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0438\u043b\u0438 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0440\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c(\u043e\u043f\u043e\u0441\u0440\u0435\u0434\u043e\u0432\u0430\u043d\u043e \u043e\u0442 \u0434\u043f\u0441 \u043e\u043d\u0430 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0441\u0443\u0431\u044c\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0438\u043b\u0438 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439))\u003C\/li\u003E\u003C\/ol\u003E\n\n\u003Cp\u003E\u0415\u0441\u043b\u0438 \u043c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u043e \u041f\u0412\u041f \u0442\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0442\u0441\u044f \u0432\u0441\u0451 \u0441\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0439 \u043f\u0443\u043b \u043e\u0440\u0443\u0436\u0438\u044f.\u003Cbr\u003E\n\u041d\u043e \u0435\u0441\u043b\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043e\u0431 \u043e\u0431\u0449\u0435\u043c \u043f\u0443\u043b\u0435 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 - \u043a\u0430\u0440\u0442\u0438\u043d\u0430 \u0441\u043e\u0432\u0441\u0435\u043c \u0434\u0440\u0443\u0433\u0430\u044f.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a \u0447\u0435\u043c\u0443 - \u0442\u044b \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u0435\u0448\u044c \u0441\u044b\u0440\u043e\u043a \u0438 \u0441\u043a\u043e\u0440\u043f. \u041f\u043e \u043c\u043e\u0435\u0439 \u043b\u043e\u0433\u0438\u043a\u0435 \u0441\u043a\u043e\u0440\u043f \u0445\u043e\u0440\u043e\u0448 \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u043a\u0442\u043e \u0437\u043d\u0430\u0435\u0442 \u0447\u0442\u043e \u0441 \u043d\u0438\u043c \u0434\u0435\u043b\u0430\u0442\u044c \u0438 \u0438\u0434\u0451\u0442 \u043a \u043d\u0435\u043c\u0443 \u043d\u0435 \u0440\u0430\u0434\u0438 \u0422\u0422\u041a \u0430 \u0440\u0430\u0434\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u044d\u0442\u043e\u0433\u043e \u043e\u0440\u0443\u0436\u0438\u044f(\u0435\u0441\u043b\u0438 \u043e\u043d \u0438\u0445 \u043f\u043e\u043d\u0438\u043c\u0430\u0435\u0442 \u0438\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u043d\u043e\u0432\u043e\u0435 \u043d\u0430 \u0444\u043e\u043d\u0435 \u0443\u0436\u0435 \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u0442\u0451\u043d\u043d\u043e\u0433\u043e \u043e\u043f\u044b\u0442\u0430 \u0438 \u0433\u0430\u043d\u043f\u043b\u0435\u044f \u0438\u0433\u0440\u044b). \u0441\u044b\u0440\u043e\u043a \u0432 \u044d\u0442\u043e\u043c \u043a\u0435\u0439\u0441\u0435(\u043e\u043f\u043e\u0441\u0440\u0435\u0434\u043e\u0432\u0430\u043d\u043d\u043e) \u044d\u0442\u043e \u043f\u0435\u0440\u0432\u044b\u0439 \u0448\u0430\u0433 \u0434\u043b\u044f \u041f\u0432\u041f \u0438\u0433\u0440\u043e\u043a\u0430, \u0434\u043b\u044f \u0435\u0433\u043e \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u0447\u0442\u043e \u0438 \u043a\u0430\u043a \u0435\u043c\u0443 \u043d\u0430\u0434\u043e \u0438 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e, \u0438\u043b\u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043b\u044f \u043d\u0435\u043a\u0438\u0431\u0435\u0440\u043a\u043e\u0442\u043b\u0435\u0442\u044b \u043f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f \u0438\u043d\u0430\u0447\u0435 \u0432 \u0435\u0433\u043e \u0431\u043e\u043b\u043e\u0442\u0435.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u0440\u0430\u0447\u0435, \u043a