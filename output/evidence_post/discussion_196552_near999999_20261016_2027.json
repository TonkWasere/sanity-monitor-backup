043f\u0440\u044f\u043c\u0443\u044e \u043e\u0442 \u0445\u043e\u0440\u043e\u0448\u0435\u0439 \u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u0411\u042b\u0421\u0422\u0420\u041e\u0419 \u043f\u0430\u043c\u044f\u0442\u0438 - \u0430 \u0442\u044b \u0445\u043e\u0440\u043e\u0448, \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u043a\u0430\u043a \u043e\u043d\u043e \u0437\u0430\u0432\u0435\u0434\u0451\u0442\u0441\u044f \u0438 \u043f\u043e\u043b\u0435\u0442\u0438\u0442. \u041e\u043d\u043e \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0437\u0430\u0432\u0435\u0434\u0451\u0442\u0441\u044f ( \u0435\u0441\u043b\u0438 \u044d\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 ecc reg \u043f\u0430\u043c\u044f\u0442\u044c) , \u043d\u043e \u043f\u0430\u043c\u044f\u0442\u044c \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u0430 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u043e\u0442\u0435, \u0438 \u043d\u0438 \u043e \u043a\u0430\u043a\u0438\u0445 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0430\u043b\u0430\u0445 \u0432 \u0440\u0430\u0437\u0433\u043e\u043d\u0435 \u0438 \u0440\u0435\u0447\u0438 \u043d\u0435 \u0431\u0443\u0434\u0435\u0442 \u0438\u0434\u0442\u0438. \u0410 \u0435\u0441\u043b\u0438 \u043c\u0435\u043d\u044f\u0442\u044c \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442 \u043d\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0435\u0441\u043a\u0442\u043e\u043f\u043d\u044b\u0439 ( non-ecc udimm), \u0442\u043e \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442 \u043f\u0430\u043c\u044f\u0442\u0438 ddr4 32gb 3600 - \u043e\u0431\u043e\u0439\u0434\u0451\u0442\u0441\u044f \u0442\u0435\u0431\u0435 \u043f\u043e \u043d\u044b\u043d\u0435\u0448\u043d\u0438\u043c \u0440\u0435\u0430\u043b\u0438\u044f\u043c \u0432 20-25\u043a, \u0431\/\u0443 \u043d\u0443 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c 15\u043a, \u0437\u0434\u043e\u0440\u043e\u0432\u043e \u043f\u0440\u0430\u0432\u0434\u0430? \u042f \u0432 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u0435 2025 \u0433\u043e\u0434\u0430 48\u0433\u0431 ddr5 \u0432\u0437\u044f\u043b \u0437\u0430 11\u043a. \u0412\u043e\u0442 \u0438 \u0434\u0443\u043c\u0430\u0439\u0442\u0435.\u003C\/p\u003E\n \n\u003Cp\u003E\u0427\u0435\u043b\u043e\u0432\u0435\u043a \u043a\u0443\u043f\u0438\u0432\u0448\u0438\u0439 \u043a\u043e\u0433\u0434\u0430-\u0442\u043e \u0444\u0443\u043b\u043b \u043a\u0443\u0434\u0430\u0445\u0442\u0435\u0440 \u0437\u0430 \u0442\u0430\u043a\u0443\u044e \u0446\u0435\u043d\u0443, \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u0435\u0431\u0435 \u043f\u043b\u0430\u0448\u043a\u0438 \u043f\u0430\u043c\u044f\u0442\u0438 10 \u043b\u0435\u0442\u043d\u0435\u0439 \u0434\u0430\u0432\u043d\u043e\u0441\u0442\u0438 \u0431\u0440\u0430\u0442\u044c \u0437\u0430 240 \u0431\u0430\u043a\u0441\u043e\u0432 ))0 \u0432\u043e\u0442 \u043e\u043d \u0443\u0436 \u0442\u043e\u0447\u043d\u043e \u043e\u0431\u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044f \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044e \u0434\u0432\u0438\u0436\u043a\u0430 \u0432 \u0438\u0433\u0440\u0435.\u003C\/p\u003E\n\n\n","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":1,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":1,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196552"}},"user":{"data":{"type":"users","id":"1700941"}},"mentionedBy":{"data":[]},"likes":{"data":[{"type":"users","id":"1700493"}]}}},{"type":"po