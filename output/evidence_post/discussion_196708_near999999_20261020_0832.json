8 \u044f \u043d\u043e\u0440\u043c \u0442\u0430\u043a \u043e\u0444\u0438\u0433\u0435\u043b \u043e\u0442 \u0440\u0430\u0437\u043d\u0438\u0446\u044b. \u041d\u0430 \u043d\u043e\u0443\u0442\u0435 \u0447\u0430\u0441\u0442\u043e \u043c\u0438\u043a\u0440\u043e\u0444\u0440\u0438\u0437\u044b, \u0441\u0430\u043c\u0438 \u043a\u0430\u0434\u0440\u044b \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0440\u0432\u0430\u043d\u044b\u0435. Vsync \u0438\u0437 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 \u043d\u0435 \u0432\u0440\u0443\u0431\u0430\u043b, \u043d\u043e \u0435\u043f\u0442, \u0435\u0441\u043b\u0438 \u0432 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0435 \u0438\u0433\u0440 \u0441 60+ \u043a\u0430\u0434\u0440\u043e\u0432 \u0431\u0435\u0437 vsync \u0440\u0430\u0437\u0440\u044b\u0432 \u044f \u0432\u0438\u0434\u0435\u043b \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0434 \u043b\u0443\u043f\u043e\u0439, \u0442\u043e \u0432 \u0441\u043a \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u044f\u0432\u043d\u043e \u0432\u0438\u0434\u043d\u043e. \u041c\u0430\u0442\u0440\u0438\u0446\u0430 \u043d\u0430 \u043d\u043e\u0443\u0442\u0435 \u043a\u0441\u0442\u0430 60 \u0433\u0435\u0440\u0446, \u0433\u0434\u0435 \u044d\u0442\u0438 \u0440\u0430\u0437\u0440\u044b\u0432\u044b \u0432 \u0442\u0435\u043e\u0440\u0438\u0438 \u0437\u0430\u043c\u0435\u0442\u043d\u044b \u043d\u0438\u0436\u0435, \u043d\u043e \u0438\u043c\u0435\u0435\u043c \u0447\u0442\u043e \u0438\u043c\u0435\u0435\u043c.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412\u0434\u0432\u043e\u0439\u043d\u0435 \u043f\u0435\u0447\u0430\u043b\u044c\u043d\u043e \u043a\u043e\u0433\u0434\u0430 \u0437\u0430\u0445\u043e\u0434\u0438\u0448\u044c \u0432 \u043d\u043e\u0432\u0438\u043d\u043a\u0438 \u0441 \u0441\u043e\u0447\u043d\u043e\u0439 \u0433\u0440\u0430\u0444\u0438\u043a\u043e\u0439, \u0430 \u0442\u0430\u043c \u0444\u043f\u0441 \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u0432 \u0441\u043a.\u003C\/p\u003E\