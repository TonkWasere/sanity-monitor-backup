C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041f\u0444\u0444\u0444. \u041f\u043e\u0438\u0433\u0440\u0430\u0439 \u0441 \u043e\u0433\u043d\u0435\u043c\u0451\u0442\u043e\u043c. \u0412\u043e\u043d \u0442\u0430\u043c \u0435\u0449\u0451 \u0432\u0435\u0441\u0435\u043b\u0435\u0439. \u0415\u0433\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u0434\u043e\u0437\u0430\u0440\u044f\u0434\u0438\u0442\u044c, \u0430 \u0434\u043b\u044f \u041f\u0412\u041f \u0445\u043e\u0434\u0438\u0442\u044c \u0441 \u0431\u0430\u043b\u043e\u043d\u043e\u043c, \u043c\u0435\u043d\u044c\u0448\u0435 \u0447\u0435\u043c \u043d\u0430 30% - \u044d\u0442\u043e \u0441\u043c\u0435\u0440\u0442\u044c. \u0412\u0435\u0441\u044f\u0442 \u043a\u0430\u043a \u0441\u043b\u043e\u043d \u0438 \u0431\u0435\u0440\u0443\u0442 2 \u0441\u043b\u043e\u0442\u0430. \u0422\u0440\u0430\u0442\u044f\u0442\u0441\u044f \u043a\u0430\u043a \u043a\u043e\u043d\u0444\u0435\u0442\u044b \u043d\u0430 \u0434\u0435\u0442\u0441\u043a\u0438\u0445 \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a\u0430\u0445. \u003Cbr\u003E\n\u0414\u0430 \u0438 \u0442\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u0448\u044c\u0441\u044f \u0441 \u041f\u041f\u0445\u0430\u043c\u0438 \u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0434\u0438\u0441\u0442\u0435, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0442\u0435\u0431\u044f \u044f\u0432\u043d\u043e \u043d\u0435 \u043a\u043e\u0440\u043e\u043b\u0451\u043c \u0441\u0445\u043e\u0434\u0430 \u0431\u043b\u0438\u0436\u043d\u044f\u043a\u0430. \u0412\u0435\u0434\u044c \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u043e \u043f\u0430\u0442\u0442\u0435\u0440\u043d \u041f\u041f\u0445 \u043d\u0430 \u0431\u043b\u044f\u0436\u043d\u044f\u043a \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u043b\u0443\u0447\u0448\u0435 \u0432\u043e \u0432\u0441\u0451\u043c \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u0430, \u043d\u043e \u0441 \u0435\u0449\u0