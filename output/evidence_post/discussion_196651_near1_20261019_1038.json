\u0430\u0440\u0430 \u043c\u043d\u0435 \u0438 \u043d\u0435 \u0437\u0430\u0448\u043b\u0430, \u043d\u043e \u0447\u0443\u0442\u044c \u043f\u043e\u0437\u0436\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u043d\u0435\u043f\u0438\u0441\u0438 \u043d\u0430 \u043a\u0430\u0436\u0434\u044b\u0445 5 \u043c\u0435\u0442\u0440\u0430\u0445 \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043b\u0438 \u0431\u0430\u0440 \u0432 \u043e\u0447\u0435\u043d\u044c \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e. \u0425\u0437 \u043a\u0430\u043a \u043d\u0430 \u043c\u0430\u0441\u0442\u0430\u0445, \u043d\u0430 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u043a\u0430\u0445 \u044d\u0442\u0438 \u0431\u043e\u0442\u044b \u043e\u0447\u0435\u043d\u044c \u0436\u0438\u0440\u043d\u044b\u0435 \u0438 \u0441\u043f\u0430\u0432\u043d\u044f\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u0443\u044e \u043c\u0438\u043d\u0443\u0442\u0443, \u0447\u0442\u043e \u0432\u044b\u0433\u043d\u0430\u043b\u043e \u041f\u041a\u0448\u0435\u0440\u043e\u0432. \u0414\u043e\u0448\u0435\u043b \u0434\u043e \u0431\u0430\u0440\u0430 = \u0432\u044b\u043d\u0435\u0441. \u042d\u0442\u0438 \u0441\u0430\u043c\u044b\u0435 \u043d\u0435\u043f\u0438\u0441\u0438 \u0435\u0449\u0435 \u0438 \u0441\u043c\u0435\u0441\u0442\u0438\u043b\u0438 \u041f\u041a\u0448\u0435\u0440\u043e\u0432 \u0438\u0437 \u043b\u0435\u0441\u0430 \u0438 \u044f\u043c\u044b - \u043d\u0435 \u0432\u044b\u0433\u043e\u0434\u043d\u043e + \u0434\u043e\u043b\u0433\u043e \u0431\u0435\u0436\u0430\u0442\u044c. \u042d\u0442\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u0442\u043e\u0436\u0435 \u043e\u0447\u0435\u043d\u044c \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u044b\u0435 \u043b\u043e\u043a\u0438.\u003C\/p\u003E\n\n\u003Cp\u003E\u0418\u0437 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u043e\u0433\u043e - \u0432\u0441\u044f \u043d\u0435\u0447\u0438\u0441\u0442\u044c \u0442\u0443\u0441\u0443\u0435\u0442\u0441\u044f \u0447\u0443\u0442\u044c \u0441\u0435\u0432\u0435\u0440\u043d\u0435\u0435, \u043f\u0440\u0438 \u0447\u0435\u043c \u043a\u0430\u043a - \u0442\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043c\u043d\u043e\u0433\u043e \u043d\u0435\u0447\u0438\u0441\u0442\u0438 \u044f \u0432\u0438\u0434\u0435\u043b \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u041c\u0413. \u0412\u0438\u0434\u0435\u043b \u043f\u0430\u0447\u043a\u0443 \u0438\u0437 \u041f\u042f\u0422\u0418 \u0434\u043e\u0445\u043e\u0434\u044f\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0440\u0430\u0437\u043e\u0431\u0440\u0430\u043b\u043e 2 \u0440\u0430\u043d\u0434\u043e\u043c\u0430, \u0432\u0438\u0434\u0435\u043b \u043f\u0430\u0447\u043a\u0443 \u0438\u0437 \u0434\u0432\u0443\u0445 \u0442\u0438\u043f\u043e\u0432, \u0447\u0442\u043e \u0443\u0431\u0438\u0432\u0430\u043b\u0438 \u043f\u0430\u0440\u0443 \u0442\u0438\u043f\u043e\u0432 \u0438 \u0444\u0438\u0434\u0438\u043b\u0438. \u0412\u0438\u0434\u0435\u043b \u0445\u0435\u0440 \u0437\u043d\u0430\u0435\u0442 \u0447\u0442\u043e \u0437\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e, \u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043d\u0430 \u0430\u043a\u043a\u0435 10 \u0447\u0430\u0441\u043e\u0432 \u0438 \u0440\u0430\u0437\u0432\u0435\u0434\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0437\u0430\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u043b\u043e\u043a\u0443, \u0432\u044b\u0431\u0440\u0438\u0432\u0430\u0435\u0442 \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0432\u0441\u0451 \u0436\u0438\u0432\u043e\u0435 \u0447\u0442\u043e \u0435\u0441\u0442\u044c, \u043d\u0435 \u0432\u0430\u0436\u043d\u043e \u0442\u044b \u0432 \u043a\u0443\u0441\u0442\u0430\u0445\/\u0434\u043e\u043c\u0435\/\u043d\u0430 \u043a\u0440\u044b\u0448\u0435, \u043e\u043d \u043f\u0440\u0438\u0434\u0435\u0442 \u0438 \u0434\u0430\u0441\u0442 5 \u0433\u043e\u043b\u043e\u0432 (\u0432\u043f\u0435\u0440\u0432\u044b\u0435 \u0437\u0430 1,5\u043a \u0447\u0430\u0441\u043e\u0432 \u043a\u0441\u0442\u0430 \u0442\u0430\u043a\u043e\u0435). \u0412\u0438\u0434\u0435\u043b \u0442\u043e\u043f\u043e\u0432\u044b\u0439 \u0440\u0430\u0441\u043f\u0440\u0435\u0434, \u043a\u043e\u0433\u0434\u0430 \u0432\u043e\u0435\u0432\u0430\u043b \u043f\u0440\u043e\u0442\u0438\u0432 T23 +5 \u043c\u0430\u0441\u0442\u0430, \u0438\u043c\u0435\u044f \u043b\u0430\u0437\u0443\u0442\u043a\u0443, \u041e\u0426-14 \u0441 \u0433\u0440\u0430\u043d\u0438\u043a\u043e\u043c \u0438 \u0440\u044e\u043a\u0437\u0430\u043a \u0441 4 \u0431\u0435\u043b\u044b\u043c\u0438 \u043d\u0435 \u0442\u043e\u0447\u0435\u043d\u044b\u043c\u0438 \u043a\u0430\u043b\u043e\u0432\u044b\u043c\u0438 \u0430\u0440\u0442\u0430\u043c\u0438.\u003Cbr\u003E\n\u0418\u043d\u0442\u0435\u0440\u0435\u0441\u043d\u043e \u043a\u0441\u0442\u0430\u0442\u0438, \u0447\u0442\u043e \u0431\u0443\u0434\u0435\u0442, \u0435\u0441\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u044f\u0442 \u0440\u0430\u0441\u043f\u0440\u0435\u0434 \u043f\u043e \u043f\u0430\u0447\u043a\u0430\u043c \u043d\u0430 \u044e\u0433. \u041b\u043e\u043a\u0438 \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0431\u044b \u0438\u043c\u0435\u044e\u0442 1, \u043c\u0430\u043a\u0441\u044b 2 \u043a\u043e\u043f\u0438\u0438, \u0438\u0431\u043e \u044f \u043f\u043e\u043f\u0430\u0434\u0430\u043b \u043f\u043e\u0434 \u0433\u0435\u043d\u043e\u0446\u0438\u0434 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043f\u043e \u041a\u0414.\u003C\/p\u003E\n\n\u003Cp\u003E\u0418 \u0442\u0430\u043a\u043e\u0439 \u0435\u0449\u0435 \u0432\u043e\u043f\u0440\u043e\u0441: \u0430 \u0441\u0438\u0433\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u0436\u0438 \u044e\u0433\u0430 \u0442\u043e\u0447\u043d\u043e \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u043b\u0438\u0441\u044c? \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u044f \u043e\u0442\u0440\u0443\u0431\u0430\u044e \u043c\u043e\u0437\u0433 \u0438 \u0438\u0437\u0438 \u0447\u0438\u0449\u0443 \u0432\u0441\u0435 \u0434\u0430\u043d\u0436\u0438 \u0432 \u043a\u043e\u043d\u0447\u0435\u043d\u043e\u043c \u0441\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c\u044e. \u041d\u0430 \u0442\u0432\u0438\u043d\u043a\u0435 \u044f \u0447\u0430\u0441\u0442\u043e \u0444\u0438\u0434\u0438\u043b \u0432 \u0437\u0435\u043b\u0435\u043d\u044b\u0445 \u0434\u0430\u043d\u0436\u0430\u0445 \u044f\u043c\u044b. \u041d\u0430\u043f\u043e\u043c\u043d\u044e, \u043b\u0430\u0437\u0443\u0442\u043a\u0430 + \u041e\u0426-14\u041c \u0441 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u043c \u043d\u0430 75 \u043f\u0442. \u0412\u043f\u043e\u043b\u043d\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0447\u0442\u043e \u044d\u0442\u043e \u0441\u043a\u0435\u043b \u043a\u0435\u0448\u044c\u044e, \u043d\u043e \u0432 \u041c\u0413 \u0432\u0441\u0435 \u0441\u0438\u043d\u0438\u0435 \u0434\u0430\u043d\u0436\u0438, \u0447\u0442\u043e \u043c\u043d\u0435 \u0432\u044b\u043f\u0430\u043b\u0438, \u044f \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u0437\u0430\u043a\u0440\u044b\u043b \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0432 \u043c\u043e\u0437\u0433.\u003C\/p\u003E","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":3,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":1,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":1,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196651"}},"user":{"data":{"type":"users","id":"1678292"}},"mentionedBy":{"data":[{"type":"posts","id":"4714511"},{"type":"posts","id":"4714665"},{"type":"posts","id":"4715828"}]},"likes":{"data":[{"type