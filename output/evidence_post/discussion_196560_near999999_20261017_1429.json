":"comment","contentHtml":"\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196560-rsh-vtorichka\/50\u0022 class=\u0022PostMention\u0022 data-id=\u00224712617\u0022\u003E\u0410\u043d\u0434\u0435\u0440\u0440\u0433\u0440\u0430\u0443\u043d\u0434\u003C\/a\u003E \u0414\u043e\u043b\u0431\u043e\u0435\u0431\u0438\u043a\u0438 - \u044e\u0437\u0435\u0440\u044b \u0420\u0428 \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0433\u0430\u043d, \u043d\u043e \u043f\u043e \u0444\u0430\u043a\u0442\u0443 \u044d\u0442\u043e \u0435\u0431\u0430\u043d\u0430\u044f \u0445\u0443\u0435\u0442\u0430 \u0432 \u0441\u043b\u043e\u0442\u0435 \u0432\u0442\u043e\u0440\u0438\u0447\u043a\u0438 \u0441\u043d\u043e\u0441\u0438\u0442 \u0441 \u0442\u044b\u0447\u043a\u0438 \u043f\u043e\u043b \u0435\u0431\u0430\u043b\u0430\u003Cbr\u003E\n\u0414\u043e\u043b\u0436\u043d\u043e \u0442\u0430\u043a \u0431\u044b\u0442\u044c? \u043d\u0435\u0442.\u003Cbr\u003E\n\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196560-rsh-vtorichka\/50\u0022 class=\u0022PostMention\u0022 data-id=\u00224712617\u0022\u003E\u0410\u043d\u0434\u0435\u0440\u0440\u0433\u0440\u0430\u0443\u043d\u0434\u003C\/a\u003E \u042d\u0442\u043e \u0432\u0442\u043e\u0440\u0438\u0447\u043a\u0430 \u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c, \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c \u0442\u0442\u043a \u043c\u0435\u0439\u043d\u0433\u0430\u043d\u0430, \u0438 \u0443\u0436 \u0442\u0435\u043c \u0431\u043e\u043b\u0435\u0435 \u0431\u044b\u0442\u044c \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u0443\u043b\u044c\u0442\u0438\u043c\u044b ( \u0434\u0432\u0443\u0448\u043e\u0442 ) . \u003Cbr\u003E\n\u041c\u043d\u0435 \u043f\u043e\u0445\u0443\u0439 \u043d\u0430 \u0432\u0430\u0448\u0435 \u043c\u043d\u0435\u043d\u0438\u0435, \u044f \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u044e\u0441\u044c \u043b\u0438\u0447\u043d\u043e \u043c\u043d\u0435\u043d\u0438\u044f \u043d\u0435\u0439\u0442\u0440\u0430\u043b\u0438\u0442\u0435\u0442\u0430 ( \u0440\u0443\u043f\u043e\u0440\u044b ).\u003Cbr\u003E\n\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196560-rsh-vtorichka\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224711471\u0022\u003E\u0410\u043d\u0434\u0435\u0440\u0440\u0433\u0440\u0430\u0443\u043d\u0434\u003C\/a\u003E \u042d\u0442\u0430 \u0432\u0442\u043e\u0440\u0438\u0447\u043a\u0430\u003Cbr\u003E\n\u041e\u043d\u0430 \u0434\u043e\u0431\u0438\u0432\u0430\u0435\u0442\u003Cbr\u003E\n\u041e\u043d\u0430 \u043d\u0435 \u0443\u0431\u0438\u0432\u0430\u0435\u0442\u003Cbr\u003E\n\u0420\u0430\u0437\u0440\u0430\u0431\u044b?\u003C\/p\u003E\u003C\/div\u003E\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u0415\u0441\u043b\u0438 \u0447\u0435\u0441\u0442\u043d\u043e, \u044f \u0434\u0430\u0436\u0435 \u043d\u0435 \u0437\u043d\u0430\u044e, \u0447\u0442\u043e \u0442\u0443\u0442 \u0441\u043a\u0430\u0437\u0430\u0442\u044c - \u0447\u0442\u043e \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c\/\u0447\u0435\u0433\u043e \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0432 \u0431\u0430\u043b\u0430\u043d\u0441\u0435 \u044d\u0442\u043e \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u0430\u044f \u0434\u0438\u043b\u0435\u043c\u043c\u0430 \u003Cem\u003E(\u043d\u0443 \u0438 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u0447\u0442\u043e \u0440\u0435\u0448\u0430\u0435\u0442\u0441\u044f \u043e\u043d\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043e\u0442\u0434\u0435\u043b\u043e\u043c \u0431\u0430\u043b\u0430\u043d\u0441\u0430)\u003C\/em\u003E. \u0412\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435, \u043d\u0430\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u043d\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e, \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0442\u0441\u044f \u043d\u0435 \u0442\u0430\u043a, \u043a\u0430\u043a \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0435 \u0438 \u0442\u0430\u043c \u0441\u0432\u043e\u0438 \u043d\u044e\u0430\u043d\u0441\u044b.\u003C\/p\u003E\n\n\u003Cp\u003E\u0412 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0438 \u0442\u043e, \u0447\u0442\u043e \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0442\u0441\u044f \u043e\u0440\u0443\u0436\u0438\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0441\u0443\u0445\u043e\u043c\u0443 \u0422\u0422\u041a, \u0430 \u0432 \u0441\u043e\u0432\u043e\u043a\u0443\u043f\u043d\u043e\u0441\u0442\u0438 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0438\u0433\u0440\u0430\u0435\u0442\u0441\u044f \u043e\u0440\u0443\u0436\u0438\u0435. \u0415\u0441\u043b\u0438 \u043d\u0435 \u043e\u0448\u0438\u0431\u0430\u044e\u0441\u044c, \u0432 \u0432\u043e\u043f\u0440\u043e\u0441\u043d\u0438\u043a\u0435 \u043f\u043e \u0431\u0430\u043b\u0430\u043d\u0441\u0443 \u043d\u0435\u0442 \u043a\u0430\u043a\u043e\u0433\u043e-\u043b\u0438\u0431\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u0430 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e \u043f\u043e \u0420\u0428.\u003C\/p\u003E\n\n\u003Cp\u003E\u041a\u0430\u0436\u0435\u0442\u0441\u044f, \u043a\u0430\u043a-\u0442\u043e \u0434\u0430\u0432\u043d\u043e \u0435\u0449\u0451 \u043f\u0435\u0440\u0435\u043c\u044b\u0432\u0430\u043b\u0438 \u043a\u043e\u0441\u0442\u0438 \u043f\u043e \u0433\u0430\u0443\u0441\u0441-\u043f\u0438\u0441\u0442\u043e\u043b\u0435\u0442\u0443, \u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/176000-sapport-gany-i-toksichnye-vanshoty\/72\u0022 rel=\u0022ugc nofollow\u0022\u003E\u0443 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u043f\u0440\u044f\u043c\u043e \u0441\u0438\u043b\u044c\u043d\u043e \u0441\u0445\u043e\u0436\u0438\u