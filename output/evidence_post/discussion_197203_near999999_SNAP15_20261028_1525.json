044c  \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043c\u0435\u0442\u043a\u0443 \u043d\u0430 \u0441\u0430\u043c \u0431\u0443\u043d\u043a\u0435\u0440, \u043f\u0440\u0438\u0434\u044f \u043d\u0430 \u043c\u0435\u0442\u043a\u0443 \u0442\u0430\u043c \u0431\u0443\u0434\u0435\u0442 \u0434\u0432\u0435\u0440\u044c \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f 3 \u043c\u0438\u043d\u0443\u0442\u044b \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0438 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u044d\u0442\u043e \u0441\u043e\u0431\u044b\u0442\u0438\u0435 \u0431\u0443\u0434\u0435\u0442 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0435 \u0434\u043b\u044f \u0432\u0441\u0435\u0445. \u041f\u043e\u0441\u043b\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0434\u0432\u0435\u0440\u0438 \u0432\u044b \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442\u0435 \u0432 \u0411\u0443\u043d\u043a\u0435\u0440 \u0438 \u043b\u0443\u0442\u0430\u0435\u0442\u0435 \u0435\u0433\u043e, \u043f\u043e\u043f\u0443\u0442\u043d\u043e \u0443\u0431\u0438\u0432\u0430\u044f \u0431\u043e\u0442\u043e\u0432 \u0438 \u0440\u0435\u0448\u0430\u0435\u0442\u0435 1-2 \u043b\u0451\u0433\u043a\u0438\u0445 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438 (\u043a\u0430\u043a \u043f\u0440\u0438\u043c\u0435\u0440 \u0442\u0430, \u0447\u0442\u043e \u0431\u044b\u043b\u0430 \u043d\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u0448\u0442\u043e\u0440\u043c\u0435). \u0412 \u043a\u043e\u043d\u0446\u0435 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0447\u0442\u043e-\u0442\u043e \u0442\u0438\u043f\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0443\u0436\u043d\u043e \u043a\u0430\u043a\u0438\u043c \u043b\u0438\u0431\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044c (\u043d\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u0430\u043b). \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u043c \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u043d\u0430\u0433\u0440\u0430\u0434\u0443 (\u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e 4-5\u043a\u043a \u0437\u0430 \u043f\u043e\u043b\u043d\u043e\u0435 \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438) \u0438 \u043f\u043e\u043a\u0438\u0434\u0430\u0435\u043c \u0411\u0443\u043d\u043a\u0435\u0440 \u0447\u0435\u0440\u0435\u0437 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0432\u044b\u0445\u043e\u0434, \u043b\u0438\u0431\u043e \u0447\u0435\u0440\u0435\u0437 \u0432\u0442\u043e\u0440\u043e\u0439 (\u043a\u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f, \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0446\u0438\u044f, \u0438\u043b\u0438 \u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u0437\u0430\u043f\u0430\u0441\u043d\u043e\u0439 \u0432\u044b\u0445\u043e\u0434)\u003Cbr\u003E\n\u0416\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c 2 \u0431\u0443\u043d\u043a\u0435\u0440\u0430 \u0434\u043b\u044f \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044f \u0438 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0438\u0445 \u043d\u0430 \u044f\u043d\u043e\u0432, \u0440\u044b\u0436\u0438\u043a \u0438 1 \u0431\u0443\u043d\u043a\u0435\u0440 \u043d\u0430 \u0437\u0430\u0442\u043e\u043d.\u003Cbr\u003E\n\u0412 \u0438\u0442\u043e\u0433\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c \u0441\u043e\u0431\u044b\u0442\u0438\u0435 \u043d\u0430 15-20 \u043c\u0438\u043d\u0443\u0442, \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0431\u0443\u0434\u0435\u0442 \u