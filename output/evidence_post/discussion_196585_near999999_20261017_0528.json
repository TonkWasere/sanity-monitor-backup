43d\u0430\u044f \u043c\u044b\u0441\u043b\u044c. \u0416\u0434\u0443, \u043a\u043e\u0433\u0434\u0430 \u0443\u0436\u0435 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u0440\u0430\u0437\u0431\u0430\u043d\u044b ( \u043a\u0430\u043a \u0432 \u0441\u0442\u0430\u0440\u044b\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0430) ) \u0438 \u0438\u0433\u0440\u0430 \u0438\u0437 \u0438\u0433\u0440\u044b \u0443\u0436\u0435 \u043e\u043a\u043e\u043d\u0447\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u0441\u044f \u0432 \u043a\u0430\u0437\u0438\u043d\u043e, \u0438 \u0431\u0435\u0437 \u0437\u0430\u043a\u0438\u0434\u043a\u0438 20\u043a \u0441\u0442\u0430\u043b\u043a\u043e\u0435\u043d\u043e\u0432 \u0432 \u043d\u0435\u0451 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0443\u0442 \u043f\u0443\u0441\u043a\u0430\u0442\u044c. \u0412\u044b \u0441\u043c\u0435\u0451\u0442\u0435\u0441\u044c, \u0430 \u0433\u0434\u0435 \u0438\u0437 \u043c\u0443\u043b\u044c\u0442\u0438\u0432\u0441\u0435\u043b\u0435\u043d\u043d\u044b\u0445 \u044d\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e. \u0410\u0445\u0445\u0445, \u0434\u0430, \u0437\u0430\u0431\u044b\u043b: \u0412\u0430\u0441\u044f \u0438\u0437 \u00ab\u0421\u0432\u043e\u0431\u043e\u0434\u044b\u00bb \u043d\u0435 \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u043a\u043e\u043d\u0446\u0435\u043f\u0446\u0438\u044f \u043c\u0443\u043b\u044c\u0442\u0438\u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u041e\u043d \u043a\u0440\u043e\u043c\u0435 \u0410\u0424\u041a \u00ab\u0421\u0432\u043e\u0431\u043e\u0434\u044b\u00bb \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0437\u043d\u0430\u0435\u0442. \u041e\u043d \u043a\u0430\u043a \u0440\u044b\u0431\u043a\u0430 \u0438\u0437 \u0430\u043c\u0435\u0440\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043f\u043