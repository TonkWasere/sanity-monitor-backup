30\u043c\u0438, \u043d\u0435 \u0431\u0435\u0437 \u043c\u0438\u043d\u0443\u0441\u043e\u0432 \u043a\u043e\u043d\u0435\u0447\u043d\u043e. \u041f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u043e\u043d\u043b\u0430\u0439\u043d \u043d\u0435 \u0431\u0443\u0434\u0443, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0432\u0435\u0437\u0434\u0435 \u043e\u0431\u0441\u0438\u0440\u0430\u044e\u0442 \u0438\u0433\u0440\u0443 \u0442\u0435\u043c, \u0447\u0442\u043e \u0442\u0430\u043c \u043a\u0443\u0447\u0430 \u0447\u0438\u0442\u0435\u0440\u043e\u0432. \u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u0432 \u043e\u043d\u043b\u0430\u0439\u043d\u0435 \u044f\u0441\u0435\u043d \u0445\u0443\u0439 \u0431\u0443\u0434\u0435\u0442 \u043a\u0440\u0430\u0442\u043d\u043e \u0445\u0443\u0436\u0435, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0442\u0430\u043c \u0431\u0443\u0434\u0443\u0442 \u043c\u043e\u0434\u0435\u043b\u044c\u043a\u0438 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0438 \u0441\u0442\u0440\u0435\u043b\u044c\u0431\u0430 \u0441 \u0438\u0433\u0440\u043e\u043a\u0430\u043c\u0438. \u003Cbr\u003E\n\u0422\u043e\u0442 \u043a\u043e\u043c\u043c\u0435\u043d\u0442 \u043a \u0442\u043e\u043c\u0443, \u0447\u0442\u043e \u0447\u0435\u043b\u044b \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0431\u0441\u0438\u0440\u0430\u044e\u0442 \u0438\u0433\u0440\u0443, \u0442\u0443\u043f\u043e \u043d\u0435 \u0438\u0433\u0440\u0430\u044e\u0442 \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0433\u0440\u044b (\u043d\u0435 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0435) \u0438 \u043d\u0435 \u0432\u0438\u0434\u044f\u0442, \u0447\u0442\u043e \u043f\u043e\u0434\u043e\u0431\u043d\u0430\u044f \u0445\u0443\u0439\u043d\u044f \u0432\u043e\u043e\u0431\u0449\u0435 \u0432\u0435\u0437\u0434\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0433\u0434\u0435 \u043d\u0435\u0442 \u043f\u0438\u0441\u044c\u043a\u043e\u043c\u0435\u0440\u0441\u0442\u0432\u0430 \