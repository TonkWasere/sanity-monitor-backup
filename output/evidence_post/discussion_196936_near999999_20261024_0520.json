044c\u043d\u044b\u0439 \u043a\u0430\u043f \u043d\u0430 \u043a\u043e\u043b-\u0432\u043e \u201c\u0432\u044b\u0433\u043e\u0434\u043d\u044b\u0445\u201d \u043f\u0440\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0439 \u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u043e \u0440\u0435\u0448\u0438\u0442 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0442\u0432\u0438\u043d\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0430 - \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0444\u0430\u0440\u043c\u0438\u0442\u044c \u0440\u0435\u0441\u0443\u0440\u0441\u044b \u043d\u0430 \u043e\u0434\u043d\u043e\u043c \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u0435\u043b\u044c \u0432\u043f\u0435\u0440\u0451\u0434, \u043f\u043e\u0442\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0445\u043e\u0434\u0438 \u0434\u0430 \u0442\u0440\u0430\u0442\u044c.\u003Cbr\u003E\n\u041f\u0440\u0438 \u044d\u0442\u043e\u043c \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0443\u0439\u0442\u0438 \u0438 \u043e\u0442 \u0440\u0443\u0431\u043b\u0435\u0439 \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b, \u0434\u043e\u0431\u0430\u0432\u0438\u0432 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u044c \u0442\u0443 \u0436\u0435 \u0437\u0430\u0442\u043e\u0447\u043a\u0443 \u0437\u0430 \u043e\u0431\u0440\u0430\u0437\u0446\u044b \u0432 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0435\u043c\u043e\u043c \u0432\u0438\u0434\u0435 - \u0442\u0430\u043a \u0446\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u0431\u0443\u0434\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c\u0441\u044f \u0443\u0436\u0435 \u0440\u044b\u043d\u043a\u043e\u043c \u0432\u043d\u0443\u0442\u0440\u0438 \u0441\u0430\u043c\u043e\u0439 \u0438\u0433\u0440\u044b, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0438\u0437\u0431\u0435\u0433\u0430\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0442\u043e\u0439 \u0436\u0435 \u0434\u0435\u043d\u0435\u0436\u043d\u043e\u0439 \u0432\u0430\u043b\u044e\u0442\u044b \u201c\u0438\u0437 \u0432\u043e\u0437\u0434\u0443\u0445\u0430\u201d \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u044f \u0432\u0441\u0451 \u043a \u0430\u0443\u043a\u0446\u0438\u043e\u043d\u0443\/\u043e\u0431\u043c\u0435\u043d\u0430\u043c.\u003Cbr\u003E\n\u041d\u0443 \u0438\u043b\u0438 \u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043f\u0440\u044f\u043c\u043e\u0439 \u043e\u0431\u043c\u0435\u043d \u0432\u0430\u043b\u044e\u0442\u044b \u043d\u0430 \u043a\u0443\u043f\u044e\u0440\u044b \u0432 2 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430 - \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0439 \u043f\u043e \u043d\u0435\u0434\u0435\u043b\u044f\u043c \u043d\u043e \u0432\u044b\u0433\u043e\u0434\u043d\u044b\u0439 \u0438 \u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u0439 \u043d\u043e \u0434\u0435\u0448\u0451\u0432\u044b\u0439.\u003C\/p\u003E\n\n\u003Cp\u003E\u0422\u0430\u043a\u0436\u0435 \u0432\u043c\u0435\u0441\u0442\u043e \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0435\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u043e\u0439 \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0437\u0430 \u044d\u0442\u0443 \u0432\u0430\u043b\u044e\u0442\u0443 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u041a\u0435\u0439\u0441\u044b \u041e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u0441 \u044f\u0434\u0440\u0430\u043c\u0438, \u0432\u043a\u043b\u044e\u0447\u0438\u0432 \u0432 \u043d\u0438\u0445 \u0448\u0430\u043d