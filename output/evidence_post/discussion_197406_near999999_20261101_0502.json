0438\u0441\u0442\u0430\u043c\u0438, \u0432\u0441\u0451 \u0442\u0430\u043a\u0436\u0435 \u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0441\u044f \u043d\u0435\u0439\u0440\u043e\u043a\u043e\u0434 \u0433\u043e\u0432\u043d\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0435\u0449\u0435 \u0438 \u0443\u043c\u0440\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0441\u044f\u0446\u0435\u0432 \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e\u0434 \u0433\u0440\u0443\u0437\u043e\u043c \u043d\u0430\u043a\u043e\u043f\u0438\u0432\u0448\u0438\u0445\u0441\u044f \u0438\u0448\u044c\u044e\u0441.\u003Cbr\u003E\n\u0414\u0430, \u0435\u0441\u0442\u044c \u043c\u043e\u0434\u044b \u0438 \u0430\u0434\u0434\u043e\u043d\u044b, \u0432 \u0442\u0447 \u043d\u0430 \u0440\u0430\u0437\u043d\u044b\u0435 \u0438\u0433\u0440\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0434\u0435\u043b\u0430\u043d\u044b \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0442\u0430\u043a, \u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0445\u043e\u0440\u043e\u0448\u043e (\u0437\u043d\u0430\u044e \u0442\u0430\u043a\u043e\u0432\u044b\u0435 \u043d\u0430 \u0430\u043d\u043e\u043c\u0430\u043b\u0438 \u0438 \u0444\u0430\u043b\u043b\u0430\u0443\u0442), \u043d\u043e \u0442\u0430\u043c \u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u044d\u0442\u043e \u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0432 \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u044b\u0445 \u0440\u0443\u043a\u0430\u0445 \u043c\u043e\u0434\u043c\u0435\u0439\u043a\u0435\u0440\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043e\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442 \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u044e\u0442, \u0430 \u043d\u0435 \u043a\u043e\u043f\u0438\u043f\u0430\u0441\u0442\u044f\u0442 