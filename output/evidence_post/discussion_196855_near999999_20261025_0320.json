3c\u0430\u0435\u0442\u0441\u044f \u043e\u043d \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0428\u0412, \u0435\u0441\u043b\u0438 \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u044f\u043b\u0438 \u0432 \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0445 \u043f\u0430\u0442\u0447\u0430\u0445\u2026 \u041e\u0434\u043d\u043e \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u0441\u043e\u043c\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0432\u044b\u0431\u043e\u0440\u043e\u043c \u0432 \u043f\u0432\u0435.\u003C\/p\u003E \n\n\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/u\/Crios\u0022 rel=\u0022ugc nofollow\u0022\u003E@Crios\u003C\/a\u003E \u043c\u043e\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u044c \u043f\u0440\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043b\u043e\u043c\u0430\u043d\u0438\u044f \u0432\u0441\u0441 (\u0438 \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435 \u0432\u0441\u043a)? \u0422\u0430\u043c \u0432\u0440\u043e\u0434\u0435 \u0447\u0442\u043e-\u0442\u043e \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u043e\u0435 \u0441 \u0440\u0435\u043c\u043e\u043d\u0442\u043e\u043c \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0441\u0442\u044b \u0442\u0440\u043e\u0433\u0430\u0442\u044c \u0441\u043e\u0431\u0438\u0440\u0430\u044e\u0442\u0441\u044f? \u041f\u0443\u0441\u0442\u044c \u043f\u0440\u043e \u043d\u0438\u0445 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0442. \u0410 \u0442\u043e \u0443\u0436\u0435 \u043f\u043e \u0441\u0442\u0430\u0442\u0430\u043c \u043e\u0442 \u0428\u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u044f \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0435, \u0430 \u043b\u043e\u043c\u0430\u044e\u0442\u0441\u044f \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u0431\u044b\u0441\u0442\u0440\u0435\u0435. \u0416\u0430\u0431\u0430 \u0434\u0443\u0448\u0438\u0442 \u0438\u0441\u04