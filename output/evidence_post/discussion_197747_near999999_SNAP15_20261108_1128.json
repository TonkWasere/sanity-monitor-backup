,"ignored":false,"canBeIgnored":true,"bestAnswerCount":1,"canSpamblock":false,"canViewWarnings":false,"canManageWarnings":false,"canDeleteWarnings":false,"visibleWarningCount":0},"relationships":{"groups":{"data":[{"type":"groups","id":"8"}]}}},{"type":"posts","id":"4751561","attributes":{"number":1,"createdAt":"2026-11-08T10:17:26+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u0412 StalZone \u0435\u0441\u0442\u044c \u0442\u0430\u043a\u0430\u044f \u043b\u043e\u043a\u0430\u0446\u0438\u044f, \u043a\u0430\u043a \u041b\u0438\u043c\u0430\u043d\u0441\u043a. \u041f\u043e \u043d\u0435\u0439 \u043f\u0440\u0438\u044f\u0442\u043d\u043e \u0431\u0435\u0433\u0430\u0442\u044c: \u0437\u0434\u0435\u0441\u044c \u0440\u0435\u0434\u043a\u043e \u043f\u043e\u043f\u0430\u0434\u0430\u044e\u0442\u0441\u044f \u043f\u0430\u0447\u043a\u0438 \u0438\u0437 \u043f\u044f\u0442\u0438 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u043e\u0432, \u0438 \u044d\u0442\u043e \u043c\u0435\u0441\u0442\u043e, \u0433\u0434\u0435 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0431\u0435\u0433\u0430\u0442\u044c \u0432 \u0441\u043e\u043b\u043e \u0438 \u0434\u0430\u0436\u0435 \u0447\u0442\u043e\u2011\u043d\u0438\u0431\u0443\u0434\u044c \u0432\u044b\u043d\u0435\u0441\u0442\u0438. \u041d\u043e \u0441 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u044d\u0442\u043e \u043d\u0435 \u0441\u0430\u043c\u0430\u044f \u043f\u0440\u0438\u0431\u044b\u043b\u044c\u043d\u0430\u044f \u043b\u043e\u043a\u0430\u0446\u0438\u044f.\u003Cbr\u003E\n\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043e\u043a \u0432 \u041b\u0438\u043c\u0435\u00a0-\u00a0\u044d\u0442\u043e \u0443\u0434\u0430\u0447\u0430 \u043d\u0430 \u0432\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u0440\u0435\u0434\u043a\u0438\u0445 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432: \u0442\u0451\u043c\u043d\u044b\u0439 \u043b\u0438\u043c, \u043c\u043e\u0434. \u0431\u0430\u0442\u0430\u0440\u0435\u044f, \u043a\u043e\u043d\u0446. \u043b\u0438\u043c\u0431\u043e\u043f\u043b\u0430\u0437\u043c\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435. \u041a\u043e\u043d\u0435\u0447\u043d\u043e, \u0441 \u043d\u0435\u0434\u0430\u0432\u043d\u0435\u0433\u043e \u043f\u0430\u0442\u0447\u0430, \u043a\u043e\u0433\u0434\u0430 \u0443\u0431\u0440\u0430\u043b\u0438 \u0440\u0430\u0437\u0431\u0440\u043e\u0441 \u0432\u044b\u043f\u0430\u0434\u0430\u0435\u043c\u043e\u0433\u043e \u043b\u0443\u0442\u0430 \u0432 \u0441\u043f\u043e\u0442\u0430\u0445 \u043f\u043e \u0444\u0438\u043b\u043b\u0435\u0440\u0430\u043c, \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0441\u0442\u0430\u043b\u0430 \u0447\u0443\u0442\u044c \u043b\u0443\u0447\u0448\u0435, \u043d\u043e \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c, \u0447\u0442\u043e, \u0432\u043e\u2011\u043f\u0435\u0440\u0432\u044b\u0445, \u043d\u0430\u0434\u043e \u0433\u0434\u0435\u2011\u0442\u043e \u043d\u0430\u0439\u0442\u0438 \u043a\u0441\u0438\u0432\u0443, \u0430 \u0432\u043e\u2011\u0432\u0442\u043e\u0440\u044b\u0445\u00a0-\u00a0\u043d\u0430\u043b\u0443\u0442\u0430\u0442\u044c \u0434\u0435\u043d\u0435\u0433, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0441\u043e \u0441\u043f\u043e\u0442\u043e\u0432 \u043f\u0430\u0434\u0430\u0435\u0442 \u043d\u0435 \u0442\u0430\u043a \u043c\u043d\u043e\u0433\u043e.\u003Cbr\u003E\n\u0421\u0435\u0433\u043e\u0434\u043d\u044f, \u043f\u043e\u0441\u043b\u0435 \u043c\u0435\u0433\u0430\u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0433\u043e \u0432\u044b\u043d\u043e\u0441\u0430 \u043d\u0430 200\u00a0\u0442\u044b\u0441\u044f\u0447, \u044f \u043f\u043e\u0434\u0443\u043c\u0430\u043b, \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u041b\u0438\u043c\u0430\u043d\u0441\u043a \u043b\u0443\u0447\u0448\u0435 \u0441 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f, \u0438 \u0432\u0441\u043f\u043e\u043c\u043d\u0438\u043b \u043f\u0440\u043e \u0442\u0430\u043a\u0443\u044e \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443, \u043a\u0430\u043a \u0441\u0435\u0439\u0444\u044b \u0438 \u043a\u043b\u044e\u0447\u0438.\u003Cbr\u003E\n\u041c\u043e\u0451 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432\u044b\u043f\u0430\u0434\u0435\u043d\u0438\u0435 \u043a\u043b\u044e\u0447\u0435\u0439 \u0432 \u0441\u043f\u043e\u0442\u044b \u0441 \u041d\u041f\u0421, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u0430 \u043b\u043e\u043a\u0430\u0446\u0438\u0438 3\u20134\u00a0\u0441\u0435\u0439\u0444\u0430\u00a0-\u00a0\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438\u0439 \u0441\u0435\u0439\u0444 \u0432 \u0431\u043e\u043b\u044c\u043d\u0438\u0446\u0435: \u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-11-08\/1794132362-507421-20261108150325-1.jpg\u0022 title=\u002220261108150325-1.jpg\u0022 alt=\u0022\u0022 data-id=\u0022a47d4801-0522-4369-9eb8-0a809c252115\u0022 loading=\u0022lazy\u0022 width=\u00221304\u0022 height=\u0022738\u0022\u003E\u003Cbr\u003E\n\u0412\u043e\u0435\u043d\u043d\u044b\u0439 \u0441\u0435\u0439\u0444 \u0432 \u043f\u043e\u0436\u0430\u0440\u043d\u0443\u044e \u0447\u0430\u0441\u0442\u044c, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0441\u0435\u0439\u0444 \u043c\u043e\u043d\u043e\u043b\u0438\u0442\u0430 \u0432 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u044c: \u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-11-08\/1794132450-934729-20261108150342-1.jpg\u0022 title=\u002220261108150342-1.jpg\u0022 alt=\u0022\u0022 data-id=\u00229f7e71cb-fef8-43ba-9b00-b91b4aebc02c\u0022 loading=\u0022lazy\u0022 width=\u00221720\u0022 height=\u0022771\u0022\u003E\u003Cbr\u003E\n\u042f \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u0447\u0442\u043e \u0441\u0435\u0439\u0444 \u043c\u043e\u043d\u043e\u043b\u0438\u0442\u0430 - \u044d\u0442\u043e \u0443\u0436\u0435 \u0436\u0438\u0440\u043d\u043e \u0434\u043b\u044f \u0442\u0430\u043a\u043e\u0439 \u043b\u043e\u043a\u0430\u0446\u0438\u0438, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043c\u043e\u0436\u043d\u043e \u0441\u0440\u0435\u0437\u0430\u0442\u044c \u043d\u0430\u0433\u0440\u0430\u0434\u044b \u0432 1,5\u20132 \u0440\u0430\u0437\u0430, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u043c\u044b\u0441\u043b\u0430 \u0442\u0440\u0430\u0442\u0438\u0442\u044c \u043a\u043b\u044e\u0447 \u043d\u0430 \u041b\u0438\u043c\u0435, \u0430 \u043d\u0435 \u043d\u0430 \u0437\u0430\u0442\u043e\u043d\u0435 \u0438\u043b\u0438 \u044f\u043d\u043e\u0432\u0435. \u0422\u0430\u043a\u0436\u0435 \u0443 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0410\u0424\u041a \u043d\u0430 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u043c, \u043d\u043e \u0441 \u044d\u0442\u0438\u043c \u043f\u0440\u043e\u0449\u0435: \u043d\u0443\u0436\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0441\u043f\u0430\u0432\u043d \u043d\u0430 \u0412\u0435\u0442\u0435\u0440\u0430\u043d\u0441\u043a\u043e\u043c \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435. \u0427\u0435\u0441\u0442\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u044f, \u044f \u043d\u0435 \u0437\u043d\u0430\u044e, \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c, \u0447\u0442\u043e\u0431\u044b \u043a\u043b\u044e\u0447\u0438\u043a\u0438 \u043d\u0435 \u0430\u0431\u0443\u0437\u0438\u043b\u0438\u0441\u044c \u043d\u0430 \u0410\u0424\u041a \u041b\u0438\u043c\u0435 \u043d\u0430 \u043c\u0430\u0441\u0442\u0435\u0440-\u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u0435, \u043d\u043e \u043d\u0430\u0434\u0435\u044e\u0441\u044c, \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0438 \u0432\u0441\u0451 \u0436\u0435 \u0432\u043e\u043f\u043b\u043e\u0442\u044f\u0442 \u043c\u043e\u044e \u0437\u0430\u0442\u0435\u044e \u0432 \u0436\u0438\u0437\u043d\u044c, \u0442\u043e \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u043e\u0442\u0440\u044f\u0442 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u044d\u0442\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b.\u003Cbr\u003E\n\u0421\u043f\u0430\u0441\u0438\u0431\u043e, \u0447\u0442\u043e \u043f\u043e\u0442\u0440\u0430\u0442\u0438\u043b\u0438 \u0432\u0440\u0435\u043c\u044f \u043d\u0430 \u0449\u0438\u0442\u043f\u043e\u0441\u0442\u003Cimg class=\u0022FoFUpload--Upl-Image-Preview\u0022 src=\u0022https:\/\/forum-cdn.exbo.net\/\/2026-11-08\/1794132984-19187-16d6b76277a7088d7af5c2a8876f2027.jpg\u0022 title=\u002216d6b76277a7088d7af5c2a8876f2027.jpg\u0022 alt=\u0022\u0022 data-id=\u002216806c7b-5ff4-4fa7-bdea-e7777d74efcd\u0022 loading=\u0022lazy\u0022 width=\u0022736\u0022 height=\u0022978\u0022\u003E\u003C\/p\u003E\n\n\n","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":4,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,