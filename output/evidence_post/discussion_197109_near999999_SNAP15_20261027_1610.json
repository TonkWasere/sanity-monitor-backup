u043d\u0435\u043f\u043b\u043e\u0445\u0438\u043c \u0441 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044f, \u043d\u043e \u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u0440\u0430\u0432\u043e\u043a \u0431\u0430\u043b\u0430\u043d\u0441\u0430, \u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044f \u0432 \u0441\u0430\u043c\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0438, \u0441\u0430\u043c\u043e\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0435, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430.\u003C\/p\u003E\n\n\u003Col style=\u0022list-style-type:decimal\u0022\u003E\u003Cli\u003E\u003Cp\u003E\u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0443\u0447\u0451\u0442 \u043b\u0438\u0447\u043d\u043e\u0433\u043e \u0441\u0447\u0451\u0442\u0430 (\u0435\u0441\u043b\u0438 \u043e\u043d \u0435\u0441\u0442\u044c) \u0431\u043e\u043b\u0435\u0435 \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u043c.\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u041a\u043b\u0430\u0441\u0441 \u0431\u043e\u0435\u0432\u043e\u043a \u043d\u0443\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c: \u043e\u043d \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u0435\u0441\u043f\u043e\u043b\u0435\u0437\u0435\u043d. \u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0435\u043c\u0443 \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u041d\u0435 \u0441\u043d\u0438\u043c\u0430\u0439\u0442\u0435 \u0440\u0435\u0439\u0442\u0438\u043d\u0433 \u0437\u0430 \u043b\u0438\u0432\u0435\u0440\u043e\u0432 \u0432 \u043a\u043e\u043c\u0430\u043d\u0434\u0435.\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0416\u0435\u0442\u043e\u043d\u044b \u0434\u0432\u043e\u0439\u043d\u043e\u0439 \u0441\u0442\u0430\u0432\u043a\u0438 \u2014 \u043f\u043b\u043e\u0445\u0430\u044f \u0438\u0434\u0435\u044f \u0434\u043b\u044f \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430, \u0445\u043e\u0442\u044f \u0432 \u0446\u0435\u043b\u043e\u043c \u043f\u043e\u043d\u044f\u0442\u043d\u043e, \u043f\u043e\u0447\u0435\u043c\u0443 \u043e\u043d\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0442.\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u0443\u044e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0432 \u0432\u043e\u0439\u0441, \u0431\u0443\u0434\u0443\u0447\u0438 \u043c\u0451\u0440\u0442\u0432\u044b\u043c. \u0421\u0435\u0439\u0447\u0430\u0441 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u044f\u0437\u043a\u0443 \u043a\u043b\u0430\u0432\u0438\u0448 \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0438 \u0432\u043e\u0439\u0441\u0430 (\u043f\u043e\u0447\u0435\u043c\u0443-\u0442\u043e).\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044e\u044e \u043d\u0435\u0434\u0435\u043b\u044e \u0431\u044b\u043b\u043e \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u0442\u044c \u0440\u0435\u0439\u0442\u0438\u043d\u0433: \u0442\u043e \u043b\u0438 \u0432\u044b \u0447\u0442\u043e-\u0442\u043e \u043f\u043e\u043c\u0435\u043d\u044f\u043b\u0438 \u0432 \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u0445, \u0442\u043e \u043b\u0438 \u043b\u044e\u0434\u0438 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0438 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 \u0442\u043e\u043f\u0435 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0430, \u043d\u0435\u043f\u043e\u043d\u044f\u0442\u043d\u043e. \u0425\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0431\u044b \u0443\u0441\u043b\u044b\u0448\u0430\u0442\u044c \u043e\u0442 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u043e\u0432, \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u0430\u043a \u043f\u0440\u043e\u0438\u0437\u043e\u0448\u043b\u043e.\u003C\/p\u003E\u003C\/li\u003E\n\n\u003Cli\u003E\u003Cp\u003E\u0417\u0430\u043c\u0435\u0442\u0438\u043b, \u0447\u0442\u043e \u0432 \u0443\u0441\u0442\u0430\u0445 \u0441\u043f\u0430\u0432\u043d \u043a\u043e\u043c\u0430\u043d\u0434 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043d\u0435 \u043f\u043e \u043f\u043e\u0440\u044f\u0434\u043a\u0443 \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u043a\u043e\u043c\u0430\u043d\u0434, \u0445\u043e\u0442\u044f \u0431\u044b\u043b\u043e \u0431\u044b \u043b\u043e\u0433\u0438\u0447\u043d\u043e \u0441\u043f\u0430\u0432\u043d\u0438\u0442\u044c \u0441\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u0445 \u0441 \u0441\u0438\u043b\u044c\u043d\u0435\u0439\u0448\u0438\u043c\u0438.\u003C\/p\u003E\u003C\/li\u003E\u003C\/ol\u003E\n\n\u003Cp\u003E\u0415\u0441\u043b\u0438 \u0447\u0442\u043e-\u0442\u043e \u0443\u043f\u0443\u0441\u0442\u0438\u043b, \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0441\u0432\u043e\u0438 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0432 \u044d\u0442\u043e\u0439 \u0442\u0435\u043c\u0435.\u003Cbr\u003E\n\u003Cspan class=\u0022GroupMention GroupMention--colored\u0022 style=\u0022--color:#22b7f7;\u0022\u003E\u003Cspan class=\u0022GroupMention-name\u0022\u003E@\u041a\u043e\u043c\u0430\u043d\u0434\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u003C\/span\u003E\u003Ci class=\u0022icon fas fa-gem\u0022\u003E\u003C\/i\u00