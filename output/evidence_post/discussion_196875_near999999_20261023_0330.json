\u003C\/blockquote\u003E\n\n\u003Cp\u003E\u041f\u043e\u0433\u043e\u0434\u0438, \u0431\u0440\u0430\u0442, \u044d\u0442\u043e \u0434\u0430\u043b\u0435\u043a\u043e \u043d\u0435 \u0432\u0441\u0435 \u0447\u0443\u0434\u0435\u0441\u0430.\u003Cbr\u003E\n\u042f \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043c\u043d\u043e\u0433\u043e \u043a\u0430\u0442\u043e\u043a \u0441\u044b\u0433\u0440\u0430\u043b \u0443\u0436\u0435 \u0438 \u043c\u043e\u0433\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u043b\u0443\u0447\u0448\u0435 \u043f\u0443\u0441\u0442\u044c \u0432\u0441\u0435 \u0431\u0443\u0434\u0435\u0442 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e - \u0438\u0433\u0440\u043e\u043a\u0438 S \u0442\u0438\u0440\u0430 \u0432 \u0445\u0438\u0442\u0438\u043d\u0430\u0445 \u0441 \u043b\u0435\u0433 \u0441\u0431\u043e\u0440\u043a\u0430\u043c\u0438.\u003Cbr\u003E\n\u042f \u0432\u0438\u0434\u0435\u043b: \u0447\u0435\u043b\u044b, \u0441\u0442\u0440\u0435\u043b\u044f\u044e\u0449\u0438\u0435 \u0441 \u043c\u0433 \u043d\u0430 50+ \u043c\u0435\u0442\u0440\u043e\u0432 \u043e\u043d\u043b\u0438 \u0433\u043e\u043b\u043e\u0432\u0443; \u0447\u0435\u043b\u044b, \u0441\u0442\u0440\u0435\u043b\u044f\u044e\u0449\u0438\u0435 \u0441 \u043f\u0443\u043b\u044c\u0441\u0430 \u0442\u0430\u043a, \u0431\u0443\u0434\u0442\u043e \u044d\u0442\u043e \u0444\u0430\u043c\u0430\u0441 \u043f\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0440\u0435\u043b\u0443; \u0447\u0435\u043b\u044b \u0441 \u043d\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d\u043d\u044b\u043c \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435\u043c, \u0438\u0433\u0440\u0430\u044e\u0449\u0438\u0435 \u043d\u0430 \u0443\u0440\u043e\u0432\u0435\u043d\u044c S \u0442\u0438\u0440 (6+1); \u0447\u0435\u043b\u044b \u0441 \u0441\u0438\u043d\u0438\u043c\u0438 \u0438 \u0437\u0435\u043b\u0451\u043d\u044b\u043c\u0438 \u0441\u0431\u043e\u0440\u043a\u0430\u043c\u0438, \u0436\u0438\u0432\u0443\u0449\u0438\u0435 \u0431\u0443\u0434\u0442\u043e \u043e\u043d\u0438 \u0432 \u0441\u0432\u0435\u0440\u0445\u0442\u044f\u0436\u0435 \u0441 \u043b\u0435\u0433 \u0441\u0431\u043e\u0440\u043a\u043e\u0439; \u043d\u0443 \u0438 \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0436\u0435, \u0440\u0443\u0438\u043d\u044f\u0449\u0438\u0435 \u043a\u0430\u0442\u043a\u0438 \u0447\u0435\u043b\u044b. \u003Cbr\u003E\n\u0418 \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u043e \u044f \u0443\u0432\u0435\u0440\u0435\u043d, \u0447\u0442\u043e \u0440\u0435\u0436\u0438\u043c \u0435\u0449\u0451 \u043d\u0430\u0439\u0434\u0435\u0442 \u0447\u0435\u043c \u043c\u0435\u043d\u044f \u0443\u0434\u0438\u0432\u0438\u0442\u044c.\u003C\/p\u003E","renderFailed":false,"editedAt":"2026-10-23T02:20:02+00:00","canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":1,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":1,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196875"}},"user":{"data":{"type":"users","id":"1676678"}},"editedUser":{"data":{"type":"users","id":"1676678"}},"mentionedBy":{"data":[]},"likes":{"data":[{"type":"users","id":"1053466"}]}}},{"type":"posts","id":"4722465","attributes":{"number":32,"createdAt":"2026-10-23T02:55:08+00:00","contentType":"comment","contentHtml":"\u003Cblockquote class=\u0022uncited\u0022\u003E\u003Cdiv\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/forum.exbo.net\/d\/196875-reshil-poigrat-etot-vash-kolizey\/1\u0022 class=\u0022PostMention\u0022 data-id=\u00224722337\u0022\u003EIgorLaser\u003C\/a\u003E \u0422\