0440\u043c \u0442\u0440\u0435\u043a\u0438\u043d\u0433\u0435 \u043c\u043e\u0436\u0435\u0442 \u043f\u0435\u0440\u0435\u0441\u0442\u0440\u0435\u043b\u044f\u0442\u044c 2-3 \u0432 \u0435\u0431\u043b\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u043e\u0434 \u043f\u043e\u0434\u043e\u0440\u043e\u0436\u043d\u0438\u043a\u043e\u043c\u003Cbr\u003E\n5.\u044f \u0431\u044b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043d\u0430\u0432\u0435\u0440\u043d\u043e\u0435 \u0434\u043b\u044f \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430 \u0432 \u043e\u0431\u0449\u0435\u043c \u0438\u043b\u0438 \u0432 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0435 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u044b, \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c \u0432 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0435 \u0447\u0435\u043c \u0432\u044b\u0448\u0435 \u043b\u0438\u0433\u0430 \u0442\u0435\u043c \u0432\u044b\u0448\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u043d\u043e \u0438 \u0441\u043b\u043e\u0436\u043d\u0435\u0435 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u044b\u003Cbr\u003E\n6.\u043c\u043e\u0434\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u044b \u0431\u0443\u0434\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043a\u0430\u043a \u0442\u043e \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0442\u044c, \u0438\u0445 \u044f \u043a\u0430\u043a \u0442\u043e \u0438 \u043d\u0435 \u0437\u0430\u043c\u0435\u0442\u0438\u043b \u0445\u043e\u0442\u044f \u0432 \u043f\u0440\u043e\u0448\u043b\u044b\u0439 \u0440\u0430\u0437 \u043f\u043e\u0442\u0435\u0442\u044c \u0438\u043d\u043e\u0433\u0434\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043b\u043e\u0441\u044c, \u043d\u043e \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0447