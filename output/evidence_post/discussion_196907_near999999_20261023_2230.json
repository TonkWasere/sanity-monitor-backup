40\u0430\u0443\u043d\u0434\u0430\u0445 \u0441\u043e \u0441\u0442\u0440\u0435\u043b\u043a\u0430\u043c\u0438 \u0438\u043b\u0438 \u0434\u0440\u043e\u0431\u043e\u0432\u0438\u043a \u043d\u0435 \u043e\u0442\u0441\u0442\u0440\u0435\u043b\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0441\u0442\u0438\u0439\/\u0445\u0438\u043c\u0435\u0440 \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u0438\u0442\u044c \u043e\u0442 \u0436\u0438\u0437\u043d\u0438 \u0442\u0438\u043c\u0435\u0439\u0442\u0430 \u0434\u043e \u0446\u0435\u043d\u043d\u044b\u0445 % \u0438\u0434\u043e\u043b\u0430\u003C\/li\u003E\n\u003Cli\u003E\u0411\u0443\u0434\u0435\u0442 \u043b\u0438 \u0437\u0430\u0449\u0438\u0442\u0430 \u043e\u0442 \u043f\u043e\u0442\u0435\u0440\u0438 \u043e\u0447\u043a\u043e\u0432, \u0435\u0441\u043b\u0438 \u0442\u044b \u0441\u0430\u043c \u0438\u0433\u0440\u0430\u043b \u043b\u0443\u0447\u0448\u0435 \u0447\u0435\u043c \u043e\u0442\u043b\u0438\u0447\u043d\u043e, \u043d\u043e \u043d\u0435 \u043f\u043e\u0432\u0435\u0437\u043b\u043e \u0441 \u0441\u043e\u044e\u0437\u043d\u0438\u043a\u0430\u043c\u0438.\u003C\/li\u003E\u003C\/ol\u003E\n\n\u003Cp\u003E-\u043f\u0440\u043e \u043f\u043e\u0434\u0431\u043e\u0440\u003C\/p\u003E\n\u003Col style=\u0022list-style-type:decimal\u0022\u003E\u003Cli\u003E5vs5 \u0438\u043b\u0438 \u043a\u0430\u043a \u0432\u0441\u0435\u0433\u0434\u0430 5vs 1-1-1-1-1 \/ 1-1-1-2 \/ 1-1-3 \/ 1-4 \/ 2-2-1 \/ 2-3 (\u0432\u0440\u043e\u0434\u0435 \u0432\u0441\u0451 \u0443\u043a\u0430\u0437\u0430\u043b)\u003Cbr\u003E\n1.1. \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u043f\u0430\u0447\u043a\u0430 \u0438\u0437 5 \u0443\u0436\u0435 \u0441\u044b\u0433\u0440\u0430\u043d\u043d\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0431\u0443\u0434\u0435\u0442 \u0441\u0438\u043b\u044c\u043d\u0435\u0435 \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0442\u0438\u0432 \u043d\u0438\u0445 \u043d\u0435\u0442 \u0445\u043e\u0442\u044f \u0431\u044b \u0442\u0430\u043a\u043e\u0439 \u0436\