440\u043e\u0441\u0442\u043e \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u044f\u0442 \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d\u0438 \u043d\u0430\u0445\u043e\u0434\u044f\u0442 \u0441 \u0441\u0430\u043a-1 5 \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432 \u0432 \u0434\u0435\u043d\u044c \u0438 \u0437\u0430\u0431\u0440\u043e\u0441\u044f\u0442 \u044d\u0442\u043e. \u041f\u043e \u0445\u043e\u0440\u043e\u0448\u0435\u043c\u0443 \u0431\u044b \u043d\u0430 \u044e\u0436\u043d\u044b\u0445 \u043b\u043e\u043a\u0430\u0446\u0438\u044f\u0445 \u0447\u0443\u0442\u043a\u0430 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u044c \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432. \u042f \u0441\u0435\u0439\u0447\u0430\u0441 \u0447\u0442\u043e\u0431\u044b \u043d\u0430 \u0441\u0430\u043a-2 \u043d\u0430\u0431\u0438\u0432\u0430\u0442\u044c \u043d\u0430\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u043a\u0430\u043a \u0441\u0435\u0439\u0447\u0430\u0441 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 - \u0431\u0435\u0433\u0430\u044e \u0441 \u043f\u0438\u043e\u043d\u0435\u0440\u043e\u043c \u0438 \u043f\u043e \u043d\u0435\u043c\u0443 \u043d\u0430\u0445\u043e\u0436\u0443, \u0430 \u043f\u043e\u0442\u043e\u043c \u0432\u043a\u043b\u044e\u0447\u0430\u044e \u0441\u0430\u043a-2. \u0412\u043e\u043e\u0431\u0449\u0435\u043c - \u0438\u043b\u0438 \u0437\u043e\u043d\u044b \u043f\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0443 2 \u0438 1, \u043b\u0438\u0431\u043e \u0432 \u043b\u0435\u0441\u0443 \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432 \u0440\u0430\u0437\u0430 \u0432 \u0434\u0432\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0438 \u0443 \u0431\u0430\u043d\u0434\u043e\u0441\u043e\u0432 \u0432 \u044f\u043c\u0435 \u0442\u0430\u043a\u0436\u0435. \u041d\u0443 \u0438 \u0435\u0449\u0451 - \u0440\u0430\u0437 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0432\u0435\u0449\u0438 \u0432 \u043c\u0443\u0441\u043e\u0440, \u0442\u043e \u044f \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0431\u044b \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0432 \u043c\u0443\u0441\u043e\u0440 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u0443\u043c\u043a\u0438 \u0441 \u043f\u0430\u0442\u0440\u043e\u043d\u0430\u043c\u0438, \u0447\u0442\u043e\u0431\u044b \u0438\u0445 \u0442\u043e\u0436\u0435 \u043d\u0435 \u043b\u0443\u0442\u0430\u0442\u044c \u0441 \u0441\u0438\u0433\u043d\u0430\u043b\u043e\u0432, \u0447\u0430\u0441\u0442\u043e \u0441\u044b\u043f\u0438\u0442 \u043d\u0435 \u0441\u0432\u043e\u0438\u0445\u003C\/p\u003E","renderFailed":false,"canEdit":false,"canDelete":false,"canHide":false,"mentionedByCount":0,"canFlag":false,"isApproved":true,"canApprove":false,"canLike":false,"likesCount":0,"canReact":false,"canDeletePostReactions":false,"reactionCounts":{"32":0,"33":0,"34":0,"35":0,"38":0,"39":0,"40":0,"42":0,"43":0,"44":0,"45":0,"46":0,"47":0,"48":0,"50":0,"51":0,"52":0,"54":0,"55":0,"56":0,"57":0,"59":0,"60":0,"61":0,"63":0,"65":0,"67":0,"68":0,"69":0,"72":0,"73":0,"74":0,"75":0,"76":0,"77":0,"80":0,"81":0,"82":0,"83":0,"84":0,"85":0,"86":0,"87":0,"88":0},"userReactionIdentifier":null,"canSelectAsBestAnswer":false},"relationships":{"discussion":{"data":{"type":"discussions","id":"196425"}},"user":{"data":{"type":"users","id":"222756"}},"mentionedBy":{"data":[]},"likes":{"data":[]}}},{"type":"posts","id":"4713148","attributes":{"number":112,"createdAt":"2026-10-17T15:24:20+00:00","contentType":"comment","contentHtml":"\u003Cp\u003E\u041f\u043e\u0433\u043e\u043d\u044f\u043b \u044f \u0432 \u043f\u0430\u0447\u043a\u0430\u0445 \u043d\u0430 \u043f\u0440\u0438\u0442\u043e\u043a\u0435\u2026\u003Cbr\u003E\n\u041f\u0430\u0447\u043a\u0430 \u0438\u0437 \u0434\u0432\u0443\u0445 \u0438 \u0442\u0440\u0435\u0445 \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u0437\u043